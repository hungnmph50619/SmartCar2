@model SmartCar.Web.ViewModels.StaffDashboardViewModel
@using SmartCar.Domain.Enums
@{
    ViewData["Title"] = "Tổng quan nhân viên";
}
<div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4">
    <div><h1 class="h3 mb-1">Công việc nhân viên</h1><p class="text-muted mb-0">Giao xe, nhận xe, thuê tại quầy và hoàn tiền đã được duyệt.</p></div>
    <div class="d-flex gap-2"><a class="btn btn-outline-primary" asp-action="Bookings">Tất cả đơn cần xử lý</a><a class="btn btn-primary" asp-action="CounterRental">+ Thuê tại quầy</a></div>
</div>
<div class="row g-3 mb-4">
    <div class="col-md-6 col-xl"><div class="card card-body shadow-sm h-100"><div class="text-muted small">Chờ chuẩn bị xe</div><div class="display-6 fw-semibold">@Model.PaidWaitingPreparation</div></div></div>
    <div class="col-md-6 col-xl"><div class="card card-body shadow-sm h-100"><div class="text-muted small">Nhận xe hôm nay</div><div class="display-6 fw-semibold">@Model.TodayPickups</div></div></div>
    <div class="col-md-6 col-xl"><div class="card card-body shadow-sm h-100"><div class="text-muted small">Trả xe hôm nay</div><div class="display-6 fw-semibold">@Model.TodayReturns</div></div></div>
    <div class="col-md-6 col-xl"><div class="card card-body shadow-sm h-100"><div class="text-muted small">Chờ kiểm tra trả xe</div><div class="display-6 fw-semibold">@Model.PendingInspections</div></div></div>
    <div class="col-md-6 col-xl"><a class="card card-body shadow-sm h-100 text-decoration-none text-reset" asp-action="Refunds"><div class="text-muted small">Hoàn tiền đã duyệt</div><div class="display-6 fw-semibold">@Model.ApprovedRefundBookings</div></a></div>
</div>
<div class="card shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center"><strong>Việc cần xử lý gần nhất</strong><a asp-action="Bookings" class="small">Xem tất cả</a></div>
    @if (Model.WorkItems.Count == 0)
    {
        <div class="card-body text-muted">Hiện không có đơn nghiệp vụ đang chờ nhân viên.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Đơn</th><th>Khách</th><th>Xe</th><th>Nhận / trả</th><th>Trạng thái</th><th></th></tr></thead>
                <tbody>
                    @foreach (var item in Model.WorkItems)
                    {
                        <tr><td><strong>#@item.BookingId</strong></td><td>@item.CustomerName<div class="small text-muted">@item.CustomerPhone</div></td><td>@item.VehicleName<div class="small text-muted">@item.LicensePlate</div></td><td><div>@item.PickupDate.ToString("dd/MM HH:mm")</div><div class="small text-muted">→ @item.ReturnDate.ToString("dd/MM HH:mm")</div></td><td><span class="badge bg-primary">@item.Status.ToVietnamese()</span></td><td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.BookingId">Xử lý</a></td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>