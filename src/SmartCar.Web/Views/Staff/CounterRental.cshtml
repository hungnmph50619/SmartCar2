@model SmartCar.Web.ViewModels.StaffCounterRentalViewModel
@using SmartCar.Application.Features.Bookings
@using SmartCar.Domain.Constants
@inject SmartCar.Infrastructure.Persistence.ApplicationDbContext PolicyDb
@{
    var policy = await SmartCar.Infrastructure.Services.BusinessPolicyStore.ReadAsync(PolicyDb, Context.RequestAborted);
    ViewData["Title"] = "Thuê xe tại quầy";
}

@section Styles {
    <link rel="stylesheet" href="~/css/staff-operations.css" asp-append-version="true" />
}

<div class="staff-op-page">
    <section class="staff-hero p-4 p-lg-5 mb-4">
        <div class="position-relative" style="z-index:1">
            <span class="staff-eyebrow mb-3"><span class="staff-pulse-dot"></span> Nghiệp vụ tại quầy</span>
            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                <div style="max-width:800px">
                    <h1 class="display-6 fw-bold mb-2">Lập đơn thuê xe tại quầy</h1>
                    <p class="text-muted mb-0">
                        Tìm đúng khách, chọn thời gian rồi hệ thống chỉ trả về các xe thực sự còn khả dụng theo cùng quy tắc lịch với website khách hàng.
                        Đơn sau khi lập phải qua bước nhân viên kiểm tra và Admin duyệt trước khi thu tiền.
                    </p>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <a class="btn btn-outline-primary px-4" asp-controller="StaffCustomers" asp-action="Index">Tìm trong danh sách khách</a>
                    <a class="btn btn-primary staff-action-button px-4" asp-controller="StaffCustomers" asp-action="Create">＋ Tạo khách mới</a>
                </div>
            </div>
        </div>
    </section>

    <div class="row g-3 mb-4 staff-stagger">
        <div class="col-sm-6 col-xl-3">
            <div class="staff-step h-100">
                <span class="staff-step-number">1</span>
                <div class="fw-bold">Chọn khách</div>
                <div class="small text-muted">Tìm theo tên, số điện thoại hoặc email. Không tải toàn bộ khách vào dropdown.</div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="staff-step h-100">
                <span class="staff-step-number">2</span>
                <div class="fw-bold">Chọn thời gian</div>
                <div class="small text-muted">Khoảng thuê quyết định xe nào thực sự có thể nhận đơn.</div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="staff-step h-100">
                <span class="staff-step-number">3</span>
                <div class="fw-bold">Tìm xe khả dụng</div>
                <div class="small text-muted">Có xét lịch trùng, buffer @policy.VehicleTurnaroundMinutes phút, tình trạng và giấy tờ xe.</div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="staff-step h-100">
                <span class="staff-step-number">4</span>
                <div class="fw-bold">Duyệt rồi thanh toán</div>
                <div class="small text-muted">Sau Admin duyệt mới chọn thu tiền mặt hoặc xác nhận khách đã chuyển khoản/QR.</div>
            </div>
        </div>
    </div>

    <form asp-action="CounterRental" method="post" class="card staff-form-card" data-loading-form id="counter-rental-form">
        <input type="hidden" name="PolicyVersion" value="@policy.Version" />
        <div class="alert alert-info m-3">Cọc @policy.DepositPercent.ToString("0.##")% tiền thuê ban đầu. Giữ cọc @policy.DepositHoldDays ngày sau khi trả xe. Định mức @policy.IncludedKilometersPerDay km/ngày; vượt mức @policy.ExcessKilometerFee.ToString("N0") đ/km.</div>
        <div class="card-body p-4 p-lg-5">
            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4">
                <div>
                    <h2 class="h4 mb-1">Thông tin đơn thuê</h2>
                    <div class="text-muted small">Kết quả tìm xe dùng trực tiếp nguồn khả dụng của hệ thống; POST vẫn kiểm tra lại lần cuối để chống tranh chấp lịch.</div>
                </div>
                <span class="badge rounded-pill text-bg-warning px-3 py-2">Chưa tạo đơn</span>
            </div>

            <div asp-validation-summary="All" class="alert alert-danger py-2 mb-4"></div>

            <input asp-for="CustomerId" type="hidden" id="counter-customer-id" />
            <input asp-for="VehicleId" type="hidden" id="counter-vehicle-id" />

            <section class="staff-work-section mb-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <span class="staff-step-number">1</span>
                    <div>
                        <h3 class="h5 mb-0">Khách hàng</h3>
                        <div class="small text-muted">Nhập ít nhất 2 ký tự để tìm trên hệ thống.</div>
                    </div>
                </div>

                <div class="staff-autocomplete" data-autocomplete="customer">
                    <label for="counter-customer-search" class="form-label fw-semibold">Tên / SĐT / email *</label>
                    <input id="counter-customer-search"
                           type="search"
                           class="form-control form-control-lg"
                           autocomplete="off"
                           placeholder="Ví dụ: Nguyễn Văn A, 098..., a@gmail.com"
                           data-selected-name="@Model.SelectedCustomerName"
                           data-selected-detail="@Model.SelectedCustomerDetail"
                           aria-autocomplete="list"
                           aria-controls="counter-customer-results" />
                    <div id="counter-customer-results" class="staff-search-results d-none" role="listbox"></div>
                    <div id="counter-customer-selected" class="staff-selected-result d-none mt-2"></div>
                    <div id="counter-customer-status" class="form-text">Không dùng dropdown toàn bộ khách hàng nữa.</div>
                    <span asp-validation-for="CustomerId" class="text-danger small"></span>
                </div>
            </section>

            <section class="staff-work-section mb-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <span class="staff-step-number">2</span>
                    <div>
                        <h3 class="h5 mb-0">Thời gian thuê</h3>
                        <div class="small text-muted">Đổi thời gian sẽ tự bỏ xe đã chọn vì tính khả dụng có thể thay đổi.</div>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input asp-for="IsImmediatePickup" class="form-check-input" id="counter-immediate" />
                            <label asp-for="IsImmediatePickup" class="form-check-label fw-semibold">Nhận ngay tại quầy</label>
                        </div>
                        <div class="form-text">Không cần chờ tới giờ nhận để demo. Sau khi Admin duyệt, hệ thống cập nhật giờ nhận và dời giờ trả để giữ nguyên thời lượng thuê, rồi kiểm tra lại lịch xe. Chuyến bắt đầu khi ký bàn giao.</div>
                    </div>
                    <div class="col-md-6" id="counter-scheduled-pickup">
                        <label asp-for="PickupDate" class="form-label fw-semibold">Thời gian nhận *</label>
                        <input asp-for="PickupDate" type="datetime-local" class="form-control" asp-format="{0:yyyy-MM-ddTHH:mm}" id="counter-pickup" required />
                        <span asp-validation-for="PickupDate" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ReturnDate" class="form-label fw-semibold">Thời gian trả dự kiến *</label>
                        <input asp-for="ReturnDate" type="datetime-local" class="form-control" asp-format="{0:yyyy-MM-ddTHH:mm}" id="counter-return" required />
                        <span asp-validation-for="ReturnDate" class="text-danger small"></span>
                    </div>
                </div>

                <div class="staff-summary p-3 mt-3" aria-live="polite">
                    <div class="d-flex justify-content-between gap-3 flex-wrap">
                        <div>
                            <div class="small text-muted">Khoảng thuê dự kiến</div>
                            <strong id="counter-duration">Đang tính...</strong>
                        </div>
                        <div class="text-md-end">
                            <div class="small text-muted">Buffer vận hành</div>
                            <strong>≥ @policy.VehicleTurnaroundMinutes phút giữa hai chuyến</strong>
                        </div>
                    </div>
                </div>
            </section>

            <section class="staff-work-section mb-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <span class="staff-step-number">3</span>
                    <div>
                        <h3 class="h5 mb-0">Xe khả dụng</h3>
                        <div class="small text-muted">Xe còn trống tự hiện theo khoảng thuê; nhập tên hoặc biển số để lọc.</div>
                    </div>
                </div>

                <div class="staff-autocomplete" data-autocomplete="vehicle">
                    <label for="counter-vehicle-search" class="form-label fw-semibold">Tên xe / biển số / hãng *</label>
                    <input id="counter-vehicle-search"
                           type="search"
                           class="form-control form-control-lg"
                           autocomplete="off"
                           placeholder="Lọc tên xe hoặc biển số (không bắt buộc)"
                           data-selected-name="@Model.SelectedVehicleName"
                           data-selected-detail="@Model.SelectedVehicleDetail"
                           aria-autocomplete="list"
                           aria-controls="counter-vehicle-results" />
                    <div id="counter-vehicle-results" class="staff-vehicle-list d-none mt-3" role="listbox" aria-label="Xe theo lịch thuê"></div>
                    <div id="counter-vehicle-selected" class="staff-selected-result d-none mt-2"></div>
                    <div id="counter-vehicle-status" class="form-text">Hệ thống sẽ kiểm tra lịch và chỉ trả xe còn nhận được đơn này.</div>
                    <span asp-validation-for="VehicleId" class="text-danger small"></span>
                </div>
            </section>

            <section class="staff-note p-3 mb-4 small">
                <strong>Thanh toán chưa được chọn ở bước này.</strong>
                <div class="mt-1">
                    Sau khi Staff kiểm tra và Admin duyệt, đơn chuyển sang <strong>Chờ thanh toán</strong>. Nhân viên có thể <strong>thu tiền mặt</strong> hoặc đưa <strong>QR</strong> cho khách chuyển khoản; chuyển khoản cần Admin đối soát.
                </div>
            </section>

            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-primary staff-action-button px-4" type="submit" data-loading-text="Đang lập đơn...">Lập đơn thuê tại quầy</button>
                <a class="btn btn-outline-secondary px-4" asp-action="Index">Hủy</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const customerSearch = document.getElementById('counter-customer-search');
            const customerId = document.getElementById('counter-customer-id');
            const customerResults = document.getElementById('counter-customer-results');
            const customerSelected = document.getElementById('counter-customer-selected');
            const customerStatus = document.getElementById('counter-customer-status');

            const vehicleSearch = document.getElementById('counter-vehicle-search');
            const vehicleId = document.getElementById('counter-vehicle-id');
            const vehicleResults = document.getElementById('counter-vehicle-results');
            const vehicleSelected = document.getElementById('counter-vehicle-selected');
            const vehicleStatus = document.getElementById('counter-vehicle-status');

            const pickup = document.getElementById('counter-pickup');
            const immediate = document.getElementById('counter-immediate');
            const scheduledPickup = document.getElementById('counter-scheduled-pickup');
            const returned = document.getElementById('counter-return');
            const duration = document.getElementById('counter-duration');
            const form = document.getElementById('counter-rental-form');

            let customerTimer;
            let vehicleTimer;
            let customerRequest = 0;
            let vehicleRequest = 0;

            const escapeHtml = value => String(value ?? '')
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#039;');

            const hideResults = container => {
                container.replaceChildren();
                container.classList.add('d-none');
            };

            const renderResults = (container, items, onSelect, emptyText) => {
                container.replaceChildren();
                if (!items.length) {
                    const empty = document.createElement('div');
                    empty.className = 'staff-search-empty';
                    empty.textContent = emptyText;
                    container.appendChild(empty);
                } else {
                    items.forEach(item => {
                        const button = document.createElement('button');
                        button.type = 'button';
                        button.className = 'staff-search-option';
                        button.setAttribute('role', 'option');
                        button.innerHTML = `<span class="fw-semibold">${escapeHtml(item.label)}</span><span class="small text-muted">${escapeHtml(item.detail)}</span>`;
                        if (item.canBook === false) {
                            button.disabled = true;
                            button.title = 'Hãy chỉnh giờ trả theo giới hạn hiển thị rồi tìm lại xe.';
                        } else {
                            button.addEventListener('click', () => onSelect(item));
                        }
                        container.appendChild(button);
                    });
                }
                container.classList.remove('d-none');
            };

            const renderVehicles = items => {
                vehicleResults.replaceChildren();
                if (!items.length) {
                    const empty = document.createElement('div');
                    empty.className = 'staff-search-empty';
                    empty.textContent = 'Không có xe phù hợp. Hãy đổi thời gian hoặc từ khóa.';
                    vehicleResults.appendChild(empty);
                }
                items.forEach(item => {
                    const button = document.createElement('button');
                    button.type = 'button';
                    button.className = 'staff-vehicle-card';
                    button.setAttribute('role', 'option');
                    button.setAttribute('aria-selected', String(String(item.value) === vehicleId.value));
                    button.innerHTML = `<span class="fw-semibold">${escapeHtml(item.label)}</span><span class="small text-muted">${escapeHtml(item.detail)}</span><span class="badge ${item.canBook ? 'text-bg-success' : 'text-bg-secondary'}">${item.canBook ? 'Chọn xe này' : 'Cần đổi giờ trả'}</span>`;
                    if (!item.canBook) {
                        button.disabled = true;
                    } else {
                        button.addEventListener('click', () => {
                            selectVehicle(item);
                            vehicleResults.querySelectorAll('.staff-vehicle-card').forEach(card =>
                                card.setAttribute('aria-selected', String(card === button)));
                        });
                    }
                    vehicleResults.appendChild(button);
                });
                vehicleResults.classList.remove('d-none');
            };

            const clearCustomer = () => {
                ++customerRequest;
                customerId.value = '';
                customerSelected.replaceChildren();
                customerSelected.classList.add('d-none');
            };

            const clearVehicle = (message = 'Hãy tìm lại xe phù hợp với khoảng thời gian mới.') => {
                ++vehicleRequest;
                clearTimeout(vehicleTimer);
                vehicleId.value = '0';
                vehicleSelected.replaceChildren();
                vehicleSelected.classList.add('d-none');
                vehicleSearch.value = '';
                vehicleStatus.textContent = message;
                hideResults(vehicleResults);
            };

            const selectCustomer = item => {
                ++customerRequest;
                customerId.value = item.value;
                customerSearch.value = item.label;
                customerSelected.innerHTML = `<strong>${escapeHtml(item.label)}</strong><span class="small text-muted ms-2">${escapeHtml(item.detail)}</span>`;
                customerSelected.classList.remove('d-none');
                customerStatus.textContent = 'Đã chọn khách hàng.';
                hideResults(customerResults);
            };

            const selectVehicle = item => {
                vehicleId.value = item.value;
                vehicleSearch.value = item.label;
                vehicleSelected.innerHTML = `<strong>${escapeHtml(item.label)}</strong><span class="small text-muted ms-2">${escapeHtml(item.detail)}</span>`;
                vehicleSelected.classList.remove('d-none');
                vehicleStatus.textContent = item.latestReturn
                    ? `Đã chọn xe. Giờ trả muộn nhất trước đơn kế tiếp: ${new Date(item.latestReturn).toLocaleString('vi-VN')}.`
                    : 'Đã chọn xe còn khả dụng trong khoảng thời gian này.';
            };

            customerSearch.addEventListener('input', () => {
                clearCustomer();
                clearTimeout(customerTimer);
                const term = customerSearch.value.trim();
                if (term.length < 2) {
                    hideResults(customerResults);
                    customerStatus.textContent = 'Nhập ít nhất 2 ký tự để tìm khách.';
                    return;
                }

                customerStatus.textContent = 'Đang tìm khách...';
                const requestId = ++customerRequest;
                customerTimer = setTimeout(async () => {
                    try {
                        const response = await fetch(`@Url.Action("Customers", "StaffLookups")?term=${encodeURIComponent(term)}`, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                        if (!response.ok) throw new Error('lookup-failed');
                        const items = await response.json();
                        if (requestId !== customerRequest) return;
                        renderResults(customerResults, items, selectCustomer, 'Không tìm thấy khách đang hoạt động phù hợp.');
                        customerStatus.textContent = items.length ? `Tìm thấy ${items.length} kết quả.` : 'Không tìm thấy khách phù hợp.';
                    } catch {
                        if (requestId === customerRequest) customerStatus.textContent = 'Không thể tìm khách lúc này. Hãy thử lại.';
                    }
                }, 250);
            });

            const toLocalMinuteValue = date => {
                const pad = value => String(value).padStart(2, '0');
                return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`;
            };

            const minimumPickupDate = () => {
                const threshold = Date.now() + @policy.MinimumPickupLeadMinutes * 60000;
                return new Date(Math.ceil(threshold / 60000) * 60000);
            };

            const syncTimeConstraints = () => {
                const minimumPickup = minimumPickupDate();
                pickup.min = toLocalMinuteValue(minimumPickup);

                const start = immediate.checked ? new Date() : (pickup.value ? new Date(pickup.value) : null);
                if (start && Number.isFinite(start.valueOf())) {
                    returned.min = toLocalMinuteValue(new Date(Math.ceil((start.getTime() + 60000) / 60000) * 60000));
                } else {
                    returned.removeAttribute('min');
                }

                pickup.setCustomValidity('');
                returned.setCustomValidity('');

                if (!immediate.checked && pickup.value) {
                    const selectedPickup = new Date(pickup.value);
                    if (!Number.isFinite(selectedPickup.valueOf()) || selectedPickup < minimumPickup) {
                        pickup.setCustomValidity(`Thời gian nhận phải cách hiện tại ít nhất @policy.MinimumPickupLeadMinutes phút.`);
                    }
                }

                if ((immediate.checked || pickup.value) && returned.value) {
                    const selectedPickup = immediate.checked ? new Date() : new Date(pickup.value);
                    const selectedReturn = new Date(returned.value);
                    if (!Number.isFinite(selectedReturn.valueOf()) || selectedReturn <= selectedPickup) {
                        returned.setCustomValidity('Thời gian trả phải sau thời gian nhận.');
                    }
                }
            };

            const validRange = () => {
                syncTimeConstraints();
                if ((!immediate.checked && !pickup.value) || !returned.value) return false;
                const start = immediate.checked ? new Date() : new Date(pickup.value);
                const end = new Date(returned.value);
                return pickup.checkValidity() &&
                    returned.checkValidity() &&
                    Number.isFinite(start.valueOf()) &&
                    Number.isFinite(end.valueOf()) &&
                    end > start;
            };

            const renderDuration = () => {
                if ((!immediate.checked && !pickup.value) || !returned.value) {
                    duration.textContent = 'Chọn đủ thời gian nhận và trả.';
                    return;
                }
                const start = immediate.checked ? new Date() : new Date(pickup.value);
                const end = new Date(returned.value);
                const diff = end - start;
                if (!Number.isFinite(diff) || diff <= 0) {
                    duration.textContent = 'Thời gian trả phải sau thời gian nhận.';
                    return;
                }
                const hours = diff / 3600000;
                const billableDays = Math.max(1, Math.ceil(hours / 24));
                duration.textContent = `${hours.toLocaleString('vi-VN', { maximumFractionDigits: 1 })} giờ · ${billableDays} ngày tính phí`;
            };

            const searchVehicles = () => {
                clearTimeout(vehicleTimer);
                const requestId = ++vehicleRequest;
                if (!validRange()) {
                    hideResults(vehicleResults);
                    vehicleStatus.textContent = 'Hãy chọn thời gian nhận/trả hợp lệ trước khi tìm xe.';
                    return;
                }
                const term = vehicleSearch.value.trim();
                vehicleStatus.textContent = 'Đang kiểm tra xe khả dụng...';
                vehicleTimer = setTimeout(async () => {
                    const query = new URLSearchParams({
                        pickupDate: pickup.value,
                        returnDate: returned.value,
                        immediatePickup: immediate.checked,
                        term
                    });
                    try {
                        const response = await fetch(`@Url.Action("Vehicles", "StaffLookups")?${query}`, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                        if (!response.ok) {
                            const failure = await response.json().catch(() => null);
                            throw new Error(failure?.message ?? 'Không thể kiểm tra xe lúc này.');
                        }
                        const items = await response.json();
                        if (requestId !== vehicleRequest) return;
                        renderVehicles(items);
                        const count = items.filter(item => item.canBook).length;
                        vehicleStatus.textContent = count
                            ? `Có ${count} xe chọn được${items.length >= 60 ? ' trong 60 kết quả đầu; gõ từ khóa để tìm thêm' : ''}. Xe có đơn sau ghi rõ giới hạn giờ trả.`
                            : 'Không có xe đủ khoảng thuê này. Hãy đổi giờ nhận/trả hoặc xem giới hạn của xe bên dưới.';
                    } catch (ex) {
                        if (requestId === vehicleRequest) vehicleStatus.textContent = ex.message;
                    }
                }, 250);
            };

            const onTimeChanged = () => {
                syncTimeConstraints();
                renderDuration();
                const rangeValid = validRange();
                clearVehicle(rangeValid
                    ? 'Thời gian đã thay đổi. Đang cập nhật xe khả dụng...'
                    : 'Khoảng thời gian chưa hợp lệ nên chưa thể tìm xe.');
                vehicleSearch.disabled = !rangeValid;
                if (rangeValid) searchVehicles();
            };

            pickup.addEventListener('change', onTimeChanged);
            returned.addEventListener('change', onTimeChanged);
            immediate.addEventListener('change', () => {
                pickup.disabled = immediate.checked;
                scheduledPickup.classList.toggle('d-none', immediate.checked);
                onTimeChanged();
            });

            vehicleSearch.addEventListener('input', () => {
                vehicleId.value = '0';
                vehicleSelected.classList.add('d-none');
                searchVehicles();
            });

            form.addEventListener('submit', event => {
                syncTimeConstraints();

                if (!validRange()) {
                    event.preventDefault();
                    clearVehicle('Khoảng thời gian chưa hợp lệ nên chưa thể lập đơn.');
                    if (!pickup.checkValidity()) {
                        pickup.reportValidity();
                    } else {
                        returned.reportValidity();
                    }
                    return;
                }

                if (!customerId.value) {
                    event.preventDefault();
                    customerStatus.textContent = 'Phải chọn một khách hàng từ kết quả tìm kiếm.';
                    customerSearch.focus();
                    return;
                }

                if (!vehicleId.value || vehicleId.value === '0') {
                    event.preventDefault();
                    vehicleStatus.textContent = 'Phải chọn một xe còn khả dụng từ kết quả tìm kiếm.';
                    vehicleSearch.focus();
                }
            });

            document.addEventListener('click', event => {
                if (!event.target.closest('[data-autocomplete="customer"]')) hideResults(customerResults);
            });

            pickup.disabled = immediate.checked;
            scheduledPickup.classList.toggle('d-none', immediate.checked);
            syncTimeConstraints();
            renderDuration();
            vehicleSearch.disabled = !validRange();
            if (customerId.value && customerSearch.dataset.selectedName) {
                selectCustomer({ value: customerId.value, label: customerSearch.dataset.selectedName, detail: customerSearch.dataset.selectedDetail });
            }
            if (vehicleId.value !== '0' && vehicleSearch.dataset.selectedName) {
                selectVehicle({ value: vehicleId.value, label: vehicleSearch.dataset.selectedName, detail: vehicleSearch.dataset.selectedDetail });
            }
            searchVehicles();
        })();
    </script>
}
