@model SmartCar.Web.ViewModels.StaffBookingDetailsViewModel
@using SmartCar.Domain.Enums
@using SmartCar.Domain.Constants
@using SmartCar.Application.Features.Operations
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = $"Xử lý đơn #{Model.Booking.BookingId}";
    var b = Model.Booking;
    var canInspect = b.Status == BookingStatus.PendingInspection
        && Model.HandoverIdentityVerified
        && Model.HandoverSignedDocumentVerified
        && Model.ReturnIdentityVerified
        && Model.ReturnSignedDocumentVerified;
    var hasPaymentAwaitingConfirmation = b.Payments.Any(payment =>
        payment.Status == PaymentStatus.AwaitingConfirmation);
    var canCancelBeforeHandover = !b.HasHandover
        && !hasPaymentAwaitingConfirmation
        && b.Status is BookingStatus.PendingConfirmation
            or BookingStatus.PendingPayment
            or BookingStatus.Paid
            or BookingStatus.ReadyForPickup;
    var canMarkNoShow = b.Status == BookingStatus.ReadyForPickup
        && !b.HasHandover
        && DateTime.Now >= b.PickupDate.AddMinutes(b.Policy.NoShowGraceMinutes);
    var rentalAwaitingConfirmation = b.Payments.Any(payment =>
        payment.Type == PaymentType.Rental &&
        payment.Status == PaymentStatus.AwaitingConfirmation);
    var hasOpenRefund = Model.HasUnapprovedRefund || Model.HasApprovedRefund;
    var hasUnsettledPreHandoverPayment = b.Payments.Any(payment =>
        payment.Type is PaymentType.Rental or PaymentType.Deposit or PaymentType.VehicleSwapAdjustment &&
        payment.Status is PaymentStatus.Pending or PaymentStatus.AwaitingConfirmation);
    var hasPendingSwapAdjustment = b.Payments.Any(payment =>
        payment.Type == PaymentType.VehicleSwapAdjustment &&
        payment.Status == PaymentStatus.Pending);
    var hasOpenExtension = b.Extensions.Any(extension =>
        extension.Status is BookingExtensionStatus.Pending
            or BookingExtensionStatus.NeedsEvidence
            or BookingExtensionStatus.Approved);
    var approvedExtension = b.Extensions
        .Where(extension => extension.Status == BookingExtensionStatus.Approved)
        .OrderByDescending(extension => extension.RequestedReturnDate)
        .FirstOrDefault();
    var extensionNeedsEvidence = b.Extensions.Any(extension =>
        extension.Status == BookingExtensionStatus.NeedsEvidence);
    var extensionAwaitingConfirmation = b.Payments.Any(payment =>
        payment.Type == PaymentType.Extension &&
        payment.Status == PaymentStatus.AwaitingConfirmation);
    var overdueCompensationDebtOpen = b.Payments
        .Where(payment =>
            payment.Type == PaymentType.OverdueCompensationDebt &&
            payment.Amount > 0m &&
            payment.Status is PaymentStatus.Pending or PaymentStatus.AwaitingConfirmation)
        .Sum(payment => payment.Amount);
    var overdueCompensationDebtAwaiting = b.Payments.Any(payment =>
        payment.Type == PaymentType.OverdueCompensationDebt &&
        payment.Amount > 0m &&
        payment.Status == PaymentStatus.AwaitingConfirmation);

    var paymentBankName = Configuration["PaymentQr:BankName"]?.Trim() ?? "Vietcombank";
    var paymentAccountNumber = Configuration["PaymentQr:AccountNumber"]?.Trim() ?? string.Empty;
    var paymentAccountHolder = Configuration["PaymentQr:AccountHolder"]?.Trim() ?? "SMARTCAR";
    var paymentQrImagePath = Configuration["PaymentQr:QrImagePath"]?.Trim() ?? "/images/payment/bank-qr.jpg";
    var transferContent = $"SMARTCAR {b.BookingId}";
}

@section Styles {
    <link rel="stylesheet" href="~/css/staff-operations.css" asp-append-version="true" />
}

<div class="staff-op-page">
    <section class="staff-hero p-4 mb-4">
        <div class="position-relative" style="z-index:1">
            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                <div>
                    <span class="staff-eyebrow mb-2"><span class="staff-pulse-dot"></span> Hồ sơ vận hành</span>
                    <h1 class="h2 mb-1">Đơn #@b.BookingId</h1>
                    <p class="text-muted mb-0">@b.CustomerName · @b.VehicleName · @b.LicensePlate</p>
                </div>
                <div class="d-flex gap-2 flex-wrap align-items-center">
                    <span class="badge bg-primary fs-6">@b.Status.ToVietnamese()</span>
                    <a class="btn btn-outline-secondary" asp-action="Bookings">Danh sách đơn</a>
                </div>
            </div>
        </div>
    </section>

    <div class="row g-3 mb-4">
        <div class="col-lg-7">
            <div class="card card-body shadow-sm h-100 border-0 rounded-4">
                <h2 class="h5">Chuyến thuê</h2>
                <dl class="row mb-0">
                    <dt class="col-sm-4">Khách</dt><dd class="col-sm-8">@b.CustomerName · @(b.CustomerPhone ?? "Chưa có SĐT")</dd>
                    <dt class="col-sm-4">Xe</dt><dd class="col-sm-8">@b.VehicleName · @b.LicensePlate</dd>
                    <dt class="col-sm-4">Nhận dự kiến</dt><dd class="col-sm-8">@b.PickupDate.ToString("dd/MM/yyyy HH:mm")</dd>
                    <dt class="col-sm-4">Trả dự kiến</dt><dd class="col-sm-8">@b.ReturnDate.ToString("dd/MM/yyyy HH:mm")</dd>
                    <dt class="col-sm-4">Tiền thuê + phí</dt><dd class="col-sm-8"><strong>@b.TotalAmount.ToString("N0") đ</strong></dd>
                    <dt class="col-sm-4">Tiền cọc</dt><dd class="col-sm-8"><strong>@b.DepositAmount.ToString("N0") đ</strong></dd>
                </dl>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card card-body shadow-sm h-100 border-0 rounded-4">
                <h2 class="h5">Kiểm soát bắt buộc</h2>
                <div class="small d-grid gap-2">
                    <div>✓ Người nhận/trả phải khớp <strong>hồ sơ danh tính đã xác minh</strong>.</div>
                    <div>✓ File tải lên chỉ là <strong>bản chờ đối chiếu</strong>, không tự trở thành biên bản hợp lệ.</div>
                    <div>✓ Chỉ sau khi Staff mở bản ký và xác minh thì hệ thống mới cho đi bước tiếp theo.</div>
                </div>
            </div>
        </div>
    </div>

    @if (b.Status == BookingStatus.PendingConfirmation)
    {
        <section class="card card-body shadow-sm mb-3 border-warning-subtle rounded-4">
            <div class="d-flex gap-3 align-items-start">
                <span class="staff-step-number">1</span>
                <div class="flex-grow-1">
                    @if (Model.StaffReviewedAt is null)
                    {
                        <h2 class="h5 mb-2">Kiểm tra đơn & gửi Admin duyệt</h2>
                        <p class="text-muted mb-3">Đây là thao tác duy nhất cho bước kiểm tra. Hệ thống kiểm tra KYC, xe và lịch hiện tại rồi ghi trạng thái review thật lên đơn.</p>
                        <form asp-controller="StaffBookingOperations" asp-action="ReviewForApproval" method="post" data-loading-form data-confirm="Kiểm tra điều kiện hiện tại và gửi đơn cho Admin duyệt?">
                            <input type="hidden" name="bookingId" value="@b.BookingId" />
                            <button class="btn btn-primary" data-loading-text="Đang kiểm tra...">Kiểm tra & gửi duyệt</button>
                        </form>
                    }
                    else
                    {
                        <h2 class="h5 mb-2">Đã kiểm tra · đang chờ Admin duyệt</h2>
                        <div class="alert alert-success mb-0">
                            <strong>✓ Bước Staff đã hoàn tất.</strong>
                            Đã kiểm tra lúc @Model.StaffReviewedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm").
                            Không cần và không thể gửi duyệt lần hai.
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    @if (b.Status == BookingStatus.PendingPayment)
    {
        <section class="card card-body shadow-sm mb-3 border-info-subtle rounded-4">
            <div class="d-flex gap-3 align-items-start mb-3">
                <span class="staff-step-number">2</span>
                <div>
                    <h2 class="h5 mb-1">Thanh toán sau khi Admin duyệt</h2>
                    <div class="text-muted">Chọn đúng thao tác khách đang thực hiện tại quầy. Cả hai luồng đều ghi dữ liệu thật.</div>
                </div>
            </div>

            @if (rentalAwaitingConfirmation)
            {
                <div class="alert alert-warning mb-0">
                    <strong>Đang chờ Admin đối soát chuyển khoản.</strong> Không được đồng thời thu/ghi nhận tiền mặt cho đơn này. Sau khi Admin xác nhận tiền thực nhận, đơn sẽ tự chuyển sang Đã thanh toán.
                </div>
            }
            else
            {
                <div class="row g-3">
                    <div class="col-lg-6">
                        <div class="border rounded-4 p-3 h-100">
                            <h3 class="h6">Tiền mặt tại quầy</h3>
                            <p class="small text-muted">Chỉ bấm sau khi nhân viên đã thực nhận đủ tiền thuê/phí và tiền cọc.</p>
                            <form asp-action="ReceiveCash" method="post" data-confirm="Xác nhận bạn đã THỰC NHẬN đủ tiền thuê/phí và tiền cọc bằng tiền mặt? Hệ thống sẽ ghi các khoản này là Paid.">
                                <input type="hidden" name="bookingId" value="@b.BookingId" />
                                <button class="btn btn-success">Đã nhận đủ tiền mặt</button>
                            </form>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="border rounded-4 p-3 h-100">
                            <h3 class="h6 mb-3">Chuyển khoản / QR</h3>
                            <div class="row g-3 align-items-start">
                                <div class="col-sm-auto text-center">
                                    <div class="bg-white border rounded-3 p-2 d-inline-block">
                                        <img src="@paymentQrImagePath"
                                             alt="QR chuyển khoản SmartCar"
                                             width="220" height="220"
                                             style="display:block;object-fit:contain;max-width:100%;height:auto" />
                                    </div>
                                </div>
                                <div class="col">
                                    <dl class="small mb-2">
                                        <dt>Ngân hàng</dt><dd>@paymentBankName</dd>
                                        <dt>Số tài khoản</dt><dd class="font-monospace fw-semibold">@paymentAccountNumber</dd>
                                        <dt>Chủ tài khoản</dt><dd>@paymentAccountHolder</dd>
                                        <dt>Số tiền trước giao xe</dt><dd class="fw-bold text-primary">@b.UpfrontAmount.ToString("N0") đ</dd>
                                        <dt>Nội dung</dt><dd class="font-monospace fw-semibold">@transferContent</dd>
                                    </dl>
                                    <div class="small text-muted">QR dùng chung cấu hình thanh toán với màn Customer; ảnh được hiển thị nguyên tỷ lệ, không crop.</div>
                                </div>
                            </div>
                            <form asp-controller="StaffPayments" asp-action="SubmitCounterQr" method="post" class="mt-3" data-confirm="Xác nhận khách đã thực hiện chuyển khoản/QR? Thao tác này CHƯA coi là đã thanh toán; giao dịch sẽ chờ Admin đối soát.">
                                <input type="hidden" name="bookingId" value="@b.BookingId" />
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" name="transferConfirmed" value="true" id="counter-transfer-confirmed" required />
                                    <label class="form-check-label small" for="counter-transfer-confirmed">Tôi đã thấy khách hoàn tất thao tác chuyển tiền đúng đơn này.</label>
                                </div>
                                <button class="btn btn-outline-primary">Gửi giao dịch chờ đối soát</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </section>
    }

    @if (b.Status == BookingStatus.Paid)
    {
        <section class="card card-body shadow-sm mb-3 rounded-4">
            <div class="d-flex gap-3 align-items-start">
                <span class="staff-step-number">3</span>
                <div class="flex-grow-1">
                    <h2 class="h5">Chuẩn bị xe</h2>
                    @if (hasUnsettledPreHandoverPayment)
                    {
                        <div class="alert alert-warning">
                            Đơn còn khoản tiền trước giao xe chưa hoàn tất hoặc đang chờ đối soát.
                            Không được chuyển sang sẵn sàng bàn giao cho đến khi khoản này được xử lý xong.
                        </div>
                        @if (hasPendingSwapAdjustment && !hasPaymentAwaitingConfirmation)
                        {
                            <form asp-action="ReceiveCash"
                                  method="post"
                                  class="mt-2"
                                  data-confirm="Xác nhận đã thực nhận đủ phần chênh lệch đổi xe còn thiếu bằng tiền mặt?">
                                <input type="hidden" name="bookingId" value="@b.BookingId" />
                                <button class="btn btn-success">Thu chênh lệch đổi xe bằng tiền mặt</button>
                            </form>
                        }
                    }
                    else
                    {
                        <p class="text-muted">Kiểm tra xe thực tế trước khi xác nhận sẵn sàng bàn giao.</p>
                        @if (DateTime.Now.Date == b.PickupDate.Date)
                        {
                            <form asp-action="MarkReady" method="post" data-confirm="Xác nhận xe đã được kiểm tra thực tế và sẵn sàng để giao cho khách?">
                                <input type="hidden" name="bookingId" value="@b.BookingId" />
                                <button class="btn btn-primary">Xe đã sẵn sàng</button>
                            </form>
                        }
                        else
                        {
                            <div class="alert alert-info">Chỉ xác nhận xe sẵn sàng trong ngày nhận xe: @b.PickupDate.ToString("dd/MM/yyyy").</div>
                        }
                    }
                </div>
            </div>
        </section>
    }

    @if (b.Status == BookingStatus.ReadyForPickup)
    {
        <section class="card card-body shadow-sm mb-3 rounded-4">
            <div class="d-flex gap-3 align-items-start mb-3">
                <span class="staff-step-number">4</span>
                <div>
                    <h2 class="h5 mb-1">Bàn giao xe</h2>
                    <div class="text-muted">Danh tính → biên bản điện tử → ký → Staff đối chiếu → bắt đầu chuyến.</div>
                </div>
            </div>

            @if (!b.HasHandover)
            {
                <div class="alert alert-info">Chưa có biên bản giao. Màn bàn giao sẽ đối chiếu hồ sơ đã xác minh và yêu cầu ảnh tình trạng xe.</div>
                @if (BookingWorkflowRules.CanPrepareHandover(DateTime.Now, b.PickupDate, b.ReturnDate))
                {
                    <a class="btn btn-primary align-self-start" asp-controller="Handovers" asp-action="Create" asp-route-bookingId="@b.BookingId">Lập biên bản giao xe</a>
                }
                else
                {
                    <div class="alert alert-info">Chỉ lập biên bản giao từ @b.PickupDate.ToString("dd/MM/yyyy HH:mm").</div>
                }
            }
            else
            {
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="border rounded-4 p-3 h-100">
                            <div class="fw-semibold">Danh tính người nhận</div>
                            @if (Model.HandoverIdentityVerified)
                            {
                                <div class="text-success">✓ Đã đối chiếu đúng khách</div>
                                <div class="small text-muted">@(Model.HandoverIdentityVerifiedBy ?? "Nhân viên") · @Model.HandoverIdentityVerifiedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                            }
                            else
                            {
                                <div class="text-danger">Chưa xác minh danh tính.</div>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="border rounded-4 p-3 h-100">
                            <div class="fw-semibold">Bản giao đã ký</div>
                            @if (Model.HandoverSignedDocumentVerified)
                            {
                                <div class="text-success">✓ Đã đối chiếu chữ ký</div>
                                <div class="small text-muted">@(Model.HandoverSignedVerifiedBy ?? "Nhân viên") · @Model.HandoverSignedVerifiedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                            }
                            else if (Model.HandoverSignedPaths.Count > 0)
                            {
                                <div class="text-warning">Đã tải @Model.HandoverSignedPaths.Count trang, chưa xác minh.</div>
                            }
                            else
                            {
                                <div class="text-danger">Chưa có bản ký.</div>
                            }
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 flex-wrap mt-3">
                    <a class="btn btn-outline-primary" asp-controller="AdminRentalDocuments" asp-action="HandoverPrint" asp-route-bookingId="@b.BookingId">In / xem biên bản giao</a>
                    @if (Model.HandoverSignedPaths.Count > 0)
                    {
                        <a class="btn btn-outline-secondary" asp-controller="AdminSignedDocuments" asp-action="Handover" asp-route-bookingId="@b.BookingId" target="_blank">Mở bản ký đã tải</a>
                    }
                </div>

                @if (!Model.HandoverSignedDocumentVerified)
                {
                    <form asp-controller="AdminRentalDocuments" asp-action="UploadHandoverSigned"
                          method="post" enctype="multipart/form-data" class="border rounded-4 p-3 mt-3">
                        <input type="hidden" name="bookingId" value="@b.BookingId" />
                        <label for="handover-signed-files" class="form-label fw-semibold">Tải bản ký biên bản giao xe</label>
                        <input id="handover-signed-files" name="signedDocuments" type="file"
                               accept="image/jpeg,image/png,image/webp" multiple required class="form-control" />
                        <div class="form-text">Chọn 1–12 ảnh JPG, PNG hoặc WebP; tối đa 8 MB mỗi ảnh. Nếu tải lại, chọn đủ các trang để thay bộ bản ký cũ.</div>
                        <button type="submit" class="btn btn-outline-success mt-2">Tải bản ký giao xe</button>
                    </form>
                }

                @if (Model.HandoverSignedPaths.Count == 0)
                {
                    <div class="alert alert-warning mt-3 mb-0">In biên bản, cho đúng khách ký rồi tải ảnh/scan bản ký. Việc tải file <strong>không tự bắt đầu chuyến</strong>.</div>
                }
                else if (!Model.HandoverSignedDocumentVerified)
                {
                    <form asp-action="VerifyHandoverSigned" method="post" class="border rounded-4 p-3 mt-3" data-confirm="Xác nhận bạn đã MỞ bản ký và đối chiếu đúng khách? Thao tác này sẽ bắt đầu chuyến thuê.">
                        <input type="hidden" name="bookingId" value="@b.BookingId" />
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" name="signedCopyConfirmed" value="true" id="handover-confirm" required />
                            <label class="form-check-label" for="handover-confirm">Tôi đã mở toàn bộ trang bản ký, đối chiếu chữ ký và xác nhận đúng khách.</label>
                        </div>
                        <button class="btn btn-success" @(Model.HandoverIdentityVerified ? null : "disabled")>Xác minh bản ký & bắt đầu chuyến</button>
                    </form>
                }
            }
        </section>
    }

    @if (canCancelBeforeHandover)
    {
        <section class="card card-body shadow-sm mb-3 border-danger-subtle rounded-4">
            <details>
                <summary class="text-danger fw-semibold">Khách yêu cầu hủy trước khi lập biên bản giao</summary>
                <div class="alert alert-light border mt-3 small">
                    <div>@CancellationRefundPolicy.GetVietnamesePolicySummary(b.Policy)</div>
                    <div class="mt-1">Nếu xe chưa bàn giao, phần cọc còn lại được hoàn 100%. Khoản hoàn phát sinh chỉ chuyển sang <strong>chờ Admin duyệt</strong>; Staff không thể tự duyệt và cũng chưa được coi là đã chuyển tiền.</div>
                </div>
                <form asp-controller="StaffBookingOperations" asp-action="Cancel" method="post" class="row g-2" data-confirm="Xác nhận khách yêu cầu hủy? Hệ thống sẽ khóa đơn, giải phóng lịch và tính khoản hoàn theo chính sách đã chốt của đơn.">
                    <input type="hidden" name="BookingId" value="@b.BookingId" />
                    <div class="col-md-9">
                        <input class="form-control" name="Reason" required maxlength="500" placeholder="Lý do khách yêu cầu hủy" />
                    </div>
                    <div class="col-md-3 d-grid">
                        <button class="btn btn-outline-danger">Hủy đơn</button>
                    </div>
                </form>

                @if (b.Status == BookingStatus.ReadyForPickup)
                {
                    <hr />
                    <div class="fw-semibold mb-2">Khách không đến nhận xe</div>
                    @if (canMarkNoShow)
                    {
                        <form asp-controller="StaffBookingOperations" asp-action="MarkNoShow" method="post" data-confirm="Xác nhận đã liên hệ khách và khách không đến nhận xe sau thời gian chờ quy định?">
                            <input type="hidden" name="bookingId" value="@b.BookingId" />
                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" name="customerContacted" value="true" id="customer-contacted" required />
                                <label class="form-check-label" for="customer-contacted">Đã liên hệ khách nhưng khách không đến nhận xe.</label>
                            </div>
                            <button class="btn btn-dark">Ghi nhận No-show</button>
                        </form>
                    }
                    else
                    {
                        <div class="small text-muted">Có thể ghi nhận No-show từ @b.PickupDate.AddMinutes(b.Policy.NoShowGraceMinutes).ToString("dd/MM/yyyy HH:mm").</div>
                    }
                }
            </details>
        </section>
    }

    @if (!b.HasHandover && hasPaymentAwaitingConfirmation &&
        b.Status is BookingStatus.PendingConfirmation or BookingStatus.PendingPayment or BookingStatus.Paid or BookingStatus.ReadyForPickup)
    {
        <section class="card card-body shadow-sm mb-3 border-warning-subtle rounded-4">
            <div class="d-flex gap-3 align-items-start">
                <span class="staff-step-number">!</span>
                <div class="flex-grow-1">
                    <h2 class="h5 mb-1">Chưa thể hủy đơn vì còn giao dịch chờ đối soát</h2>
                    <p class="text-muted mb-3">
                        Có khoản chuyển khoản/QR đang chờ Admin xác nhận tiền thực nhận hoặc từ chối giao dịch.
                        Sau khi Admin xử lý, Staff mới có thể hủy và tính hoàn tiền để tránh bỏ sót tiền khách đã chuyển.
                    </p>
                    <span class="badge text-bg-warning">Đang chờ Admin đối soát</span>
                </div>
            </div>
        </section>
    }

    @if (b.Status == BookingStatus.Rented)
    {
        @if (overdueCompensationDebtOpen > 0m)
        {
            <section class="card card-body shadow-sm mb-3 border-danger rounded-4">
                <h2 class="h5 text-danger">Bồi thường quá hạn còn thiếu</h2>
                <p class="mb-2">
                    Sau khi khấu trừ phần cọc khả dụng, khách còn phải thanh toán
                    <strong>@overdueCompensationDebtOpen.ToString("N0") đ</strong>.
                    Khoản này độc lập với phí gia hạn và phụ phí trả xe.
                </p>

                @if (overdueCompensationDebtAwaiting)
                {
                    <div class="alert alert-warning py-2">
                        Khách đã báo chuyển khoản/QR. Không thu tiền mặt đồng thời.
                    </div>
                    <span class="badge text-bg-warning">Đang chờ Admin đối soát</span>
                }
                else
                {
                    <form asp-controller="StaffPayments"
                          asp-action="CollectOverdueCompensationDebtCash"
                          method="post"
                          data-loading-form
                          data-confirm="Xác nhận bạn đã thực nhận đủ @overdueCompensationDebtOpen.ToString("N0") đ bồi thường quá hạn bằng tiền mặt?">
                        <input type="hidden" name="bookingId" value="@b.BookingId" />
                        <button class="btn btn-success" type="submit">
                            Thu đủ @overdueCompensationDebtOpen.ToString("N0") đ tiền mặt
                        </button>
                    </form>
                }
            </section>
        }

        <section class="card card-body shadow-sm mb-3 rounded-4">
            <div class="d-flex gap-3 align-items-start">
                <span class="staff-step-number">5</span>
                <div class="flex-grow-1">
                    <h2 class="h5">Gia hạn trong chuyến</h2>
                    @if (hasOpenExtension)
                    {
                        <div class="alert alert-warning mb-3">
                            Đơn đang có yêu cầu gia hạn chưa kết thúc. Không tạo thêm yêu cầu trùng.
                            Admin duyệt/từ chối; nếu có xung đột bất khả kháng, Staff xử lý phương án xe thay thế ở mục <strong>Xung đột gia hạn</strong>.
                        </div>

                        @if (approvedExtension is not null)
                        {
                            <div class="border rounded-3 p-3 mb-3">
                                <div class="fw-semibold">Gia hạn đã được Admin duyệt · chờ thanh toán</div>
                                <div class="small text-muted mb-2">
                                    Trả mới @approvedExtension.RequestedReturnDate.ToString("dd/MM/yyyy HH:mm")
                                    · phí @approvedExtension.AdditionalAmount.ToString("N0") đ.
                                    Thời gian mới chỉ có hiệu lực sau khi tiền được ghi nhận.
                                </div>

                                @if (extensionAwaitingConfirmation)
                                {
                                    <div class="alert alert-info py-2 mb-2">
                                        Khách đã báo chuyển khoản/QR. Không thu tiền mặt cùng lúc; Admin phải đối soát giao dịch trước.
                                    </div>
                                    <span class="badge text-bg-warning">Đang chờ Admin đối soát</span>
                                }
                                else
                                {
                                    <form asp-controller="StaffPayments"
                                          asp-action="CollectExtensionCash"
                                          method="post"
                                          data-loading-form
                                          data-confirm="Xác nhận bạn đã thực nhận đủ phí gia hạn bằng tiền mặt? Sau thao tác này thời gian trả mới sẽ có hiệu lực.">
                                        <input type="hidden" name="bookingId" value="@b.BookingId" />
                                        <button class="btn btn-success" type="submit">
                                            Thu phí gia hạn tiền mặt
                                        </button>
                                    </form>
                                }
                            </div>
                        }
                        else if (extensionNeedsEvidence)
                        {
                            <div class="alert alert-info py-2">
                                Admin đang yêu cầu bổ sung minh chứng. Với yêu cầu bất khả kháng, khách phải tự gửi ảnh và vị trí trực tiếp từ tài khoản/thiết bị của họ; Staff không nhập GPS thay khách.
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-light border small">
                            <strong>Khách gọi điện xin gia hạn thông thường:</strong> Staff có thể ghi nhận yêu cầu tại đây.
                            Trường hợp khách khai <strong>bất khả kháng</strong>, yêu cầu khách gửi trực tiếp từ tài khoản của họ để ảnh minh chứng và vị trí GPS được lấy từ thiết bị khách; không dùng vị trí trình duyệt của nhân viên thay cho vị trí khách.
                        </div>
                        <form asp-controller="StaffExtensionRequests"
                              asp-action="CreateForCustomer"
                              method="post"
                              class="row g-3"
                              data-loading-form
                              data-confirm="Xác nhận bạn đang ghi nhận đúng yêu cầu gia hạn thông thường mà khách vừa cung cấp?">
                            <input type="hidden" name="bookingId" value="@b.BookingId" />
                            <div class="col-md-5">
                                <label class="form-label">Thời gian trả mới</label>
                                <input class="form-control"
                                       name="requestedReturnDate"
                                       type="datetime-local"
                                       min="@b.ReturnDate.AddMinutes(1).ToString("yyyy-MM-ddTHH:mm")"
                                       value="@b.ReturnDate.AddMinutes(1).ToString("yyyy-MM-ddTHH:mm")"
                                       required />
                            </div>
                            <div class="col-md-7">
                                <label class="form-label">Lý do khách cung cấp</label>
                                <input class="form-control"
                                       name="note"
                                       maxlength="500"
                                       required
                                       placeholder="VD: Khách cần thêm 1 ngày và đã gọi xác nhận..." />
                            </div>
                            <div class="col-12 d-flex justify-content-end">
                                <button class="btn btn-outline-primary" type="submit">
                                    Ghi nhận yêu cầu & gửi Admin duyệt
                                </button>
                            </div>
                        </form>
                    }

                    <hr />

                    <h2 class="h5">Nhận xe trả</h2>
                    <p class="text-muted">Lập biên bản trả, đối chiếu người trả và ảnh tình trạng thực tế.</p>
                    @if (!b.HasReturn)
                    {
                        <a class="btn btn-primary" asp-controller="Returns" asp-action="Create" asp-route-bookingId="@b.BookingId">Lập biên bản trả xe</a>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-0">Đã có biên bản trả nhưng đơn vẫn ở trạng thái Đang thuê. Cần kiểm tra dữ liệu trước khi tiếp tục.</div>
                    }
                </div>
            </div>
        </section>
    }

    @if (b.Status == BookingStatus.PendingInspection)
    {
        <section class="card card-body shadow-sm mb-3 rounded-4">
            <div class="d-flex gap-3 align-items-start mb-3">
                <span class="staff-step-number">6</span>
                <div>
                    <h2 class="h5 mb-1">Đối chiếu xe trả & quyết toán</h2>
                    <div class="text-muted">Chỉ mở quyết toán khi cả hồ sơ giao và trả đều đủ danh tính + bản ký đã xác minh.</div>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <div class="border rounded-4 p-3 h-100">
                        <div class="fw-semibold">Người trả xe</div>
                        @if (Model.ReturnIdentityVerified)
                        {
                            <div class="text-success">✓ Đã đối chiếu đúng khách</div>
                            <div class="small text-muted">@(Model.ReturnIdentityVerifiedBy ?? "Nhân viên") · @Model.ReturnIdentityVerifiedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                        }
                        else
                        {
                            <div class="text-danger">Chưa xác minh người trả.</div>
                        }
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="border rounded-4 p-3 h-100">
                        <div class="fw-semibold">Bản trả đã ký</div>
                        @if (Model.ReturnSignedDocumentVerified)
                        {
                            <div class="text-success">✓ Đã xác minh chữ ký</div>
                            <div class="small text-muted">@(Model.ReturnSignedVerifiedBy ?? "Nhân viên") · @Model.ReturnSignedVerifiedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                        }
                        else if (Model.ReturnSignedPaths.Count > 0)
                        {
                            <div class="text-warning">Đã tải @Model.ReturnSignedPaths.Count trang, chưa xác minh.</div>
                        }
                        else
                        {
                            <div class="text-danger">Chưa tải bản ký.</div>
                        }
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap mt-3">
                <a class="btn btn-outline-primary" asp-controller="AdminRentalDocuments" asp-action="ReturnPrint" asp-route-bookingId="@b.BookingId">In / xem biên bản trả</a>
                @if (Model.ReturnSignedPaths.Count == 0)
                {
                    <a class="btn btn-outline-warning" asp-controller="ReturnEdits" asp-action="Edit" asp-route-bookingId="@b.BookingId">Chỉnh sửa biên bản trả</a>
                }
                else
                {
                    <a class="btn btn-outline-secondary" asp-controller="AdminSignedDocuments" asp-action="Return" asp-route-bookingId="@b.BookingId" target="_blank">Mở bản ký đã tải</a>
                }
            </div>

            @if (!Model.ReturnSignedDocumentVerified)
            {
                <form asp-controller="AdminRentalDocuments" asp-action="UploadReturnSigned"
                      method="post" enctype="multipart/form-data" class="border rounded-4 p-3 mt-3">
                    <input type="hidden" name="bookingId" value="@b.BookingId" />
                    <label for="return-signed-files" class="form-label fw-semibold">Tải bản ký biên bản trả xe</label>
                    <input id="return-signed-files" name="signedDocuments" type="file"
                           accept="image/jpeg,image/png,image/webp" multiple required class="form-control" />
                    <div class="form-text">Chọn 1–12 ảnh JPG, PNG hoặc WebP; tối đa 8 MB mỗi ảnh. Nếu tải lại, chọn đủ các trang để thay bộ bản ký cũ.</div>
                    <button type="submit" class="btn btn-outline-success mt-2">Tải bản ký trả xe</button>
                </form>
            }

            @if (Model.ReturnSignedPaths.Count == 0)
            {
                <div class="alert alert-warning mt-3 mb-0">In biên bản trả, cho đúng khách ký rồi tải bản scan/ảnh. File tải lên vẫn phải được Staff mở và xác minh.</div>
            }
            else if (!Model.ReturnSignedDocumentVerified)
            {
                <form asp-action="VerifyReturnSigned" method="post" class="border rounded-4 p-3 mt-3" data-confirm="Xác nhận đã mở bản ký trả và đối chiếu đúng khách?">
                    <input type="hidden" name="bookingId" value="@b.BookingId" />
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" name="signedCopyConfirmed" value="true" id="return-confirm" required />
                        <label class="form-check-label" for="return-confirm">Tôi đã mở bản ký trả xe, đối chiếu chữ ký và xác nhận đúng khách.</label>
                    </div>
                    <button class="btn btn-success" @(Model.ReturnIdentityVerified ? null : "disabled")>Xác minh bản ký trả</button>
                </form>
            }

            @if (canInspect)
            {
                <hr />
                <a class="btn btn-primary" asp-controller="Returns" asp-action="Inspect" asp-route-bookingId="@b.BookingId">Đối chiếu, thêm phí & quyết toán</a>
            }
        </section>
    }

    @if ((b.Status == BookingStatus.AwaitingRefund || b.Status == BookingStatus.Cancelled || b.Status == BookingStatus.NoShow) && hasOpenRefund)
    {
        <section class="card card-body shadow-sm mb-3 border-warning-subtle rounded-4">
            <div class="d-flex gap-3 align-items-start">
                <span class="staff-step-number">7</span>
                <div class="flex-grow-1">
                    <h2 class="h5">Hoàn tiền</h2>
                    <div class="fs-5 mb-2">Khoản đang mở: <strong>@Model.RefundAmount.ToString("N0") đ</strong></div>
                    @if (Model.HasUnapprovedRefund)
                    {
                        <div class="alert alert-warning mb-0">Đang chờ Admin duyệt. Staff chưa được phép chuyển tiền.</div>
                    }
                    else if (Model.HasApprovedRefund)
                    {
                        <div class="alert alert-success">Admin đã duyệt. Bước tiếp theo là Staff thực hiện chuyển khoản thật và nhập mã giao dịch.</div>
                        <a class="btn btn-success" asp-action="Refunds">Thực hiện hoàn tiền đã duyệt</a>
                    }
                </div>
            </div>
        </section>
    }

    @if (b.Status == BookingStatus.Cancelled && !hasOpenRefund)
    {
        <div class="alert alert-secondary"><strong>Đơn đã hủy.</strong> Không còn khoản hoàn tiền đang mở.</div>
    }

    @if (b.Status == BookingStatus.NoShow && !hasOpenRefund)
    {
        <div class="alert alert-secondary"><strong>Đơn đã ghi nhận khách không đến.</strong> Không còn khoản hoàn tiền đang mở.</div>
    }

    @if (b.Status == BookingStatus.Completed)
    {
        <div class="alert alert-success"><strong>✓ Đơn đã hoàn tất.</strong> Không còn thao tác vận hành bắt buộc.</div>
    }
</div>

