@model SmartCar.Domain.Constants.RentalPolicySnapshot
@{
    ViewData["Title"] = "Cấu hình nghiệp vụ";
    Layout = "_AdminLayout";
    var current = (SmartCar.Domain.Constants.RentalPolicySnapshot)ViewData["CurrentPolicy"]!;
    var editing = ViewData["EditingGroup"] as string;
    var conflict = ViewData["PolicyConflict"] as bool? ?? false;
    var vi = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
    string FriendlyHours(int hours) =>
        hours % 24 == 0
            ? $"{hours / 24} ngày"
            : $"{hours} giờ";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-business-settings.css" asp-append-version="true" />
}

<div class="policy-settings-page">
    <div class="policy-settings-header">
        <div>
            <h1 class="policy-settings-title">Cấu hình nghiệp vụ</h1>
            <p class="policy-settings-subtitle">Quản lý chính sách áp dụng cho đơn mới.</p>
        </div>
        <a class="btn btn-outline-primary policy-history-btn"
           asp-controller="AuditLogs"
           asp-action="Index"
           asp-route-search="BusinessSetting">
            <span aria-hidden="true">↶</span>
            <span>Lịch sử thay đổi</span>
        </a>
    </div>

    <div class="policy-overview" aria-label="Tóm tắt cấu hình">
        <div class="policy-overview-item">
            <span class="policy-overview-icon" aria-hidden="true">▱</span>
            <div class="policy-overview-copy">
                <strong>9 nhóm chính sách</strong>
                <span>Cọc, giữ chỗ, lịch xe, hủy đơn, phí và điều khoản</span>
            </div>
        </div>
        <div class="policy-overview-item">
            <span class="policy-overview-icon" aria-hidden="true">✓</span>
            <div class="policy-overview-copy">
                <strong>Áp dụng cho đơn mới</strong>
                <span>Đơn cũ giữ chính sách đã chốt</span>
            </div>
        </div>
        <div class="policy-overview-item">
            <span class="policy-overview-icon" aria-hidden="true">₫</span>
            <div class="policy-overview-copy">
                <strong>Giá thuê/ngày</strong>
                <span>Chỉnh riêng trong Quản lý xe</span>
            </div>
        </div>
    </div>

    @if (conflict)
    {
        <div class="alert alert-warning policy-conflict-alert">
            Chính sách vừa thay đổi. Nội dung bạn nhập vẫn được giữ.
            <a asp-action="Index" class="alert-link">Tải lại</a> trước khi sửa tiếp.
        </div>
    }

    <noscript>
        <div class="alert alert-warning policy-conflict-alert">Vui lòng bật JavaScript để chỉnh sửa chính sách.</div>
    </noscript>

    <div id="policy-groups" class="policy-grid" data-conflict="@(conflict ? "true" : "false")">
        <section class="policy-card" data-policy-group="deposit">
            <div class="policy-card-main">
                <div class="policy-card-header">
                    <span class="policy-card-icon" aria-hidden="true">₫</span>
                    <div class="policy-card-heading">
                        <h2>Tiền cọc</h2>
                        <p>Tỷ lệ cọc và thời gian giữ cọc</p>
                    </div>
                    <button type="button"
                            class="btn btn-outline-primary policy-edit-btn"
                            data-edit
                            aria-controls="edit-deposit"
                            aria-expanded="@(editing == "deposit" ? "true" : "false")"
                            disabled="@conflict">
                        <span aria-hidden="true">✎</span> Chỉnh sửa
                    </button>
                </div>

                <div class="policy-metrics">
                    <div class="policy-metric">
                        <span class="policy-metric-label">Tỷ lệ trên tiền thuê</span>
                        <strong class="policy-metric-value">@current.DepositPercent.ToString("0.##", vi)%</strong>
                    </div>
                    <div class="policy-metric">
                        <span class="policy-metric-label">Giữ cọc sau trả xe</span>
                        <strong class="policy-metric-value">@current.DepositHoldDays.ToString("N0", vi) ngày</strong>
                    </div>
                </div>

                <p class="policy-helper">
                    <span class="policy-helper-icon" aria-hidden="true">i</span>
                    <span>Hoàn cọc sau hậu kiểm và xử lý các khoản còn mở.</span>
                </p>
            </div>

            <form asp-action="Update"
                  method="post"
                  id="edit-deposit"
                  class="policy-edit-form"
                  data-policy-form
                  hidden="@(editing != "deposit")"
                  data-server-edit="@(editing == "deposit" ? "true" : "false")">
                <input type="hidden" name="group" value="deposit" />
                <input type="hidden" name="version" value="@(editing == "deposit" ? Model.Version : current.Version)" />
                @if (editing == "deposit")
                {
                    <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
                }
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="DepositPercent" class="form-label">Tỷ lệ trên tiền thuê</label>
                        <div class="input-group">
                            <input asp-for="DepositPercent"
                                   type="number"
                                   min="1"
                                   max="1000"
                                   step=".01"
                                   required
                                   class="form-control"
                                   data-policy-input
                                   data-label="Tỷ lệ trên tiền thuê"
                                   data-unit="%"
                                   data-current="@current.DepositPercent.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                            <span class="input-group-text">%</span>
                        </div>
                        <span asp-validation-for="DepositPercent" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DepositHoldDays" class="form-label">Giữ cọc sau trả xe</label>
                        <div class="input-group">
                            <input asp-for="DepositHoldDays"
                                   type="number"
                                   min="0"
                                   max="30"
                                   step="1"
                                   required
                                   class="form-control"
                                   data-policy-input
                                   data-label="Giữ cọc sau trả xe"
                                   data-unit="ngày"
                                   data-current="@current.DepositHoldDays.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                            <span class="input-group-text">ngày</span>
                        </div>
                        <span asp-validation-for="DepositHoldDays" class="text-danger small"></span>
                    </div>
                </div>
                <div class="alert alert-warning mt-3" data-changes hidden aria-live="polite"></div>
                <div class="policy-edit-actions">
                    <button type="submit" class="btn btn-primary" data-save disabled>Lưu thay đổi</button>
                    <button type="button" class="btn btn-outline-secondary" data-cancel>Hủy</button>
                </div>
            </form>
        </section>

        <section class="policy-card" data-policy-group="mileage">
            <div class="policy-card-main">
                <div class="policy-card-header">
                    <span class="policy-card-icon" aria-hidden="true">↔</span>
                    <div class="policy-card-heading">
                        <h2>Quãng đường</h2>
                        <p>Định mức và phí vượt</p>
                    </div>
                    <button type="button"
                            class="btn btn-outline-primary policy-edit-btn"
                            data-edit
                            aria-controls="edit-mileage"
                            aria-expanded="@(editing == "mileage" ? "true" : "false")"
                            disabled="@conflict">
                        <span aria-hidden="true">✎</span> Chỉnh sửa
                    </button>
                </div>

                <div class="policy-metrics">
                    <div class="policy-metric">
                        <span class="policy-metric-label">Định mức mỗi ngày</span>
                        <strong class="policy-metric-value">@current.IncludedKilometersPerDay.ToString("N0", vi) km/ngày</strong>
                    </div>
                    <div class="policy-metric">
                        <span class="policy-metric-label">Phí vượt định mức</span>
                        <strong class="policy-metric-value">@current.ExcessKilometerFee.ToString("N0", vi) đ/km</strong>
                    </div>
                </div>

                <p class="policy-helper">
                    <span class="policy-helper-icon" aria-hidden="true">i</span>
                    <span>Định mức chuyến = định mức/ngày × số ngày tính phí.</span>
                </p>
            </div>

            <form asp-action="Update"
                  method="post"
                  id="edit-mileage"
                  class="policy-edit-form"
                  data-policy-form
                  hidden="@(editing != "mileage")"
                  data-server-edit="@(editing == "mileage" ? "true" : "false")">
                <input type="hidden" name="group" value="mileage" />
                <input type="hidden" name="version" value="@(editing == "mileage" ? Model.Version : current.Version)" />
                @if (editing == "mileage")
                {
                    <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
                }
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="IncludedKilometersPerDay" class="form-label">Định mức mỗi ngày</label>
                        <div class="input-group">
                            <input asp-for="IncludedKilometersPerDay"
                                   type="number"
                                   min="1"
                                   max="1000"
                                   step="1"
                                   required
                                   class="form-control"
                                   data-policy-input
                                   data-label="Định mức mỗi ngày"
                                   data-unit="km/ngày"
                                   data-current="@current.IncludedKilometersPerDay.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                            <span class="input-group-text">km/ngày</span>
                        </div>
                        <span asp-validation-for="IncludedKilometersPerDay" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ExcessKilometerFee" class="form-label">Phí vượt định mức</label>
                        <div class="input-group">
                            <input asp-for="ExcessKilometerFee"
                                   type="number"
                                   min="0"
                                   max="50000"
                                   step="1"
                                   required
                                   class="form-control"
                                   data-policy-input
                                   data-label="Phí vượt định mức"
                                   data-unit="đ/km"
                                   data-current="@current.ExcessKilometerFee.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                            <span class="input-group-text">đ/km</span>
                        </div>
                        <span asp-validation-for="ExcessKilometerFee" class="text-danger small"></span>
                    </div>
                </div>
                <div class="alert alert-warning mt-3" data-changes hidden aria-live="polite"></div>
                <div class="policy-edit-actions">
                    <button type="submit" class="btn btn-primary" data-save disabled>Lưu thay đổi</button>
                    <button type="button" class="btn btn-outline-secondary" data-cancel>Hủy</button>
                </div>
            </form>
        </section>

        <section class="policy-card" data-policy-group="late">
            <div class="policy-card-main">
                <div class="policy-card-header">
                    <span class="policy-card-icon" aria-hidden="true">◷</span>
                    <div class="policy-card-heading">
                        <h2>Trả muộn</h2>
                        <p>Hệ số phí và thời gian miễn phí</p>
                    </div>
                    <button type="button"
                            class="btn btn-outline-primary policy-edit-btn"
                            data-edit
                            aria-controls="edit-late"
                            aria-expanded="@(editing == "late" ? "true" : "false")"
                            disabled="@conflict">
                        <span aria-hidden="true">✎</span> Chỉnh sửa
                    </button>
                </div>

                <div class="policy-metrics">
                    <div class="policy-metric">
                        <span class="policy-metric-label">Hệ số phí/ngày</span>
                        <strong class="policy-metric-value">@current.LateReturnFeeMultiplier.ToString("0.##", vi) lần/ngày</strong>
                    </div>
                    <div class="policy-metric">
                        <span class="policy-metric-label">Thời gian miễn phí</span>
                        <strong class="policy-metric-value">@current.LateReturnGraceMinutes.ToString("N0", vi) phút</strong>
                    </div>
                </div>

                <p class="policy-helper">
                    <span class="policy-helper-icon" aria-hidden="true">i</span>
                    <span>Quá thời gian miễn phí, mỗi 24 giờ bắt đầu tính một ngày phí.</span>
                </p>
            </div>

            <form asp-action="Update"
                  method="post"
                  id="edit-late"
                  class="policy-edit-form"
                  data-policy-form
                  hidden="@(editing != "late")"
                  data-server-edit="@(editing == "late" ? "true" : "false")">
                <input type="hidden" name="group" value="late" />
                <input type="hidden" name="version" value="@(editing == "late" ? Model.Version : current.Version)" />
                @if (editing == "late")
                {
                    <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
                }
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="LateReturnFeeMultiplier" class="form-label">Hệ số phí/ngày</label>
                        <div class="input-group">
                            <input asp-for="LateReturnFeeMultiplier"
                                   type="number"
                                   min="1"
                                   max="5"
                                   step=".01"
                                   required
                                   class="form-control"
                                   data-policy-input
                                   data-label="Hệ số phí/ngày"
                                   data-unit="lần"
                                   data-current="@current.LateReturnFeeMultiplier.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                            <span class="input-group-text">lần</span>
                        </div>
                        <span asp-validation-for="LateReturnFeeMultiplier" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="LateReturnGraceMinutes" class="form-label">Thời gian miễn phí</label>
                        <div class="input-group">
                            <input asp-for="LateReturnGraceMinutes"
                                   type="number"
                                   min="0"
                                   max="1440"
                                   step="1"
                                   required
                                   class="form-control"
                                   data-policy-input
                                   data-label="Thời gian miễn phí"
                                   data-unit="phút"
                                   data-current="@current.LateReturnGraceMinutes.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                            <span class="input-group-text">phút</span>
                        </div>
                        <span asp-validation-for="LateReturnGraceMinutes" class="text-danger small"></span>
                    </div>
                </div>
                <div class="alert alert-warning mt-3" data-changes hidden aria-live="polite"></div>
                <div class="policy-edit-actions">
                    <button type="submit" class="btn btn-primary" data-save disabled>Lưu thay đổi</button>
                    <button type="button" class="btn btn-outline-secondary" data-cancel>Hủy</button>
                </div>
            </form>
        </section>

        <section class="policy-card policy-card-half" data-policy-group="reservation">
            <div class="policy-card-main">
                <div class="policy-card-header">
                    <span class="policy-card-icon" aria-hidden="true">⌛</span>
                    <div class="policy-card-heading">
                        <h2>Giữ chỗ & thanh toán</h2>
                        <p>Thời gian chờ trước khi đơn hết hạn</p>
                    </div>
                    <button type="button"
                            class="btn btn-outline-primary policy-edit-btn"
                            data-edit
                            aria-controls="edit-reservation"
                            aria-expanded="@(editing == "reservation" ? "true" : "false")"
                            disabled="@conflict">
                        <span aria-hidden="true">✎</span> Chỉnh sửa
                    </button>
                </div>

                <div class="policy-metrics">
                    <div class="policy-metric">
                        <span class="policy-metric-label">Chờ khách thanh toán</span>
                        <strong class="policy-metric-value">@current.BookingPaymentHoldMinutes.ToString("N0", vi) phút</strong>
                    </div>
                    <div class="policy-metric">
                        <span class="policy-metric-label">Chờ đối soát chuyển khoản</span>
                        <strong class="policy-metric-value">@current.BookingTransferReconciliationHoldMinutes.ToString("N0", vi) phút</strong>
                    </div>
                </div>

                <p class="policy-helper">
                    <span class="policy-helper-icon" aria-hidden="true">i</span>
                    <span>Xác nhận đơn @current.BookingConfirmationHoldMinutes phút · đặt trước tối thiểu @current.MinimumPickupLeadMinutes phút.</span>
                </p>
            </div>

            <form asp-action="Update"
                  method="post"
                  id="edit-reservation"
                  class="policy-edit-form"
                  data-policy-form
                  hidden="@(editing != "reservation")"
                  data-server-edit="@(editing == "reservation" ? "true" : "false")">
                <input type="hidden" name="group" value="reservation" />
                <input type="hidden" name="version" value="@(editing == "reservation" ? Model.Version : current.Version)" />
                @if (editing == "reservation")
                {
                    <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
                }
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="BookingConfirmationHoldMinutes" class="form-label">Chờ xác nhận đơn</label>
                        <div class="input-group">
                            <input asp-for="BookingConfirmationHoldMinutes" type="number" min="5" max="240" step="1" required
                                   class="form-control" data-policy-input data-label="Chờ xác nhận đơn" data-unit="phút"
                                   data-current="@current.BookingConfirmationHoldMinutes.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                            <span class="input-group-text">phút</span>
                        </div>
                        <span asp-validation-for="BookingConfirmationHoldMinutes" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="BookingPaymentHoldMinutes" class="form-label">Chờ khách thanh toán</label>
                        <div class="input-group">
                            <input asp-for="BookingPaymentHoldMinutes" type="number" min="5" max="180" step="1" required
                                   class="form-control" data-policy-input data-label="Chờ khách thanh toán" data-unit="phút"
                                   data-current="@current.BookingPaymentHoldMinutes.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                            <span class="input-group-text">phút</span>
                        </div>
                        <span asp-validation-for="BookingPaymentHoldMinutes" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="BookingTransferReconciliationHoldMinutes" class="form-label">Chờ đối soát chuyển khoản</label>
                        <div class="input-group">
                            <input asp-for="BookingTransferReconciliationHoldMinutes" type="number" min="15" max="720" step="1" required
                                   class="form-control" data-policy-input data-label="Chờ đối soát chuyển khoản" data-unit="phút"
                                   data-current="@current.BookingTransferReconciliationHoldMinutes.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                            <span class="input-group-text">phút</span>
                        </div>
                        <span asp-validation-for="BookingTransferReconciliationHoldMinutes" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="MinimumPickupLeadMinutes" class="form-label">Đặt xe trước tối thiểu</label>
                        <div class="input-group">
                            <input asp-for="MinimumPickupLeadMinutes" type="number" min="0" max="1440" step="1" required
                                   class="form-control" data-policy-input data-label="Đặt xe trước tối thiểu" data-unit="phút"
                                   data-current="@current.MinimumPickupLeadMinutes.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                            <span class="input-group-text">phút</span>
                        </div>
                        <span asp-validation-for="MinimumPickupLeadMinutes" class="text-danger small"></span>
                    </div>
                </div>
                <div class="alert alert-warning mt-3" data-changes hidden aria-live="polite"></div>
                <div class="policy-edit-actions">
                    <button type="submit" class="btn btn-primary" data-save disabled>Lưu thay đổi</button>
                    <button type="button" class="btn btn-outline-secondary" data-cancel>Hủy</button>
                </div>
            </form>
        </section>

        <section class="policy-card policy-card-half" data-policy-group="schedule">
            <div class="policy-card-main">
                <div class="policy-card-header">
                    <span class="policy-card-icon" aria-hidden="true">⇄</span>
                    <div class="policy-card-heading">
                        <h2>Lịch xe</h2>
                        <p>Khoảng chuẩn bị giữa hai lượt thuê</p>
                    </div>
                    <button type="button"
                            class="btn btn-outline-primary policy-edit-btn"
                            data-edit
                            aria-controls="edit-schedule"
                            aria-expanded="@(editing == "schedule" ? "true" : "false")"
                            disabled="@conflict">
                        <span aria-hidden="true">✎</span> Chỉnh sửa
                    </button>
                </div>

                <div class="policy-metrics">
                    <div class="policy-metric">
                        <span class="policy-metric-label">Xoay vòng xe</span>
                        <strong class="policy-metric-value">@current.VehicleTurnaroundMinutes.ToString("N0", vi) phút</strong>
                    </div>
                    <div class="policy-metric">
                        <span class="policy-metric-label">Thêm khi giao tận nơi</span>
                        <strong class="policy-metric-value">+@current.DeliveryLeadMinutes.ToString("N0", vi) phút</strong>
                    </div>
                </div>

                <p class="policy-helper">
                    <span class="policy-helper-icon" aria-hidden="true">i</span>
                    <span>Giữ khoảng trống để nhận xe, kiểm tra, vệ sinh và chuẩn bị lượt kế tiếp.</span>
                </p>
            </div>

            <form asp-action="Update"
                  method="post"
                  id="edit-schedule"
                  class="policy-edit-form"
                  data-policy-form
                  hidden="@(editing != "schedule")"
                  data-server-edit="@(editing == "schedule" ? "true" : "false")">
                <input type="hidden" name="group" value="schedule" />
                <input type="hidden" name="version" value="@(editing == "schedule" ? Model.Version : current.Version)" />
                @if (editing == "schedule")
                {
                    <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
                }
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="VehicleTurnaroundMinutes" class="form-label">Xoay vòng giữa hai lượt</label>
                        <div class="input-group">
                            <input asp-for="VehicleTurnaroundMinutes" type="number" min="0" max="360" step="1" required
                                   class="form-control" data-policy-input data-label="Xoay vòng giữa hai lượt" data-unit="phút"
                                   data-current="@current.VehicleTurnaroundMinutes.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                            <span class="input-group-text">phút</span>
                        </div>
                        <span asp-validation-for="VehicleTurnaroundMinutes" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DeliveryLeadMinutes" class="form-label">Chuẩn bị thêm khi giao tận nơi</label>
                        <div class="input-group">
                            <input asp-for="DeliveryLeadMinutes" type="number" min="0" max="240" step="1" required
                                   class="form-control" data-policy-input data-label="Chuẩn bị giao tận nơi" data-unit="phút"
                                   data-current="@current.DeliveryLeadMinutes.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                            <span class="input-group-text">phút</span>
                        </div>
                        <span asp-validation-for="DeliveryLeadMinutes" class="text-danger small"></span>
                    </div>
