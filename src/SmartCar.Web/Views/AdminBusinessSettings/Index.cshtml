@model SmartCar.Domain.Constants.RentalPolicySnapshot
@{
    ViewData["Title"] = "Cấu hình nghiệp vụ";
    Layout = "_AdminLayout";
    var currentPolicy = (SmartCar.Domain.Constants.RentalPolicySnapshot)ViewData["CurrentPolicy"]!;
    var vi = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h1 class="h3">Cấu hình nghiệp vụ</h1><p class="text-muted">Thiết lập chính sách áp dụng cho đơn thuê tạo mới.</p></div>
    <a class="btn btn-outline-secondary" asp-controller="AuditLogs" asp-action="Index" asp-route-search="BusinessSetting">Xem lịch sử thay đổi</a>
</div>
<div class="alert alert-info">Mỗi đơn lưu chính sách tại lúc tạo. Thay đổi dưới đây không sửa tiền hoặc nội dung biên bản của đơn cũ. Giá thuê/ngày được chỉnh trong Quản lý xe.</div>
<section class="card card-body mb-4 border-primary" aria-labelledby="current-policy-heading">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
        <h2 id="current-policy-heading" class="h5 mb-0">Chính sách đang áp dụng cho đơn mới</h2>
        <span class="badge bg-success">Đang áp dụng</span>
    </div>
    <p class="text-muted small">Các mức hệ thống đang dùng tại lúc tải trang. Nhập thay đổi ở bên dưới chưa làm thay đổi chính sách này.</p>
    <div class="row g-3">
        <div class="col-lg-4">
            <div class="bg-light rounded p-3 h-100">
                <h3 class="h6 text-primary">Tiền cọc</h3>
                <dl class="mb-0">
                    <dt class="small text-muted fw-normal">Tỷ lệ cọc trên tiền thuê ban đầu</dt>
                    <dd class="fs-5 fw-semibold">@currentPolicy.DepositPercent.ToString("0.##", vi)%</dd>
                    <dt class="small text-muted fw-normal">Giữ cọc sau khi trả xe</dt>
                    <dd class="fs-5 fw-semibold mb-0">@currentPolicy.DepositHoldDays ngày</dd>
                </dl>
                @if (currentPolicy.DepositHoldDays == 0)
                {
                    <p class="small text-muted mt-2 mb-0">Không chờ thêm ngày; vẫn cần hậu kiểm, xử lý khoản còn mở và duyệt hoàn.</p>
                }
            </div>
        </div>
        <div class="col-lg-4">
            <div class="bg-light rounded p-3 h-100">
                <h3 class="h6 text-primary">Quãng đường và trả muộn</h3>
                <dl class="mb-0">
                    <dt class="small text-muted fw-normal">Định mức</dt>
                    <dd class="fs-5 fw-semibold">@currentPolicy.IncludedKilometersPerDay.ToString("N0", vi) km/ngày</dd>
                    <dt class="small text-muted fw-normal">Phí vượt định mức</dt>
                    <dd class="fw-semibold">@currentPolicy.ExcessKilometerFee.ToString("N0", vi) đ/km</dd>
                    <dt class="small text-muted fw-normal">Trả muộn</dt>
                    <dd class="fw-semibold mb-0">@currentPolicy.LateReturnFeeMultiplier.ToString("0.##", vi) × giá thuê/ngày · miễn @currentPolicy.LateReturnGraceMinutes phút</dd>
                </dl>
                <p class="small text-muted mt-2 mb-0">Sau thời gian miễn phí, mỗi 24 giờ bắt đầu tính 1 ngày phí.</p>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="bg-light rounded p-3 h-100">
                <h3 class="h6 text-primary">Giao xe tận nơi</h3>
                <dl class="mb-0">
                    <dt class="small text-muted fw-normal">Phí cơ bản</dt>
                    <dd class="fs-5 fw-semibold">@currentPolicy.BaseDeliveryFee.ToString("N0", vi) đ / @currentPolicy.IncludedDeliveryDistanceKm.ToString("0.##", vi) km đầu</dd>
                    <dt class="small text-muted fw-normal">Mỗi km bắt đầu tiếp theo</dt>
                    <dd class="fw-semibold">@currentPolicy.DeliveryFeePerExtraKm.ToString("N0", vi) đ/km</dd>
                    <dt class="small text-muted fw-normal">Bán kính tối đa</dt>
                    <dd class="fw-semibold mb-0">@currentPolicy.MaxDeliveryDistanceKm.ToString("0.##", vi) km</dd>
                </dl>
            </div>
        </div>
    </div>
    <details class="mt-3">
        <summary>Xem điều khoản đang áp dụng</summary>
        <h3 class="h6 mt-3">Vi phạm giao thông / phạt nguội</h3>
        <p style="white-space:pre-wrap">@currentPolicy.TrafficFineTerms</p>
        <h3 class="h6">Hư hỏng / thiếu / trả muộn</h3>
        <p class="mb-0" style="white-space:pre-wrap">@currentPolicy.DamageCompensationTerms</p>
    </details>
</section>
<h2 class="h5">Chỉnh sửa chính sách</h2>
<p class="text-muted">Các giá trị nhập bên dưới chỉ có hiệu lực sau khi lưu thành công. Đơn cũ giữ chính sách đã chốt.</p>
<form asp-action="Update" method="post">
    <input asp-for="Version" type="hidden" />
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
<section class="card card-body mb-3"><h2 class="h5 mb-3">Tiền cọc</h2><div class="row g-3">
<div class="col-md-6"><label asp-for="DepositPercent" class="form-label">Tỷ lệ cọc trên tiền thuê ban đầu (%)</label><input asp-for="DepositPercent" type="number" min="1" max="1000" step="0.01" required class="form-control" /><span asp-validation-for="DepositPercent" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="DepositHoldDays" class="form-label">Số ngày giữ cọc sau khi trả xe</label><input asp-for="DepositHoldDays" type="number" min="0" max="30" step="1" required class="form-control" /><span asp-validation-for="DepositHoldDays" class="text-danger"></span></div>
</div><p class="small text-muted mt-3 mb-0">Ví dụ: thuê 750.000 đ, cọc 300% → cọc 2.250.000 đ. Thời gian giữ cọc chỉ áp dụng sau chuyến thuê; đủ ngày vẫn cần duyệt hoàn và xử lý các khoản còn mở.</p></section>
<section class="card card-body mb-3"><h2 class="h5 mb-3">Quãng đường và trả muộn</h2><div class="row g-3">
<div class="col-md-6"><label asp-for="IncludedKilometersPerDay" class="form-label">Định mức (km/ngày thuê)</label><input asp-for="IncludedKilometersPerDay" type="number" min="1" max="10000" step="1" required class="form-control" /><span asp-validation-for="IncludedKilometersPerDay" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="ExcessKilometerFee" class="form-label">Phí vượt định mức (đ/km)</label><input asp-for="ExcessKilometerFee" type="number" min="0" max="1000000" step="1" required class="form-control" /><span asp-validation-for="ExcessKilometerFee" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="LateReturnFeeMultiplier" class="form-label">Hệ số phí trả muộn × giá thuê/ngày</label><input asp-for="LateReturnFeeMultiplier" type="number" min="1" max="10" step="0.01" required class="form-control" /><span asp-validation-for="LateReturnFeeMultiplier" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="LateReturnGraceMinutes" class="form-label">Số phút trả muộn được miễn phí</label><input asp-for="LateReturnGraceMinutes" type="number" min="0" max="1440" step="1" required class="form-control" /><span asp-validation-for="LateReturnGraceMinutes" class="text-danger"></span></div>
</div><p class="small text-muted mt-3 mb-0">Sau số phút miễn phí, mỗi khoảng 24 giờ bắt đầu tiếp theo tính 1 ngày phí. Ví dụ miễn 30 phút: muộn 30 phút không tính phí; muộn 31 phút tính 1 ngày × hệ số × giá thuê/ngày của đơn.</p></section>
<section class="card card-body mb-3"><h2 class="h5 mb-3">Giao xe tận nơi</h2><div class="row g-3">
<div class="col-md-6"><label asp-for="IncludedDeliveryDistanceKm" class="form-label">Số km trong phí cơ bản</label><input asp-for="IncludedDeliveryDistanceKm" type="number" min="0" max="500" step="0.01" required class="form-control" /><span asp-validation-for="IncludedDeliveryDistanceKm" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="BaseDeliveryFee" class="form-label">Phí giao cơ bản (đ)</label><input asp-for="BaseDeliveryFee" type="number" min="0" max="10000000" step="1" required class="form-control" /><span asp-validation-for="BaseDeliveryFee" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="DeliveryFeePerExtraKm" class="form-label">Phí mỗi km bắt đầu tiếp theo (đ)</label><input asp-for="DeliveryFeePerExtraKm" type="number" min="0" max="1000000" step="1" required class="form-control" /><span asp-validation-for="DeliveryFeePerExtraKm" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="MaxDeliveryDistanceKm" class="form-label">Bán kính giao tối đa (km)</label><input asp-for="MaxDeliveryDistanceKm" type="number" min="1" max="500" step="0.01" required class="form-control" /><span asp-validation-for="MaxDeliveryDistanceKm" class="text-danger"></span></div>
</div><p class="small text-muted mt-3 mb-0">Nhận tại cửa hàng: 0 đ. Giao tận nơi: phí cơ bản + số km vượt được làm tròn lên × phí/km. Khoảng cách tính theo tọa độ, làm tròn 2 chữ số thập phân trước khi tính phí.</p></section>
<section class="card card-body mb-3"><h2 class="h5">Điều khoản trên biên bản</h2>
<p class="text-muted">Chỉnh nội dung diễn giải không làm thay đổi công thức tính phí. Các mức phí được hiển thị riêng từ cấu hình ở trên. Nội dung lưu dưới dạng văn bản thuần.</p>
<label asp-for="TrafficFineTerms" class="form-label">Vi phạm giao thông / phạt nguội</label>
<textarea asp-for="TrafficFineTerms" rows="6" maxlength="1500" required class="form-control mb-3"></textarea>
<label asp-for="DamageCompensationTerms" class="form-label">Hư hỏng / thiếu / trả muộn</label>
<textarea asp-for="DamageCompensationTerms" rows="7" maxlength="1500" required class="form-control"></textarea>
<details class="mt-3"><summary>Xem trước điều khoản</summary><h3 class="h6 mt-3">Vi phạm giao thông / phạt nguội</h3><p id="traffic-preview" style="white-space:pre-wrap"></p><h3 class="h6">Hư hỏng / thiếu / trả muộn</h3><p id="damage-preview" style="white-space:pre-wrap"></p></details>
</section>
<button class="btn btn-primary" type="submit">Lưu chính sách cho đơn mới</button>
</form>
@section Scripts {
<script>
for (const [field, preview] of [['TrafficFineTerms','traffic-preview'],['DamageCompensationTerms','damage-preview']]) {
    const input = document.getElementById(field), output = document.getElementById(preview);
    const render = () => output.textContent = input.value;
    input.addEventListener('input', render); render();
}
</script>
}
