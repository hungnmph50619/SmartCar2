@model SmartCar.Domain.Constants.RentalPolicySnapshot
@{
    ViewData["Title"] = "Cấu hình nghiệp vụ";
    Layout = "_AdminLayout";
    var current = (SmartCar.Domain.Constants.RentalPolicySnapshot)ViewData["CurrentPolicy"]!;
    var editing = ViewData["EditingGroup"] as string;
    var conflict = ViewData["PolicyConflict"] as bool? ?? false;
    var vi = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-business-settings.css" asp-append-version="true" />
}

<div class="policy-settings-page">
    <div class="policy-settings-header">
        <div>
            <h1 class="policy-settings-title">Cấu hình nghiệp vụ</h1>
            <p class="policy-settings-subtitle">Quản lý chính sách áp dụng cho đơn mới.</p>
        </div>
        <a class="btn btn-outline-primary policy-history-btn"
           asp-controller="AuditLogs"
           asp-action="Index"
           asp-route-search="BusinessSetting">
            <span aria-hidden="true">↶</span>
            <span>Lịch sử thay đổi</span>
        </a>
    </div>

    <div class="policy-overview" aria-label="Tóm tắt cấu hình">
        <div class="policy-overview-item">
            <span class="policy-overview-icon" aria-hidden="true">▱</span>
            <div class="policy-overview-copy">
                <strong>5 nhóm chính sách</strong>
                <span>Cọc, quãng đường, trả muộn, giao xe, điều khoản</span>
            </div>
        </div>
        <div class="policy-overview-item">
            <span class="policy-overview-icon" aria-hidden="true">✓</span>
            <div class="policy-overview-copy">
                <strong>Áp dụng cho đơn mới</strong>
                <span>Đơn cũ giữ chính sách đã chốt</span>
            </div>
        </div>
        <div class="policy-overview-item">
            <span class="policy-overview-icon" aria-hidden="true">₫</span>
            <div class="policy-overview-copy">
                <strong>Giá thuê/ngày</strong>
                <span>Chỉnh riêng trong Quản lý xe</span>
            </div>
        </div>
    </div>

    @if (conflict)
    {
        <div class="alert alert-warning policy-conflict-alert">
            Chính sách vừa thay đổi. Nội dung bạn nhập vẫn được giữ.
            <a asp-action="Index" class="alert-link">Tải lại</a> trước khi sửa tiếp.
        </div>
    }

    <noscript>
        <div class="alert alert-warning policy-conflict-alert">Vui lòng bật JavaScript để chỉnh sửa chính sách.</div>
    </noscript>

    <div id="policy-groups" class="policy-grid" data-conflict="@(conflict ? "true" : "false")">
        <section class="policy-card" data-policy-group="deposit">
            <div class="policy-card-main">
                <div class="policy-card-header">
                    <span class="policy-card-icon" aria-hidden="true">₫</span>
                    <div class="policy-card-heading">
                        <h2>Tiền cọc</h2>
                        <p>Tỷ lệ cọc và thời gian giữ cọc</p>
                    </div>
                    <button type="button"
                            class="btn btn-outline-primary policy-edit-btn"
                            data-edit
                            aria-controls="edit-deposit"
                            aria-expanded="@(editing == "deposit" ? "true" : "false")"
                            disabled="@conflict">
                        <span aria-hidden="true">✎</span> Chỉnh sửa
                    </button>
                </div>

                <div class="policy-metrics">
                    <div class="policy-metric">
                        <span class="policy-metric-label">Tỷ lệ trên tiền thuê</span>
                        <strong class="policy-metric-value">@current.DepositPercent.ToString("0.##", vi)%</strong>
                    </div>
                    <div class="policy-metric">
                        <span class="policy-metric-label">Giữ cọc sau trả xe</span>
                        <strong class="policy-metric-value">@current.DepositHoldDays.ToString("N0", vi) ngày</strong>
                    </div>
                </div>

                <p class="policy-helper">
                    <span class="policy-helper-icon" aria-hidden="true">i</span>
                    <span>Hoàn cọc sau hậu kiểm và xử lý các khoản còn mở.</span>
                </p>
            </div>

            <form asp-action="Update"
                  method="post"
                  id="edit-deposit"
                  class="policy-edit-form"
                  data-policy-form
                  hidden="@(editing != "deposit")"
                  data-server-edit="@(editing == "deposit" ? "true" : "false")">
                <input type="hidden" name="group" value="deposit" />
                <input type="hidden" name="version" value="@(editing == "deposit" ? Model.Version : current.Version)" />
                @if (editing == "deposit")
                {
                    <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
                }
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="DepositPercent" class="form-label">Tỷ lệ trên tiền thuê</label>
                        <div class="input-group">
                            <input asp-for="DepositPercent"
                                   type="number"
                                   min="1"
                                   max="1000"
                                   step=".01"
                                   required
                                   class="form-control"
                                   data-policy-input
                                   data-label="Tỷ lệ trên tiền thuê"
                                   data-unit="%"
                                   data-current="@current.DepositPercent.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                            <span class="input-group-text">%</span>
                        </div>
                        <span asp-validation-for="DepositPercent" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DepositHoldDays" class="form-label">Giữ cọc sau trả xe</label>
                        <div class="input-group">
                            <input asp-for="DepositHoldDays"
                                   type="number"
                                   min="0"
                                   max="30"
                                   step="1"
                                   required
                                   class="form-control"
                                   data-policy-input
                                   data-label="Giữ cọc sau trả xe"
                                   data-unit="ngày"
                                   data-current="@current.DepositHoldDays.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                            <span class="input-group-text">ngày</span>
                        </div>
                        <span asp-validation-for="DepositHoldDays" class="text-danger small"></span>
                    </div>
                </div>
                <div class="alert alert-warning mt-3" data-changes hidden aria-live="polite"></div>
                <div class="policy-edit-actions">
                    <button type="submit" class="btn btn-primary" data-save disabled>Lưu thay đổi</button>
                    <button type="button" class="btn btn-outline-secondary" data-cancel>Hủy</button>
                </div>
            </form>
        </section>

        <section class="policy-card" data-policy-group="mileage">
            <div class="policy-card-main">
                <div class="policy-card-header">
                    <span class="policy-card-icon" aria-hidden="true">↔</span>
                    <div class="policy-card-heading">
                        <h2>Quãng đường</h2>
                        <p>Định mức và phí vượt</p>
                    </div>
                    <button type="button"
                            class="btn btn-outline-primary policy-edit-btn"
                            data-edit
                            aria-controls="edit-mileage"
                            aria-expanded="@(editing == "mileage" ? "true" : "false")"
                            disabled="@conflict">
                        <span aria-hidden="true">✎</span> Chỉnh sửa
                    </button>
                </div>

                <div class="policy-metrics">
                    <div class="policy-metric">
                        <span class="policy-metric-label">Định mức mỗi ngày</span>
                        <strong class="policy-metric-value">@current.IncludedKilometersPerDay.ToString("N0", vi) km/ngày</strong>
                    </div>
                    <div class="policy-metric">
                        <span class="policy-metric-label">Phí vượt định mức</span>
                        <strong class="policy-metric-value">@current.ExcessKilometerFee.ToString("N0", vi) đ/km</strong>
                    </div>
                </div>

                <p class="policy-helper">
                    <span class="policy-helper-icon" aria-hidden="true">i</span>
                    <span>Định mức chuyến = định mức/ngày × số ngày tính phí.</span>
                </p>
            </div>

            <form asp-action="Update"
                  method="post"
                  id="edit-mileage"
                  class="policy-edit-form"
                  data-policy-form
                  hidden="@(editing != "mileage")"
                  data-server-edit="@(editing == "mileage" ? "true" : "false")">
                <input type="hidden" name="group" value="mileage" />
                <input type="hidden" name="version" value="@(editing == "mileage" ? Model.Version : current.Version)" />
                @if (editing == "mileage")
                {
                    <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
                }
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="IncludedKilometersPerDay" class="form-label">Định mức mỗi ngày</label>
                        <div class="input-group">
                            <input asp-for="IncludedKilometersPerDay"
                                   type="number"
                                   min="1"
                                   max="1000"
                                   step="1"
                                   required
                                   class="form-control"
                                   data-policy-input
                                   data-label="Định mức mỗi ngày"
                                   data-unit="km/ngày"
                                   data-current="@current.IncludedKilometersPerDay.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                            <span class="input-group-text">km/ngày</span>
                        </div>
                        <span asp-validation-for="IncludedKilometersPerDay" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ExcessKilometerFee" class="form-label">Phí vượt định mức</label>
                        <div class="input-group">
                            <input asp-for="ExcessKilometerFee"
                                   type="number"
                                   min="0"
                                   max="50000"
                                   step="1"
                                   required
                                   class="form-control"
                                   data-policy-input
                                   data-label="Phí vượt định mức"
                                   data-unit="đ/km"
                                   data-current="@current.ExcessKilometerFee.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                            <span class="input-group-text">đ/km</span>
                        </div>
                        <span asp-validation-for="ExcessKilometerFee" class="text-danger small"></span>
                    </div>
                </div>
                <div class="alert alert-warning mt-3" data-changes hidden aria-live="polite"></div>
                <div class="policy-edit-actions">
                    <button type="submit" class="btn btn-primary" data-save disabled>Lưu thay đổi</button>
                    <button type="button" class="btn btn-outline-secondary" data-cancel>Hủy</button>
                </div>
            </form>
        </section>

        <section class="policy-card" data-policy-group="late">
            <div class="policy-card-main">
                <div class="policy-card-header">
                    <span class="policy-card-icon" aria-hidden="true">◷</span>
                    <div class="policy-card-heading">
                        <h2>Trả muộn</h2>
                        <p>Hệ số phí và thời gian miễn phí</p>
                    </div>
                    <button type="button"
                            class="btn btn-outline-primary policy-edit-btn"
                            data-edit
                            aria-controls="edit-late"
                            aria-expanded="@(editing == "late" ? "true" : "false")"
                            disabled="@conflict">
                        <span aria-hidden="true">✎</span> Chỉnh sửa
                    </button>
                </div>

                <div class="policy-metrics">
                    <div class="policy-metric">
                        <span class="policy-metric-label">Hệ số phí/ngày</span>
                        <strong class="policy-metric-value">@current.LateReturnFeeMultiplier.ToString("0.##", vi) lần/ngày</strong>
                    </div>
                    <div class="policy-metric">
                        <span class="policy-metric-label">Thời gian miễn phí</span>
                        <strong class="policy-metric-value">@current.LateReturnGraceMinutes.ToString("N0", vi) phút</strong>
                    </div>
                </div>

                <p class="policy-helper">
                    <span class="policy-helper-icon" aria-hidden="true">i</span>
                    <span>Quá thời gian miễn phí, mỗi 24 giờ bắt đầu tính một ngày phí.</span>
                </p>
            </div>

            <form asp-action="Update"
                  method="post"
                  id="edit-late"
                  class="policy-edit-form"
                  data-policy-form
                  hidden="@(editing != "late")"
                  data-server-edit="@(editing == "late" ? "true" : "false")">
                <input type="hidden" name="group" value="late" />
                <input type="hidden" name="version" value="@(editing == "late" ? Model.Version : current.Version)" />
                @if (editing == "late")
                {
                    <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
                }
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="LateReturnFeeMultiplier" class="form-label">Hệ số phí/ngày</label>
                        <div class="input-group">
                            <input asp-for="LateReturnFeeMultiplier"
                                   type="number"
                                   min="1"
                                   max="5"
                                   step=".01"
                                   required
                                   class="form-control"
                                   data-policy-input
                                   data-label="Hệ số phí/ngày"
                                   data-unit="lần"
                                   data-current="@current.LateReturnFeeMultiplier.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                            <span class="input-group-text">lần</span>
                        </div>
                        <span asp-validation-for="LateReturnFeeMultiplier" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="LateReturnGraceMinutes" class="form-label">Thời gian miễn phí</label>
                        <div class="input-group">
                            <input asp-for="LateReturnGraceMinutes"
                                   type="number"
                                   min="0"
                                   max="1440"
                                   step="1"
                                   required
                                   class="form-control"
                                   data-policy-input
                                   data-label="Thời gian miễn phí"
                                   data-unit="phút"
                                   data-current="@current.LateReturnGraceMinutes.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                            <span class="input-group-text">phút</span>
                        </div>
                        <span asp-validation-for="LateReturnGraceMinutes" class="text-danger small"></span>
                    </div>
                </div>
                <div class="alert alert-warning mt-3" data-changes hidden aria-live="polite"></div>
                <div class="policy-edit-actions">
                    <button type="submit" class="btn btn-primary" data-save disabled>Lưu thay đổi</button>
                    <button type="button" class="btn btn-outline-secondary" data-cancel>Hủy</button>
                </div>
            </form>
        </section>

        <section class="policy-card policy-card-wide" data-policy-group="delivery">
            <div class="policy-card-main">
                <div class="policy-card-header">
                    <span class="policy-card-icon" aria-hidden="true">➜</span>
                    <div class="policy-card-heading">
                        <h2>Giao xe tận nơi</h2>
                        <p>Chi phí và phạm vi giao xe</p>
                    </div>
                    <button type="button"
                            class="btn btn-outline-primary policy-edit-btn"
                            data-edit
                            aria-controls="edit-delivery"
                            aria-expanded="@(editing == "delivery" ? "true" : "false")"
                            disabled="@conflict">
                        <span aria-hidden="true">✎</span> Chỉnh sửa
                    </button>
                </div>

                <div class="policy-metrics four">
                    <div class="policy-metric">
                        <span class="policy-metric-label">Trong phí cơ bản</span>
                        <strong class="policy-metric-value">@current.IncludedDeliveryDistanceKm.ToString("0.##", vi) km</strong>
                    </div>
                    <div class="policy-metric">
                        <span class="policy-metric-label">Phí giao cơ bản</span>
                        <strong class="policy-metric-value">@current.BaseDeliveryFee.ToString("N0", vi) đ</strong>
                    </div>
                    <div class="policy-metric">
                        <span class="policy-metric-label">Mỗi km tiếp theo</span>
                        <strong class="policy-metric-value">@current.DeliveryFeePerExtraKm.ToString("N0", vi) đ/km</strong>
                    </div>
                    <div class="policy-metric">
                        <span class="policy-metric-label">Phạm vi tối đa</span>
                        <strong class="policy-metric-value">@current.MaxDeliveryDistanceKm.ToString("0.##", vi) km</strong>
                    </div>
                </div>

                <p class="policy-helper">
                    <span class="policy-helper-icon" aria-hidden="true">i</span>
                    <span>Nhận tại cửa hàng miễn phí; giao tận nơi tính phần km vượt.</span>
                </p>
            </div>

            <form asp-action="Update"
                  method="post"
                  id="edit-delivery"
                  class="policy-edit-form"
                  data-policy-form
                  hidden="@(editing != "delivery")"
                  data-server-edit="@(editing == "delivery" ? "true" : "false")">
                <input type="hidden" name="group" value="delivery" />
                <input type="hidden" name="version" value="@(editing == "delivery" ? Model.Version : current.Version)" />
                @if (editing == "delivery")
                {
                    <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
                }
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="IncludedDeliveryDistanceKm" class="form-label">Quãng đường trong phí cơ bản</label>
                        <div class="input-group">
                            <input asp-for="IncludedDeliveryDistanceKm"
                                   type="number"
                                   min="0"
                                   max="20"
                                   step=".01"
                                   required
                                   class="form-control"
                                   data-policy-input
                                   data-label="Quãng đường trong phí cơ bản"
                                   data-unit="km"
                                   data-current="@current.IncludedDeliveryDistanceKm.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                            <span class="input-group-text">km</span>
                        </div>
                        <span asp-validation-for="IncludedDeliveryDistanceKm" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="BaseDeliveryFee" class="form-label">Phí giao cơ bản</label>
                        <div class="input-group">
                            <input asp-for="BaseDeliveryFee"
                                   type="number"
                                   min="0"
                                   max="100000"
                                   step="1"
                                   required
                                   class="form-control"
                                   data-policy-input
                                   data-label="Phí giao cơ bản"
                                   data-unit="đ"
                                   data-current="@current.BaseDeliveryFee.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                            <span class="input-group-text">đ</span>
                        </div>
                        <span asp-validation-for="BaseDeliveryFee" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DeliveryFeePerExtraKm" class="form-label">Phí mỗi km tiếp theo</label>
                        <div class="input-group">
                            <input asp-for="DeliveryFeePerExtraKm"
                                   type="number"
                                   min="0"
                                   max="50000"
                                   step="1"
                                   required
                                   class="form-control"
                                   data-policy-input
                                   data-label="Phí mỗi km tiếp theo"
                                   data-unit="đ/km"
                                   data-current="@current.DeliveryFeePerExtraKm.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                            <span class="input-group-text">đ/km</span>
                        </div>
                        <span asp-validation-for="DeliveryFeePerExtraKm" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="MaxDeliveryDistanceKm" class="form-label">Phạm vi giao tối đa</label>
                        <div class="input-group">
                            <input asp-for="MaxDeliveryDistanceKm"
                                   type="number"
                                   min="1"
                                   max="80"
                                   step=".01"
                                   required
                                   class="form-control"
                                   data-policy-input
                                   data-label="Phạm vi giao tối đa"
                                   data-unit="km"
                                   data-current="@current.MaxDeliveryDistanceKm.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                            <span class="input-group-text">km</span>
                        </div>
                        <span asp-validation-for="MaxDeliveryDistanceKm" class="text-danger small"></span>
                    </div>
                </div>
                <div class="alert alert-warning mt-3" data-changes hidden aria-live="polite"></div>
                <div class="policy-edit-actions">
                    <button type="submit" class="btn btn-primary" data-save disabled>Lưu thay đổi</button>
                    <button type="button" class="btn btn-outline-secondary" data-cancel>Hủy</button>
                </div>
            </form>
        </section>

        <section class="policy-card policy-card-terms" data-policy-group="terms">
            <div class="policy-card-main">
                <div class="policy-card-header">
                    <span class="policy-card-icon" aria-hidden="true">§</span>
                    <div class="policy-card-heading">
                        <h2>Điều khoản biên bản</h2>
                        <p>Quy định khi phát sinh sự cố</p>
                    </div>
                    <button type="button"
                            class="btn btn-outline-primary policy-edit-btn"
                            data-edit
                            aria-controls="edit-terms"
                            aria-expanded="@(editing == "terms" ? "true" : "false")"
                            disabled="@conflict">
                        <span aria-hidden="true">✎</span> Chỉnh sửa
                    </button>
                </div>

                <div class="policy-terms-list">
                    <div class="policy-term-row">
                        <span class="policy-term-row-icon" aria-hidden="true">!</span>
                        <div class="policy-term-row-copy">
                            <strong>Vi phạm giao thông / phạt nguội</strong>
                            <span>Khách chịu trách nhiệm trong thời gian thực tế giữ xe.</span>
                        </div>
                    </div>
                    <div class="policy-term-row">
                        <span class="policy-term-row-icon" aria-hidden="true">⌁</span>
                        <div class="policy-term-row-copy">
                            <strong>Hư hỏng / thiếu / trả muộn</strong>
                            <span>Bồi thường theo thiệt hại thực tế và chứng cứ.</span>
                        </div>
                    </div>
                </div>

                <details class="policy-terms-details">
                    <summary>Xem nội dung đầy đủ</summary>
                    <div class="policy-terms-full">
                        <h3>Vi phạm giao thông / phạt nguội</h3>
                        <p>@current.TrafficFineTerms</p>
                        <h3>Hư hỏng / thiếu / trả muộn</h3>
                        <p>@current.DamageCompensationTerms</p>
                    </div>
                </details>
            </div>

            <form asp-action="Update"
                  method="post"
                  id="edit-terms"
                  class="policy-edit-form"
                  data-policy-form
                  hidden="@(editing != "terms")"
                  data-server-edit="@(editing == "terms" ? "true" : "false")">
                <input type="hidden" name="group" value="terms" />
                <input type="hidden" name="version" value="@(editing == "terms" ? Model.Version : current.Version)" />
                @if (editing == "terms")
                {
                    <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
                }
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="TrafficFineTerms" class="form-label">Vi phạm giao thông / phạt nguội</label>
                        <textarea asp-for="TrafficFineTerms"
                                  rows="6"
                                  maxlength="1500"
                                  required
                                  class="form-control"
                                  data-policy-input
                                  data-label="Vi phạm giao thông / phạt nguội"
                                  data-current="@current.TrafficFineTerms"></textarea>
                        <span asp-validation-for="TrafficFineTerms" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="DamageCompensationTerms" class="form-label">Hư hỏng / thiếu / trả muộn</label>
                        <textarea asp-for="DamageCompensationTerms"
                                  rows="6"
                                  maxlength="1500"
                                  required
                                  class="form-control"
                                  data-policy-input
                                  data-label="Hư hỏng / thiếu / trả muộn"
                                  data-current="@current.DamageCompensationTerms"></textarea>
                        <span asp-validation-for="DamageCompensationTerms" class="text-danger small"></span>
                    </div>
                </div>
                <div class="alert alert-warning mt-3" data-changes hidden aria-live="polite"></div>
                <div class="policy-edit-actions">
                    <button type="submit" class="btn btn-primary" data-save disabled>Lưu thay đổi</button>
                    <button type="button" class="btn btn-outline-secondary" data-cancel>Hủy</button>
                </div>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <script src="~/js/business-policy-settings.js" asp-append-version="true"></script>
}
