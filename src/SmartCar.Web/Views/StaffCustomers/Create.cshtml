@model SmartCar.Web.ViewModels.StaffCreateCustomerViewModel
@{
    ViewData["Title"] = "Tạo khách tại quầy";
}

@section Styles {
    <link rel="stylesheet" href="~/css/staff-operations.css" asp-append-version="true" />
}

<div class="staff-op-page">
    <section class="staff-hero p-4 p-lg-5 mb-4">
        <div class="position-relative" style="z-index:1">
            <span class="staff-eyebrow mb-3"><span class="staff-pulse-dot"></span> Khách vãng lai tại quầy</span>
            <h1 class="display-6 fw-bold mb-2">Tạo tài khoản Customer</h1>
            <p class="text-muted mb-3" style="max-width:760px">
                Nhân viên có thể tạo tài khoản cho khách đến trực tiếp. Việc này chỉ tạo <strong>tài khoản Customer</strong>,
                không tự động duyệt CCCD/GPLX và không bỏ qua bước KYC.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-outline-primary" asp-controller="Staff" asp-action="CounterRental">← Thuê xe tại quầy</a>
                @if (User.IsInRole(SmartCar.Domain.Constants.RoleNames.Admin))
                {
                    <a class="btn btn-outline-secondary" asp-controller="AdminKyc" asp-action="Index">Mở hàng chờ KYC</a>
                }
            </div>
        </div>
    </section>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="staff-step">
                <span class="staff-step-number">1</span>
                <div class="fw-bold">Tạo tài khoản</div>
                <div class="small text-muted">Nhập đúng họ tên, số điện thoại và email của khách.</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="staff-step" style="animation-delay:.06s">
                <span class="staff-step-number">2</span>
                <div class="fw-bold">Khách hoàn tất KYC</div>
                <div class="small text-muted">CCCD và GPLX phải được gửi đầy đủ, còn hiệu lực.</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="staff-step" style="animation-delay:.12s">
                <span class="staff-step-number">3</span>
                <div class="fw-bold">Admin xác minh</div>
                <div class="small text-muted">Chỉ sau khi KYC hợp lệ, nhân viên mới tạo được đơn thuê tại quầy.</div>
            </div>
        </div>
    </div>

    <div class="card staff-form-card">
        <div class="card-body p-4 p-lg-5">
            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4">
                <div>
                    <h2 class="h4 mb-1">Thông tin khách hàng</h2>
                    <div class="text-muted small">Mật khẩu ban đầu nên được giao trực tiếp cho khách và khách nên đổi lại sau khi đăng nhập.</div>
                </div>
                <span class="badge rounded-pill text-bg-light border px-3 py-2">Vai trò: Customer</span>
            </div>

            <form asp-action="Create" method="post" class="row g-3" data-loading-form>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-1"></div>

                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label fw-semibold"></label>
                    <input asp-for="FullName" class="form-control" autocomplete="name" placeholder="Nguyễn Văn A" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                    <input asp-for="PhoneNumber" class="form-control" autocomplete="tel" placeholder="09xxxxxxxx" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Email" class="form-label fw-semibold"></label>
                    <input asp-for="Email" class="form-control" autocomplete="email" placeholder="khachhang@example.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Password" class="form-label fw-semibold"></label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" placeholder="Ít nhất 8 ký tự" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <div class="staff-note p-3">
                        <div class="form-check mb-1">
                            <input asp-for="CustomerAcceptedTerms" class="form-check-input" />
                            <label asp-for="CustomerAcceptedTerms" class="form-check-label fw-semibold"></label>
                        </div>
                        <div class="small text-muted ms-4">Nhân viên chỉ đánh dấu sau khi khách đã được cung cấp điều khoản/chính sách và xác nhận đồng ý.</div>
                        <span asp-validation-for="CustomerAcceptedTerms" class="text-danger small ms-4"></span>
                    </div>
                </div>

                <div class="col-12 d-flex flex-wrap gap-2 pt-2">
                    <button class="btn btn-primary staff-action-button px-4" type="submit" data-loading-text="Đang tạo tài khoản...">Tạo tài khoản khách</button>
                    <a class="btn btn-outline-secondary px-4" asp-controller="Staff" asp-action="CounterRental">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
