@model SmartCar.Web.ViewModels.StaffCreateCustomerViewModel
@using SmartCar.Web.Services
@inject IUserBankAccountService BankAccountService
@{
    ViewData["Title"] = "Tạo khách tại quầy";
    var latestDateOfBirth = DateTime.Today.AddYears(-18).ToString("yyyy-MM-dd");
    var minimumExpiryDate = DateTime.Today.ToString("yyyy-MM-dd");
}

@section Styles {
    <link rel="stylesheet" href="~/css/staff-operations.css" asp-append-version="true" />
}

<div class="staff-op-page">
    <section class="staff-hero p-4 p-lg-5 mb-4">
        <div class="position-relative" style="z-index:1">
            <span class="staff-eyebrow mb-3"><span class="staff-pulse-dot"></span> Khách tại quầy</span>
            <h1 class="display-6 fw-bold mb-2">Tạo khách và tiếp nhận hồ sơ</h1>
            <p class="text-muted mb-0">
                Nhân viên hỗ trợ nhập CCCD/GPLX và đối chiếu giấy tờ gốc. Hồ sơ được lưu ở trạng thái
                <strong>Chờ xử lý</strong>; chỉ quản trị viên mới được duyệt KYC trước khi khách có thể thuê xe.
            </p>
        </div>
    </section>

    <div class="alert alert-info">
        <strong>Luồng đúng:</strong> Tạo tài khoản → tiếp nhận 4 ảnh giấy tờ + tài khoản nhận hoàn → quản trị viên duyệt KYC → Staff lập đơn tại quầy.
        Việc nhân viên đánh dấu đã xem bản gốc không đồng nghĩa hồ sơ đã được duyệt.
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data" class="card staff-form-card" data-loading-form>
        <div class="card-body p-4 p-lg-5">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <h2 class="h5 mb-3">1. Tài khoản khách hàng</h2>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label fw-semibold"></label>
                    <input asp-for="FullName" class="form-control" autocomplete="name" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                    <input asp-for="PhoneNumber" class="form-control" autocomplete="tel" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Email" class="form-label fw-semibold"></label>
                    <input asp-for="Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Password" class="form-label fw-semibold"></label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>

            <hr />
            <h2 class="h5 mb-3">2. Căn cước công dân</h2>
            <div class="row g-3 mb-4">
                <div class="col-md-7">
                    <label asp-for="CitizenIdVerification.FullNameOnDocument" class="form-label fw-semibold"></label>
                    <input asp-for="CitizenIdVerification.FullNameOnDocument" class="form-control" maxlength="100" required />
                    <span asp-validation-for="CitizenIdVerification.FullNameOnDocument" class="text-danger small"></span>
                </div>
                <div class="col-md-5">
                    <label asp-for="CitizenIdVerification.DocumentNumber" class="form-label fw-semibold"></label>
                    <input asp-for="CitizenIdVerification.DocumentNumber" class="form-control" inputmode="numeric" maxlength="12" pattern="[0-9]{12}" required />
                    <span asp-validation-for="CitizenIdVerification.DocumentNumber" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="CitizenIdVerification.DateOfBirth" class="form-label fw-semibold"></label>
                    <input asp-for="CitizenIdVerification.DateOfBirth" type="date" class="form-control" max="@latestDateOfBirth" required />
                    <span asp-validation-for="CitizenIdVerification.DateOfBirth" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="CitizenIdVerification.Gender" class="form-label fw-semibold"></label>
                    <select asp-for="CitizenIdVerification.Gender" class="form-select" required>
                        <option value="">-- Chọn giới tính --</option>
                        <option value="Nam">Nam</option>
                        <option value="Nữ">Nữ</option>
                        <option value="Khác">Khác</option>
                    </select>
                    <span asp-validation-for="CitizenIdVerification.Gender" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="CitizenIdVerification.ExpiryDate" class="form-label fw-semibold"></label>
                    <input asp-for="CitizenIdVerification.ExpiryDate" type="date" class="form-control" min="@minimumExpiryDate" required />
                    <span asp-validation-for="CitizenIdVerification.ExpiryDate" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Ảnh CCCD mặt trước *</label>
                    <input asp-for="CitizenIdVerification.FrontImage" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" required />
                    <span asp-validation-for="CitizenIdVerification.FrontImage" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Ảnh CCCD mặt sau *</label>
                    <input asp-for="CitizenIdVerification.BackImage" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" required />
                    <span asp-validation-for="CitizenIdVerification.BackImage" class="text-danger small"></span>
                </div>
            </div>

            <hr />
            <h2 class="h5 mb-3">3. Giấy phép lái xe</h2>
            <div class="row g-3 mb-4">
                <div class="col-md-5">
                    <label asp-for="DrivingLicenseVerification.DocumentNumber" class="form-label fw-semibold"></label>
                    <input asp-for="DrivingLicenseVerification.DocumentNumber" class="form-control" maxlength="12" pattern="[A-Za-z0-9]{8,12}" required />
                    <span asp-validation-for="DrivingLicenseVerification.DocumentNumber" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="DrivingLicenseVerification.LicenseClass" class="form-label fw-semibold"></label>
                    <select asp-for="DrivingLicenseVerification.LicenseClass" class="form-select" required>
                        <option value="">-- Chọn hạng --</option>
                        <option value="B">B</option><option value="C1">C1</option><option value="C">C</option>
                        <option value="D1">D1</option><option value="D2">D2</option><option value="D">D</option>
                        <option value="BE">BE</option><option value="C1E">C1E</option><option value="CE">CE</option>
                        <option value="D1E">D1E</option><option value="D2E">D2E</option><option value="DE">DE</option>
                        <option value="B1">B1</option><option value="B2">B2</option>
                    </select>
                    <span asp-validation-for="DrivingLicenseVerification.LicenseClass" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="DrivingLicenseVerification.ExpiryDate" class="form-label fw-semibold"></label>
                    <input asp-for="DrivingLicenseVerification.ExpiryDate" type="date" class="form-control" min="@minimumExpiryDate" required />
                    <span asp-validation-for="DrivingLicenseVerification.ExpiryDate" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Ảnh GPLX mặt trước *</label>
                    <input asp-for="DrivingLicenseVerification.FrontImage" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" required />
                    <span asp-validation-for="DrivingLicenseVerification.FrontImage" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Ảnh GPLX mặt sau *</label>
                    <input asp-for="DrivingLicenseVerification.BackImage" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" required />
                    <span asp-validation-for="DrivingLicenseVerification.BackImage" class="text-danger small"></span>
                </div>
            </div>

            <hr />
            <h2 class="h5 mb-3">4. Tài khoản nhận hoàn tiền</h2>
            <div class="alert alert-light border small mb-3">
                Dùng để hoàn cọc, hoàn tiền hoặc chuyển trả khoản phát sinh. SmartCar không dùng thông tin này để tự động trừ tiền.
            </div>
            <div class="row g-3 mb-4">
                <div class="col-md-5">
                    <label asp-for="BankAccount.BankCode" class="form-label fw-semibold"></label>
                    <select asp-for="BankAccount.BankCode" class="form-select" required>
                        <option value="">-- Chọn ngân hàng --</option>
                        @foreach (var bank in BankAccountService.Banks)
                        {
                            <option value="@bank.Code">@bank.Name</option>
                        }
                    </select>
                    <span asp-validation-for="BankAccount.BankCode" class="text-danger small"></span>
                </div>
                <div class="col-md-7">
                    <label asp-for="BankAccount.AccountNumber" class="form-label fw-semibold"></label>
                    <input asp-for="BankAccount.AccountNumber"
                           class="form-control"
                           inputmode="numeric"
                           autocomplete="off"
                           minlength="6"
                           maxlength="20"
                           pattern="[0-9]{6,20}"
                           required />
                    <span asp-validation-for="BankAccount.AccountNumber" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="BankAccount.AccountHolderName" class="form-label fw-semibold"></label>
                    <input asp-for="BankAccount.AccountHolderName"
                           class="form-control text-uppercase"
                           maxlength="150"
                           autocomplete="name"
                           pattern="[\p{L}]+(?:[ ]+[\p{L}]+)*"
                           required />
                    <div class="form-text">Nhập đúng tên chủ tài khoản nhận tiền; có thể dùng chữ có dấu hoặc không dấu.</div>
                    <span asp-validation-for="BankAccount.AccountHolderName" class="text-danger small"></span>
                </div>
            </div>

            <hr />
            <h2 class="h5 mb-3">5. Xác nhận tiếp nhận</h2>
            <div class="form-check mb-3">
                <input asp-for="ConfirmSamePerson" class="form-check-input" required />
                <label asp-for="ConfirmSamePerson" class="form-check-label fw-semibold"></label>
                <span asp-validation-for="ConfirmSamePerson" class="text-danger small d-block"></span>
            </div>
            <div class="form-check mb-3">
                <input asp-for="OriginalDocumentsChecked" class="form-check-input" required />
                <label asp-for="OriginalDocumentsChecked" class="form-check-label fw-semibold"></label>
                <div class="small text-muted">Xác nhận này ghi nhận nhân viên đã xem người thật và giấy tờ gốc; không tự chuyển hồ sơ sang Đã xác minh.</div>
                <span asp-validation-for="OriginalDocumentsChecked" class="text-danger small d-block"></span>
            </div>
            <div class="form-check mb-4">
                <input asp-for="CustomerAcceptedTerms" class="form-check-input" required />
                <label asp-for="CustomerAcceptedTerms" class="form-check-label fw-semibold"></label>
                <span asp-validation-for="CustomerAcceptedTerms" class="text-danger small d-block"></span>
            </div>

            <div class="alert alert-warning">
                Sau khi gửi, khách <strong>chưa thể lập đơn ngay</strong>. Quản trị viên phải duyệt CCCD và GPLX; tài khoản nhận hoàn đã được lưu sẵn để sau khi KYC đạt, Staff có thể lập đơn ngay tại quầy.
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <button class="btn btn-primary px-4" type="submit" data-loading-text="Đang tạo và gửi hồ sơ...">Tạo khách & gửi hồ sơ chờ duyệt</button>
                <a class="btn btn-outline-secondary px-4" asp-action="Index">Hủy</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
