@model SmartCar.Web.ViewModels.ReturnEditViewModel
@{
    ViewData["Title"] = "Chỉnh sửa biên bản trả xe";
    var currentImages = Model.ExistingImagePaths ?? new List<string>();
    var accessoryIsMissing = Model.AccessoryStatus == "Thiếu";
    const string imageAccept = ".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp";

    bool IsRequiredEvidence(string path)
    {
        var fileName = System.IO.Path.GetFileName(path);
        return new[] { "front-", "rear-", "left-", "right-", "interior-", "odometer-", "fuel-" }
            .Any(prefix => fileName.StartsWith(prefix, StringComparison.OrdinalIgnoreCase));
    }
}

<div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-3">
    <div>
        <h1 class="h3 mb-1">Chỉnh sửa biên bản trả xe · #@Model.BookingId</h1>
        <p class="text-muted mb-0">Chỉnh sửa thông tin, thêm/xóa ảnh trả xe rồi quay về màn đối chiếu trước khi in ký.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-controller="Returns" asp-action="Inspect" asp-route-bookingId="@Model.BookingId">← Quay lại đối chiếu</a>
</div>

<form asp-controller="ReturnEdits" asp-action="Edit" method="post" enctype="multipart/form-data" class="card card-body shadow-sm" data-loading-form>
    <input asp-for="BookingId" type="hidden" />
    <input asp-for="ReturnedAt" type="hidden" id="returned-at-value" />

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger py-2">
            <strong>Chưa thể lưu biên bản.</strong>
            <div asp-validation-summary="All" class="mb-0 mt-1"></div>
        </div>
    }

    <h2 class="h5 mb-3">Thông tin trả xe</h2>
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label fw-semibold">Thời gian trả thực tế</label>
            <div class="form-control bg-light">@Model.ReturnedAt.ToString("dd/MM/yyyy HH:mm")</div>
            <div class="form-text">Thời gian này do server ghi khi nhận xe trả và không được chỉnh sửa.</div>
        </div>

        <div class="col-md-3">
            <label asp-for="Mileage" class="form-label fw-semibold">Số km khi trả</label>
            <input asp-for="Mileage" type="number" min="0" step="1" class="form-control" required />
            <span asp-validation-for="Mileage" class="text-danger small"></span>
        </div>

        <div class="col-md-3">
            <label asp-for="FuelLevel" class="form-label fw-semibold">Nhiên liệu</label>
            <div class="input-group">
                <input asp-for="FuelLevel" id="fuel-level" type="text" inputmode="numeric" maxlength="3" pattern="(?:100|[0-9]{1,2})" class="form-control" required />
                <span class="input-group-text">%</span>
            </div>
            <span asp-validation-for="FuelLevel" class="text-danger small"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="ExteriorCondition" class="form-label fw-semibold">Ngoại thất khi trả</label>
            <textarea asp-for="ExteriorCondition" class="form-control" rows="2" maxlength="1500"></textarea>
            <span asp-validation-for="ExteriorCondition" class="text-danger small"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="InteriorCondition" class="form-label fw-semibold">Nội thất khi trả</label>
            <textarea asp-for="InteriorCondition" class="form-control" rows="2" maxlength="1500"></textarea>
            <span asp-validation-for="InteriorCondition" class="text-danger small"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="AccessoryStatus" class="form-label fw-semibold">Phụ kiện khi trả</label>
            <select asp-for="AccessoryStatus" id="return-accessories-status" class="form-select" required>
                <option value="Đủ">Đủ như lúc giao</option>
                <option value="Thiếu">Thiếu / mất</option>
            </select>
            <span asp-validation-for="AccessoryStatus" class="text-danger small"></span>
        </div>

        <div class="col-md-6 d-flex align-items-end">
            <div class="form-check mb-2">
                <input asp-for="HasDamage" class="form-check-input" id="has-damage" />
                <label asp-for="HasDamage" class="form-check-label fw-semibold">Có hư hỏng mới</label>
            </div>
        </div>


        <div class="col-12 @(accessoryIsMissing ? string.Empty : "d-none")" id="missing-accessories-box">
            <label asp-for="MissingAccessories" class="form-label fw-semibold text-danger">Thiếu / mất phụ kiện nào?</label>
            <input asp-for="MissingAccessories" id="missing-accessories" class="form-control" maxlength="1000" placeholder="Ví dụ: thiếu 1 chìa khóa phụ, cáp sạc..." />
            <span asp-validation-for="MissingAccessories" class="text-danger small"></span>
        </div>

        <div class="col-12">
            <label asp-for="Notes" class="form-label fw-semibold">Ghi chú</label>
            <textarea asp-for="Notes" class="form-control" rows="3" maxlength="1500"></textarea>
            <span asp-validation-for="Notes" class="text-danger small"></span>
        </div>
    </div>

    <hr class="my-4" />
    <h2 class="h5 mb-2">Ảnh đối chiếu khi trả xe</h2>
    <p class="text-muted mb-3">7 ảnh vị trí bắt buộc được giữ nguyên. Chỉ ảnh bổ sung có thể xóa; nếu có hư hỏng phải giữ hoặc bổ sung ảnh hư hỏng.</p>
    <span asp-validation-for="ImagesToDelete" class="text-danger small d-block"></span>
    <span asp-validation-for="DamageImages" class="text-danger small d-block"></span>
    <span asp-validation-for="NewImages" class="text-danger small d-block"></span>
    <div id="delete-image-summary" class="alert alert-danger d-none py-2 mb-3">
        <strong>Đã chọn xóa ảnh.</strong>
        <span id="delete-image-summary-text">Ảnh chỉ bị xóa khỏi biên bản sau khi bấm “Lưu và quay lại đối chiếu”.</span>
    </div>

    @if (currentImages.Count == 0)
    {
        <div class="alert alert-warning mb-3">Biên bản hiện chưa có ảnh đối chiếu nào.</div>
    }
    else
    {
        <div class="row g-3 mb-3" id="existing-image-list" data-current-count="@currentImages.Count">
            @for (var index = 0; index < currentImages.Count; index++)
            {
                var imagePath = currentImages[index];
                var checkboxId = $"delete-return-image-{index}";
                var imageFileName = imagePath
                    .Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                    .LastOrDefault();
                var isDamageImage = !string.IsNullOrWhiteSpace(imageFileName) &&
                    imageFileName.StartsWith("damage-", StringComparison.OrdinalIgnoreCase);
                <div class="col-sm-6 col-lg-3 existing-image-card" data-is-damage="@(isDamageImage ? "true" : "false")">
                    <div class="border rounded-3 p-2 h-100 bg-light position-relative existing-image-box">
                        @if (IsRequiredEvidence(imagePath))
                        {
                            <span class="badge text-bg-primary position-absolute" style="top:-8px;right:-6px;z-index:2">Ảnh bắt buộc</span>
                        }
                        else
                        {
                            <button type="button" class="btn btn-danger btn-sm rounded-circle position-absolute d-flex align-items-center justify-content-center mark-delete-image" style="width:26px;height:26px;padding:0;top:-8px;right:-8px;z-index:2;line-height:1" title="Xóa ảnh này" aria-label="Xóa ảnh trả xe @(index + 1)">&times;</button>
                            <input class="delete-image-check d-none" type="checkbox" name="ImagesToDelete" value="@imagePath" id="@checkboxId" />
                        }
                        <a href="@imagePath" target="_blank" rel="noopener" class="existing-image-link">
                            <img src="@imagePath" alt="Ảnh trả xe @(index + 1)" class="img-fluid rounded border bg-white existing-image-thumb" style="height:150px;width:100%;object-fit:contain" />
                        </a>
                        <div class="small text-muted text-center mt-2 image-title">Ảnh @(index + 1)</div>
                        <div class="delete-image-note d-none mt-2 rounded-3 border border-danger bg-danger-subtle text-danger p-2">
                            <div class="fw-semibold">Đã chọn xóa ảnh này</div>
                            <div class="small">Ảnh sẽ bị xóa sau khi bấm “Lưu và quay lại đối chiếu”.</div>
                            <button type="button" class="btn btn-outline-danger btn-sm mt-2 undo-delete-image">Giữ lại ảnh</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div id="damage-image-box" class="border border-warning rounded p-3 bg-warning-subtle mb-3 @(Model.HasDamage ? string.Empty : "d-none")">
        <div class="d-flex justify-content-between align-items-end gap-2 flex-wrap mb-2">
            <div>
                <label asp-for="DamageImages" class="form-label fw-semibold mb-1">Ảnh hư hỏng bổ sung</label>
                <div class="small">Bắt buộc khi đánh dấu “Có hư hỏng mới” mà bộ ảnh giữ lại chưa còn ảnh hư hỏng.</div>
            </div>
            <span id="new-damage-image-count" class="badge text-bg-secondary">Chưa chọn ảnh</span>
        </div>
        <input asp-for="DamageImages" id="new-damage-images" type="file" class="form-control" multiple accept="@imageAccept"
               data-file-draft-key="return-edit-@Model.BookingId-damage-images" />
        <div class="form-text">JPG/PNG/WEBP · 5 MB/ảnh. Ảnh này được lưu riêng dưới nhóm chứng cứ hư hỏng.</div>
        <div id="new-damage-image-preview" class="d-flex flex-wrap gap-2 mt-3"></div>
    </div>

    <div class="border rounded p-3 bg-light">
        <div class="d-flex justify-content-between align-items-end gap-2 flex-wrap mb-2">
            <div>
                <label asp-for="NewImages" class="form-label fw-semibold mb-1">Thêm ảnh đối chiếu khác</label>
                <div class="text-muted small">Không bắt buộc nếu chỉ sửa thông tin.</div>
            </div>
            <span id="new-return-image-count" class="badge text-bg-secondary">Chưa chọn ảnh</span>
        </div>
        <input asp-for="NewImages" id="new-return-images" type="file" class="form-control" multiple accept="@imageAccept"
               data-file-draft-key="return-edit-@Model.BookingId-new-images" />
        <div class="form-text">JPG/PNG/WEBP · tổng cộng tối đa 25 ảnh · 5 MB/ảnh.</div>
        <div id="new-return-image-preview" class="d-flex flex-wrap gap-2 mt-3"></div>
    </div>

    <div class="alert alert-info mt-4 mb-0"><strong>Lưu ý:</strong> Ảnh không được đánh dấu xóa sẽ được giữ nguyên. Sau khi lưu, hệ thống quay lại màn đối chiếu để kiểm tra trước khi in và ký.</div>
    <div class="mt-4 d-flex gap-2 flex-wrap">
        <button class="btn btn-primary" type="submit">Lưu và quay lại đối chiếu</button>
        <a class="btn btn-outline-secondary" asp-controller="Returns" asp-action="Inspect" asp-route-bookingId="@Model.BookingId">Hủy</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const form = document.querySelector('form');
            const hidden = document.getElementById('returned-at-value');
            const date = document.getElementById('return-date');
            const time = document.getElementById('return-time');
            const fuel = document.getElementById('fuel-level');
            const accessoryStatus = document.getElementById('return-accessories-status');
            const missingBox = document.getElementById('missing-accessories-box');
            const missingInput = document.getElementById('missing-accessories');
            const hasDamage = document.getElementById('has-damage');

            const damageBox = document.getElementById('damage-image-box');
            const damageInput = document.getElementById('new-damage-images');
            const damagePreview = document.getElementById('new-damage-image-preview');
            const damageCount = document.getElementById('new-damage-image-count');
            const damageValidation = form?.querySelector('[data-valmsg-for="DamageImages"]');

            const imageInput = document.getElementById('new-return-images');
            const imagePreview = document.getElementById('new-return-image-preview');
            const imageCount = document.getElementById('new-return-image-count');
            const imageValidation = form?.querySelector('[data-valmsg-for="NewImages"]');

            const existingList = document.getElementById('existing-image-list');
            const deleteSummary = document.getElementById('delete-image-summary');
            const deleteSummaryText = document.getElementById('delete-image-summary-text');

            const minimumImages = 7;
            const maximumImages = 25;
            const maximumImageBytes = 5 * 1024 * 1024;
            const allowedImageExtensions = ['.jpg', '.jpeg', '.png', '.webp'];
            const allowedImageTypes = ['image/jpeg', 'image/png', 'image/webp'];

            let selectedDamageFiles = Array.from(damageInput?.files || []);
            let selectedImageFiles = Array.from(imageInput?.files || []);
            let damagePreviewUrls = [];
            let imagePreviewUrls = [];

            function syncDateTime() {
                if (!date?.value || !/^(?:[01]\d|2[0-3]):[0-5]\d$/.test(time?.value || '')) {
                    return false;
                }
                hidden.value = `${date.value}T${time.value}`;
                return true;
            }

            function selectedDeleteCount() {
                return document.querySelectorAll('.delete-image-check:checked').length;
            }

            function currentImageCountAfterDelete() {
                const currentCount = Number(existingList?.dataset.currentCount || 0);
                return Math.max(0, currentCount - selectedDeleteCount());
            }

            function currentDamageCountAfterDelete() {
                return Array.from(document.querySelectorAll('.existing-image-card[data-is-damage="true"]'))
                    .filter(card => !card.querySelector('.delete-image-check')?.checked)
                    .length;
            }

            function updateDeleteSummary() {
                const count = selectedDeleteCount();
                if (!deleteSummary || !deleteSummaryText) return;
                if (count > 0) {
                    deleteSummary.classList.remove('d-none');
                    deleteSummaryText.textContent =
                        `Đã chọn xóa ${count} ảnh. Ảnh chỉ bị xóa khỏi biên bản sau khi bấm “Lưu và quay lại đối chiếu”.`;
                } else {
                    deleteSummary.classList.add('d-none');
                }
            }

            function setValidationMessage(element, message, showInline) {
                if (!element) return;
                if (showInline && message) {
                    element.textContent = message;
                    element.classList.remove('field-validation-valid');
                    element.classList.add('field-validation-error');
                } else if (!message) {
                    element.textContent = '';
                    element.classList.remove('field-validation-error');
                    element.classList.add('field-validation-valid');
                }
            }

            function fileValidationMessage(files) {
                const oversized = files.find(file => file.size > maximumImageBytes);
                if (oversized) return `Ảnh "${oversized.name}" vượt quá 5 MB.`;

                const invalid = files.find(file => {
                    const lower = file.name.toLowerCase();
                    const extensionValid = allowedImageExtensions.some(ext => lower.endsWith(ext));
                    const typeValid = !file.type || allowedImageTypes.includes(file.type.toLowerCase());
                    return !extensionValid || !typeValid;
                });
                return invalid
                    ? `Ảnh "${invalid.name}" không đúng định dạng. Chỉ chấp nhận JPG, PNG hoặc WEBP.`
                    : '';
            }

            function validateImages(showInline = false) {
                const allNewFiles = [...selectedDamageFiles, ...selectedImageFiles];
                const total = currentImageCountAfterDelete() + allNewFiles.length;

                let commonMessage = '';
                if (total < minimumImages) {
                    commonMessage = `Biên bản trả xe phải giữ tối thiểu ${minimumImages} ảnh đối chiếu.`;
                } else if (total > maximumImages) {
                    commonMessage = `Biên bản chỉ được lưu tối đa ${maximumImages} ảnh đối chiếu.`;
                } else {
                    commonMessage = fileValidationMessage(allNewFiles);
                }

                let damageMessage = '';
                if (hasDamage?.checked &&
                    currentDamageCountAfterDelete() + selectedDamageFiles.length === 0) {
                    damageMessage =
                        'Đã đánh dấu hư hỏng thì bộ ảnh cuối cùng phải có ít nhất một ảnh hư hỏng.';
                }

                imageInput?.setCustomValidity(commonMessage);
                damageInput?.setCustomValidity(damageMessage || commonMessage);
                setValidationMessage(imageValidation, commonMessage, showInline);
                setValidationMessage(damageValidation, damageMessage, showInline);

                return !commonMessage && !damageMessage;
            }

            function syncInputFiles(input, files) {
                if (!input) return;
                const transfer = new DataTransfer();
                files.forEach(file => transfer.items.add(file));
                input.files = transfer.files;
            }

            function clearPreviewUrls(urls) {
                urls.forEach(url => URL.revokeObjectURL(url));
                urls.length = 0;
            }

            function renderPreview(files, preview, count, urls, removeFile) {
                if (!preview || !count) return;
                clearPreviewUrls(urls);
                preview.innerHTML = '';
                count.textContent = files.length > 0 ? `Đã chọn ${files.length} ảnh` : 'Chưa chọn ảnh';
                count.className = `badge ${files.length > 0 ? 'text-bg-success' : 'text-bg-secondary'}`;

                files.forEach((file, index) => {
                    const url = URL.createObjectURL(file);
                    urls.push(url);

                    const wrapper = document.createElement('div');
                    wrapper.className = 'border rounded bg-white p-1 position-relative';
                    wrapper.style.width = '116px';

                    const removeButton = document.createElement('button');
                    removeButton.type = 'button';
                    removeButton.className =
                        'btn btn-danger btn-sm rounded-circle position-absolute d-flex align-items-center justify-content-center';
                    removeButton.style.width = '24px';
                    removeButton.style.height = '24px';
                    removeButton.style.padding = '0';
                    removeButton.style.top = '-7px';
                    removeButton.style.right = '-7px';
                    removeButton.style.zIndex = '2';
                    removeButton.style.lineHeight = '1';
                    removeButton.innerHTML = '&times;';
                    removeButton.title = 'Xóa ảnh này';
                    removeButton.addEventListener('click', () => removeFile(index));

                    const image = document.createElement('img');
                    image.src = url;
                    image.alt = file.name;
                    image.className = 'rounded border bg-light';
                    image.style.width = '106px';
                    image.style.height = '82px';
                    image.style.objectFit='contain';

                    const caption = document.createElement('div');
                    caption.className = 'small text-muted text-truncate mt-1';
                    caption.title = file.name;
                    caption.textContent = file.name;

                    wrapper.append(removeButton, image, caption);
                    preview.appendChild(wrapper);
                });
            }

            function renderDamagePreview() {
                renderPreview(
                    selectedDamageFiles,
                    damagePreview,
                    damageCount,
                    damagePreviewUrls,
                    index => {
                        selectedDamageFiles.splice(index, 1);
                        syncInputFiles(damageInput, selectedDamageFiles);
                        renderDamagePreview();
                        validateImages(true);
                    });
            }

            function renderImagePreview() {
                renderPreview(
                    selectedImageFiles,
                    imagePreview,
                    imageCount,
                    imagePreviewUrls,
                    index => {
                        selectedImageFiles.splice(index, 1);
                        syncInputFiles(imageInput, selectedImageFiles);
                        renderImagePreview();
                        validateImages(true);
                    });
            }

            function syncAccessories() {
                if (accessoryStatus?.value === 'Thiếu') {
                    missingBox?.classList.remove('d-none');
                    missingInput?.setAttribute('required', 'required');
                } else {
                    missingBox?.classList.add('d-none');
                    missingInput?.removeAttribute('required');
                    if (missingInput) missingInput.value = '';
                }
            }

            function syncDamageBox() {
                if (hasDamage?.checked) {
                    damageBox?.classList.remove('d-none');
                } else {
                    damageBox?.classList.add('d-none');
                    selectedDamageFiles = [];
                    syncInputFiles(damageInput, selectedDamageFiles);
                    renderDamagePreview();
                }
                validateImages(true);
            }

            document.querySelectorAll('.mark-delete-image').forEach(button =>
                button.addEventListener('click', () => {
                    const card = button.closest('.existing-image-card');
                    const box = card?.querySelector('.existing-image-box');
                    const check = card?.querySelector('.delete-image-check');
                    const note = card?.querySelector('.delete-image-note');
                    const img = card?.querySelector('.existing-image-thumb');
                    const link = card?.querySelector('.existing-image-link');
                    const title = card?.querySelector('.image-title');

                    if (check) check.checked = true;
                    note?.classList.remove('d-none');
                    if (box) {
                        box.classList.remove('bg-light');
                        box.classList.add('border-danger', 'bg-danger-subtle', 'shadow-sm');
                    }
                    if (img) {
                        img.classList.add('opacity-50');
                        img.style.filter = 'grayscale(1)';
                    }
                    link?.classList.add('pe-none');
                    if (title) {
                        title.textContent = 'Ảnh đã chọn xóa';
                        title.classList.remove('text-muted');
                        title.classList.add('text-danger', 'fw-semibold');
                    }
                    button.classList.add('d-none');
                    updateDeleteSummary();
                    validateImages(true);
                }));

            document.querySelectorAll('.undo-delete-image').forEach(button =>
                button.addEventListener('click', () => {
                    const card = button.closest('.existing-image-card');
                    const box = card?.querySelector('.existing-image-box');
                    const check = card?.querySelector('.delete-image-check');
                    const note = card?.querySelector('.delete-image-note');
                    const img = card?.querySelector('.existing-image-thumb');
                    const link = card?.querySelector('.existing-image-link');
                    const title = card?.querySelector('.image-title');
                    const deleteButton = card?.querySelector('.mark-delete-image');

                    if (check) check.checked = false;
                    note?.classList.add('d-none');
                    if (box) {
                        box.classList.add('bg-light');
                        box.classList.remove('border-danger', 'bg-danger-subtle', 'shadow-sm');
                    }
                    if (img) {
                        img.classList.remove('opacity-50');
                        img.style.filter = '';
                    }
                    link?.classList.remove('pe-none');
                    if (title) {
                        const index = Array.from(document.querySelectorAll('.existing-image-card')).indexOf(card);
                        title.textContent = `Ảnh ${index + 1}`;
                        title.classList.add('text-muted');
                        title.classList.remove('text-danger', 'fw-semibold');
                    }
                    deleteButton?.classList.remove('d-none');
                    updateDeleteSummary();
                    validateImages(true);
                }));

            fuel?.addEventListener('input', () => {
                fuel.value = fuel.value.replace(/[^0-9]/g, '').slice(0, 3);
                if (Number(fuel.value) > 100) fuel.value = '100';
            });

            damageInput?.addEventListener('change', () => {
                selectedDamageFiles = Array.from(damageInput.files || []);
                renderDamagePreview();
                validateImages(true);
            });

            imageInput?.addEventListener('change', () => {
                selectedImageFiles = Array.from(imageInput.files || []);
                renderImagePreview();
                validateImages(true);
            });

            hasDamage?.addEventListener('change', syncDamageBox);
            accessoryStatus?.addEventListener('change', syncAccessories);

            form?.addEventListener('submit', event => {
                let valid = true;

                if (!syncDateTime()) {
                    time?.setCustomValidity('Giờ phải theo định dạng HH:mm, ví dụ 14:30.');
                    time?.reportValidity();
                    valid = false;
                }

                if (!validateImages(true)) {
                    if (damageInput?.validationMessage) {
                        damageInput.reportValidity();
                    } else {
                        imageInput?.reportValidity();
                    }
                    valid = false;
                }

                if (!valid) event.preventDefault();
            });

            date?.addEventListener('change', syncDateTime);
            time?.addEventListener('input', () => {
                time.setCustomValidity('');
                syncDateTime();
            });

            syncAccessories();
            renderDamagePreview();
            renderImagePreview();
            updateDeleteSummary();
            syncDateTime();
            if (hasDamage?.checked) damageBox?.classList.remove('d-none');
            validateImages(false);
        })();
    </script>
}
 
