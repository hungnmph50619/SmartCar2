@model IReadOnlyList<SmartCar.Application.Features.Vehicles.VehicleDto>
@using SmartCar.Domain.Enums
@{
    ViewData["Title"] = "Quản lý xe";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Quản lý xe</h1>
        <p class="text-muted mb-0">Theo dõi toàn bộ đội xe SmartCar.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Thêm xe</a>
</div>

<div class="table-responsive">
<table class="table table-bordered align-middle">
    <thead>
        <tr>
            <th>Xe</th>
            <th>Biển số</th>
            <th>Giá/ngày</th>
            <th>Số km</th>
            <th>Trạng thái</th>
            <th class="text-end">Thao tác</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var vehicle in Model)
    {
        <tr>
            <td>
                <div class="d-flex align-items-center gap-2">
                    @if (!string.IsNullOrWhiteSpace(vehicle.PrimaryImagePath))
                    {
                        <img src="@vehicle.PrimaryImagePath" alt="@vehicle.VehicleName" style="width:72px;height:48px;object-fit:cover" class="rounded" />
                    }
                    <div><strong>@vehicle.VehicleName</strong><br /><small>@vehicle.BrandName - @vehicle.Seats chỗ</small></div>
                </div>
            </td>
            <td>@vehicle.LicensePlate</td>
            <td>@vehicle.DailyPrice.ToString("N0") đ</td>
            <td>@vehicle.CurrentMileage.ToString("N0") km</td>
            <td><span class="badge bg-secondary">@vehicle.Status</span></td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@vehicle.VehicleId">Sửa/Ảnh</a>
                @if (vehicle.Status != VehicleStatus.Rented)
                {
                    <form class="d-inline" asp-action="ChangeStatus" method="post">
                        <input type="hidden" name="id" value="@vehicle.VehicleId" />
                        <input type="hidden" name="status" value="@(vehicle.Status == VehicleStatus.Inactive ? VehicleStatus.Available : VehicleStatus.Inactive)" />
                        <button class="btn btn-sm @(vehicle.Status == VehicleStatus.Inactive ? "btn-outline-success" : "btn-outline-danger")" type="submit">
                            @(vehicle.Status == VehicleStatus.Inactive ? "Mở lại" : "Ngừng thuê")
                        </button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
