@model IReadOnlyList<SmartCar.Application.Features.Brands.BrandDto>
@{
    ViewData["Title"] = "Quản lý hãng xe";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Quản lý hãng xe</h1>
        <p class="text-muted mb-0">Thêm, sửa hoặc ngừng sử dụng hãng xe.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Thêm hãng xe</a>
</div>

<table class="table table-bordered align-middle">
    <thead>
        <tr>
            <th>Tên hãng</th>
            <th>Số xe</th>
            <th>Trạng thái</th>
            <th class="text-end">Thao tác</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var brand in Model)
    {
        <tr>
            <td>@brand.BrandName</td>
            <td>@brand.VehicleCount</td>
            <td>
                <span class="badge @(brand.IsActive ? "bg-success" : "bg-secondary")">
                    @(brand.IsActive ? "Đang dùng" : "Đã ngừng")
                </span>
            </td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@brand.BrandId">Sửa</a>
                <form class="d-inline" asp-action="SetActive" method="post">
                    <input type="hidden" name="id" value="@brand.BrandId" />
                    <input type="hidden" name="isActive" value="@(!brand.IsActive)" />
                    <button class="btn btn-sm @(brand.IsActive ? "btn-outline-danger" : "btn-outline-success")" type="submit">
                        @(brand.IsActive ? "Ngừng dùng" : "Kích hoạt")
                    </button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
