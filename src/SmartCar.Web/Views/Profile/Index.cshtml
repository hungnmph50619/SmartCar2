@model SmartCar.Web.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    var avatarInitial = Model.FullName.Trim().FirstOrDefault().ToString().ToUpperInvariant();
}

<div class="profile-shell py-3">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <span class="section-eyebrow">TÀI KHOẢN SMARTCAR</span>
            <h1 class="h2 fw-bold mb-1">Hồ sơ cá nhân</h1>
            <p class="text-muted mb-0">Thông tin đang được sử dụng cho các đơn thuê xe của bạn.</p>
        </div>
        @if (User.IsInRole(RoleNames.Customer))
        {
            <a asp-controller="Bookings" asp-action="MyBookings" class="btn btn-outline-primary">
                Xem đơn thuê của tôi
            </a>
        }
    </div>

    <section class="profile-card">
        <div class="profile-header">
            <div class="profile-avatar" aria-hidden="true">@avatarInitial</div>
            <div>
                <h2 class="h4 fw-bold mb-1">@Model.FullName</h2>
                <p class="text-muted mb-0">@Model.Email</p>
            </div>
        </div>

        <div class="profile-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="profile-detail">
                        <span>Họ và tên</span>
                        <strong>@Model.FullName</strong>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="profile-detail">
                        <span>Email</span>
                        <strong>@Model.Email</strong>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="profile-detail">
                        <span>Số điện thoại</span>
                        <strong>@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "Chưa cập nhật" : Model.PhoneNumber)</strong>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="profile-detail">
                        <span>Ngày tạo tài khoản</span>
                        <strong>@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</strong>
                    </div>
                </div>
                <div class="col-12">
                    <div class="profile-detail">
                        <span>Địa chỉ</span>
                        <strong>@(string.IsNullOrWhiteSpace(Model.Address) ? "Chưa cập nhật" : Model.Address)</strong>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
