@model SmartCar.Web.ViewModels.ProfileViewModel
@using System.Security.Claims
@using SmartCar.Web.Services
@inject IUserBankAccountService BankAccountService
@{
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
    var bankAccount = string.IsNullOrWhiteSpace(userId)
        ? null
        : await BankAccountService.GetDefaultAsync(userId);

    var returnVehicleId = ViewBag.ReturnVehicleId is int vehicleId ? vehicleId : (int?)null;
    var returnPickupDate = ViewBag.ReturnPickupDate is DateTime pickup ? pickup : (DateTime?)null;
    var returnDate = ViewBag.ReturnDate is DateTime returnAt ? returnAt : (DateTime?)null;
    var returnVehicleName = ViewBag.ReturnVehicleName as string;
    var hasReturnContext = returnVehicleId.HasValue && returnPickupDate.HasValue && returnDate.HasValue;
}

@if (hasReturnContext)
{
    @if (bankAccount is null)
    {
        <div class="alert alert-warning shadow-sm mb-4">
            <strong>🏦 Cần tài khoản ngân hàng trước khi đặt xe.</strong>
            <div class="mt-1">Hãy lưu tài khoản nhận tiền bên dưới. SmartCar sử dụng thông tin này để hoàn tiền, hoàn cọc hoặc chuyển trả các khoản phát sinh khi cần.</div>
        </div>
    }
    else
    {
        <div class="alert alert-success shadow-sm mb-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <strong>✓ Đã có tài khoản nhận hoàn tiền.</strong>
                <div class="small mt-1">Bạn có thể quay lại xe đã chọn và tiếp tục gửi yêu cầu thuê.</div>
            </div>
            <a class="btn btn-success flex-shrink-0"
               asp-controller="Vehicles"
               asp-action="Details"
               asp-route-id="@returnVehicleId"
               asp-route-pickupDate="@returnPickupDate?.ToString("O")"
               asp-route-returnDate="@returnDate?.ToString("O")">
                @(string.IsNullOrWhiteSpace(returnVehicleName) ? "Tiếp tục đặt xe" : $"Tiếp tục đặt {returnVehicleName}")
            </a>
        </div>
    }
}

<div class="row g-4 align-items-start">
    <div class="col-lg-4">
        <section class="profile-card">
            <div class="profile-header flex-column align-items-start">
                <div class="security-icon" aria-hidden="true">🏦</div>
                <div>
                    <h2 class="h4 fw-bold mb-1">Tài khoản nhận tiền</h2>
                    <p class="text-muted mb-0">Dùng làm tài khoản mặc định để SmartCar hoàn tiền cho khách hàng.</p>
                </div>
            </div>
            <div class="profile-body">
                @if (bankAccount is null)
                {
                    <div class="alert alert-light border mb-3">
                        Bạn chưa lưu tài khoản ngân hàng.
                    </div>
                }
                else
                {
                    <div class="profile-detail">
                        <span>Ngân hàng</span>
                        <strong>@bankAccount.BankName</strong>
                    </div>
                    <div class="profile-detail mt-2">
                        <span>Số tài khoản</span>
                        <strong>@bankAccount.MaskedAccountNumber</strong>
                    </div>
                    <div class="profile-detail mt-2">
                        <span>Chủ tài khoản</span>
                        <strong>@bankAccount.AccountHolderName</strong>
                    </div>
                }
            </div>
        </section>

        <div class="alert alert-info small mt-3 mb-0">
            <strong>Lưu ý:</strong> thông tin này phục vụ nhận hoàn tiền, hoàn cọc hoặc các khoản SmartCar cần chuyển trả. Việc lưu số tài khoản <strong>không cho phép SmartCar tự động trừ tiền</strong> từ tài khoản của bạn khi có vi phạm hoặc chi phí phát sinh.
        </div>
    </div>

    <div class="col-lg-8">
        <form asp-controller="ProfileSettings"
              asp-action="SaveBankAccount"
              method="post"
              class="card card-body shadow-sm border-0 profile-form-card"
              data-loading-form>
            @if (hasReturnContext)
            {
                <input type="hidden" name="returnVehicleId" value="@returnVehicleId" />
                <input type="hidden" name="pickupDate" value="@returnPickupDate?.ToString("O")" />
                <input type="hidden" name="returnDate" value="@returnDate?.ToString("O")" />
            }

            <div class="mb-4">
                <h2 class="h5 mb-1">@(bankAccount is null ? "Thêm tài khoản ngân hàng" : "Cập nhật tài khoản ngân hàng")</h2>
                <p class="text-muted mb-0">Cập nhật chính xác thông tin tài khoản dùng để nhận tiền hoàn từ SmartCar.</p>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold" for="bankCode">Ngân hàng</label>
                    <select class="form-select" id="bankCode" name="BankCode" required>
                        <option value="">-- Chọn ngân hàng --</option>
                        @foreach (var bank in BankAccountService.Banks)
                        {
                            if (bankAccount?.BankCode == bank.Code)
                            {
                                <option value="@bank.Code" selected>@bank.Name</option>
                            }
                            else
                            {
                                <option value="@bank.Code">@bank.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold" for="bankAccountNumber">Số tài khoản</label>
                    <input class="form-control"
                           id="bankAccountNumber"
                           name="AccountNumber"
                           value="@bankAccount?.AccountNumber"
                           inputmode="numeric"
                           autocomplete="off"
                           minlength="6"
                           maxlength="20"
                           pattern="[0-9]{6,20}"
                           title="Số tài khoản phải gồm từ 6 đến 20 chữ số."
                           placeholder="Ví dụ: 0123456789"
                           required />
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold" for="bankHolderName">Chủ tài khoản</label>
                    <input class="form-control text-uppercase"
                           id="bankHolderName"
                           name="AccountHolderName"
                           value="@bankAccount?.AccountHolderName"
                           maxlength="150"
                           autocomplete="name"
                           pattern="[\p{L}]+(?:[ ]+[\p{L}]+)*"
                           title="Tên chủ tài khoản chỉ được chứa chữ cái và khoảng trắng."
                           placeholder="NGUYEN MANH HUNG"
                           required />
                    <div class="form-text">Chỉ nhập chữ cái và khoảng trắng; có thể nhập tên có dấu hoặc không dấu.</div>
                </div>
            </div>

            <div class="alert alert-warning small mt-4 mb-0">
                <strong>Lưu ý:</strong> Vui lòng kiểm tra chính xác thông tin tài khoản. SmartCar sẽ hoàn tiền vào tài khoản đã đăng ký.
            </div>

            <div class="mt-4 d-flex justify-content-end">
                <button class="btn btn-primary" type="submit" data-loading-text="Đang lưu tài khoản...">
                    @(bankAccount is null ? "Lưu tài khoản" : "Lưu thay đổi")
                </button>
            </div>
        </form>
    </div>
</div>
