@model SmartCar.Web.ViewModels.ProfileViewModel
@using SmartCar.Domain.Constants
@using SmartCar.Domain.Enums
@{
    static string MaskNumber(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "Chưa có";
        var trimmed = value.Trim();
        return trimmed.Length <= 4
            ? new string('*', trimmed.Length)
            : new string('*', trimmed.Length - 4) + trimmed[^4..];
    }

    static string StatusBadge(string status) => status switch
    {
        "Đã duyệt" => "bg-success",
        "Chờ duyệt" => "bg-warning text-dark",
        "Cần gửi lại" => "bg-danger",
        _ => "bg-secondary"
    };

    var citizenFront = Model.Documents.FirstOrDefault(item => item.DocumentType == DocumentTypes.CitizenId);
    var citizenBack = Model.Documents.FirstOrDefault(item => item.DocumentType == DocumentTypes.CitizenIdBack);
    var drivingLicense = Model.Documents.FirstOrDefault(item => item.DocumentType == DocumentTypes.DrivingLicense);
    var drivingLicenseBack = Model.Documents.FirstOrDefault(item => item.DocumentType == DocumentTypes.DrivingLicenseBack);

    var returnVehicleId = ViewBag.ReturnVehicleId is int vehicleId ? vehicleId : (int?)null;
    var returnPickupDate = ViewBag.ReturnPickupDate is DateTime pickup ? pickup : (DateTime?)null;
    var returnDate = ViewBag.ReturnDate is DateTime returnAt ? returnAt : (DateTime?)null;
    var returnVehicleName = ViewBag.ReturnVehicleName as string;
    var hasReturnContext = returnVehicleId.HasValue && returnPickupDate.HasValue && returnDate.HasValue;
    var returnPickupRoute = returnPickupDate?.ToString("O");
    var returnDateRoute = returnDate?.ToString("O");
    var requiredValidThrough = returnDate?.Date ?? DateTime.Today;

    var citizenVerifiedByAdmin = citizenFront is not null && citizenBack is not null &&
                                 citizenFront.Status == DocumentStatus.Verified &&
                                 citizenBack.Status == DocumentStatus.Verified &&
                                 citizenFront.HasRequiredData && citizenBack.HasRequiredData;
    var citizenVerified = citizenVerifiedByAdmin &&
                          citizenFront!.ExpiryDate.HasValue &&
                          citizenFront.ExpiryDate.Value.Date >= requiredValidThrough;
    var citizenPending = citizenFront?.Status == DocumentStatus.Pending || citizenBack?.Status == DocumentStatus.Pending;
    var citizenRejected = citizenFront?.Status == DocumentStatus.Rejected || citizenBack?.Status == DocumentStatus.Rejected;

    var licenseVerifiedByAdmin = drivingLicense is not null && drivingLicenseBack is not null &&
                                 drivingLicense.Status == DocumentStatus.Verified &&
                                 drivingLicenseBack.Status == DocumentStatus.Verified &&
                                 drivingLicense.HasRequiredData && drivingLicenseBack.HasRequiredData;
    var licenseVerified = licenseVerifiedByAdmin &&
                          drivingLicense!.ExpiryDate.HasValue &&
                          drivingLicense.ExpiryDate.Value.Date >= requiredValidThrough;
    var licensePending = drivingLicense?.Status == DocumentStatus.Pending || drivingLicenseBack?.Status == DocumentStatus.Pending;
    var licenseRejected = drivingLicense?.Status == DocumentStatus.Rejected || drivingLicenseBack?.Status == DocumentStatus.Rejected;

    var citizenStatus = citizenVerified ? "Đã duyệt" : citizenRejected ? "Cần gửi lại" : citizenPending ? "Chờ duyệt" : "Chưa gửi";
    var licenseStatus = licenseVerified ? "Đã duyệt" : licenseRejected ? "Cần gửi lại" : licensePending ? "Chờ duyệt" : "Chưa gửi";
    var verifiedSteps = (citizenVerified ? 1 : 0) + (licenseVerified ? 1 : 0);
    var isFullyVerified = verifiedSteps == 2;
    var bothPending = citizenPending && licensePending;
}

<div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
    <div>
        <h2 class="h4 mb-1">Hồ sơ CCCD & giấy phép lái xe</h2>
        <p class="text-muted mb-0">Bạn tự nhập thông tin và tải ảnh. Quản trị viên sẽ xem CCCD và GPLX rồi duyệt hồ sơ.</p>
    </div>
    @if (hasReturnContext)
    {
        <a class="btn @(isFullyVerified ? "btn-primary" : "btn-outline-primary")"
           asp-controller="Vehicles"
           asp-action="Details"
           asp-route-id="@returnVehicleId"
           asp-route-pickupDate="@returnPickupRoute"
           asp-route-returnDate="@returnDateRoute">
            @(isFullyVerified && !string.IsNullOrWhiteSpace(returnVehicleName)
                ? $"Quay lại {returnVehicleName}"
                : "Quay lại xe đang chọn")
        </a>
    }
    else
    {
        <a class="btn btn-outline-primary" asp-controller="Vehicles" asp-action="Index">Tiếp tục tìm xe</a>
    }
</div>

<div class="alert alert-info border-info shadow-sm" role="alert">
    <strong>Quy trình đơn giản:</strong> 1) Nhập CCCD và tải 2 ảnh; 2) Nhập GPLX và tải 2 ảnh; 3) Quản trị viên xem cả hai loại giấy tờ và duyệt một lần.
    <div class="small mt-1">SmartCar không tự đọc QR, MRZ, OCR hay nhận diện khuôn mặt. Ảnh chỉ được kiểm tra định dạng và dung lượng trước khi lưu.</div>
</div>

@if (!isFullyVerified)
{
    <div class="alert @(bothPending ? "alert-warning" : "alert-light border") shadow-sm" role="alert">
        @if (bothPending)
        {
            <strong>Hồ sơ đã đủ và đang chờ Quản trị viên duyệt.</strong>
            <span>Bạn không cần gửi thêm thông tin.</span>
        }
        else
        {
            <strong>Bạn chưa đủ điều kiện gửi yêu cầu thuê xe.</strong>
            <span>Hãy gửi đủ CCCD và GPLX, sau đó chờ Quản trị viên duyệt.</span>
        }
        @if (hasReturnContext)
        {
            <div class="small mt-1">Giấy tờ cần còn hiệu lực ít nhất đến ngày trả xe <strong>@requiredValidThrough.ToString("dd/MM/yyyy")</strong>.</div>
        }
    </div>
}
else if (hasReturnContext)
{
    <div class="alert alert-success border-success shadow-sm" role="alert">
        <strong>✓ Hồ sơ giấy tờ đã được duyệt.</strong> Bạn có thể quay lại xe đang chọn và tiếp tục đặt xe.
    </div>
}

<div class="card card-body shadow-sm border-0 mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
        <div>
            <div class="text-uppercase small text-muted fw-semibold">Trạng thái hồ sơ</div>
            <h3 class="h5 mb-0">@verifiedSteps/2 loại giấy tờ đã được duyệt</h3>
        </div>
        <span class="badge @(isFullyVerified ? "bg-success" : "bg-warning text-dark") px-3 py-2">
            @(isFullyVerified ? "Đủ điều kiện thuê xe" : bothPending ? "Đang chờ duyệt" : "Chưa hoàn tất")
        </span>
    </div>
    <div class="row g-3">
        <div class="col-md-6">
            <div class="border rounded-3 p-3 h-100">
                <div class="small text-muted">Phần 1</div>
                <div class="fw-bold">Căn cước công dân</div>
                <span class="badge @StatusBadge(citizenStatus) mt-2">@citizenStatus</span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="border rounded-3 p-3 h-100">
                <div class="small text-muted">Phần 2</div>
                <div class="fw-bold">Giấy phép lái xe</div>
                <span class="badge @StatusBadge(licenseStatus) mt-2">@licenseStatus</span>
            </div>
        </div>
    </div>
</div>

<div class="alert alert-light border mb-4" role="note">
    <strong>Ảnh cần tải:</strong> CCCD mặt trước + mặt sau, GPLX mặt trước + mặt sau. Chọn ảnh nhìn rõ thông tin để Quản trị viên đối chiếu. Hỗ trợ JPG, PNG, WEBP; tối đa <strong>5 MB/ảnh</strong>.
</div>

<section class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white border-0 px-4 pt-4 pb-2">
        <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
            <div>
                <div class="text-uppercase small text-primary fw-semibold">Phần 1</div>
                <h3 class="h4 fw-bold mb-1">Căn cước công dân</h3>
                <p class="text-muted mb-0">Nhập thông tin đúng như trên CCCD và tải ảnh hai mặt.</p>
            </div>
            <span class="badge @StatusBadge(citizenStatus) px-3 py-2">@citizenStatus</span>
        </div>
    </div>
    <div class="card-body p-4">
        @if (citizenRejected)
        {
            <div class="alert alert-danger"><strong>CCCD cần gửi lại.</strong> @(citizenFront?.RejectionReason ?? citizenBack?.RejectionReason)</div>
        }
        else if (citizenPending)
        {
            <div class="alert alert-warning mb-0">
                <strong>CCCD đã được gửi.</strong> Hãy gửi GPLX nếu chưa gửi. Quản trị viên sẽ duyệt cả hồ sơ khi đủ hai phần.
            </div>
        }
        else if (citizenVerified)
        {
            <div class="alert alert-success mb-0">
                <strong>✓ CCCD đã được duyệt.</strong>
                <span class="ms-1">Số: @MaskNumber(citizenFront?.DocumentNumber) · Họ tên: @(citizenFront?.FullNameOnDocument ?? "-") · Hết hạn: @(citizenFront?.ExpiryDate?.ToString("dd/MM/yyyy") ?? "-")</span>
            </div>
        }
        else
        {
            @if (citizenVerifiedByAdmin && !citizenVerified)
            {
                <div class="alert alert-danger">CCCD cũ không còn hiệu lực đến ngày cần thuê. Vui lòng gửi CCCD còn hiệu lực.</div>
            }

            <form asp-action="SubmitCitizenId" method="post" enctype="multipart/form-data" data-loading-form>
                @if (hasReturnContext)
                {
                    <input type="hidden" name="returnVehicleId" value="@returnVehicleId" />
                    <input type="hidden" name="pickupDate" value="@returnPickupRoute" />
                    <input type="hidden" name="returnDate" value="@returnDateRoute" />
                }

                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                <div class="row g-3">
                    <div class="col-md-7">
                        <label asp-for="CitizenIdVerification.FullNameOnDocument" class="form-label fw-semibold"></label>
                        <input asp-for="CitizenIdVerification.FullNameOnDocument" class="form-control" autocomplete="name" />
                        <span asp-validation-for="CitizenIdVerification.FullNameOnDocument" class="text-danger small"></span>
                    </div>
                    <div class="col-md-5">
                        <label asp-for="CitizenIdVerification.DocumentNumber" class="form-label fw-semibold"></label>
                        <input asp-for="CitizenIdVerification.DocumentNumber" class="form-control" inputmode="numeric" maxlength="12" autocomplete="off" />
                        <span asp-validation-for="CitizenIdVerification.DocumentNumber" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="CitizenIdVerification.DateOfBirth" class="form-label fw-semibold"></label>
                        <input asp-for="CitizenIdVerification.DateOfBirth" class="form-control" type="date" max="@DateTime.Today.AddYears(-18).ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="CitizenIdVerification.DateOfBirth" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="CitizenIdVerification.Gender" class="form-label fw-semibold"></label>
                        <select asp-for="CitizenIdVerification.Gender" class="form-select">
                            <option value="">-- Chọn giới tính --</option>
                            <option value="Nam">Nam</option>
                            <option value="Nữ">Nữ</option>
                            <option value="Khác">Khác</option>
                        </select>
                        <span asp-validation-for="CitizenIdVerification.Gender" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="CitizenIdVerification.IssuedDate" class="form-label fw-semibold"></label>
                        <input asp-for="CitizenIdVerification.IssuedDate" class="form-control" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="CitizenIdVerification.IssuedDate" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="CitizenIdVerification.ExpiryDate" class="form-label fw-semibold"></label>
                        <input asp-for="CitizenIdVerification.ExpiryDate" class="form-control" type="date" min="@requiredValidThrough.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="CitizenIdVerification.ExpiryDate" class="text-danger small"></span>
                    </div>
                    <div class="col-md-8">
                        <label asp-for="CitizenIdVerification.PermanentAddress" class="form-label fw-semibold"></label>
                        <input asp-for="CitizenIdVerification.PermanentAddress" class="form-control" autocomplete="street-address" />
                        <span asp-validation-for="CitizenIdVerification.PermanentAddress" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CitizenIdVerification.FrontImage" class="form-label fw-semibold"></label>
                        <input asp-for="CitizenIdVerification.FrontImage" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                        <span asp-validation-for="CitizenIdVerification.FrontImage" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CitizenIdVerification.BackImage" class="form-label fw-semibold"></label>
                        <input asp-for="CitizenIdVerification.BackImage" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                        <span asp-validation-for="CitizenIdVerification.BackImage" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mt-4 d-flex align-items-center gap-3 flex-wrap">
                    <button type="submit" class="btn btn-primary" data-loading-text="Đang gửi CCCD...">Gửi thông tin CCCD</button>
                    <span class="small text-muted">Sau khi gửi CCCD, tiếp tục điền GPLX ở phần bên dưới.</span>
                </div>
            </form>
        }
    </div>
</section>

<section id="driving-license-verification" class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white border-0 px-4 pt-4 pb-2">
        <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
            <div>
                <div class="text-uppercase small text-primary fw-semibold">Phần 2</div>
                <h3 class="h4 fw-bold mb-1">Giấy phép lái xe</h3>
                <p class="text-muted mb-0">Nhập thông tin đúng như trên GPLX và tải ảnh hai mặt.</p>
            </div>
            <span class="badge @StatusBadge(licenseStatus) px-3 py-2">@licenseStatus</span>
        </div>
    </div>
    <div class="card-body p-4">
        @if (licenseRejected)
        {
            <div class="alert alert-danger"><strong>GPLX cần gửi lại.</strong> @(drivingLicense?.RejectionReason ?? drivingLicenseBack?.RejectionReason)</div>
        }
        else if (licensePending)
        {
            <div class="alert alert-warning mb-0">
                <strong>GPLX đã được gửi.</strong> @(citizenPending || citizenVerified ? "Hồ sơ đang chờ Quản trị viên duyệt." : "Hãy gửi thêm CCCD để hoàn tất hồ sơ.")
            </div>
        }
        else if (licenseVerified)
        {
            <div class="alert alert-success mb-0">
                <strong>✓ GPLX đã được duyệt.</strong>
                <span class="ms-1">Số: @MaskNumber(drivingLicense?.DocumentNumber) · Hạng: @(drivingLicense?.LicenseClass ?? "-") · Hết hạn: @(drivingLicense?.ExpiryDate?.ToString("dd/MM/yyyy") ?? "-")</span>
            </div>
        }
        else
        {
            @if (licenseVerifiedByAdmin && !licenseVerified)
            {
                <div class="alert alert-danger">GPLX cũ không còn hiệu lực đến ngày cần thuê. Vui lòng gửi GPLX còn hiệu lực.</div>
            }

            <form asp-action="SubmitDrivingLicense" method="post" enctype="multipart/form-data" data-loading-form>
                @if (hasReturnContext)
                {
                    <input type="hidden" name="returnVehicleId" value="@returnVehicleId" />
                    <input type="hidden" name="pickupDate" value="@returnPickupRoute" />
                    <input type="hidden" name="returnDate" value="@returnDateRoute" />
                }

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="DrivingLicenseVerification.FullNameOnDocument" class="form-label fw-semibold"></label>
                        <input asp-for="DrivingLicenseVerification.FullNameOnDocument" class="form-control" autocomplete="name" />
                        <span asp-validation-for="DrivingLicenseVerification.FullNameOnDocument" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DrivingLicenseVerification.DocumentNumber" class="form-label fw-semibold"></label>
                        <input asp-for="DrivingLicenseVerification.DocumentNumber" class="form-control" autocomplete="off" />
                        <span asp-validation-for="DrivingLicenseVerification.DocumentNumber" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="DrivingLicenseVerification.LicenseClass" class="form-label fw-semibold"></label>
                        <select asp-for="DrivingLicenseVerification.LicenseClass" class="form-select">
                            <option value="">-- Chọn hạng --</option>
                            <option>B</option><option>B1</option><option>B2</option><option>BE</option>
                            <option>C1</option><option>C</option><option>C1E</option><option>CE</option>
                            <option>D1</option><option>D2</option><option>D</option>
                            <option>D1E</option><option>D2E</option><option>DE</option>
                            <option>E</option><option>FB2</option><option>FC</option><option>FD</option><option>FE</option>
                        </select>
                        <span asp-validation-for="DrivingLicenseVerification.LicenseClass" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="DrivingLicenseVerification.IssuedDate" class="form-label fw-semibold"></label>
                        <input asp-for="DrivingLicenseVerification.IssuedDate" class="form-control" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="DrivingLicenseVerification.IssuedDate" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="DrivingLicenseVerification.ExpiryDate" class="form-label fw-semibold"></label>
                        <input asp-for="DrivingLicenseVerification.ExpiryDate" class="form-control" type="date" min="@requiredValidThrough.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="DrivingLicenseVerification.ExpiryDate" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DrivingLicenseVerification.FrontImage" class="form-label fw-semibold"></label>
                        <input asp-for="DrivingLicenseVerification.FrontImage" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                        <span asp-validation-for="DrivingLicenseVerification.FrontImage" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DrivingLicenseVerification.BackImage" class="form-label fw-semibold"></label>
                        <input asp-for="DrivingLicenseVerification.BackImage" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                        <span asp-validation-for="DrivingLicenseVerification.BackImage" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mt-4 d-flex align-items-center gap-3 flex-wrap">
                    <button type="submit" class="btn btn-primary" data-loading-text="Đang gửi GPLX...">Gửi thông tin GPLX</button>
                    <span class="small text-muted">Khi cả CCCD và GPLX đã được gửi, Quản trị viên sẽ nhận thông báo để duyệt hồ sơ.</span>
                </div>
            </form>
        }
    </div>
</section>

<div class="card card-body border-0 shadow-sm">
    <div class="d-flex gap-2 align-items-start">
        <span aria-hidden="true">🔒</span>
        <div class="small text-muted">
            <strong class="text-body">Bảo mật thông tin:</strong> ảnh giấy tờ được lưu ngoài thư mục công khai và chỉ người có quyền mới xem được để đối chiếu hồ sơ.
        </div>
    </div>
</div>
