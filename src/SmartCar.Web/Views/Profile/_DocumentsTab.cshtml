@model SmartCar.Web.ViewModels.ProfileViewModel
@using SmartCar.Domain.Constants
@using SmartCar.Domain.Enums
@{
    static string MaskNumber(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "Chưa có";
        var text = value.Trim();
        return text.Length <= 4 ? new string('*', text.Length) : new string('*', text.Length - 4) + text[^4..];
    }

    static string BadgeClass(string status) => status switch
    {
        "Đã xác minh" => "bg-success",
        "Sắp hết hạn" => "bg-warning text-dark",
        "Chờ xác minh" => "bg-warning text-dark",
        "Cần cập nhật" => "bg-danger",
        _ => "bg-secondary"
    };

    static string StepClass(string status) => status switch
    {
        "Đã xác minh" => "is-done",
        "Sắp hết hạn" => "is-pending",
        "Chờ xác minh" => "is-pending",
        "Cần cập nhật" => "is-error",
        _ => string.Empty
    };

    static string ExpiryText(DateTime? expiryDate, DateTime today, DateTime requiredValidThrough)
    {
        if (!expiryDate.HasValue) return "Chưa có ngày hết hạn";
        var expiry = expiryDate.Value.Date;
        if (expiry < today) return $"Đã hết hạn ngày {expiry:dd/MM/yyyy}";
        if (expiry < requiredValidThrough) return $"Hết hạn {expiry:dd/MM/yyyy}, không đủ hiệu lực đến ngày trả xe {requiredValidThrough:dd/MM/yyyy}";
        var days = (expiry - today).Days;
        return days <= 30
            ? $"Sắp hết hạn ngày {expiry:dd/MM/yyyy} · còn {days} ngày"
            : $"Hết hạn ngày {expiry:dd/MM/yyyy}";
    }

    var today = DateTime.Today;
    var citizenFront = Model.Documents.FirstOrDefault(item => item.DocumentType == DocumentTypes.CitizenId);
    var citizenBack = Model.Documents.FirstOrDefault(item => item.DocumentType == DocumentTypes.CitizenIdBack);
    var licenseFront = Model.Documents.FirstOrDefault(item => item.DocumentType == DocumentTypes.DrivingLicense);
    var licenseBack = Model.Documents.FirstOrDefault(item => item.DocumentType == DocumentTypes.DrivingLicenseBack);

    var returnVehicleId = ViewBag.ReturnVehicleId is int vehicleId ? vehicleId : (int?)null;
    var returnPickupDate = ViewBag.ReturnPickupDate is DateTime pickup ? pickup : (DateTime?)null;
    var returnDate = ViewBag.ReturnDate is DateTime returnAt ? returnAt : (DateTime?)null;
    var returnVehicleName = ViewBag.ReturnVehicleName as string;
    var hasReturnContext = returnVehicleId.HasValue && returnPickupDate.HasValue && returnDate.HasValue;
    var returnPickupRoute = returnPickupDate?.ToString("O");
    var returnDateRoute = returnDate?.ToString("O");
    var requiredValidThrough = returnDate?.Date ?? today;

    var citizenPairExists = citizenFront is not null && citizenBack is not null;
    var licensePairExists = licenseFront is not null && licenseBack is not null;

    var citizenPending = citizenPairExists && citizenFront!.Status == DocumentStatus.Pending && citizenBack!.Status == DocumentStatus.Pending;
    var licensePending = licensePairExists && licenseFront!.Status == DocumentStatus.Pending && licenseBack!.Status == DocumentStatus.Pending;

    var citizenRejected = citizenFront?.Status == DocumentStatus.Rejected || citizenBack?.Status == DocumentStatus.Rejected;
    var licenseRejected = licenseFront?.Status == DocumentStatus.Rejected || licenseBack?.Status == DocumentStatus.Rejected;

    var citizenVerifiedByAdmin = citizenPairExists &&
                                 citizenFront!.Status == DocumentStatus.Verified &&
                                 citizenBack!.Status == DocumentStatus.Verified &&
                                 citizenFront.HasRequiredData && citizenBack.HasRequiredData;
    var licenseVerifiedByAdmin = licensePairExists &&
                                 licenseFront!.Status == DocumentStatus.Verified &&
                                 licenseBack!.Status == DocumentStatus.Verified &&
                                 licenseFront.HasRequiredData && licenseBack.HasRequiredData;

    var citizenExpiry = citizenFront?.ExpiryDate?.Date;
    var licenseExpiry = licenseFront?.ExpiryDate?.Date;

    var citizenVerified = citizenVerifiedByAdmin && citizenExpiry.HasValue && citizenExpiry.Value >= requiredValidThrough;
    var licenseVerified = licenseVerifiedByAdmin && licenseExpiry.HasValue && licenseExpiry.Value >= requiredValidThrough;

    var citizenNeedsRenewal = citizenVerifiedByAdmin && (!citizenExpiry.HasValue || citizenExpiry.Value < requiredValidThrough);
    var licenseNeedsRenewal = licenseVerifiedByAdmin && (!licenseExpiry.HasValue || licenseExpiry.Value < requiredValidThrough);

    var citizenExpiringSoon = citizenVerifiedByAdmin && citizenExpiry.HasValue && citizenExpiry.Value >= today && citizenExpiry.Value <= today.AddDays(30);
    var licenseExpiringSoon = licenseVerifiedByAdmin && licenseExpiry.HasValue && licenseExpiry.Value >= today && licenseExpiry.Value <= today.AddDays(30);

    var citizenStatus = citizenPending
        ? "Chờ xác minh"
        : citizenRejected || citizenNeedsRenewal
            ? "Cần cập nhật"
            : citizenExpiringSoon
                ? "Sắp hết hạn"
                : citizenVerified
                    ? "Đã xác minh"
                    : "Chưa gửi";

    var licenseStatus = licensePending
        ? "Chờ xác minh"
        : licenseRejected || licenseNeedsRenewal
            ? "Cần cập nhật"
            : licenseExpiringSoon
                ? "Sắp hết hạn"
                : licenseVerified
                    ? "Đã xác minh"
                    : "Chưa gửi";

    var allPending = citizenPending && licensePending;
    var individualPending = (citizenPending && licenseVerifiedByAdmin) || (licensePending && citizenVerifiedByAdmin);
    var fullyVerified = citizenVerified && licenseVerified;
    var needsUpdate = citizenRejected || licenseRejected || citizenNeedsRenewal || licenseNeedsRenewal;
    var hasExpiryWarning = citizenExpiringSoon || licenseExpiringSoon;
    var hasVerifiedHistory = citizenVerifiedByAdmin || licenseVerifiedByAdmin || individualPending;

    var citizenCanUpdateIndividually = hasVerifiedHistory && !citizenPending &&
                                       (citizenRejected || citizenNeedsRenewal || citizenExpiringSoon || !citizenPairExists);
    var licenseCanUpdateIndividually = hasVerifiedHistory && !licensePending &&
                                       (licenseRejected || licenseNeedsRenewal || licenseExpiringSoon || !licensePairExists);

    var verifiedSteps = (citizenVerified ? 1 : 0) + (licenseVerified ? 1 : 0);
    var overallStatus = needsUpdate
        ? "Cần cập nhật"
        : allPending || individualPending
            ? "Chờ xác minh"
            : fullyVerified
                ? "Đã xác minh"
                : "Chưa hoàn tất";

    var rejectionReason = citizenFront?.RejectionReason ?? citizenBack?.RejectionReason ?? licenseFront?.RejectionReason ?? licenseBack?.RejectionReason;
}

<div class="kyc-page">
    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4">
        <div>
            <h2 class="h4 fw-bold mb-1">Hồ sơ xác minh CCCD & GPLX</h2>
            <p class="text-muted mb-0">Xác minh lần đầu cần đủ CCCD và GPLX. Khi một giấy tờ sắp hết hạn hoặc hết hạn, bạn chỉ cần cập nhật đúng loại giấy tờ đó.</p>
        </div>
        @if (fullyVerified)
        {
            <a class="btn btn-primary"
               asp-controller="Vehicles"
               asp-action="@(hasReturnContext ? "Details" : "Index")"
               asp-route-id="@returnVehicleId"
               asp-route-pickupDate="@returnPickupRoute"
               asp-route-returnDate="@returnDateRoute">
                @(hasReturnContext && !string.IsNullOrWhiteSpace(returnVehicleName) ? $"Tiếp tục thuê {returnVehicleName}" : "Tiếp tục tìm xe")
            </a>
        }
    </div>

    <div class="kyc-stepper mb-4" aria-label="Tiến trình xác minh giấy tờ">
        <div class="kyc-step @(citizenStatus == "Chưa gửi" ? "is-active" : StepClass(citizenStatus))">
            <span class="kyc-step-number">1</span>
            <span><strong>CCCD</strong><small>@citizenStatus</small></span>
        </div>
        <div class="kyc-step-line"></div>
        <div class="kyc-step @(licenseStatus == "Chưa gửi" && citizenStatus != "Chưa gửi" ? "is-active" : StepClass(licenseStatus))">
            <span class="kyc-step-number">2</span>
            <span><strong>GPLX</strong><small>@licenseStatus</small></span>
        </div>
        <div class="kyc-step-line"></div>
        <div class="kyc-step @StepClass(overallStatus)">
            <span class="kyc-step-number">3</span>
            <span><strong>Hoàn tất</strong><small>@overallStatus</small></span>
        </div>
    </div>

    <section class="card border-0 shadow-sm mb-4 kyc-status-card">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                <div>
                    <div class="text-uppercase small text-muted fw-semibold">Trạng thái hồ sơ</div>
                    <h3 class="h5 fw-bold mb-1">@verifiedSteps/2 loại giấy tờ đủ hiệu lực để thuê xe</h3>
                    @if (hasReturnContext)
                    {
                        <div class="small text-muted">CCCD và GPLX phải còn hiệu lực ít nhất đến <strong>@requiredValidThrough.ToString("dd/MM/yyyy")</strong>.</div>
                    }
                </div>
                <span class="badge @BadgeClass(overallStatus) px-3 py-2">@overallStatus</span>
            </div>

            <div class="row g-3 mt-1">
                <div class="col-md-6">
                    <div class="kyc-status-item align-items-start">
                        <span>
                            <strong class="d-block">Căn cước công dân</strong>
                            <small class="text-muted">@ExpiryText(citizenExpiry, today, requiredValidThrough)</small>
                        </span>
                        <span class="badge @BadgeClass(citizenStatus)">@citizenStatus</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="kyc-status-item align-items-start">
                        <span>
                            <strong class="d-block">Giấy phép lái xe</strong>
                            <small class="text-muted">@ExpiryText(licenseExpiry, today, requiredValidThrough)</small>
                        </span>
                        <span class="badge @BadgeClass(licenseStatus)">@licenseStatus</span>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(rejectionReason) && needsUpdate)
            {
                <div class="alert alert-danger mt-3 mb-0">
                    <strong>Lý do cần cập nhật:</strong> @rejectionReason
                </div>
            }
        </div>
    </section>

    @if (fullyVerified && !hasExpiryWarning)
    {
        <div class="alert alert-success shadow-sm mb-4">
            <strong>✓ Hồ sơ xác minh giấy tờ đã hoàn tất.</strong> CCCD và GPLX đều đã được xác minh và còn hiệu lực.
        </div>

        <div class="row g-4">
            <div class="col-md-6">
                <section class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <div class="text-uppercase small text-primary fw-semibold">CCCD</div>
                        <h3 class="h5 fw-bold">Căn cước công dân</h3>
                        <p class="mb-1"><span class="text-muted">Số:</span> <strong>@MaskNumber(citizenFront?.DocumentNumber)</strong></p>
                        <p class="mb-1"><span class="text-muted">Họ tên:</span> <strong>@(citizenFront?.FullNameOnDocument ?? "-")</strong></p>
                        <p class="mb-0"><span class="text-muted">Hết hạn:</span> <strong>@(citizenExpiry?.ToString("dd/MM/yyyy") ?? "-")</strong></p>
                    </div>
                </section>
            </div>
            <div class="col-md-6">
                <section class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <div class="text-uppercase small text-primary fw-semibold">GPLX</div>
                        <h3 class="h5 fw-bold">Giấy phép lái xe</h3>
                        <p class="mb-1"><span class="text-muted">Số:</span> <strong>@MaskNumber(licenseFront?.DocumentNumber)</strong></p>
                        <p class="mb-1"><span class="text-muted">Hạng:</span> <strong>@(licenseFront?.LicenseClass ?? "-")</strong></p>
                        <p class="mb-0"><span class="text-muted">Hết hạn:</span> <strong>@(licenseExpiry?.ToString("dd/MM/yyyy") ?? "-")</strong></p>
                    </div>
                </section>
            </div>
        </div>
    }
    else if (allPending)
    {
        <div class="card border-warning shadow-sm mb-4">
            <div class="card-body p-4 text-center">
                <div class="kyc-waiting-icon mb-3" aria-hidden="true">⌛</div>
                <h3 class="h5 fw-bold">CCCD và GPLX đang chờ xác minh</h3>
                <p class="text-muted mb-0">Cả hai loại giấy tờ hiện đang chờ Quản trị viên xử lý. Bạn không cần gửi thêm cho đến khi có kết quả.</p>
            </div>
        </div>
    }
    else if (hasVerifiedHistory || hasExpiryWarning)
    {
        @if (needsUpdate)
        {
            <div class="alert alert-danger shadow-sm mb-4">
                <strong>Cần cập nhật giấy tờ.</strong> Giấy tờ hết hạn hoặc không đủ hiệu lực đến ngày trả xe sẽ không được dùng để tạo đơn thuê mới.
            </div>
        }
        else if (hasExpiryWarning)
        {
            <div class="alert alert-warning shadow-sm mb-4">
                <strong>Giấy tờ sắp hết hạn.</strong> Hồ sơ hiện vẫn có thể sử dụng nếu giấy tờ còn hiệu lực đến ngày trả xe. Bạn có thể cập nhật sớm để tránh gián đoạn việc thuê xe.
            </div>
        }

        <div class="row g-4 mb-4">
            <div class="col-lg-6">
                <section class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start gap-3">
                            <div>
                                <div class="text-uppercase small text-primary fw-semibold">CCCD</div>
                                <h3 class="h5 fw-bold mb-1">Căn cước công dân</h3>
                            </div>
                            <span class="badge @BadgeClass(citizenStatus)">@citizenStatus</span>
                        </div>
                        <p class="small text-muted mt-2 mb-1">@ExpiryText(citizenExpiry, today, requiredValidThrough)</p>
                        @if (citizenFront is not null)
                        {
                            <p class="mb-0"><span class="text-muted">Số:</span> <strong>@MaskNumber(citizenFront.DocumentNumber)</strong></p>
                        }

                        @if (citizenPending)
                        {
                            <div class="alert alert-warning mt-3 mb-0">CCCD mới đã được gửi và đang chờ Quản trị viên xác minh.</div>
                        }
                        else if (citizenCanUpdateIndividually)
                        {
                            <div class="alert alert-light border mt-3 mb-0">Chỉ cập nhật CCCD; GPLX hiện tại không bị thay đổi.</div>
                        }
                    </div>
                </section>
            </div>

            <div class="col-lg-6">
                <section class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start gap-3">
                            <div>
                                <div class="text-uppercase small text-primary fw-semibold">GPLX</div>
                                <h3 class="h5 fw-bold mb-1">Giấy phép lái xe</h3>
                            </div>
                            <span class="badge @BadgeClass(licenseStatus)">@licenseStatus</span>
                        </div>
                        <p class="small text-muted mt-2 mb-1">@ExpiryText(licenseExpiry, today, requiredValidThrough)</p>
                        @if (licenseFront is not null)
                        {
                            <p class="mb-0"><span class="text-muted">Số:</span> <strong>@MaskNumber(licenseFront.DocumentNumber)</strong></p>
                        }

                        @if (licensePending)
                        {
                            <div class="alert alert-warning mt-3 mb-0">GPLX mới đã được gửi và đang chờ Quản trị viên xác minh.</div>
                        }
                        else if (licenseCanUpdateIndividually)
                        {
                            <div class="alert alert-light border mt-3 mb-0">Chỉ cập nhật GPLX; CCCD hiện tại không bị thay đổi.</div>
                        }
                    </div>
                </section>
            </div>
        </div>

        @if (citizenCanUpdateIndividually)
        {
            <partial name="_CitizenIdRenewalForm" model="Model" />
        }

        @if (licenseCanUpdateIndividually)
        {
            <partial name="_DrivingLicenseRenewalForm" model="Model" />
        }

        @if (fullyVerified)
        {
            <div class="d-flex justify-content-end mt-4">
                <a class="btn btn-outline-primary"
                   asp-controller="Vehicles"
                   asp-action="@(hasReturnContext ? "Details" : "Index")"
                   asp-route-id="@returnVehicleId"
                   asp-route-pickupDate="@returnPickupRoute"
                   asp-route-returnDate="@returnDateRoute">
                    Tiếp tục thuê xe
                </a>
            </div>
        }
    }
    else
    {
        <partial name="_InitialDocumentsVerificationForm" model="Model" />
    }

    <div class="alert alert-light border small mt-4 mb-0" role="note">
        <strong>🔒 Bảo mật thông tin:</strong> ảnh giấy tờ được lưu ngoài thư mục công khai và chỉ tài khoản có quyền mới xem được để đối chiếu hồ sơ.
    </div>
</div>
