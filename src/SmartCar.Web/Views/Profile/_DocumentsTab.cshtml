@model SmartCar.Web.ViewModels.ProfileViewModel
@using SmartCar.Domain.Constants
@using SmartCar.Domain.Enums
@{
    static string MaskDocumentNumber(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "Chưa có";
        }

        var trimmed = value.Trim();
        return trimmed.Length <= 4
            ? new string('*', trimmed.Length)
            : new string('*', trimmed.Length - 4) + trimmed[^4..];
    }

    static string GetDocumentName(string type) => type switch
    {
        DocumentTypes.CitizenId => "CCCD mặt trước",
        DocumentTypes.CitizenIdBack => "CCCD mặt sau",
        DocumentTypes.DrivingLicense => "Giấy phép lái xe",
        _ => type
    };

    var verifiedCount = Model.Documents.Count(item =>
        DocumentTypes.RequiredForRental.Contains(item.DocumentType) &&
        item.Status == DocumentStatus.Verified &&
        (!item.ExpiryDate.HasValue || item.ExpiryDate.Value.Date >= DateTime.Today));
    var isFullyVerified = verifiedCount == DocumentTypes.RequiredForRental.Count;
}

<div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
    <div>
        <h2 class="h4 mb-1">Xác minh danh tính & giấy phép lái xe</h2>
        <p class="text-muted mb-0">Hoàn thành đủ 3 mục để có thể gửi yêu cầu thuê xe.</p>
    </div>
    <a class="btn btn-outline-primary" asp-controller="Vehicles" asp-action="Index">Tiếp tục tìm xe</a>
</div>

@if (TempData["KycRequired"] is not null)
{
    <div class="alert alert-warning border-warning shadow-sm" role="alert">
        <strong>Bạn chưa thể gửi yêu cầu thuê xe.</strong>
        Hãy hoàn tất các bước xác minh bên dưới. Sau khi Quản trị viên duyệt đủ hồ sơ, bạn có thể quay lại đặt xe.
    </div>
}

<div class="card card-body shadow-sm mb-4 border-0">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <div class="text-uppercase small text-muted fw-semibold">Tiến độ xác minh</div>
            <h3 class="h5 mb-0">@verifiedCount/@DocumentTypes.RequiredForRental.Count giấy tờ đã xác minh</h3>
        </div>
        <span class="badge @(isFullyVerified ? "bg-success" : "bg-warning text-dark") px-3 py-2">
            @(isFullyVerified ? "Đủ điều kiện thuê xe" : "Chưa đủ điều kiện thuê xe")
        </span>
    </div>

    <div class="row g-3">
        @foreach (var type in DocumentTypes.RequiredForRental)
        {
            var item = Model.Documents.FirstOrDefault(document => document.DocumentType == type);
            var itemVerified = item?.Status == DocumentStatus.Verified &&
                               (!item.ExpiryDate.HasValue || item.ExpiryDate.Value.Date >= DateTime.Today);
            <div class="col-md-4">
                <div class="border rounded p-3 h-100 @(itemVerified ? "border-success" : string.Empty)">
                    <div class="small text-muted">@(type == DocumentTypes.CitizenId ? "Bước 1" : type == DocumentTypes.CitizenIdBack ? "Bước 2" : "Bước 3")</div>
                    <div class="fw-semibold">@GetDocumentName(type)</div>
                    <div class="small mt-1 @(itemVerified ? "text-success" : "text-muted")">
                        @(itemVerified ? "✓ Đã xác minh" : item is null ? "Chưa gửi" : item.Status.ToVietnamese())
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="alert alert-info" role="alert">
    <strong>Yêu cầu ảnh:</strong> ảnh rõ chữ, đủ bốn góc, không bị lóa hoặc che thông tin.
    CCCD cần gửi riêng <strong>mặt trước</strong> và <strong>mặt sau</strong>. GPLX phải còn hiệu lực đến ngày trả xe.
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="row g-3">
            @foreach (var type in DocumentTypes.RequiredForRental)
            {
                var document = Model.Documents.FirstOrDefault(item => item.DocumentType == type);
                var expired = document?.ExpiryDate.HasValue == true &&
                              document.ExpiryDate.Value.Date < DateTime.Today;
                var expiresSoon = document?.Status == DocumentStatus.Verified &&
                                  document.ExpiryDate.HasValue &&
                                  document.ExpiryDate.Value.Date >= DateTime.Today &&
                                  document.ExpiryDate.Value.Date <= DateTime.Today.AddDays(30);
                var badgeClass = document is null
                    ? "bg-secondary"
                    : expired
                        ? "bg-danger"
                        : expiresSoon
                            ? "bg-warning text-dark"
                            : document.Status == DocumentStatus.Verified
                                ? "bg-success"
                                : document.Status == DocumentStatus.Rejected
                                    ? "bg-danger"
                                    : "bg-warning text-dark";
                var statusText = document is null
                    ? "Chưa gửi"
                    : expired
                        ? "Đã hết hạn"
                        : expiresSoon
                            ? "Sắp hết hạn"
                            : document.Status.ToVietnamese();
                var displayName = GetDocumentName(type);

                <div class="col-md-6">
                    <div class="card card-body h-100 shadow-sm">
                        <div class="d-flex justify-content-between align-items-center mb-2 gap-2">
                            <h3 class="h5 mb-0">@displayName</h3>
                            <span class="badge @badgeClass">@statusText</span>
                        </div>

                        @if (document is null)
                        {
                            <p class="text-muted">Bạn chưa gửi @displayName. Hãy bổ sung để hoàn thiện điều kiện thuê xe.</p>
                            <button type="button"
                                    class="btn btn-sm btn-outline-primary mt-auto"
                                    data-document-update-button
                                    data-document-type="@type">
                                Bổ sung @displayName
                            </button>
                        }
                        else
                        {
                            <div><strong>Số giấy tờ:</strong> @MaskDocumentNumber(document.DocumentNumber)</div>
                            @if (document.ExpiryDate.HasValue)
                            {
                                <div><strong>Hết hạn:</strong> @document.ExpiryDate.Value.ToString("dd/MM/yyyy")</div>
                            }

                            <img src="@Url.Action("ViewImage", "Documents", new { id = document.CustomerDocumentId })"
                                 class="img-fluid rounded mt-3"
                                 style="height:180px;width:100%;object-fit:cover"
                                 alt="Ảnh @displayName" />

                            @if (document.Status == DocumentStatus.Pending)
                            {
                                <div class="alert alert-warning mt-3 mb-0 py-2">
                                    Hồ sơ đang chờ Quản trị viên kiểm tra. Bạn chưa cần gửi lại.
                                </div>
                            }
                            else if (expired)
                            {
                                <div class="alert alert-danger mt-3 mb-2">
                                    <strong>Giấy tờ đã hết hạn.</strong>
                                    Bạn cần nhập ngày hết hạn mới và tải ảnh giấy tờ còn hiệu lực.
                                </div>
                                <button type="button"
                                        class="btn btn-sm btn-danger w-100"
                                        data-document-update-button
                                        data-document-type="@type">
                                    Cập nhật @displayName
                                </button>
                            }
                            else if (document.Status == DocumentStatus.Rejected)
                            {
                                <div class="alert alert-danger mt-3 mb-2">
                                    <strong>Cần cập nhật và gửi lại:</strong> @document.RejectionReason
                                    <div class="mt-1">Hãy sửa thông tin và tải ảnh mới theo yêu cầu của Quản trị viên.</div>
                                </div>
                                <button type="button"
                                        class="btn btn-sm btn-danger w-100"
                                        data-document-update-button
                                        data-document-type="@type">
                                    Sửa và gửi lại @displayName
                                </button>
                            }
                            else if (expiresSoon)
                            {
                                <div class="alert alert-warning mt-3 mb-2">
                                    <strong>Giấy tờ sắp hết hạn.</strong>
                                    Bạn nên cập nhật sớm để không bị gián đoạn khi đặt xe.
                                </div>
                                <button type="button"
                                        class="btn btn-sm btn-outline-warning w-100"
                                        data-document-update-button
                                        data-document-type="@type">
                                    Cập nhật trước hạn
                                </button>
                            }
                            else if (document.Status == DocumentStatus.Verified)
                            {
                                <div class="alert alert-success mt-3 mb-2 py-2">
                                    Giấy tờ đã hợp lệ và được dùng trong hồ sơ thuê xe.
                                </div>
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary w-100"
                                        data-document-update-button
                                        data-document-type="@type">
                                    Cập nhật thông tin hoặc ảnh
                                </button>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-5">
        <form asp-action="SubmitDocument"
              method="post"
              enctype="multipart/form-data"
              id="profile-document-upload-form"
              class="card card-body shadow-sm"
              data-loading-form>
            <h2 class="h5 mb-1">Bổ sung hoặc cập nhật giấy tờ</h2>
            <p class="text-muted small">Ảnh và thông tin mới sẽ thay thế hồ sơ cũ của cùng loại giấy tờ rồi chuyển về trạng thái chờ xác minh.</p>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            <div class="mb-3">
                <label asp-for="DocumentUpload.DocumentType" class="form-label fw-semibold">Loại giấy tờ</label>
                <select asp-for="DocumentUpload.DocumentType" id="profile-document-type" class="form-select">
                    <option value="@DocumentTypes.CitizenId">CCCD mặt trước</option>
                    <option value="@DocumentTypes.CitizenIdBack">CCCD mặt sau</option>
                    <option value="@DocumentTypes.DrivingLicense">Giấy phép lái xe</option>
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="DocumentUpload.DocumentNumber" class="form-label fw-semibold">Số giấy tờ</label>
                <input asp-for="DocumentUpload.DocumentNumber" class="form-control" autocomplete="off" />
                <span asp-validation-for="DocumentUpload.DocumentNumber" class="text-danger small"></span>
                <div class="form-text">Với CCCD mặt trước và mặt sau, nhập cùng một số CCCD.</div>
            </div>

            <div class="mb-3">
                <label asp-for="DocumentUpload.ExpiryDate" class="form-label fw-semibold">Ngày hết hạn</label>
                <input asp-for="DocumentUpload.ExpiryDate" type="date" class="form-control" />
                <div class="form-text">Chỉ bắt buộc với GPLX và phải còn hạn đến ngày trả xe.</div>
            </div>

            <div class="mb-3">
                <label asp-for="DocumentUpload.Image" class="form-label fw-semibold">Ảnh giấy tờ mới</label>
                <input asp-for="DocumentUpload.Image"
                       type="file"
                       accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                       class="form-control"
                       data-image-input
                       data-preview-target="#profile-document-image-preview"
                       data-file-info-target="#profile-document-file-info" />
                <span asp-validation-for="DocumentUpload.Image" class="text-danger small"></span>
                <div class="form-text">
                    JPG, PNG hoặc WEBP; tối đa 5 MB. Mỗi lần tải đúng một mặt/loại giấy tờ đã chọn.
                </div>
                <div id="profile-document-file-info" class="small text-muted mt-2 d-none"></div>
                <div id="profile-document-image-preview" class="mt-3 d-none">
                    <img class="img-fluid rounded border" style="max-height:240px;width:100%;object-fit:contain" alt="Xem trước ảnh đã chọn" />
                    <button type="button" class="btn btn-sm btn-outline-secondary mt-2" data-clear-image>Chọn ảnh khác</button>
                </div>
            </div>

            <button class="btn btn-primary" type="submit" data-loading-text="Đang gửi giấy tờ...">
                Lưu và gửi xác minh
            </button>
        </form>

        <div class="alert alert-light border mt-3 mb-0 small">
            <strong>Bảo mật:</strong> số giấy tờ được che trên hồ sơ khách hàng. Quản trị viên chỉ dùng ảnh để xác minh danh tính và điều kiện thuê xe.
        </div>
    </div>
</div>
