@model SmartCar.Web.ViewModels.ProfileViewModel
@{
    var returnVehicleId = ViewBag.ReturnVehicleId is int vehicleId ? vehicleId : (int?)null;
    var returnPickupDate = ViewBag.ReturnPickupDate is DateTime pickup ? pickup : (DateTime?)null;
    var returnDate = ViewBag.ReturnDate is DateTime returnAt ? returnAt : (DateTime?)null;
    var latestDateOfBirth = DateTime.Today.AddYears(-18).ToString("yyyy-MM-dd");
    var minimumExpiryDate = returnDate.HasValue && returnDate.Value.Date > DateTime.Today
        ? returnDate.Value.Date.ToString("yyyy-MM-dd")
        : DateTime.Today.ToString("yyyy-MM-dd");
}

<div class="alert alert-light border shadow-sm mb-4">
    <strong>Chuẩn bị 4 ảnh:</strong> CCCD mặt trước + mặt sau và GPLX mặt trước + mặt sau. Hỗ trợ JPG, PNG, WEBP; tối đa <strong>5 MB/ảnh</strong>. Đây là lần xác minh đầu tiên nên Quản trị viên sẽ đối chiếu toàn bộ hồ sơ trong một lần.
</div>

<form asp-controller="KycPackage"
      asp-action="Submit"
      method="post"
      enctype="multipart/form-data"
      class="kyc-package-form"
      data-kyc-package-form
      data-loading-form>
    @if (returnVehicleId.HasValue)
    {
        <input type="hidden" name="returnVehicleId" value="@returnVehicleId" />
        <input type="hidden" name="pickupDate" value="@returnPickupDate?.ToString("O")" />
        <input type="hidden" name="returnDate" value="@returnDate?.ToString("O")" />
    }

    <section class="card border-0 shadow-sm mb-4" id="kycCitizenSection">
        <div class="card-header bg-white border-0 p-4 pb-2">
            <div class="text-uppercase small text-primary fw-semibold">Bước 1/2</div>
            <h3 class="h4 fw-bold mb-1">Căn cước công dân</h3>
            <p class="text-muted mb-0">Nhập thông tin cần cho xác minh danh tính và thời hạn thuê xe.</p>
        </div>
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-7">
                    <label asp-for="CitizenIdVerification.FullNameOnDocument" class="form-label fw-semibold"></label>
                    <input asp-for="CitizenIdVerification.FullNameOnDocument" class="form-control" autocomplete="name" maxlength="100" data-person-name data-client-error-id="citizenNameError" required />
                    <span asp-validation-for="CitizenIdVerification.FullNameOnDocument" id="citizenNameError" class="kyc-client-error d-block"></span>
                </div>
                <div class="col-md-5">
                    <label asp-for="CitizenIdVerification.DocumentNumber" class="form-label fw-semibold"></label>
                    <input asp-for="CitizenIdVerification.DocumentNumber" class="form-control" inputmode="numeric" maxlength="12" pattern="[0-9]{12}" autocomplete="off" data-citizen-number data-client-error-id="citizenNumberError" required />
                    <span asp-validation-for="CitizenIdVerification.DocumentNumber" id="citizenNumberError" class="kyc-client-error d-block"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold" for="CitizenDateOfBirth">Ngày sinh</label>
                    <input id="CitizenDateOfBirth"
                           name="CitizenIdVerification.DateOfBirth"
                           type="date"
                           class="form-control"
                           max="@latestDateOfBirth"
                           value="@Model.CitizenIdVerification.DateOfBirth?.ToString("yyyy-MM-dd")"
                           required />
                    <span asp-validation-for="CitizenIdVerification.DateOfBirth" class="kyc-client-error d-block"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold" for="CitizenExpiryDate">Ngày hết hạn</label>
                    <input id="CitizenExpiryDate"
                           name="CitizenIdVerification.ExpiryDate"
                           type="date"
                           class="form-control"
                           min="@minimumExpiryDate"
                           value="@Model.CitizenIdVerification.ExpiryDate?.ToString("yyyy-MM-dd")"
                           required />
                    <span asp-validation-for="CitizenIdVerification.ExpiryDate" class="kyc-client-error d-block"></span>
                </div>
                <div class="col-12">
                    <label asp-for="CitizenIdVerification.PermanentAddress" class="form-label fw-semibold"></label>
                    <input asp-for="CitizenIdVerification.PermanentAddress" class="form-control" autocomplete="street-address" minlength="5" maxlength="500" data-address-field data-client-error-id="citizenAddressError" required />
                    <span asp-validation-for="CitizenIdVerification.PermanentAddress" id="citizenAddressError" class="kyc-client-error d-block"></span>
                </div>
            </div>

            <div class="row g-3 mt-2">
                <div class="col-md-6">
                    <label class="kyc-upload-card" data-upload-card>
                        <input asp-for="CitizenIdVerification.FrontImage" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" class="visually-hidden" data-upload-input data-client-error-id="citizenFrontImageError" required />
                        <img alt="Xem trước CCCD mặt trước" class="kyc-upload-preview" data-upload-preview />
                        <span class="kyc-upload-icon" data-upload-placeholder>＋</span>
                        <strong>CCCD mặt trước</strong>
                        <span class="kyc-upload-name" data-upload-name>Chọn ảnh</span>
                        <small>JPG, PNG, WEBP · tối đa 5 MB</small>
                    </label>
                    <span asp-validation-for="CitizenIdVerification.FrontImage" id="citizenFrontImageError" class="kyc-client-error d-block"></span>
                </div>
                <div class="col-md-6">
                    <label class="kyc-upload-card" data-upload-card>
                        <input asp-for="CitizenIdVerification.BackImage" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" class="visually-hidden" data-upload-input data-client-error-id="citizenBackImageError" required />
                        <img alt="Xem trước CCCD mặt sau" class="kyc-upload-preview" data-upload-preview />
                        <span class="kyc-upload-icon" data-upload-placeholder>＋</span>
                        <strong>CCCD mặt sau</strong>
                        <span class="kyc-upload-name" data-upload-name>Chọn ảnh</span>
                        <small>JPG, PNG, WEBP · tối đa 5 MB</small>
                    </label>
                    <span asp-validation-for="CitizenIdVerification.BackImage" id="citizenBackImageError" class="kyc-client-error d-block"></span>
                </div>
            </div>

            <div class="d-flex justify-content-end mt-4">
                <button type="button" class="btn btn-outline-primary" data-scroll-to="#kycLicenseSection">Tiếp tục điền GPLX ↓</button>
            </div>
        </div>
    </section>

    <section class="card border-0 shadow-sm mb-4" id="kycLicenseSection">
        <div class="card-header bg-white border-0 p-4 pb-2">
            <div class="text-uppercase small text-primary fw-semibold">Bước 2/2</div>
            <h3 class="h4 fw-bold mb-1">Giấy phép lái xe</h3>
            <p class="text-muted mb-0">Nhập số GPLX, hạng GPLX và thời hạn; Quản trị viên sẽ đối chiếu tên trực tiếp trên ảnh với CCCD.</p>
        </div>
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-5">
                    <label asp-for="DrivingLicenseVerification.DocumentNumber" class="form-label fw-semibold"></label>
                    <input asp-for="DrivingLicenseVerification.DocumentNumber" class="form-control" inputmode="text" maxlength="12" pattern="[A-Za-z0-9]{8,12}" autocomplete="off" data-license-number data-client-error-id="licenseNumberError" required />
                    <div class="form-text">Nhập đúng số trên GPLX, từ 8 đến 12 ký tự chữ hoặc số.</div>
                    <span asp-validation-for="DrivingLicenseVerification.DocumentNumber" id="licenseNumberError" class="kyc-client-error d-block"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="DrivingLicenseVerification.LicenseClass" class="form-label fw-semibold"></label>
                    <select asp-for="DrivingLicenseVerification.LicenseClass" class="form-select" data-license-class data-client-error-id="licenseClassError" required>
                        <option value="">-- Chọn hạng --</option>
                        <option value="B">B</option><option value="C1">C1</option><option value="C">C</option><option value="D1">D1</option><option value="D2">D2</option><option value="D">D</option><option value="BE">BE</option><option value="C1E">C1E</option><option value="CE">CE</option><option value="D1E">D1E</option><option value="D2E">D2E</option><option value="DE">DE</option><option value="B1">B1</option><option value="B2">B2</option>
                    </select>
                    <span asp-validation-for="DrivingLicenseVerification.LicenseClass" id="licenseClassError" class="kyc-client-error d-block"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold" for="LicenseExpiryDate">Ngày hết hạn</label>
                    <input id="LicenseExpiryDate"
                           name="DrivingLicenseVerification.ExpiryDate"
                           type="date"
                           class="form-control"
                           min="@minimumExpiryDate"
                           value="@Model.DrivingLicenseVerification.ExpiryDate?.ToString("yyyy-MM-dd")"
                           required />
                    <span asp-validation-for="DrivingLicenseVerification.ExpiryDate" class="kyc-client-error d-block"></span>
                </div>
            </div>

            <div class="row g-3 mt-2">
                <div class="col-md-6">
                    <label class="kyc-upload-card" data-upload-card>
                        <input asp-for="DrivingLicenseVerification.FrontImage" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" class="visually-hidden" data-upload-input data-client-error-id="licenseFrontImageError" required />
                        <img alt="Xem trước GPLX mặt trước" class="kyc-upload-preview" data-upload-preview />
                        <span class="kyc-upload-icon" data-upload-placeholder>＋</span>
                        <strong>GPLX mặt trước</strong>
                        <span class="kyc-upload-name" data-upload-name>Chọn ảnh</span>
                        <small>JPG, PNG, WEBP · tối đa 5 MB</small>
                    </label>
                    <span asp-validation-for="DrivingLicenseVerification.FrontImage" id="licenseFrontImageError" class="kyc-client-error d-block"></span>
                </div>
                <div class="col-md-6">
                    <label class="kyc-upload-card" data-upload-card>
                        <input asp-for="DrivingLicenseVerification.BackImage" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" class="visually-hidden" data-upload-input data-client-error-id="licenseBackImageError" required />
                        <img alt="Xem trước GPLX mặt sau" class="kyc-upload-preview" data-upload-preview />
                        <span class="kyc-upload-icon" data-upload-placeholder>＋</span>
                        <strong>GPLX mặt sau</strong>
                        <span class="kyc-upload-name" data-upload-name>Chọn ảnh</span>
                        <small>JPG, PNG, WEBP · tối đa 5 MB</small>
                    </label>
                    <span asp-validation-for="DrivingLicenseVerification.BackImage" id="licenseBackImageError" class="kyc-client-error d-block"></span>
                </div>
            </div>
        </div>
    </section>

    <section class="card border-primary shadow-sm mb-4 kyc-submit-card">
        <div class="card-body p-4">
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" value="true" id="confirmSamePerson" name="ConfirmSamePerson" data-confirm-same-person data-client-error-id="confirmSamePersonError" required />
                <label class="form-check-label fw-semibold" for="confirmSamePerson">Tôi xác nhận CCCD và GPLX trên thuộc cùng một người và thông tin cung cấp là chính xác.</label>
            </div>
            <div id="confirmSamePersonError" class="kyc-client-error mb-2"></div>
            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
                <div>
                    <h3 class="h5 fw-bold mb-1">Gửi một hồ sơ duy nhất cho Quản trị viên</h3>
                    <p class="text-muted mb-0">Lần xác minh đầu tiên cần đủ thông tin và cả 4 ảnh. Quản trị viên sẽ duyệt hoặc yêu cầu cập nhật toàn bộ hồ sơ.</p>
                </div>
                <div class="text-lg-end">
                    <button class="btn btn-primary btn-lg" type="submit" data-kyc-submit data-loading-text="Đang gửi hồ sơ..." disabled>Gửi hồ sơ xác minh</button>
                    <small class="text-muted d-block mt-2" data-submit-hint>Vui lòng hoàn tất thông tin, chọn đủ 4 ảnh và tích xác nhận.</small>
                </div>
            </div>
        </div>
    </section>
</form>
