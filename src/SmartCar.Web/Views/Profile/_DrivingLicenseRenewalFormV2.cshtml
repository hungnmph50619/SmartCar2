@model SmartCar.Web.ViewModels.ProfileViewModel
@{
    var returnVehicleId = ViewBag.ReturnVehicleId is int vehicleId ? vehicleId : (int?)null;
    var pickup = ViewBag.ReturnPickupDate as DateTime?;
    var returnAt = ViewBag.ReturnDate as DateTime?;
}
<form asp-controller="DocumentRenewal" asp-action="SubmitDrivingLicense" method="post" enctype="multipart/form-data" class="card border-warning shadow-sm mt-3" data-kyc-renewal-form data-loading-form>
    @if (returnVehicleId.HasValue)
    {
        <input type="hidden" name="returnVehicleId" value="@returnVehicleId" />
        <input type="hidden" name="pickupDate" value="@pickup?.ToString("O")" />
        <input type="hidden" name="returnDate" value="@returnAt?.ToString("O")" />
    }
    <div class="card-header bg-warning-subtle border-0 p-4 pb-2">
        <h3 class="h5 fw-bold mb-1">Cập nhật Giấy phép lái xe</h3>
        <p class="text-muted mb-0">Chỉ cần gửi lại GPLX; không cần nhập ngày cấp.</p>
    </div>
    <div class="card-body p-4">
        <div class="row g-3">
            <div class="col-md-5">
                <label asp-for="DrivingLicenseVerification.DocumentNumber" class="form-label fw-semibold"></label>
                <input asp-for="DrivingLicenseVerification.DocumentNumber" class="form-control" maxlength="12" pattern="[A-Za-z0-9]{8,12}" required />
                <div class="form-text">Nhập đúng số trên GPLX mới, từ 8 đến 12 ký tự chữ hoặc số.</div>
            </div>
            <div class="col-md-3">
                <label asp-for="DrivingLicenseVerification.LicenseClass" class="form-label fw-semibold"></label>
                <select asp-for="DrivingLicenseVerification.LicenseClass" class="form-select" required>
                    <option value="">-- Chọn hạng --</option>
                    <option>B</option><option>C1</option><option>C</option><option>D1</option><option>D2</option><option>D</option><option>BE</option><option>C1E</option><option>CE</option><option>D1E</option><option>D2E</option><option>DE</option><option>B1</option><option>B2</option>
                </select>
            </div>
            <div class="col-md-4">
                <label asp-for="DrivingLicenseVerification.ExpiryDate" class="form-label fw-semibold"></label>
                <input asp-for="DrivingLicenseVerification.ExpiryDate" type="date" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
            </div>
        </div>
        <div class="row g-3 mt-2">
            <div class="col-md-6">
                <label class="kyc-upload-card" data-upload-card>
                    <input asp-for="DrivingLicenseVerification.FrontImage" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" class="visually-hidden" data-upload-input required />
                    <img alt="Xem trước GPLX mặt trước" class="kyc-upload-preview" data-upload-preview />
                    <span class="kyc-upload-icon" data-upload-placeholder>＋</span><strong>GPLX mặt trước mới</strong><span class="kyc-upload-name" data-upload-name>Chọn ảnh</span><small>JPG, PNG, WEBP · tối đa 5 MB</small>
                </label>
            </div>
            <div class="col-md-6">
                <label class="kyc-upload-card" data-upload-card>
                    <input asp-for="DrivingLicenseVerification.BackImage" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" class="visually-hidden" data-upload-input required />
                    <img alt="Xem trước GPLX mặt sau" class="kyc-upload-preview" data-upload-preview />
                    <span class="kyc-upload-icon" data-upload-placeholder>＋</span><strong>GPLX mặt sau mới</strong><span class="kyc-upload-name" data-upload-name>Chọn ảnh</span><small>JPG, PNG, WEBP · tối đa 5 MB</small>
                </label>
            </div>
        </div>
        <div class="alert alert-light border small mt-3 mb-3">Sau khi gửi, GPLX chuyển sang <strong>Chờ xác minh</strong>. Quản trị viên phải duyệt GPLX mới trước khi giấy phép được sử dụng lại để thuê xe.</div>
        <button type="submit" class="btn btn-warning fw-semibold" data-loading-text="Đang gửi GPLX...">Gửi GPLX mới để xác minh</button>
    </div>
</form>
