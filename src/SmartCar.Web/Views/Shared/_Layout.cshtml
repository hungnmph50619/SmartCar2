<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartCar</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SmartCar.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-xl navbar-light bg-white border-bottom box-shadow mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">SmartCar</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-label="Mở hoặc đóng trình đơn">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-xl-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Vehicles" asp-action="Index">Danh sách xe</a></li>
                        @if (User.IsInRole(RoleNames.Customer))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Bookings" asp-action="MyBookings">Đơn của tôi</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Documents" asp-action="Index">CCCD/GPLX</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Extensions" asp-action="Index">Gia hạn</a></li>
                        }
                        @if (User.IsInRole(RoleNames.Admin))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Tổng quan</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="AdminBookings" asp-action="Index">Đơn thuê</a></li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Vận hành</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="AdminDocuments" asp-action="Index">Xác minh khách hàng</a></li>
                                    <li><a class="dropdown-item" asp-controller="VehicleDocuments" asp-action="Index">Giấy tờ pháp lý xe</a></li>
                                    <li><a class="dropdown-item" asp-controller="AdminExtensions" asp-action="Index">Gia hạn thuê</a></li>
                                    <li><a class="dropdown-item" asp-controller="Maintenance" asp-action="Index">Bảo trì xe</a></li>
                                    <li><a class="dropdown-item" asp-controller="Incidents" asp-action="Index">Sự cố và vi phạm</a></li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Quản trị</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="AdminVehicles" asp-action="Index">Quản lý xe</a></li>
                                    <li><a class="dropdown-item" asp-controller="Brands" asp-action="Index">Hãng xe</a></li>
                                    <li><a class="dropdown-item" asp-controller="Promotions" asp-action="Index">Khuyến mãi</a></li>
                                    <li><a class="dropdown-item" asp-controller="Reports" asp-action="Index">Hiệu suất và lợi nhuận</a></li>
                                    <li><a class="dropdown-item" asp-controller="AuditLogs" asp-action="Index">Nhật ký thao tác</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-xl-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Notifications" asp-action="Index">Thông báo</a></li>
                            <li class="nav-item"><span class="nav-link">Xin chào, @User.Identity.Name</span></li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-outline-secondary btn-sm">Đăng xuất</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Đăng nhập</a></li>
                            <li class="nav-item"><a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Đăng ký</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @successMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng thông báo"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @errorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng thông báo"></button>
            </div>
        }
        <main role="main" class="pb-5">@RenderBody()</main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">&copy; 2026 - SmartCar</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
