@model SmartCar.Web.ViewModels.HandoverDocumentViewModel
@using SmartCar.Domain.Enums
@{
    Layout = null;
    var booking = Model.Booking;
    var pickupText = booking.PickupMethod == VehiclePickupMethod.Delivery
        ? $"Giao tận nơi - {booking.DeliveryAddress}"
        : "Nhận tại cửa hàng";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Biên bản giao xe #@booking.BookingId</title>
    <style>
        body { font-family: Arial, sans-serif; color:#111; margin:18mm; font-size:13px; line-height:1.45; }
        h1 { text-align:center; font-size:21px; margin:0 0 4px; }
        .sub { text-align:center; margin-bottom:20px; color:#555; }
        .grid { display:grid; grid-template-columns:1fr 1fr; gap:7px 24px; }
        table { width:100%; border-collapse:collapse; margin-top:14px; }
        th,td { border:1px solid #aaa; padding:7px; text-align:left; vertical-align:top; }
        th { width:30%; }
        .confirm { margin-top:16px; padding:10px; border:1px solid #999; }
        .signatures { display:grid; grid-template-columns:1fr 1fr; gap:70px; margin-top:34px; text-align:center; }
        .signature-space { height:90px; }
        .no-print { margin-bottom:14px; }
        @@media print { .no-print { display:none; } body { margin:12mm; } }
    </style>
</head>
<body>
    <div class="no-print">
        <button type="button" onclick="window.print()">In biên bản</button>
        <button type="button" onclick="window.close()">Đóng</button>
    </div>

    <h1>BIÊN BẢN GIAO XE</h1>
    <div class="sub">SmartCar · Đơn #@booking.BookingId</div>

    <div class="grid">
        <div><strong>Khách hàng:</strong> @booking.CustomerName</div>
        <div><strong>SĐT:</strong> @booking.CustomerPhone</div>
        <div><strong>Xe:</strong> @booking.VehicleName</div>
        <div><strong>Biển số:</strong> @booking.LicensePlate</div>
        <div><strong>Thời gian giao:</strong> @Model.RecordedAt.ToString("dd/MM/yyyy HH:mm")</div>
        <div><strong>Dự kiến trả:</strong> @booking.ReturnDate.ToString("dd/MM/yyyy HH:mm")</div>
        <div><strong>Cách nhận:</strong> @pickupText</div>
        <div><strong>Ảnh xe:</strong> @Model.ImagePaths.Count ảnh lưu trên SmartCar</div>
    </div>

    <table>
        <tr><th>Số km khi giao</th><td>@Model.Mileage.ToString("N0") km</td></tr>
        <tr><th>Nhiên liệu</th><td>@Model.FuelLevel</td></tr>
        <tr><th>Định mức sử dụng</th><td>@Model.IncludedKilometers.ToString("N0") km/chuyến</td></tr>
        <tr><th>Vượt km</th><td>@Model.ExcessKmFeePerKm.ToString("N0") đ/km</td></tr>
        <tr><th>Trả muộn</th><td>@Model.LateReturnFeeMultiplier.ToString("0.##") × giá/ngày</td></tr>
        <tr><th>Phạt giao thông</th><td>@Model.TrafficFineTerms</td></tr>
        <tr><th>Hư hỏng / bồi thường</th><td>@Model.DamageCompensationTerms</td></tr>
        <tr><th>Ghi chú</th><td>@(Model.Notes ?? "Không có")</td></tr>
    </table>

    <div class="confirm">
        Hai bên xác nhận đã kiểm tra xe, số km, nhiên liệu, ảnh bàn giao lưu trong hồ sơ SmartCar và đã được thông báo các chính sách phí/phạt nêu trên.
    </div>

    <div class="signatures">
        <div>
            <strong>ĐẠI DIỆN SMARTCAR</strong>
            <div class="signature-space"></div>
            <div>(Ký, ghi rõ họ tên)</div>
        </div>
        <div>
            <strong>KHÁCH HÀNG</strong>
            <div class="signature-space"></div>
            <div>(Ký, ghi rõ họ tên)</div>
        </div>
    </div>
</body>
</html>
