@model SmartCar.Web.ViewModels.TripRecordViewModel
@using SmartCar.Domain.Constants
@using SmartCar.Domain.Enums

@{
    ViewData["Title"] = $"Hồ sơ chuyến #{Model.Booking.BookingId}";
    var booking = Model.Booking;
    var collection = booking.Payments.Where(p => p.Type is PaymentType.Rental or PaymentType.Deposit).ToList();
    var rentalPayments = collection.Where(p => p.Type == PaymentType.Rental).ToList();
    var depositPayments = collection.Where(p => p.Type == PaymentType.Deposit).ToList();
    var rentalCollectedAmount = rentalPayments.Sum(p => p.Amount);
    var deliveryFeeAmount = Math.Max(0m, rentalCollectedAmount - booking.RentalAmount);
    var rentalDisplayAmount = Math.Max(0m, rentalCollectedAmount - deliveryFeeAmount);

    const string overdueCompPrefix = "OVERDUE-COMP-";
    const string overdueDebtPrefix = "OVERDUE-DEBT-";
    bool IsOverdueImpactPayment(SmartCar.Domain.Entities.Payment payment) =>
        payment.Type == PaymentType.AdditionalCharge &&
        !string.IsNullOrWhiteSpace(payment.TransactionCode) &&
        (payment.TransactionCode.StartsWith(overdueCompPrefix, StringComparison.OrdinalIgnoreCase) ||
         payment.TransactionCode.StartsWith(overdueDebtPrefix, StringComparison.OrdinalIgnoreCase));

    int? AffectedBookingId(string? transactionCode)
    {
        if (string.IsNullOrWhiteSpace(transactionCode)) return null;
        var prefix = transactionCode.StartsWith(overdueCompPrefix, StringComparison.OrdinalIgnoreCase)
            ? overdueCompPrefix
            : transactionCode.StartsWith(overdueDebtPrefix, StringComparison.OrdinalIgnoreCase)
                ? overdueDebtPrefix
                : null;
        if (prefix is null) return null;
        var parts = transactionCode[prefix.Length..].Split('-', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 && int.TryParse(parts[1], out var affectedId) ? affectedId : null;
    }

    var overdueDeductions = booking.Payments
        .Where(IsOverdueImpactPayment)
        .Select(p => new { Payment = p, AffectedBookingId = AffectedBookingId(p.TransactionCode) })
        .ToList();
    var totalOverdueDeduction = overdueDeductions.Sum(x => x.Payment.Amount);

    var adjustments = booking.Payments
        .Where(p => p.Type is PaymentType.Extension or PaymentType.AdditionalCharge or PaymentType.VehicleSwapAdjustment)
        .Where(p => !IsOverdueImpactPayment(p))
        .ToList();
    var refunds = booking.Payments.Where(p => p.Type == PaymentType.Refund).ToList();
    var totalCollected = booking.Payments.Where(p => p.Status == PaymentStatus.Paid && p.Type != PaymentType.Refund).Sum(p => p.Amount);
    var totalRefunded = refunds.Where(p => p.Status == PaymentStatus.Refunded).Sum(p => p.Amount);
    var netPaid = Math.Max(0m, totalCollected - totalRefunded);

    string StatusText(PaymentStatus status) => status switch
    {
        PaymentStatus.Paid => "Đã thu",
        PaymentStatus.Refunded => "Đã hoàn",
        PaymentStatus.AwaitingRefund => "Chờ hoàn",
        PaymentStatus.AwaitingConfirmation => "Chờ xác nhận",
        PaymentStatus.Pending => "Chưa thanh toán",
        PaymentStatus.Failed => "Lỗi",
        _ => status.ToString()
    };

    string RefundLabel(string? method) => method switch
    {
        PaymentMethods.VehicleSwapRefund => "Hoàn chênh lệch đổi xe",
        PaymentMethods.DepositRefund => "Hoàn cọc / điều chỉnh cọc",
        PaymentMethods.CompensationRefund => "Bồi thường / hỗ trợ khách",
        PaymentMethods.BankTransferRefund => "Hoàn tiền",
        _ => "Hoàn tiền"
    };
}

<div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4">
    <div>
        <div class="small text-muted">HỒ SƠ CHUYẾN THUÊ</div>
        <h1 class="h3 mb-1">Đơn #@booking.BookingId</h1>
        <span class="badge @(Model.IsClosed ? "bg-success" : "bg-warning text-dark")">@(Model.IsClosed ? "Đã đóng hồ sơ" : "Đang xử lý")</span>
    </div>
    <a class="btn btn-outline-secondary" asp-controller="AdminBookings" asp-action="Details" asp-route-id="@booking.BookingId">Quay lại đơn</a>
</div>

<div class="card card-body shadow-sm mb-4">
    <h2 class="h5 mb-3">Thông tin</h2>
    <div class="row g-3">
        <div class="col-md-4"><span class="text-muted">Khách</span><br /><strong>@booking.CustomerName</strong></div>
        <div class="col-md-4"><span class="text-muted">Xe</span><br /><strong>@booking.VehicleName · @booking.LicensePlate</strong></div>
        <div class="col-md-4"><span class="text-muted">Thời gian</span><br /><strong>@booking.PickupDate.ToString("dd/MM HH:mm") → @booking.ReturnDate.ToString("dd/MM HH:mm")</strong></div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card card-body shadow-sm h-100">
            <div class="d-flex justify-content-between align-items-center gap-2 mb-3"><h2 class="h5 mb-0">Biên bản giao</h2><span class="badge @(Model.HasSignedHandover ? "bg-success" : "bg-danger")">@(Model.HasSignedHandover ? "Đã có chữ ký" : "Thiếu bản ký")</span></div>
            <div class="row g-2 small mb-3"><div class="col-4"><span class="text-muted">Thời gian</span><br /><strong>@Model.Handover.RecordedAt.ToString("dd/MM HH:mm")</strong></div><div class="col-4"><span class="text-muted">Km</span><br /><strong>@Model.Handover.Mileage.ToString("N0")</strong></div><div class="col-4"><span class="text-muted">Nhiên liệu</span><br /><strong>@Model.Handover.FuelLevel</strong></div></div>
            <div class="d-flex gap-2 flex-wrap mb-3"><a class="btn btn-sm btn-outline-primary" target="_blank" rel="noopener" asp-controller="AdminRentalDocuments" asp-action="HandoverPrint" asp-route-bookingId="@booking.BookingId">Bản in</a>@if (Model.HasSignedHandover){<a class="btn btn-sm btn-outline-success" target="_blank" rel="noopener" href="@Model.Handover.SignedDocumentPath">Xem bản ký</a>}</div>
            @if (!Model.HasSignedHandover){<form asp-controller="AdminRentalDocuments" asp-action="UploadHandoverSigned" method="post" enctype="multipart/form-data" class="input-group input-group-sm mb-3"><input type="hidden" name="bookingId" value="@booking.BookingId" /><input type="file" name="signedDocument" accept="image/jpeg,image/png,image/webp" class="form-control" required /><button class="btn btn-outline-success" type="submit">Bổ sung bản ký</button></form>}
            <div class="row g-2">@foreach (var image in Model.Handover.ImagePaths.Take(6)){<div class="col-4"><a href="@image" target="_blank"><img src="@image" class="img-fluid rounded border w-100" style="height:95px;object-fit:cover" alt="Ảnh giao xe" /></a></div>}</div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card card-body shadow-sm h-100">
            <div class="d-flex justify-content-between align-items-center gap-2 mb-3"><h2 class="h5 mb-0">Biên bản trả</h2><span class="badge @(Model.HasSignedReturn ? "bg-success" : "bg-danger")">@(Model.HasSignedReturn ? "Đã có chữ ký" : "Thiếu bản ký")</span></div>
            <div class="row g-2 small mb-3"><div class="col-4"><span class="text-muted">Thời gian</span><br /><strong>@Model.Return.RecordedAt.ToString("dd/MM HH:mm")</strong></div><div class="col-4"><span class="text-muted">Km</span><br /><strong>@Model.Return.Mileage.ToString("N0")</strong></div><div class="col-4"><span class="text-muted">Nhiên liệu</span><br /><strong>@Model.Return.FuelLevel</strong></div></div>
            <div class="mb-2"><span class="text-muted">Đối chiếu:</span> <strong>@Model.DrivenKilometers.ToString("N0") km</strong> · Hư hỏng mới: <strong>@(Model.Return.HasDamage ? "Có" : "Không")</strong></div>
            <div class="d-flex gap-2 flex-wrap mb-3"><a class="btn btn-sm btn-outline-primary" target="_blank" rel="noopener" asp-controller="AdminRentalDocuments" asp-action="ReturnPrint" asp-route-bookingId="@booking.BookingId">Bản in</a>@if (Model.HasSignedReturn){<a class="btn btn-sm btn-outline-success" target="_blank" rel="noopener" href="@Model.Return.SignedDocumentPath">Xem bản ký</a>}</div>
            @if (!Model.HasSignedReturn){<form asp-controller="AdminRentalDocuments" asp-action="UploadReturnSigned" method="post" enctype="multipart/form-data" class="input-group input-group-sm mb-3"><input type="hidden" name="bookingId" value="@booking.BookingId" /><input type="file" name="signedDocument" accept="image/jpeg,image/png,image/webp" class="form-control" required /><button class="btn btn-outline-success" type="submit">Bổ sung bản ký</button></form>}
            <div class="row g-2">@foreach (var image in Model.Return.ImagePaths.Take(6)){<div class="col-4"><a href="@image" target="_blank"><img src="@image" class="img-fluid rounded border w-100" style="height:95px;object-fit:cover" alt="Ảnh trả xe" /></a></div>}</div>
        </div>
    </div>
</div>

<div class="card card-body shadow-sm">
    <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-3"><div><h2 class="h5 mb-1">Quyết toán</h2><div class="small text-muted">Tách rõ từng khoản tiền thuê, phí giao xe, tiền cọc, phát sinh, khấu trừ và tiền hoàn.</div></div><a class="btn btn-sm btn-outline-primary" asp-controller="AdminPayments" asp-action="Index">Xem sổ giao dịch</a></div>
    <div class="row g-4">
        <div class="col-md-4">
            <div class="small text-muted fw-semibold mb-2">TIỀN THU</div>
            @if (rentalPayments.Count == 0 && depositPayments.Count == 0)
            {
                <div class="text-muted">Không có</div>
            }
            @if (rentalPayments.Count > 0)
            {
                <div class="d-flex justify-content-between border-bottom py-2"><span>Tiền thuê<br/><small>@StatusText(rentalPayments.First().Status)</small></span><strong>@rentalDisplayAmount.ToString("N0") đ</strong></div>
                @if (deliveryFeeAmount > 0)
                {
                    <div class="d-flex justify-content-between border-bottom py-2"><span>Phí giao xe<br/><small>@StatusText(rentalPayments.First().Status)</small></span><strong>@deliveryFeeAmount.ToString("N0") đ</strong></div>
                }
            }
            @foreach (var payment in depositPayments)
            {
                <div class="d-flex justify-content-between border-bottom py-2"><span>Tiền cọc<br/><small>@StatusText(payment.Status)</small></span><strong>@payment.Amount.ToString("N0") đ</strong></div>
            }
        </div>
        <div class="col-md-4">
            <div class="small text-muted fw-semibold mb-2">PHÁT SINH</div>
            @if(adjustments.Count==0){<div class="text-muted">Không có</div>}
            @foreach(var payment in adjustments){<div class="d-flex justify-content-between border-bottom py-2"><span>@(payment.Type==PaymentType.Extension?"Gia hạn":payment.Type==PaymentType.VehicleSwapAdjustment?"Chênh lệch đổi xe":"Phụ phí")<br/><small>@StatusText(payment.Status)</small></span><strong>@payment.Amount.ToString("N0") đ</strong></div>}
        </div>
        <div class="col-md-4">
            <div class="small text-muted fw-semibold mb-2">HOÀN TIỀN</div>
            @if(refunds.Count==0){<div class="text-muted">Không có</div>}
            @foreach(var payment in refunds){<div class="d-flex justify-content-between border-bottom py-2"><span><strong>@RefundLabel(payment.Method)</strong><br/><small>@StatusText(payment.Status)</small></span><strong>@payment.Amount.ToString("N0") đ</strong></div>@if(!string.IsNullOrWhiteSpace(payment.TransactionCode)){<div class="small text-muted mt-1 mb-2">Mã GD: @payment.TransactionCode</div>}}
        </div>
    </div>

    @if (overdueDeductions.Count > 0)
    {
        <div class="border border-danger rounded p-3 mt-4">
            <div class="small text-danger fw-semibold mb-2">KHẤU TRỪ TỪ CỌC DO VI PHẠM</div>
            @foreach (var deduction in overdueDeductions)
            {
                <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap py-2 border-bottom">
                    <div>
                        <strong>Trả xe quá hạn@(deduction.AffectedBookingId.HasValue ? $" – ảnh hưởng đơn #{deduction.AffectedBookingId.Value}" : string.Empty)</strong>
                        <div class="small text-muted">Khoản bồi thường được khấu trừ khi quyết toán tiền cọc.</div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <strong class="text-danger">-@deduction.Payment.Amount.ToString("N0") đ</strong>
                        @if (deduction.AffectedBookingId.HasValue)
                        {
                            <a class="btn btn-sm btn-outline-danger" asp-controller="AdminBookings" asp-action="Details" asp-route-id="@deduction.AffectedBookingId.Value">Xem đơn #@deduction.AffectedBookingId.Value</a>
                        }
                    </div>
                </div>
            }
            <div class="d-flex justify-content-between pt-2"><span>Tổng khấu trừ cọc do vi phạm</span><strong class="text-danger">-@totalOverdueDeduction.ToString("N0") đ</strong></div>
        </div>
    }

    <div class="border rounded bg-light p-3 mt-4">
        <div class="small text-muted fw-semibold mb-2">KẾT QUẢ QUYẾT TOÁN CHUYẾN THUÊ</div>
        <div class="d-flex justify-content-between py-1"><span>Tổng tiền khách đã chuyển</span><strong class="text-success">@totalCollected.ToString("N0") đ</strong></div>
        <div class="d-flex justify-content-between py-1"><span>Tổng tiền đã hoàn khách</span><strong>@totalRefunded.ToString("N0") đ</strong></div>
        @if (totalOverdueDeduction > 0)
        {
            <div class="d-flex justify-content-between py-1"><span>Trong đó khấu trừ cọc do ảnh hưởng đơn khác</span><strong class="text-danger">@totalOverdueDeduction.ToString("N0") đ</strong></div>
        }
        <hr class="my-2" />
        <div class="d-flex justify-content-between align-items-center"><strong>Chi phí khách thực chịu sau quyết toán</strong><strong class="text-primary fs-5">@netPaid.ToString("N0") đ</strong></div>
    </div>
</div>
