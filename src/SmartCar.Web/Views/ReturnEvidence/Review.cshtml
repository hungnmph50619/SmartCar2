@model SmartCar.Web.ViewModels.RentalEvidenceViewModel
@{
    ViewData["Title"] = "Hồ sơ biên bản giao nhận";
    var pairCount = Math.Max(Model.HandoverVehicleImagePaths.Count, Model.ReturnVehicleImagePaths.Count);
}

<div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4">
    <div>
        <div class="text-uppercase small text-primary fw-semibold">Hồ sơ giao nhận</div>
        <h1 class="h3 mb-1">Biên bản & ảnh hiện trạng · Đơn #@Model.BookingId</h1>
        <p class="text-muted mb-0">Một nơi lưu ảnh xe trước–sau và ảnh biên bản giấy có chữ ký của khách để phục vụ kiểm tra, xử lý phụ phí hoặc tranh chấp nếu phát sinh.</p>
    </div>
    <a class="btn btn-outline-secondary"
       asp-controller="AdminBookings"
       asp-action="Details"
       asp-route-id="@Model.BookingId">← Quay lại đơn</a>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-4">
        <div class="row g-3">
            <div class="col-md-3"><div class="small text-muted">Khách</div><strong>@Model.CustomerName</strong></div>
            <div class="col-md-3"><div class="small text-muted">Xe</div><strong>@Model.VehicleName · @Model.LicensePlate</strong></div>
            <div class="col-md-3"><div class="small text-muted">Giao xe</div><strong>@Model.HandoverAt.ToString("dd/MM/yyyy HH:mm")</strong></div>
            <div class="col-md-3"><div class="small text-muted">Nhận lại xe</div><strong>@Model.ReturnedAt.ToString("dd/MM/yyyy HH:mm")</strong></div>
        </div>

        <div class="table-responsive mt-4">
            <table class="table align-middle mb-0">
                <thead class="table-light"><tr><th>Nội dung</th><th>Khi giao</th><th>Khi trả</th></tr></thead>
                <tbody>
                    <tr><th>Số km trên đồng hồ</th><td>@Model.HandoverMileage.ToString("N0") km</td><td>@Model.ReturnMileage.ToString("N0") km</td></tr>
                    <tr><th>Nhiên liệu / pin</th><td>@Model.HandoverFuelLevel</td><td>@Model.ReturnFuelLevel</td></tr>
                    <tr><th>Ghi chú hiện trạng</th><td>@(string.IsNullOrWhiteSpace(Model.HandoverNotes) ? "Không có ghi chú" : Model.HandoverNotes)</td><td>@(string.IsNullOrWhiteSpace(Model.ReturnCondition) ? "Không ghi nhận hư hỏng mới" : Model.ReturnCondition)</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card shadow-sm border-primary h-100">
            <div class="card-body p-4">
                <div class="text-uppercase small text-primary fw-semibold">Biên bản bàn giao</div>
                <h2 class="h5">Ảnh biên bản giấy có chữ ký khách</h2>
                @if (Model.HandoverDocumentImagePaths.Count == 0)
                {
                    <div class="alert alert-secondary mb-0">Không có ảnh biên bản bàn giao riêng. Đây có thể là dữ liệu cũ trước khi áp dụng quy trình biên bản giấy.</div>
                }
                else
                {
                    <div class="row g-2">
                        @foreach (var path in Model.HandoverDocumentImagePaths)
                        {
                            <div class="col-6">
                                <a href="@path" target="_blank" rel="noopener noreferrer">
                                    <img src="@path" class="w-100 rounded border" style="height:260px;object-fit:contain;background:#f8f9fa" alt="Biên bản bàn giao có chữ ký" />
                                </a>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm border-primary h-100">
            <div class="card-body p-4">
                <div class="text-uppercase small text-primary fw-semibold">Biên bản trả xe</div>
                <h2 class="h5">Ảnh biên bản giấy có chữ ký khách</h2>
                @if (Model.ReturnDocumentImagePaths.Count == 0)
                {
                    <div class="alert alert-secondary mb-0">Không có ảnh biên bản trả xe riêng. Đây có thể là dữ liệu cũ trước khi áp dụng quy trình biên bản giấy.</div>
                }
                else
                {
                    <div class="row g-2">
                        @foreach (var path in Model.ReturnDocumentImagePaths)
                        {
                            <div class="col-6">
                                <a href="@path" target="_blank" rel="noopener noreferrer">
                                    <img src="@path" class="w-100 rounded border" style="height:260px;object-fit:contain;background:#f8f9fa" alt="Biên bản trả xe có chữ ký" />
                                </a>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3">
            <div>
                <div class="text-uppercase small text-muted fw-semibold">Ảnh hiện trạng xe</div>
                <h2 class="h5 mb-1">So sánh lúc giao ↔ lúc trả</h2>
                <p class="small text-muted mb-0">Ảnh do nhân viên SmartCar chụp tại hai thời điểm. Khi có hư hỏng, mở ảnh lớn và đối chiếu cùng vị trí.</p>
            </div>
            <span class="badge bg-light text-dark border">@Model.HandoverVehicleImagePaths.Count ảnh giao · @Model.ReturnVehicleImagePaths.Count ảnh trả</span>
        </div>

        @if (pairCount == 0)
        {
            <div class="alert alert-secondary mb-0">Không có ảnh hiện trạng để đối chiếu.</div>
        }
        else
        {
            @for (var index = 0; index < pairCount; index++)
            {
                var handoverPath = index < Model.HandoverVehicleImagePaths.Count ? Model.HandoverVehicleImagePaths[index] : null;
                var returnPath = index < Model.ReturnVehicleImagePaths.Count ? Model.ReturnVehicleImagePaths[index] : null;
                <div class="border rounded-3 p-3 mb-3">
                    <div class="small fw-semibold mb-2">Ảnh đối chiếu @(index + 1)</div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="small text-muted mb-1">Lúc giao xe</div>
                            @if (!string.IsNullOrWhiteSpace(handoverPath))
                            {
                                <a href="@handoverPath" target="_blank" rel="noopener noreferrer">
                                    <img src="@handoverPath" class="w-100 rounded border" style="height:300px;object-fit:contain;background:#f8f9fa" alt="Ảnh xe lúc giao" />
                                </a>
                            }
                            else
                            {
                                <div class="bg-light rounded p-5 text-center text-muted">Không có ảnh tương ứng</div>
                            }
                        </div>
                        <div class="col-md-6">
                            <div class="small text-muted mb-1">Lúc trả xe</div>
                            @if (!string.IsNullOrWhiteSpace(returnPath))
                            {
                                <a href="@returnPath" target="_blank" rel="noopener noreferrer">
                                    <img src="@returnPath" class="w-100 rounded border" style="height:300px;object-fit:contain;background:#f8f9fa" alt="Ảnh xe lúc trả" />
                                </a>
                            }
                            else
                            {
                                <div class="bg-light rounded p-5 text-center text-muted">Không có ảnh tương ứng</div>
                            }
                        </div>
                    </div>
                </div>
            }
        }

        @if (!string.IsNullOrWhiteSpace(Model.ReturnNotes))
        {
            <div class="alert alert-light border mb-0"><strong>Ghi chú khi trả xe:</strong><br />@Model.ReturnNotes</div>
        }
    </div>
</div>
