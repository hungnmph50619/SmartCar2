@model SmartCar.Web.ViewModels.BookingConfirmViewModel

@{
    ViewData["Title"] = "Xác nhận đặt xe";
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <h1 class="h3 mb-1">
                Xác nhận đặt xe
            </h1>

            <p class="text-muted mb-4">
                Kiểm tra lại thông tin trước khi gửi yêu cầu thuê xe.
            </p>

            <div class="card shadow-sm border-0 mb-4">

                <div class="card-body">

                    <div class="row g-4 align-items-center">

                        <div class="col-md-4">

                            @if (!string.IsNullOrWhiteSpace(
                                Model.PrimaryImagePath))
                            {
                                <img src="@Model.PrimaryImagePath"
                                     alt="@Model.VehicleName"
                                     class="img-fluid rounded"
                                     style="width:100%;
                                height:180px;
                                object-fit:cover;" />
                            }
                            else
                            {
                                <div class="bg-light rounded
                                    d-flex
                                    justify-content-center
                                    align-items-center"
                                     style="height:180px;">
                                    Chưa có ảnh
                                </div>
                            }

                        </div>

                        <div class="col-md-8">

                            <h2 class="h4">
                                @Model.VehicleName
                            </h2>

                            <div class="text-muted mb-3">
                                @Model.BrandName
                                ·
                                @Model.LicensePlate
                            </div>

                            <div class="mb-2">
                                <strong>Nhận xe:</strong>
                                @Model.PickupDate.ToString(
                                    "dd/MM/yyyy HH:mm")
                            </div>

                            <div class="mb-2">
                                <strong>Trả xe:</strong>
                                @Model.ReturnDate.ToString(
                                    "dd/MM/yyyy HH:mm")
                            </div>

                            <div class="mb-2">
                                <strong>Số ngày thuê:</strong>
                                @Model.NumberOfDays ngày
                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <div class="card shadow-sm border-0 mb-4">

                <div class="card-body">

                    <h2 class="h5 mb-3">
                        Chi phí thuê xe
                    </h2>

                    <div class="d-flex
                        justify-content-between
                        mb-2">

                        <span>
                            Giá thuê mỗi ngày
                        </span>

                        <strong>
                            @Model.DailyPrice.ToString("N0") đ
                        </strong>

                    </div>

                    <div class="d-flex
                        justify-content-between
                        mb-2">

                        <span>
                            Số ngày thuê
                        </span>

                        <strong>
                            @Model.NumberOfDays
                        </strong>

                    </div>

                    <hr />

                    <div class="d-flex
                        justify-content-between
                        fs-5">

                        <strong>
                            Tổng tiền dự kiến
                        </strong>

                        <strong class="text-primary">
                            @Model.TotalAmount.ToString("N0") đ
                        </strong>

                    </div>

                </div>

            </div>


            <div class="alert alert-info">

                Sau khi gửi yêu cầu, đơn thuê sẽ ở trạng thái
                <strong>Chờ xác nhận</strong>.

                Bạn chưa cần thanh toán cho đến khi
                yêu cầu được chấp nhận.

            </div>


            <div class="d-flex gap-2">

                <a asp-controller="Vehicles"
                   asp-action="Details"
                   asp-route-id="@Model.VehicleId"
                   asp-route-pickupDate="@Model.PickupDate"
                   asp-route-returnDate="@Model.ReturnDate"
                   class="btn btn-outline-secondary">

                    Quay lại

                </a>


                <form asp-controller="Bookings"
                      asp-action="Create"
                      method="post"
                      class="flex-grow-1">

                    <input type="hidden"
                           name="VehicleId"
                           value="@Model.VehicleId" />

                    <input type="hidden"
                           name="PickupDate"
                           value="@Model.PickupDate.ToString("O")" />

                    <input type="hidden"
                           name="ReturnDate"
                           value="@Model.ReturnDate.ToString("O")" />

                    <button type="submit"
                            class="btn btn-primary w-100">

                        Xác nhận gửi yêu cầu thuê xe

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>