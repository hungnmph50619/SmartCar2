@model SmartCar.Application.Features.Bookings.BookingDetailsDto
@using SmartCar.Domain.Enums
@{
    ViewData["Title"] = $"Đơn thuê #{Model.BookingId}";
    var hasOpenExtension = Model.Extensions.Any(item =>
        item.Status is BookingExtensionStatus.Pending or BookingExtensionStatus.Approved);
    var canCancel = Model.Status is BookingStatus.PendingConfirmation or BookingStatus.PendingPayment or BookingStatus.Paid or BookingStatus.ReadyForPickup;
    var canApplyPromotion = Model.Status is BookingStatus.PendingConfirmation or BookingStatus.PendingPayment && !Model.RentalPaid;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Đơn thuê #@Model.BookingId</h1>
        <span class="badge bg-primary">@Model.Status.ToVietnamese()</span>
    </div>
    <a class="btn btn-outline-secondary" asp-action="MyBookings">Danh sách đơn</a>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card card-body shadow-sm mb-4">
            <div class="d-flex gap-3">
                @if (!string.IsNullOrWhiteSpace(Model.PrimaryImagePath))
                {
                    <img src="@Model.PrimaryImagePath" style="width:180px;height:120px;object-fit:cover" class="rounded" alt="Ảnh @Model.VehicleName" />
                }
                <div>
                    <h2 class="h5">@Model.VehicleName</h2>
                    <p class="text-muted">@Model.LicensePlate</p>
                    <div>Nhận: <strong>@Model.PickupDate.ToString("dd/MM/yyyy HH:mm")</strong></div>
                    <div>Trả: <strong>@Model.ReturnDate.ToString("dd/MM/yyyy HH:mm")</strong></div>
                </div>
            </div>
        </div>

        <div class="card card-body shadow-sm mb-4">
            <h2 class="h5">Tiến trình đơn thuê</h2>
            <ol class="mb-0">
                <li>Gửi yêu cầu và kiểm tra giấy tờ</li>
                <li>Áp dụng mã khuyến mãi trước khi thanh toán</li>
                <li>Quản trị viên xác nhận hoặc từ chối</li>
                <li>Khách hàng thanh toán tiền thuê</li>
                <li>Quản trị viên bàn giao xe</li>
                <li>Gia hạn nếu cần và được quản trị viên duyệt</li>
                <li>Trả xe, xử lý phụ phí và hoàn tất</li>
            </ol>
            @if (!string.IsNullOrWhiteSpace(Model.CancelReason))
            {
                <div class="alert alert-danger mt-3 mb-0">
                    <strong>Lý do:</strong> @Model.CancelReason
                    @if (Model.RefundAmount > 0)
                    {
                        <div><strong>Tiền hoàn:</strong> @Model.RefundAmount.ToString("N0") đ</div>
                        <div>@Model.RefundReason</div>
                    }
                </div>
            }
        </div>

        @if (Model.Status == BookingStatus.Rented)
        {
            <div class="card card-body shadow-sm mb-4">
                <h2 class="h5">Gia hạn thuê xe</h2>
                @if (hasOpenExtension)
                {
                    <div class="alert alert-info mb-0">Đơn đang có yêu cầu gia hạn chờ xử lý hoặc chờ thanh toán.</div>
                }
                else
                {
                    <form asp-controller="Extensions" asp-action="SubmitRequest" method="post" class="row g-2">
                        <input type="hidden" name="BookingId" value="@Model.BookingId" />
                        <div class="col-md-5">
                            <label class="form-label">Thời gian trả mới</label>
                            <input name="RequestedReturnDate" type="datetime-local" min="@Model.ReturnDate.ToString("yyyy-MM-ddTHH:mm")" class="form-control" required />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label">Ghi chú</label>
                            <input name="CustomerNote" class="form-control" placeholder="Lý do gia hạn" />
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button class="btn btn-outline-primary w-100" type="submit">Gửi yêu cầu</button>
                        </div>
                    </form>
                }
            </div>
        }

        @if (Model.Extensions.Count > 0)
        {
            <div class="card card-body shadow-sm mb-4">
                <h2 class="h5">Lịch sử gia hạn</h2>
                <div class="table-responsive">
                    <table class="table mb-0">
                    @foreach (var extension in Model.Extensions)
                    {
                        <tr>
                            <td>@extension.RequestedReturnDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@extension.AdditionalDays ngày</td>
                            <td>@extension.AdditionalAmount.ToString("N0") đ</td>
                            <td><span class="badge bg-secondary">@extension.Status.ToVietnamese()</span></td>
                        </tr>
                    }
                    </table>
                </div>
            </div>
        }

        @if (Model.AdditionalCharges.Count > 0)
        {
            <div class="card card-body shadow-sm mb-4">
                <h2 class="h5">Phụ phí</h2>
                <table class="table mb-0">
                @foreach (var charge in Model.AdditionalCharges)
                {
                    <tr><td>@charge.ChargeType.ToVietnamese()</td><td>@charge.Description</td><td class="text-end">@charge.Amount.ToString("N0") đ</td></tr>
                }
                </table>
            </div>
        }

        @if (Model.Status == BookingStatus.Completed && !Model.HasReview)
        {
            <div class="card card-body shadow-sm mb-4">
                <h2 class="h5">Đánh giá chuyến thuê</h2>
                <form asp-controller="Reviews" asp-action="Create" method="post" class="row g-2">
                    <input type="hidden" name="BookingId" value="@Model.BookingId" />
                    <div class="col-md-3">
                        <select name="Rating" class="form-select" aria-label="Số sao đánh giá">
                            <option value="5">5 sao</option>
                            <option value="4">4 sao</option>
                            <option value="3">3 sao</option>
                            <option value="2">2 sao</option>
                            <option value="1">1 sao</option>
                        </select>
                    </div>
                    <div class="col-md-7"><input name="Comment" class="form-control" placeholder="Chia sẻ trải nghiệm của bạn" /></div>
                    <div class="col-md-2"><button class="btn btn-success w-100" type="submit">Gửi đánh giá</button></div>
                </form>
            </div>
        }

        @if (canCancel)
        {
            <div class="card card-body border-danger shadow-sm">
                <h2 class="h5 text-danger">Hủy đơn thuê</h2>
                <p class="text-muted">Khách hàng chủ động hủy sau khi đã thanh toán sẽ không được hoàn tiền. Quản trị viên hủy trước khi giao xe sẽ hoàn 100%.</p>
                <form asp-controller="BookingOperations" asp-action="Cancel" method="post" class="row g-2">
                    <input type="hidden" name="BookingId" value="@Model.BookingId" />
                    <div class="col-md-9"><input name="Reason" class="form-control" required placeholder="Lý do hủy đơn" /></div>
                    <div class="col-md-3"><button class="btn btn-outline-danger w-100" type="submit">Hủy đơn</button></div>
                </form>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card card-body shadow-sm sticky-top" style="top:1rem">
            <h2 class="h5">Thanh toán</h2>
            <div class="d-flex justify-content-between"><span>Tiền thuê và gia hạn</span><strong>@Model.RentalAmount.ToString("N0") đ</strong></div>
            @if (Model.DiscountAmount > 0)
            {
                <div class="d-flex justify-content-between text-success">
                    <span>Khuyến mãi (@Model.PromotionCode)</span>
                    <strong>-@Model.DiscountAmount.ToString("N0") đ</strong>
                </div>
            }
            <div class="d-flex justify-content-between"><span>Phụ phí</span><strong>@Model.AdditionalAmount.ToString("N0") đ</strong></div>
            <hr />
            <div class="d-flex justify-content-between fs-5"><span>Tổng cộng</span><strong>@Model.TotalAmount.ToString("N0") đ</strong></div>

            @if (canApplyPromotion)
            {
                @if (string.IsNullOrWhiteSpace(Model.PromotionCode))
                {
                    <form asp-controller="Promotions" asp-action="Apply" method="post" class="mt-3">
                        <input type="hidden" name="BookingId" value="@Model.BookingId" />
                        <label class="form-label">Mã khuyến mãi</label>
                        <div class="input-group">
                            <input name="Code" class="form-control text-uppercase" required placeholder="Nhập mã" />
                            <button class="btn btn-outline-success" type="submit">Áp dụng</button>
                        </div>
                    </form>
                }
                else
                {
                    <form asp-controller="Promotions" asp-action="Remove" method="post" class="mt-3">
                        <input type="hidden" name="bookingId" value="@Model.BookingId" />
                        <button class="btn btn-sm btn-outline-danger w-100" type="submit">Gỡ mã @Model.PromotionCode</button>
                    </form>
                }
            }

            @if (Model.Status == BookingStatus.PendingPayment && !Model.RentalPaid)
            {
                <form asp-controller="Payments" asp-action="Pay" method="post" class="mt-3">
                    <input type="hidden" name="bookingId" value="@Model.BookingId" />
                    <input type="hidden" name="type" value="@PaymentType.Rental" />
                    <button class="btn btn-primary w-100" type="submit">Thanh toán tiền thuê mô phỏng</button>
                </form>
            }

            @if (Model.Status == BookingStatus.Rented && !Model.ExtensionPaid)
            {
                <form asp-controller="Payments" asp-action="Pay" method="post" class="mt-3">
                    <input type="hidden" name="bookingId" value="@Model.BookingId" />
                    <input type="hidden" name="type" value="@PaymentType.Extension" />
                    <button class="btn btn-info w-100" type="submit">Thanh toán tiền gia hạn</button>
                </form>
            }

            @if (Model.Status == BookingStatus.PendingInspection && Model.AdditionalAmount > 0 && !Model.AdditionalChargePaid)
            {
                <form asp-controller="Payments" asp-action="Pay" method="post" class="mt-3">
                    <input type="hidden" name="bookingId" value="@Model.BookingId" />
                    <input type="hidden" name="type" value="@PaymentType.AdditionalCharge" />
                    <button class="btn btn-warning w-100" type="submit">Thanh toán phụ phí mô phỏng</button>
                </form>
            }

            @if (Model.RentalPaid)
            {
                <div class="alert alert-success mt-3 mb-0">Tiền thuê đã thanh toán.</div>
            }
            @if (Model.AdditionalAmount > 0 && Model.AdditionalChargePaid)
            {
                <div class="alert alert-success mt-3 mb-0">Phụ phí đã thanh toán.</div>
            }
        </div>
    </div>
</div>
