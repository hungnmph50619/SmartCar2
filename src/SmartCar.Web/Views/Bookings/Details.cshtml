                                    w-100"
                                        type="submit"
                                        data-loading-text="Đang gửi...">

                                    Tôi đã chuyển khoản phụ phí

                                </button>

                            </form>


                            <div class="text-center
                                text-muted
                                small
                                my-2">

                                hoặc thanh toán thử nghiệm

                            </div>


                            <form asp-controller="Payments"
                                  asp-action="Pay"
                                  method="post"
                                  data-loading-form
                                  data-confirm="Xác nhận dùng thanh toán mô phỏng cho phụ phí?">

                                <input type="hidden"
                                       name="bookingId"
                                       value="@Model.BookingId" />

                                <input type="hidden"
                                       name="type"
                                       value="@PaymentType.AdditionalCharge" />

                                <button class="btn
                                    btn-outline-warning
                                    w-100"
                                        type="submit"
                                        data-loading-text="Đang thanh toán...">

                                    Thanh toán phụ phí mô phỏng

                                </button>

                            </form>

                        </div>

                    </div>
                }
            }


            @* ====================================================
               THÔNG BÁO ĐÃ THANH TOÁN
               ==================================================== *@

            @if (Model.RentalPaid)
            {
                <div class="alert
                    alert-success
                    mt-3
                    mb-0">

                    ✓ Tiền thuê đã thanh toán.

                </div>
            }


            @if (Model.Extensions.Any(item =>
                item.Status ==
                    BookingExtensionStatus.Paid))
            {
                <div class="alert
                    alert-success
                    mt-3
                    mb-0">

                    ✓ Tiền gia hạn đã thanh toán.

                </div>
            }


            @if (Model.AdditionalAmount > 0 &&
                 Model.AdditionalChargePaid)
            {
                <div class="alert
                    alert-success
                    mt-3
                    mb-0">

                    ✓ Phụ phí đã thanh toán.

                </div>
            }


            @* ====================================================
               TRẠNG THÁI HOÀN TIỀN
               ==================================================== *@

            @if (Model.RefundAmount > 0 &&
                 refundPayment is not null)
            {
                @if (refundPayment.Status ==
                     PaymentStatus.AwaitingRefund)
                {
                    <div class="alert
                        alert-info
                        mt-3
                        mb-0">

                        <div class="fw-bold">

                            Khoản hoàn đang chờ xử lý

                        </div>

                        <div>

                            Số tiền dự kiến hoàn:

                            <strong>
                                @refundPayment.Amount.ToString("N0") đ
                            </strong>

                        </div>

                    </div>
                }

                else if (
                    refundPayment.Status ==
                    PaymentStatus.Refunded)
                {
                    <div class="alert
                        alert-success
                        mt-3
                        mb-0">

                        <div class="fw-bold">
                            ✓ Đã hoàn tiền
                        </div>

                        <div>

                            Số tiền:

                            <strong>
                                @refundPayment.Amount.ToString("N0") đ
                            </strong>

                        </div>


                        @if (!string.IsNullOrWhiteSpace(
                            refundPayment.TransactionCode))
                        {
                            <div class="small mt-1">

                                Mã giao dịch:

                                <strong>
                                    @refundPayment.TransactionCode
                                </strong>

                            </div>
                        }

                    </div>
                }
            }

        </div>

    </div>
</div>
