@model SmartCar.Application.Features.Bookings.BookingDetailsDto
@using SmartCar.Domain.Enums
@{
    ViewData["Title"] = $"Đơn thuê #{Model.BookingId}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Đơn thuê #@Model.BookingId</h1>
        <span class="badge bg-primary">@Model.Status</span>
    </div>
    <a class="btn btn-outline-secondary" asp-action="MyBookings">Danh sách đơn</a>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card card-body shadow-sm mb-4">
            <div class="d-flex gap-3">
                @if (!string.IsNullOrWhiteSpace(Model.PrimaryImagePath))
                {
                    <img src="@Model.PrimaryImagePath" style="width:180px;height:120px;object-fit:cover" class="rounded" />
                }
                <div>
                    <h2 class="h5">@Model.VehicleName</h2>
                    <p class="text-muted">@Model.LicensePlate</p>
                    <div>Nhận: <strong>@Model.PickupDate.ToString("dd/MM/yyyy HH:mm")</strong></div>
                    <div>Trả: <strong>@Model.ReturnDate.ToString("dd/MM/yyyy HH:mm")</strong></div>
                </div>
            </div>
        </div>

        <div class="card card-body shadow-sm mb-4">
            <h2 class="h5">Tiến trình đơn thuê</h2>
            <ol class="mb-0">
                <li>Đã gửi yêu cầu thuê xe</li>
                <li>Admin xác nhận hoặc từ chối</li>
                <li>Khách thanh toán tiền thuê</li>
                <li>Admin chuẩn bị và bàn giao xe</li>
                <li>Khách sử dụng và trả xe</li>
                <li>Admin kiểm tra, xử lý phụ phí và hoàn tất</li>
            </ol>
            @if (!string.IsNullOrWhiteSpace(Model.CancelReason))
            {
                <div class="alert alert-danger mt-3 mb-0"><strong>Lý do:</strong> @Model.CancelReason</div>
            }
        </div>

        @if (Model.AdditionalCharges.Count > 0)
        {
            <div class="card card-body shadow-sm">
                <h2 class="h5">Phụ phí</h2>
                <table class="table mb-0">
                @foreach (var charge in Model.AdditionalCharges)
                {
                    <tr><td>@charge.ChargeType</td><td>@charge.Description</td><td class="text-end">@charge.Amount.ToString("N0") đ</td></tr>
                }
                </table>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card card-body shadow-sm">
            <h2 class="h5">Thanh toán</h2>
            <div class="d-flex justify-content-between"><span>Tiền thuê</span><strong>@Model.RentalAmount.ToString("N0") đ</strong></div>
            <div class="d-flex justify-content-between"><span>Phụ phí</span><strong>@Model.AdditionalAmount.ToString("N0") đ</strong></div>
            <hr />
            <div class="d-flex justify-content-between fs-5"><span>Tổng cộng</span><strong>@Model.TotalAmount.ToString("N0") đ</strong></div>

            @if (Model.Status == BookingStatus.PendingPayment && !Model.RentalPaid)
            {
                <form asp-controller="Payments" asp-action="Pay" method="post" class="mt-3">
                    <input type="hidden" name="bookingId" value="@Model.BookingId" />
                    <input type="hidden" name="type" value="@PaymentType.Rental" />
                    <button class="btn btn-primary w-100" type="submit">Thanh toán tiền thuê mô phỏng</button>
                </form>
            }

            @if (Model.Status == BookingStatus.PendingInspection && Model.AdditionalAmount > 0 && !Model.AdditionalChargePaid)
            {
                <form asp-controller="Payments" asp-action="Pay" method="post" class="mt-3">
                    <input type="hidden" name="bookingId" value="@Model.BookingId" />
                    <input type="hidden" name="type" value="@PaymentType.AdditionalCharge" />
                    <button class="btn btn-warning w-100" type="submit">Thanh toán phụ phí mô phỏng</button>
                </form>
            }

            @if (Model.RentalPaid)
            {
                <div class="alert alert-success mt-3 mb-0">Tiền thuê đã thanh toán.</div>
            }
        </div>
    </div>
</div>
