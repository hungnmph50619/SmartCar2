@model SmartCar.Application.Features.Bookings.BookingDetailsDto
@using SmartCar.Domain.Enums
@using SmartCar.Web.Services

@{
    ViewData["Title"] = $"Đơn thuê #{Model.BookingId}";
    var earlyReturn = ViewBag.EarlyReturn as EarlyReturnSnapshot;
    var canSubmitEarlyReturn = Model.Status == BookingStatus.Rented &&
        earlyReturn?.Status != "Pending" &&
        earlyReturn?.Status != "Approved";
    var defaultReturnLocation = string.IsNullOrWhiteSpace(Model.ReturnLocation)
        ? "SmartCar"
        : Model.ReturnLocation;
    var earlyReturnMin = DateTime.Now.AddMinutes(1).ToString("yyyy-MM-ddTHH:mm");
    var earlyReturnMax = Model.ReturnDate.AddMinutes(-1).ToString("yyyy-MM-ddTHH:mm");
}

<partial name="Details" model="Model" />

@if (Model.Status == BookingStatus.Rented)
{
    <div class="card card-body shadow-sm mt-4" id="early-return-panel">
        <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3">
            <div>
                <div class="text-uppercase small text-muted fw-semibold">Thay đổi lịch trả</div>
                <h2 class="h5 mb-1">Trả xe sớm</h2>
                <p class="text-muted small mb-0">Nếu muốn kết thúc chuyến trước lịch, hãy gửi yêu cầu để SmartCar bố trí thời gian và địa điểm tiếp nhận.</p>
            </div>
            <span class="badge bg-primary">Đang thuê</span>
        </div>

        @if (earlyReturn?.Status == "Pending")
        {
            <div class="alert alert-warning mb-0">
                <div class="fw-bold">Yêu cầu đang chờ SmartCar xác nhận</div>
                <div class="small mt-2"><strong>Thời gian:</strong> @earlyReturn.RequestedReturnAt.ToString("dd/MM/yyyy HH:mm")</div>
                <div class="small"><strong>Địa điểm:</strong> @earlyReturn.ReturnLocation</div>
                <div class="small"><strong>Lý do:</strong> @earlyReturn.Reason</div>
                <div class="small text-muted mt-2">Trong thời gian chờ, đơn vẫn là Đang thuê và xe vẫn thuộc trách nhiệm của bạn.</div>
            </div>
        }
        else if (earlyReturn?.Status == "Approved")
        {
            <div class="alert alert-success mb-0">
                <div class="fw-bold">✓ SmartCar đã chấp thuận lịch trả sớm</div>
                <div class="small mt-2"><strong>Tiếp nhận:</strong> @earlyReturn.RequestedReturnAt.ToString("dd/MM/yyyy HH:mm")</div>
                <div class="small"><strong>Địa điểm:</strong> @earlyReturn.ReturnLocation</div>
                @if (!string.IsNullOrWhiteSpace(earlyReturn.DecisionNote))
                {
                    <div class="small"><strong>Ghi chú:</strong> @earlyReturn.DecisionNote</div>
                }
                <div class="small text-muted mt-2">Đơn chỉ chuyển sang bước kiểm tra sau khi SmartCar thực tế nhận lại xe và lập biên bản trả.</div>
            </div>
        }
        else
        {
            @if (earlyReturn?.Status == "Rejected")
            {
                <div class="alert alert-secondary py-2 small">
                    Yêu cầu trước chưa được chấp thuận@(string.IsNullOrWhiteSpace(earlyReturn.DecisionNote) ? "." : $": {earlyReturn.DecisionNote}") Bạn có thể gửi một thời gian khác phù hợp hơn.
                </div>
            }

            @if (canSubmitEarlyReturn)
            {
                <form asp-controller="Bookings"
                      asp-action="RequestEarlyReturn"
                      method="post"
                      class="row g-3"
                      data-loading-form
                      data-confirm="Gửi yêu cầu trả xe sớm? Đơn vẫn là Đang thuê cho đến khi SmartCar thực tế nhận lại xe.">
                    <input type="hidden" name="bookingId" value="@Model.BookingId" />

                    <div class="col-md-4">
                        <label class="form-label">Thời gian muốn trả</label>
                        <input type="datetime-local"
                               name="requestedReturnAt"
                               min="@earlyReturnMin"
                               max="@earlyReturnMax"
                               class="form-control"
                               required />
                        <div class="form-text">Sớm hơn lịch hiện tại @Model.ReturnDate.ToString("dd/MM/yyyy HH:mm").</div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Địa điểm trả xe</label>
                        <input type="text"
                               name="returnLocation"
                               maxlength="250"
                               class="form-control"
                               value="@defaultReturnLocation"
                               required />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Lý do</label>
                        <input type="text"
                               name="reason"
                               minlength="5"
                               maxlength="500"
                               class="form-control"
                               placeholder="Ví dụ: công việc kết thúc sớm"
                               required />
                    </div>

                    <div class="col-12 d-flex justify-content-between align-items-center gap-3 flex-wrap">
                        <div class="small text-muted">Trả sớm không tự động hoàn tiền thời gian chưa sử dụng; cọc vẫn được quyết toán sau khi trả xe.</div>
                        <button class="btn btn-outline-primary"
                                type="submit"
                                data-loading-text="Đang gửi yêu cầu...">Gửi yêu cầu trả xe sớm</button>
                    </div>
                </form>
            }
        }
    </div>
}
