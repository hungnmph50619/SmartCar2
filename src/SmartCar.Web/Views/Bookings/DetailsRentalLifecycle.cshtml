@model SmartCar.Application.Features.Bookings.BookingDetailsDto
@using SmartCar.Domain.Enums
@using SmartCar.Web.Services

@{
    ViewData["Title"] = $"Đơn thuê #{Model.BookingId}";
    var earlyReturn = ViewBag.EarlyReturn as EarlyReturnSnapshot;
    var canSubmitEarlyReturn = Model.Status == BookingStatus.Rented &&
        earlyReturn?.Status != "Pending" &&
        earlyReturn?.Status != "Approved";
    var defaultReturnLocation = string.IsNullOrWhiteSpace(Model.ReturnLocation)
        ? "SmartCar"
        : Model.ReturnLocation;
    var earlyReturnMin = DateTime.Now.AddMinutes(1).ToString("yyyy-MM-ddTHH:mm");
    var earlyReturnMax = Model.ReturnDate.AddMinutes(-1).ToString("yyyy-MM-ddTHH:mm");
}

<partial name="Details" model="Model" />

@if (Model.Status == BookingStatus.PendingInspection && Model.HasReturn)
{
    <div class="alert alert-info shadow-sm mt-4">
        <div class="text-uppercase small fw-semibold">Xe đã được SmartCar tiếp nhận</div>
        <div class="fw-bold fs-5">Biên bản trả xe đã được lưu</div>
        <div class="small mt-1">SmartCar đã lưu ảnh hiện trạng khi trả và ảnh biên bản giấy có chữ ký. Xe đang được kiểm tra để xác định phụ phí (nếu có) và quyết toán cọc bảo đảm.</div>
    </div>
}

@if (Model.Status == BookingStatus.Rented)
{
    <div class="card card-body shadow-sm mt-4" id="early-return-panel">
        <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3">
            <div>
                <div class="text-uppercase small text-danger fw-semibold">Kết thúc chuyến trước lịch</div>
                <h2 class="h5 mb-1">Hủy chuyến đang thuê</h2>
                <p class="text-muted small mb-0">Bạn có thể yêu cầu kết thúc chuyến và trả xe trước thời gian đã đặt. Tiền thuê và phí giao nhận của đơn vẫn được thu như đã thanh toán, không hoàn phần thời gian chưa sử dụng.</p>
            </div>
            <span class="badge bg-primary">Đang thuê</span>
        </div>

        <div class="alert alert-light border small">
            Sau khi gửi yêu cầu, xe vẫn thuộc trách nhiệm của bạn cho đến khi SmartCar thực tế nhận lại xe, hai bên ký biên bản trả xe và hệ thống chuyển sang bước kiểm tra. Cọc bảo đảm chỉ được quyết toán sau bước này.
        </div>

        @if (earlyReturn?.Status == "Pending")
        {
            <div class="alert alert-warning mb-0">
                <div class="fw-bold">Yêu cầu hủy chuyến đang chờ SmartCar xác nhận thời gian nhận lại xe</div>
                <div class="small mt-2"><strong>Thời gian muốn trả:</strong> @earlyReturn.RequestedReturnAt.ToString("dd/MM/yyyy HH:mm")</div>
                <div class="small"><strong>Địa điểm:</strong> @earlyReturn.ReturnLocation</div>
                <div class="small"><strong>Lý do:</strong> @earlyReturn.Reason</div>
                <div class="small text-muted mt-2">Tiền thuê/phí giao nhận không được hoàn do khách chủ động kết thúc chuyến khi xe đã được bàn giao.</div>
            </div>
        }
        else if (earlyReturn?.Status == "Approved")
        {
            <div class="alert alert-success mb-0">
                <div class="fw-bold">✓ SmartCar đã xác nhận lịch nhận lại xe</div>
                <div class="small mt-2"><strong>Tiếp nhận:</strong> @earlyReturn.RequestedReturnAt.ToString("dd/MM/yyyy HH:mm")</div>
                <div class="small"><strong>Địa điểm:</strong> @earlyReturn.ReturnLocation</div>
                @if (!string.IsNullOrWhiteSpace(earlyReturn.DecisionNote))
                {
                    <div class="small"><strong>Ghi chú:</strong> @earlyReturn.DecisionNote</div>
                }
                <div class="small text-muted mt-2">Khi trả xe, SmartCar sẽ chụp ảnh hiện trạng và hai bên ký biên bản trả xe. Tiền thuê/phí giao nhận vẫn giữ nguyên; cọc được quyết toán sau kiểm tra.</div>
            </div>
        }
        else
        {
            @if (earlyReturn?.Status == "Rejected")
            {
                <div class="alert alert-secondary py-2 small">
                    Thời gian tiếp nhận trước chưa được chấp thuận@(string.IsNullOrWhiteSpace(earlyReturn.DecisionNote) ? "." : $": {earlyReturn.DecisionNote}") Bạn có thể đề xuất thời gian khác.
                </div>
            }

            @if (canSubmitEarlyReturn)
            {
                <form asp-controller="Bookings"
                      asp-action="RequestEarlyReturn"
                      method="post"
                      class="row g-3"
                      data-loading-form
                      data-confirm="Hủy chuyến đang thuê và đề nghị trả xe sớm? Tiền thuê/phí giao nhận sẽ không được hoàn; xe vẫn thuộc trách nhiệm của bạn cho đến khi SmartCar nhận lại.">
                    <input type="hidden" name="bookingId" value="@Model.BookingId" />

                    <div class="col-md-4">
                        <label class="form-label">Thời gian muốn trả xe</label>
                        <input type="datetime-local"
                               name="requestedReturnAt"
                               min="@earlyReturnMin"
                               max="@earlyReturnMax"
                               class="form-control"
                               required />
                        <div class="form-text">Phải sớm hơn lịch hiện tại @Model.ReturnDate.ToString("dd/MM/yyyy HH:mm").</div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Địa điểm trả xe</label>
                        <input type="text"
                               name="returnLocation"
                               maxlength="250"
                               class="form-control"
                               value="@defaultReturnLocation"
                               required />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Lý do kết thúc chuyến</label>
                        <input type="text"
                               name="reason"
                               minlength="5"
                               maxlength="500"
                               class="form-control"
                               placeholder="Ví dụ: không còn nhu cầu sử dụng xe"
                               required />
                    </div>

                    <div class="col-12 d-flex justify-content-between align-items-center gap-3 flex-wrap">
                        <div class="small text-danger"><strong>Lưu ý:</strong> hủy chuyến khi đang thuê không hoàn tiền thuê/phí giao nhận đã thanh toán.</div>
                        <button class="btn btn-outline-danger"
                                type="submit"
                                data-loading-text="Đang gửi yêu cầu...">Hủy chuyến & đề nghị trả xe</button>
                    </div>
                </form>
            }
        }
    </div>
}

<script>
(() => {
    const statusAlert = document.querySelector('.alert[role="status"]');
    if (!statusAlert) return;

    statusAlert.innerHTML = statusAlert.innerHTML
        .replace(
            'SmartCar đang đối chiếu tình trạng xe, nhiên liệu, phụ kiện và quyết toán cọc bảo đảm.',
            'SmartCar đang đối chiếu tình trạng xe, ảnh biên bản giao nhận và quyết toán cọc bảo đảm.')
        .replace(
            'Nếu muốn trả sớm, hãy liên hệ SmartCar để thống nhất thời gian tiếp nhận.',
            'Nếu muốn kết thúc chuyến trước lịch, dùng mục Hủy chuyến đang thuê bên dưới để thống nhất thời gian SmartCar nhận lại xe.');
})();
</script>
