@model IReadOnlyList<SmartCar.Application.Features.Incidents.IncidentDto>
@using SmartCar.Domain.Enums
@{
    ViewData["Title"] = "Sự cố và vi phạm";

    IReadOnlyList<string> EvidencePaths(string? value) =>
        string.IsNullOrWhiteSpace(value)
            ? Array.Empty<string>()
            : value.Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
}

<div class="d-flex justify-content-between align-items-center mb-3 gap-3 flex-wrap">
    <div>
        <h1 class="h3 mb-1">Sự cố và vi phạm</h1>
        <p class="text-muted mb-0">Đối chiếu theo xe, đơn thuê, thời gian thực tế và bằng chứng.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Ghi nhận</a>
</div>

<div class="mb-3 d-flex flex-wrap gap-2">
    <a class="btn btn-sm btn-outline-secondary" asp-action="Index">Tất cả</a>
    @foreach (var status in Enum.GetValues<IncidentStatus>())
    {
        <a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-route-status="@status">@status.ToVietnamese()</a>
    }
</div>

<div class="row g-3">
@if (Model.Count == 0)
{
    <div class="col-12"><div class="alert alert-light border text-center">Chưa có sự cố hoặc vi phạm.</div></div>
}
else
{
    @foreach (var item in Model)
    {
        var isTrafficFine = item.IncidentType == IncidentType.TrafficFine;
        var evidence = EvidencePaths(item.EvidencePaths);
        <div class="col-12">
            <div class="card card-body shadow-sm border-0 rounded-4">
                <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                    <div>
                        <h2 class="h5 mb-1">#@item.VehicleIncidentId · @item.IncidentType.ToVietnamese()</h2>
                        <div><strong>@item.VehicleName</strong> · @item.LicensePlate</div>
                        <div class="text-muted small">
                            @item.OccurredAt.ToString("dd/MM/yyyy HH:mm")
                            @if (item.BookingId.HasValue) { <span> · Đơn #@item.BookingId</span> }
                            <span> · @(item.Location ?? "Không ghi địa điểm")</span>
                        </div>
                    </div>
                    <span class="badge bg-secondary">@item.Status.ToVietnamese()</span>
                </div>

                <p class="mt-3 mb-2">@item.Description</p>

                @if (isTrafficFine)
                {
                    <div class="alert alert-warning py-2 small mb-3">
                        <strong>Phạt/vi phạm được quản lý thành khoản phải thu riêng.</strong>
                        Hệ thống không giữ cọc nhiều tuần chỉ để chờ phạt nguội. Khi có thông báo chính thức,
                        thời điểm vi phạm phải nằm trong khoảng khách thực tế giữ xe; khoản còn nợ sẽ chặn khách tạo chuyến thuê mới.
                    </div>
                    <div class="row g-2 small mb-3">
                        <div class="col-md-4"><div class="border rounded-3 p-2">Tiền phạt: <strong>@item.FineAmount.ToString("N0") đ</strong></div></div>
                        <div class="col-md-4"><div class="border rounded-3 p-2">Khách chịu: <strong>@item.CustomerLiabilityAmount.ToString("N0") đ</strong></div></div>
                        <div class="col-md-4"><div class="border rounded-3 p-2">Trạng thái hồ sơ: <strong>@item.Status.ToVietnamese()</strong></div></div>
                    </div>
                }
                else
                {
                    <div class="row small mb-3">
                        <div class="col-md-4">Ước tính: <strong>@item.EstimatedCost.ToString("N0") đ</strong></div>
                        <div class="col-md-4">Thực tế: <strong>@item.ActualCost.ToString("N0") đ</strong></div>
                        <div class="col-md-4">Khách chịu: <strong>@item.CustomerLiabilityAmount.ToString("N0") đ</strong></div>
                    </div>
                }

                @if (evidence.Count > 0)
                {
                    <div class="d-flex gap-2 flex-wrap mb-3">
                        @for (var index = 0; index < evidence.Count; index++)
                        {
                            <a class="btn btn-sm btn-outline-primary" href="@evidence[index]" target="_blank" rel="noopener">Bằng chứng @(index + 1)</a>
                        }
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(item.Notes))
                {
                    <div class="small text-muted mb-3"><strong>Ghi chú:</strong> @item.Notes</div>
                }

                @if (item.Status == IncidentStatus.Open)
                {
                    <form asp-action="StartInvestigation" method="post" class="mb-3">
                        <input type="hidden" name="id" value="@item.VehicleIncidentId" />
                        <button class="btn btn-outline-primary btn-sm" type="submit">Bắt đầu xử lý</button>
                    </form>
                }

                @if (item.Status is IncidentStatus.Open or IncidentStatus.Investigating)
                {
                    <details>
                        <summary class="fw-semibold">Hoàn tất / chốt hồ sơ</summary>
                        <form asp-action="Resolve" method="post" class="row g-2 mt-2">
                            <input type="hidden" name="IncidentId" value="@item.VehicleIncidentId" />
                            @if (isTrafficFine)
                            {
                                <input type="hidden" name="ActualCost" value="0" />
                                <input type="hidden" name="RequiresMaintenance" value="false" />
                                <div class="col-md-3">
                                    <label class="form-label small mb-1">Tiền phạt chính thức</label>
                                    <input name="FineAmount" type="number" min="1" value="@item.FineAmount" class="form-control" required />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small mb-1">Khách chịu</label>
                                    <input name="CustomerLiabilityAmount" type="number" min="1" value="@item.CustomerLiabilityAmount" class="form-control" required />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small mb-1">Kết luận</label>
                                    <input name="Notes" class="form-control" placeholder="VD: đã đối chiếu thông báo chính thức" />
                                </div>
                                <div class="col-md-2 d-flex align-items-end">
                                    <button class="btn btn-success w-100" type="submit">Chốt hồ sơ</button>
                                </div>
                                <div class="col-12 small text-muted">
                                    Chốt hồ sơ không xóa khoản nợ. Nếu chưa thanh toán, khoản phải thu vẫn tồn tại độc lập cho đến khi được đối soát Paid.
                                </div>
                            }
                            else
                            {
                                <div class="col-md-3"><input name="ActualCost" type="number" min="0" value="@item.ActualCost" class="form-control" placeholder="Chi phí thực tế" /></div>
                                <div class="col-md-3"><input name="FineAmount" type="number" min="0" value="@item.FineAmount" class="form-control" placeholder="Khoản phạt/chi phí" /></div>
                                <div class="col-md-3"><input name="CustomerLiabilityAmount" type="number" min="0" value="@item.CustomerLiabilityAmount" class="form-control" placeholder="Khách chịu" /></div>
                                <div class="col-md-3 d-flex align-items-center">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="RequiresMaintenance" value="true" id="maintenance-@item.VehicleIncidentId" />
                                        <label class="form-check-label" for="maintenance-@item.VehicleIncidentId">Cần bảo trì</label>
                                    </div>
                                </div>
                                <div class="col-md-9"><input name="Notes" class="form-control" placeholder="Kết luận xử lý" /></div>
                                <div class="col-md-3"><button class="btn btn-success w-100" type="submit">Hoàn tất</button></div>
                            }
                        </form>
                    </details>
                }
            </div>
        </div>
    }
}
</div>