@model SmartCar.Web.ViewModels.IncidentCreateViewModel
@using SmartCar.Domain.Enums
@{
    ViewData["Title"] = "Ghi nhận sự cố";
    var occurredDate = Model.OccurredAt.ToString("yyyy-MM-dd");
    var occurredTime = Model.OccurredAt.ToString("HH:mm");
}

<div class="row justify-content-center">
    <div class="col-xl-10">
        <div class="card card-body shadow-sm border-0 rounded-4 p-4 p-lg-5">
            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4">
                <div>
                    <h1 class="h3 mb-1">Sự cố / vi phạm</h1>
                    <p class="text-muted mb-0">Gắn đúng xe, đúng đơn thuê và bằng chứng. Phạt nguội được đối chiếu theo thời gian khách thực tế giữ xe.</p>
                </div>
                <a class="btn btn-outline-secondary" asp-action="Index">← Danh sách</a>
            </div>

            <form asp-action="Create" method="post" class="row g-3" id="incident-form">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                <input asp-for="OccurredAt" type="hidden" id="occurred-at-value" />

                <div class="col-md-5">
                    <label class="form-label fw-semibold">Xe</label>
                    <select asp-for="VehicleId" asp-items="ViewBag.Vehicles" class="form-select"></select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Đơn liên quan</label>
                    <input asp-for="BookingId" type="number" min="1" class="form-control" id="incident-booking-id" placeholder="#" />
                    <div class="form-text">Bắt buộc với phạt nguội.</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Loại</label>
                    <select asp-for="IncidentType" class="form-select" id="incident-type">
                        @foreach (var type in Enum.GetValues<IncidentType>())
                        {
                            <option value="@type">@type.ToVietnamese()</option>
                        }
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Thời điểm xảy ra</label>
                    <div class="row g-2">
                        <div class="col-7"><input type="date" id="occurred-date" class="form-control" value="@occurredDate" required /></div>
                        <div class="col-5"><input type="text" id="occurred-time" class="form-control" value="@occurredTime" inputmode="numeric" maxlength="5" pattern="(?:[01][0-9]|2[0-3]):[0-5][0-9]" placeholder="HH:mm" required /></div>
                    </div>
                    <div class="form-text">Giờ 24h.</div>
                </div>
                <div class="col-md-8">
                    <label class="form-label fw-semibold">Địa điểm</label>
                    <input asp-for="Location" class="form-control" placeholder="Địa điểm/số camera/tuyến đường nếu có" />
                </div>

                <div class="col-12 d-none" id="traffic-fine-note">
                    <div class="alert alert-warning mb-0">
                        <div class="fw-bold mb-1">Phạt nguội không giữ cọc suốt 1 tháng</div>
                        <div class="small">
                            Khi có thông báo chính thức, hệ thống kiểm tra thời điểm vi phạm có nằm trong
                            <strong>HandoverAt → ReturnedAt</strong> của đơn hay không, lưu bằng chứng rồi tạo khoản phải thu riêng.
                            Nếu khách chưa thanh toán, tài khoản sẽ bị chặn tạo chuyến thuê mới.
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <label class="form-label fw-semibold">Mô tả</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Nội dung sự cố hoặc thông báo vi phạm"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="col-md-4" id="estimated-cost-group">
                    <label class="form-label fw-semibold">Chi phí ước tính</label>
                    <input asp-for="EstimatedCost" type="number" min="0" class="form-control" />
                </div>
                <div class="col-md-4" id="fine-amount-group">
                    <label class="form-label fw-semibold">Tiền phạt chính thức</label>
                    <input asp-for="FineAmount" type="number" min="0" class="form-control" id="incident-fine-amount" />
                    <span asp-validation-for="FineAmount" class="text-danger small"></span>
                </div>
                <div class="col-md-4" id="liability-group">
                    <label class="form-label fw-semibold">Khách chịu</label>
                    <input asp-for="CustomerLiabilityAmount" type="number" min="0" class="form-control" id="incident-liability-amount" />
                    <span asp-validation-for="CustomerLiabilityAmount" class="text-danger small"></span>
                    <div class="form-text d-none" id="liability-help">Không được lớn hơn tiền phạt chính thức.</div>
                </div>

                <div class="col-12">
                    <label class="form-label fw-semibold">Bằng chứng / thông báo</label>
                    <input asp-for="EvidencePaths" class="form-control" id="incident-evidence" placeholder="Đường dẫn ảnh/tài liệu, phân cách bằng ;" />
                    <div class="form-text">Với phạt nguội: bắt buộc có thông báo/ảnh làm căn cứ trước khi tạo khoản phải thu.</div>
                    <span asp-validation-for="EvidencePaths" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">Ghi chú</label>
                    <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Ghi chú nội bộ nếu cần"></textarea>
                </div>
                <div class="col-12 d-flex gap-2 pt-2">
                    <button class="btn btn-primary px-4" type="submit">Lưu hồ sơ</button>
                    <a class="btn btn-outline-secondary px-4" asp-action="Index">Quay lại</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const form = document.getElementById('incident-form');
            const type = document.getElementById('incident-type');
            const booking = document.getElementById('incident-booking-id');
            const trafficNote = document.getElementById('traffic-fine-note');
            const estimatedGroup = document.getElementById('estimated-cost-group');
            const fineGroup = document.getElementById('fine-amount-group');
            const liabilityGroup = document.getElementById('liability-group');
            const liabilityHelp = document.getElementById('liability-help');
            const estimated = document.getElementById('EstimatedCost');
            const fine = document.getElementById('incident-fine-amount');
            const liability = document.getElementById('incident-liability-amount');
            const evidence = document.getElementById('incident-evidence');
            const hidden = document.getElementById('occurred-at-value');
            const date = document.getElementById('occurred-date');
            const time = document.getElementById('occurred-time');
            const pattern = /^(?:[01]\d|2[0-3]):[0-5]\d$/;

            function isTrafficFine() {
                return type?.value === 'TrafficFine';
            }

            function validateTrafficAmounts() {
                if (!isTrafficFine()) {
                    fine?.setCustomValidity('');
                    liability?.setCustomValidity('');
                    evidence?.setCustomValidity('');
                    return true;
                }

                const fineValue = Number(fine?.value || 0);
                const liabilityValue = Number(liability?.value || 0);
                fine?.setCustomValidity(fineValue > 0 ? '' : 'Tiền phạt phải lớn hơn 0.');
                liability?.setCustomValidity(
                    liabilityValue <= 0
                        ? 'Số tiền khách chịu phải lớn hơn 0.'
                        : liabilityValue > fineValue
                            ? 'Số tiền khách chịu không được lớn hơn tiền phạt.'
                            : '');
                evidence?.setCustomValidity((evidence?.value || '').trim() ? '' : 'Phạt nguội phải có bằng chứng/thông báo.');
                return fineValue > 0 && liabilityValue > 0 && liabilityValue <= fineValue && !!(evidence?.value || '').trim();
            }

            function updateType() {
                const traffic = isTrafficFine();
                trafficNote?.classList.toggle('d-none', !traffic);
                estimatedGroup?.classList.toggle('d-none', traffic);
                liabilityHelp?.classList.toggle('d-none', !traffic);
                if (booking) booking.required = traffic;
                if (traffic && estimated) estimated.value = '0';
                validateTrafficAmounts();
            }

            function syncDateTime() {
                if (!date?.value || !pattern.test(time?.value || '')) return false;
                hidden.value = `${date.value}T${time.value}`;
                return true;
            }

            type?.addEventListener('change', updateType);
            fine?.addEventListener('input', () => {
                if (isTrafficFine() && Number(liability?.value || 0) === 0 && Number(fine.value || 0) > 0) {
                    liability.value = fine.value;
                }
                validateTrafficAmounts();
            });
            liability?.addEventListener('input', validateTrafficAmounts);
            evidence?.addEventListener('input', validateTrafficAmounts);
            date?.addEventListener('change', syncDateTime);
            time?.addEventListener('input', syncDateTime);

            form?.addEventListener('submit', event => {
                const timeOk = syncDateTime();
                const trafficOk = validateTrafficAmounts();
                if (!timeOk) {
                    time?.setCustomValidity('Nhập giờ 24h theo dạng HH:mm.');
                } else {
                    time?.setCustomValidity('');
                }
                if (!timeOk || !trafficOk) {
                    event.preventDefault();
                    form.reportValidity();
                }
            });

            updateType();
            syncDateTime();
        })();
    </script>
}
