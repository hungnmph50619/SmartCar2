@model SmartCar.Web.ViewModels.IncidentCreateViewModel
@using SmartCar.Domain.Enums
@{
    ViewData["Title"] = "Ghi nhận sự cố";
    var occurredDate = Model.OccurredAt.ToString("yyyy-MM-dd");
    var occurredTime = Model.OccurredAt.ToString("HH:mm");
    var isStaff = User.IsInRole("Staff") && !User.IsInRole("Admin");
}

<div class="row justify-content-center">
    <div class="col-xl-10">
        <div class="card card-body shadow-sm border-0 rounded-4 p-4 p-lg-5">
            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4">
                <div>
                    <h1 class="h3 mb-1">@(isStaff ? "Phát hiện hỏng hóc" : "Sự cố / vi phạm")</h1>
                    <p class="text-muted mb-0">@(isStaff ? "Ghi mô tả, ảnh và đơn thuê liên quan. Xe sẽ ngừng hoạt động sau khi lưu." : "Gắn đúng xe, đúng đơn thuê và bằng chứng. Phạt nguội được đối chiếu theo thời gian khách thực tế giữ xe.")</p>
                </div>
                @if (isStaff) { <a class="btn btn-outline-secondary" asp-controller="Staff" asp-action="Details" asp-route-id="@Model.BookingId">← Về đơn thuê</a> }
                else { <a class="btn btn-outline-secondary" asp-action="Index">← Danh sách</a> }
            </div>

            <form asp-action="Create" method="post" enctype="multipart/form-data" class="row g-3" id="incident-form" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                <input asp-for="OccurredAt" type="hidden" id="occurred-at-value" />

                <div class="col-md-5">
                    <label class="form-label fw-semibold">Xe</label>
                    <select asp-for="VehicleId" asp-items="ViewBag.Vehicles" class="form-select"></select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Đơn liên quan</label>
                    <input asp-for="BookingId" type="number" min="1" step="1" class="form-control" id="incident-booking-id" placeholder="#" />
                    <div class="form-text">@(isStaff ? "Bắt buộc khi nhân viên báo hỏng sau thuê." : "Bắt buộc với phạt nguội.")</div>
                    <span asp-validation-for="BookingId" class="text-danger small"></span>
                </div>
                <div class="col-md-4 @(isStaff ? "d-none" : "")">
                    <label class="form-label fw-semibold">Loại</label>
                    <select asp-for="IncidentType" class="form-select" id="incident-type">
                        @foreach (var type in Enum.GetValues<IncidentType>())
                        {
                            <option value="@type" selected="@(type == Model.IncidentType)">@type.ToVietnamese()</option>
                        }
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Thời điểm xảy ra</label>
                    <div class="row g-2">
                        <div class="col-7"><input type="date" id="occurred-date" class="form-control" value="@occurredDate" required /></div>
                        <div class="col-5"><input type="text" id="occurred-time" class="form-control" value="@occurredTime" inputmode="numeric" maxlength="5" pattern="(?:[01][0-9]|2[0-3]):[0-5][0-9]" placeholder="HH:mm" required /></div>
                    </div>
                    <div class="form-text">Giờ 24h.</div>
                    <div class="text-danger small mt-1" id="occurred-at-error"></div>
                </div>
                <div class="col-md-8">
                    <label class="form-label fw-semibold">Địa điểm</label>
                    <input asp-for="Location" class="form-control" placeholder="Địa điểm/số camera/tuyến đường nếu có" />
                </div>

                <div class="col-12 d-none" id="traffic-fine-note">
                    <div class="alert alert-warning mb-0">
                        <div class="fw-bold mb-1">Phạt nguội không giữ cọc suốt 1 tháng</div>
                        <div class="small">
                            Khi có thông báo chính thức, hệ thống kiểm tra thời điểm vi phạm có nằm trong
                            <strong>thời điểm giao xe → thời điểm trả xe thực tế</strong> của đơn hay không, lưu bằng chứng rồi tạo khoản phải thu riêng.
                            Nếu khách chưa thanh toán, tài khoản sẽ bị chặn tạo chuyến thuê mới.
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <label class="form-label fw-semibold">Mô tả</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Nội dung sự cố hoặc thông báo vi phạm"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="col-md-4 @(isStaff ? "d-none" : "")" id="estimated-cost-group">
                    <label class="form-label fw-semibold">Chi phí ước tính</label>
                    <input asp-for="EstimatedCost" type="number" min="0" step="1" class="form-control" id="incident-estimated-cost" inputmode="numeric" />
                    <span asp-validation-for="EstimatedCost" class="text-danger small"></span>
                </div>
                <div class="col-md-4 @(isStaff ? "d-none" : "")" id="fine-amount-group">
                    <label class="form-label fw-semibold">Tiền phạt chính thức</label>
                    <input asp-for="FineAmount" type="number" min="0" step="1" class="form-control" id="incident-fine-amount" inputmode="numeric" />
                    <span asp-validation-for="FineAmount" class="text-danger small"></span>
                </div>
                <div class="col-md-4 @(isStaff ? "d-none" : "")" id="liability-group">
                    <label class="form-label fw-semibold">Khách chịu</label>
                    <input asp-for="CustomerLiabilityAmount" type="number" min="0" step="1" class="form-control" id="incident-liability-amount" inputmode="numeric" />
                    <span asp-validation-for="CustomerLiabilityAmount" class="text-danger small"></span>
                    <div class="form-text d-none" id="liability-help">Không được lớn hơn tiền phạt chính thức.</div>
                </div>

                <div class="col-12 @(isStaff ? "d-none" : "")">
                    <label class="form-label fw-semibold">Bằng chứng / thông báo</label>
                    <input asp-for="EvidencePaths" class="form-control" id="incident-evidence" placeholder="Đường dẫn ảnh/tài liệu, phân cách bằng ;" />
                    <div class="form-text">Với phạt nguội: bắt buộc có thông báo/ảnh làm căn cứ trước khi tạo khoản phải thu.</div>
                    <span asp-validation-for="EvidencePaths" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Images" class="form-label fw-semibold">Ảnh hỏng hóc @(isStaff ? "*" : "(nếu có)")</label>
                    <input asp-for="Images" type="file" multiple accept="image/jpeg,image/png,image/webp" class="form-control" />
                    <div class="form-text">Tối đa 5 ảnh, mỗi ảnh không quá 5 MB.</div>
                    <span asp-validation-for="Images" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">Ghi chú</label>
                    <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Ghi chú nội bộ nếu cần"></textarea>
                </div>
                <div class="col-12 d-flex gap-2 pt-2">
                    <button class="btn btn-primary px-4" type="submit">Lưu hồ sơ</button>
                    @if (isStaff) { <a class="btn btn-outline-secondary px-4" asp-controller="Staff" asp-action="Details" asp-route-id="@Model.BookingId">Quay lại</a> }
                    else { <a class="btn btn-outline-secondary px-4" asp-action="Index">Quay lại</a> }
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const form = document.getElementById('incident-form');
            const type = document.getElementById('incident-type');
            const booking = document.getElementById('incident-booking-id');
            const trafficNote = document.getElementById('traffic-fine-note');
            const estimatedGroup = document.getElementById('estimated-cost-group');
            const fineGroup = document.getElementById('fine-amount-group');
            const liabilityGroup = document.getElementById('liability-group');
            const liabilityHelp = document.getElementById('liability-help');
            const estimated = document.getElementById('incident-estimated-cost');
            const fine = document.getElementById('incident-fine-amount');
            const liability = document.getElementById('incident-liability-amount');
            const evidence = document.getElementById('incident-evidence');
            const hidden = document.getElementById('occurred-at-value');
            const date = document.getElementById('occurred-date');
            const time = document.getElementById('occurred-time');
            const pattern = /^(?:[01]\d|2[0-3]):[0-5]\d$/;
            const occurredError = document.getElementById('occurred-at-error');
            const moneyInputs = [
                { input: estimated, field: 'EstimatedCost', label: 'Chi phí ước tính' },
                { input: fine, field: 'FineAmount', label: 'Tiền phạt chính thức' },
                { input: liability, field: 'CustomerLiabilityAmount', label: 'Số tiền khách chịu' }
            ];

            function isTrafficFine() {
                return type?.value === 'TrafficFine';
            }

            function setFieldMessage(fieldName, message) {
                const target = form?.querySelector('[data-valmsg-for="' + fieldName + '"]');
                if (!target) return;
                target.textContent = message || '';
                target.classList.toggle('field-validation-error', !!message);
                target.classList.toggle('field-validation-valid', !message);
            }

            function setOccurredMessage(message) {
                if (occurredError) occurredError.textContent = message || '';
            }

            function validateNonNegativeInteger(input, fieldName, label) {
                if (!input) return true;
                const raw = (input.value || '').trim();

                if (!raw) {
                    input.setCustomValidity('');
                    setFieldMessage(fieldName, '');
                    return true;
                }

                if (!/^\d+$/.test(raw)) {
                    const message = label + ' chỉ được nhập số nguyên từ 0 trở lên.';
                    input.setCustomValidity(message);
                    setFieldMessage(fieldName, message);
                    return false;
                }

                const value = Number(raw);
                if (!Number.isSafeInteger(value) || value < 0) {
                    const message = label + ' không được âm và phải là số nguyên hợp lệ.';
                    input.setCustomValidity(message);
                    setFieldMessage(fieldName, message);
                    return false;
                }

                input.setCustomValidity('');
                setFieldMessage(fieldName, '');
                return true;
            }

            function validateAllMoney() {
                return moneyInputs
                    .map(item => validateNonNegativeInteger(item.input, item.field, item.label))
                    .every(Boolean);
            }

            function blockInvalidNumberKeys(event) {
                if (['-', '+', 'e', 'E', '.', ','].includes(event.key)) {
                    event.preventDefault();
                }
            }

            function blockInvalidPaste(event, label) {
                const pasted = event.clipboardData?.getData('text')?.trim() || '';
                if (pasted && !/^\d+$/.test(pasted)) {
                    event.preventDefault();
                    const message = label + ' chỉ được nhập số nguyên từ 0 trở lên.';
                    event.currentTarget.setCustomValidity(message);
                }
            }

            function validateBooking() {
                if (!booking) return true;
                const raw = (booking.value || '').trim();

                if (isTrafficFine() && !raw) {
                    const message = 'Vui lòng nhập mã đơn liên quan cho phạt nguội.';
                    booking.setCustomValidity(message);
                    setFieldMessage('BookingId', message);
                    return false;
                }

                if (raw && (!/^\d+$/.test(raw) || Number(raw) <= 0)) {
                    const message = 'Mã đơn liên quan phải là số nguyên lớn hơn 0.';
                    booking.setCustomValidity(message);
                    setFieldMessage('BookingId', message);
                    return false;
                }

                booking.setCustomValidity('');
                setFieldMessage('BookingId', '');
                return true;
            }

            function localDateValue(value) {
                const year = value.getFullYear();
                const month = String(value.getMonth() + 1).padStart(2, '0');
                const day = String(value.getDate()).padStart(2, '0');
                return year + '-' + month + '-' + day;
            }

            function localTimeValue(value) {
                const hours = String(value.getHours()).padStart(2, '0');
                const minutes = String(value.getMinutes()).padStart(2, '0');
                return hours + ':' + minutes;
            }

            function preventFutureOccurredAt() {
                if (!date || !time) return;

                const now = new Date();
                const today = localDateValue(now);
                const currentTime = localTimeValue(now);

                date.max = today;

                if (date.value && date.value > today) {
                    date.value = today;
                    time.value = currentTime;
                }

                if (date.value === today &&
                    pattern.test(time.value || '') &&
                    time.value > currentTime) {
                    time.value = currentTime;
                }

                date.setCustomValidity('');
                time.setCustomValidity('');
                setOccurredMessage('');
            }

            function validateOccurredAt() {
                preventFutureOccurredAt();

                if (!date?.value) {
                    const message = 'Vui lòng chọn ngày xảy ra.';
                    date?.setCustomValidity(message);
                    setOccurredMessage(message);
                    return false;
                }

                if (!pattern.test(time?.value || '')) {
                    const message = 'Vui lòng nhập giờ 24h theo dạng HH:mm.';
                    time?.setCustomValidity(message);
                    setOccurredMessage(message);
                    return false;
                }

                const occurred = new Date(date.value + 'T' + time.value + ':00');

                if (Number.isNaN(occurred.getTime())) {
                    const message = 'Thời điểm xảy ra không hợp lệ.';
                    time?.setCustomValidity(message);
                    setOccurredMessage(message);
                    return false;
                }

                if (occurred > new Date()) {
                    const now = new Date();
                    date.value = localDateValue(now);
                    time.value = localTimeValue(now);
                }

                date.setCustomValidity('');
                time.setCustomValidity('');
                setOccurredMessage('');
                hidden.value = date.value + 'T' + time.value;
                return true;
            }

            function validateTrafficAmounts() {
                if (!isTrafficFine()) {
                    fine?.setCustomValidity('');
                    liability?.setCustomValidity('');
                    evidence?.setCustomValidity('');
                    return true;
                }

                const fineValue = /^\d+$/.test(fine?.value || '') ? Number(fine.value) : 0;
                const liabilityValue = /^\d+$/.test(liability?.value || '') ? Number(liability.value) : 0;
                fine?.setCustomValidity(fineValue > 0 ? '' : 'Tiền phạt phải lớn hơn 0.');
                liability?.setCustomValidity(
                    liabilityValue <= 0
                        ? 'Số tiền khách chịu phải lớn hơn 0.'
                        : liabilityValue > fineValue
                            ? 'Số tiền khách chịu không được lớn hơn tiền phạt.'
                            : '');
                evidence?.setCustomValidity((evidence?.value || '').trim() ? '' : 'Phạt nguội phải có bằng chứng/thông báo.');
                return fineValue > 0 && liabilityValue > 0 && liabilityValue <= fineValue && !!(evidence?.value || '').trim();
            }

            function updateType() {
                const traffic = isTrafficFine();
                trafficNote?.classList.toggle('d-none', !traffic);
                estimatedGroup?.classList.toggle('d-none', traffic);
                liabilityHelp?.classList.toggle('d-none', !traffic);
                if (traffic && estimated) estimated.value = '0';
                validateBooking();
                validateAllMoney();
                validateTrafficAmounts();
            }

            function syncDateTime() {
                return validateOccurredAt();
            }

            type?.addEventListener('change', updateType);

            booking?.addEventListener('keydown', blockInvalidNumberKeys);
            booking?.addEventListener('paste', event => blockInvalidPaste(event, 'Mã đơn liên quan'));
            booking?.addEventListener('input', validateBooking);

            moneyInputs.forEach(item => {
                item.input?.addEventListener('keydown', blockInvalidNumberKeys);
                item.input?.addEventListener('paste', event => blockInvalidPaste(event, item.label));
                item.input?.addEventListener('input', () => {
                    validateNonNegativeInteger(item.input, item.field, item.label);
                });
            });

            fine?.addEventListener('input', () => {
                if (isTrafficFine() && Number(liability?.value || 0) === 0 && Number(fine.value || 0) > 0) {
                    liability.value = fine.value;
                }
                validateTrafficAmounts();
            });
            liability?.addEventListener('input', validateTrafficAmounts);
            evidence?.addEventListener('input', validateTrafficAmounts);
            date?.addEventListener('change', () => {
                preventFutureOccurredAt();
                validateOccurredAt();
            });
            date?.addEventListener('input', preventFutureOccurredAt);
            time?.addEventListener('input', () => {
                preventFutureOccurredAt();
                validateOccurredAt();
            });
            time?.addEventListener('blur', validateOccurredAt);

            form?.addEventListener('submit', event => {
                const bookingOk = validateBooking();
                const timeOk = validateOccurredAt();
                const moneyOk = validateAllMoney();
                const trafficOk = validateTrafficAmounts();

                if (!bookingOk || !timeOk || !moneyOk || !trafficOk) {
                    event.preventDefault();
                    form.reportValidity();
                }
            });

            preventFutureOccurredAt();
            updateType();
            syncDateTime();
        })();
    </script>
}
