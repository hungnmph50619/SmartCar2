@model SmartCar.Application.Features.Audits.AuditLogDto
@using System.Text.Json
@using SmartCar.Web.Services
@{
    ViewData["Title"] = $"Chi tiết nhật ký #{Model.AuditLogId}";

    static string FormatPayload(string? payload)
    {
        if (string.IsNullOrWhiteSpace(payload))
        {
            return string.Empty;
        }

        try
        {
            using var document = JsonDocument.Parse(payload);
            return JsonSerializer.Serialize(document.RootElement, new JsonSerializerOptions
            {
                WriteIndented = true
            });
        }
        catch
        {
            return payload;
        }
    }

    string AuditBadgeClass(string action) => action switch
    {
        "Delete" or "Reject" or "AdminCancel" or "CustomerCancel" or "LockCustomer" => "audit-action-danger",
        "Verify" or "VerifyAll" or "Confirm" or "CompleteBooking" or "Resolve" or "UnlockCustomer" => "audit-action-success",
        "ViewKycDocumentImage" => "audit-action-info",
        "Submit" or "SubmitKycPackage" or "ChangePassword" or "UpdateBankAccount" or "UpdateAvatar" or "Update" or "ChangeStatus" or "UpdateRentalPolicy" => "audit-action-primary",
        "RequestResubmission" or "RequestUpdate" or "AddCharge" => "audit-action-warning",
        _ => "audit-action-secondary"
    };

    string FriendlyIp(string? ip) => ip switch
    {
        null or "" => "Không ghi nhận",
        "::1" or "127.0.0.1" => "Máy cục bộ",
        _ => ip
    };

    var hasOldValues = !string.IsNullOrWhiteSpace(Model.OldValues);
    var hasNewValues = !string.IsNullOrWhiteSpace(Model.NewValues);
    var hasSnapshot = hasOldValues || hasNewValues;
    var payloadColumnClass = hasOldValues && hasNewValues ? "col-lg-6" : "col-12";
    var showEntityId = !string.IsNullOrWhiteSpace(Model.EntityId) && !Guid.TryParse(Model.EntityId, out _);
    var isPolicyChange = Model.Action == "UpdateRentalPolicy" && Model.EntityName == "BusinessSetting";
    var policyChanges = isPolicyChange
        ? BusinessPolicyAuditFormatter.GetChanges(Model.OldValues, Model.NewValues)
        : Array.Empty<BusinessPolicyAuditChange>();
    var friendlyDescription = isPolicyChange
        ? BusinessPolicyAuditFormatter.BuildSummary(Model.OldValues, Model.NewValues)
        : Model.Description.ToFriendlyAuditDescription();
}

<link rel="stylesheet" href="~/css/admin-audit.css" asp-append-version="true" />

<div class="audit-page audit-detail-page">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-start gap-3 mb-4">
        <div>
            <div class="small text-primary fw-semibold mb-1">NHẬT KÝ #@Model.AuditLogId</div>
            <h1 class="h2 fw-bold mb-1">@Model.Action.ToVietnameseAuditAction()</h1>
            <p class="text-muted mb-0">
                @Model.EntityName.ToVietnameseEntity()
                @if (showEntityId)
                {
                    <text> #@Model.EntityId</text>
                }
                <span class="mx-1">·</span>
                @Model.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")
            </p>
        </div>
        <a class="btn btn-outline-primary" asp-action="Index">← Quay lại nhật ký</a>
    </div>

    <section class="card border-0 shadow-sm audit-detail-summary mb-4">
        <div class="card-body p-4">
            <div class="d-flex align-items-center gap-2 flex-wrap mb-3">
                <span class="audit-action-badge @AuditBadgeClass(Model.Action)">@Model.Action.ToVietnameseAuditAction()</span>
                <span class="small text-muted">@Model.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm:ss") · Giờ Việt Nam (UTC+7)</span>
            </div>

            <div class="audit-description-block mb-4">
                <span>Nội dung thao tác</span>
                <p class="mb-0">@friendlyDescription</p>
            </div>

            <dl class="audit-info-list mb-0">
                <div>
                    <dt>Người thực hiện</dt>
                    <dd>@(Model.UserName ?? "Hệ thống")</dd>
                </div>
                <div>
                    <dt>Dữ liệu liên quan</dt>
                    <dd>
                        @Model.EntityName.ToVietnameseEntity()
                        @if (showEntityId)
                        {
                            <text> #@Model.EntityId</text>
                        }
                    </dd>
                </div>
                <div>
                    <dt>Nơi thực hiện</dt>
                    <dd>
                        @if (string.IsNullOrWhiteSpace(Model.IpAddress))
                        {
                            <span class="text-muted">Không ghi nhận</span>
                        }
                        else if (Model.IpAddress is "::1" or "127.0.0.1")
                        {
                            <span class="audit-ip-friendly" title="Địa chỉ kỹ thuật: @Model.IpAddress">Máy cục bộ</span>
                        }
                        else
                        {
                            <span class="audit-ip-friendly">@FriendlyIp(Model.IpAddress)</span>
                        }
                    </dd>
                </div>
            </dl>

            <details class="audit-tech-details mt-4">
                <summary>Thông tin kỹ thuật</summary>
                <p class="small text-muted mt-2 mb-2">Dành cho việc kiểm tra hệ thống khi cần truy vết sâu hơn.</p>
                <dl class="audit-tech-list mb-0">
                    <div>
                        <dt>Mã hành động</dt>
                        <dd><code class="audit-tech-code">@Model.Action</code></dd>
                    </div>
                    <div>
                        <dt>Loại dữ liệu</dt>
                        <dd><code class="audit-tech-code">@Model.EntityName</code></dd>
                    </div>
                    <div>
                        <dt>Mã bản ghi</dt>
                        <dd><code class="audit-tech-code">@(Model.EntityId ?? "Không ghi nhận")</code></dd>
                    </div>
                    <div>
                        <dt>Mã người dùng hệ thống</dt>
                        <dd><code class="audit-tech-code">@(Model.UserId ?? "Không ghi nhận")</code></dd>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.IpAddress))
                    {
                        <div>
                            <dt>Địa chỉ IP gốc</dt>
                            <dd><code class="audit-tech-code">@Model.IpAddress</code></dd>
                        </div>
                    }
                </dl>
            </details>
        </div>
    </section>

    @if (isPolicyChange && policyChanges.Count > 0)
    {
        <section class="card border-0 shadow-sm audit-data-card">
            <div class="card-header bg-white border-0 px-4 pt-4 pb-2 d-flex justify-content-between align-items-start gap-3 flex-wrap">
                <div>
                    <h2 class="h5 fw-bold mb-1">Thay đổi chính sách</h2>
                    <p class="small text-muted mb-0">Chỉ hiển thị những giá trị thực sự đã thay đổi.</p>
                </div>
                <span class="badge rounded-pill text-bg-light border">@policyChanges.Count thay đổi</span>
            </div>

            <div class="card-body px-4 pt-2 pb-4">
                <div class="audit-change-list">
                    @foreach (var change in policyChanges)
                    {
                        <div class="audit-change-item">
                            <div class="audit-change-label">@change.Label</div>

                            @if (change.IsLongText)
                            {
                                <div class="audit-change-long">
                                    <span class="badge rounded-pill audit-change-updated">Đã cập nhật nội dung</span>
                                    <details>
                                        <summary>Xem nội dung trước / sau</summary>
                                        <div class="row g-3 mt-1">
                                            <div class="col-lg-6">
                                                <div class="audit-text-compare audit-text-old">
                                                    <span>TRƯỚC</span>
                                                    <p>@change.OldValue</p>
                                                </div>
                                            </div>
                                            <div class="col-lg-6">
                                                <div class="audit-text-compare audit-text-new">
                                                    <span>SAU</span>
                                                    <p>@change.NewValue</p>
                                                </div>
                                            </div>
                                        </div>
                                    </details>
                                </div>
                            }
                            else
                            {
                                <div class="audit-value-change">
                                    <span class="audit-old-value">@change.OldValue</span>
                                    <span class="audit-change-arrow" aria-hidden="true">→</span>
                                    <strong class="audit-new-value">@change.NewValue</strong>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="audit-policy-note mt-3">
                    <span aria-hidden="true">i</span>
                    <div>
                        <strong>Áp dụng cho đơn mới</strong>
                        <small>Đơn đã tạo trước thời điểm thay đổi vẫn giữ chính sách đã chốt.</small>
                    </div>
                </div>

                <details class="audit-raw-details mt-3">
                    <summary>Xem dữ liệu kỹ thuật (JSON)</summary>
                    <div class="row g-3 mt-1">
                        @if (hasOldValues)
                        {
                            <div class="@payloadColumnClass">
                                <div class="audit-payload audit-payload-old h-100">
                                    <div class="audit-payload-heading">
                                        <span>TRƯỚC THAO TÁC</span>
                                        <strong>Dữ liệu cũ</strong>
                                    </div>
                                    <pre>@FormatPayload(Model.OldValues)</pre>
                                </div>
                            </div>
                        }

                        @if (hasNewValues)
                        {
                            <div class="@payloadColumnClass">
                                <div class="audit-payload audit-payload-new h-100">
                                    <div class="audit-payload-heading">
                                        <span>SAU THAO TÁC</span>
                                        <strong>Dữ liệu mới</strong>
                                    </div>
                                    <pre>@FormatPayload(Model.NewValues)</pre>
                                </div>
                            </div>
                        }
                    </div>
                </details>
            </div>
        </section>
    }
    else
    {
        <section class="card border-0 shadow-sm audit-data-card">
            <div class="card-header bg-white border-0 px-4 pt-4 pb-2">
                <h2 class="h5 fw-bold mb-1">Dữ liệu trước và sau thao tác</h2>
                <p class="small text-muted mb-0">Chỉ hiển thị khi hệ thống có lưu lại dữ liệu để so sánh.</p>
            </div>
            <div class="card-body px-4 pt-2 pb-4">
                @if (!hasSnapshot)
                {
                    <div class="audit-no-snapshot">
                        <span class="audit-no-snapshot-icon" aria-hidden="true">i</span>
                        <div>
                            <strong>Không có dữ liệu trước/sau</strong>
                            <p class="small text-muted mb-0">Thao tác này không lưu bản chụp dữ liệu để so sánh.</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="row g-3">
                        @if (hasOldValues)
                        {
                            <div class="@payloadColumnClass">
                                <div class="audit-payload audit-payload-old h-100">
                                    <div class="audit-payload-heading">
                                        <span>TRƯỚC THAO TÁC</span>
                                        <strong>Dữ liệu cũ</strong>
                                    </div>
                                    <pre>@FormatPayload(Model.OldValues)</pre>
                                </div>
                            </div>
                        }

                        @if (hasNewValues)
                        {
                            <div class="@payloadColumnClass">
                                <div class="audit-payload audit-payload-new h-100">
                                    <div class="audit-payload-heading">
                                        <span>SAU THAO TÁC</span>
                                        <strong>Dữ liệu mới</strong>
                                    </div>
                                    <pre>@FormatPayload(Model.NewValues)</pre>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </section>
    }
</div>
