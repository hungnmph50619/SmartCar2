@model IReadOnlyList<SmartCar.Application.Features.Audits.AuditLogDto>
@{
    ViewData["Title"] = "Nhật ký thao tác";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Nhật ký thao tác</h1>
        <p class="text-muted mb-0">Bằng chứng ai đã thay đổi dữ liệu nào và vào thời điểm nào.</p>
    </div>
</div>

<form method="get" class="card card-body shadow-sm mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label">Số bản ghi gần nhất</label>
            <input name="take" type="number" min="1" max="1000" value="@ViewBag.Take" class="form-control" />
        </div>
        <div class="col-md-3"><button class="btn btn-primary w-100" type="submit">Tải nhật ký</button></div>
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Thời gian</th>
                    <th>Người thực hiện</th>
                    <th>Hành động</th>
                    <th>Đối tượng</th>
                    <th>Nội dung</th>
                    <th>Chi tiết</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-muted py-4">Chưa có nhật ký thao tác.</td></tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-nowrap">@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                        <td>@(item.UserName ?? item.UserId ?? "Hệ thống")</td>
                        <td><span class="badge bg-secondary">@item.Action</span></td>
                        <td>@item.EntityName #@item.EntityId</td>
                        <td>@item.Description</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(item.OldValues) || !string.IsNullOrWhiteSpace(item.NewValues))
                            {
                                <details>
                                    <summary>Xem dữ liệu</summary>
                                    @if (!string.IsNullOrWhiteSpace(item.OldValues))
                                    {
                                        <div class="small mt-2"><strong>Trước:</strong><pre class="text-wrap">@item.OldValues</pre></div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.NewValues))
                                    {
                                        <div class="small"><strong>Sau:</strong><pre class="text-wrap">@item.NewValues</pre></div>
                                    }
                                </details>
                            }
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
