@model SmartCar.Web.ViewModels.AuditLogIndexViewModel
@using SmartCar.Web.Services
@{
    ViewData["Title"] = "Nhật ký thao tác";
    var result = Model.Result;
    var firstRow = result.TotalCount == 0 ? 0 : ((result.Page - 1) * result.PageSize) + 1;
    var lastRow = Math.Min(result.Page * result.PageSize, result.TotalCount);
    var pageStart = Math.Max(1, result.Page - 2);
    var pageEnd = Math.Min(result.TotalPages, result.Page + 2);
    var hasAdvancedFilters = !string.IsNullOrWhiteSpace(Model.UserId)
        || !string.IsNullOrWhiteSpace(Model.Action)
        || !string.IsNullOrWhiteSpace(Model.EntityName);

    string AuditBadgeClass(string action) => action switch
    {
        "Delete" or "Reject" or "AdminCancel" or "CustomerCancel" or "LockCustomer" => "audit-action-danger",
        "Verify" or "VerifyAll" or "Confirm" or "CompleteBooking" or "Resolve" or "UnlockCustomer" => "audit-action-success",
        "ViewKycDocumentImage" => "audit-action-info",
        "Submit" or "SubmitKycPackage" or "ChangePassword" or "UpdateBankAccount" or "UpdateAvatar" or "Update" or "ChangeStatus" => "audit-action-primary",
        "RequestResubmission" or "RequestUpdate" or "AddCharge" => "audit-action-warning",
        _ => "audit-action-secondary"
    };

    string FriendlyIp(string? ip) => ip switch
    {
        null or "" => "Không ghi nhận",
        "::1" or "127.0.0.1" => "Máy cục bộ",
        _ => ip
    };

    bool IsGuidIdentifier(string? value) => Guid.TryParse(value, out _);
}

<link rel="stylesheet" href="~/css/admin-audit.css" asp-append-version="true" />

<div class="audit-page">
    <div class="audit-page-heading mb-4">
        <h1 class="h2 fw-bold mb-1">Nhật ký thao tác</h1>
        <p class="text-muted mb-0">Theo dõi ai đã thực hiện thao tác gì, trên dữ liệu nào và vào thời điểm nào.</p>
    </div>

    <section class="card border-0 shadow-sm audit-filter-card mb-3">
        <div class="card-body p-3 p-lg-4">
            <form method="get">
                <input type="hidden" name="pageSize" value="@result.PageSize" />

                <div class="row g-3 align-items-end">
                    <div class="col-12 col-xl-5">
                        <label class="form-label fw-semibold" for="auditSearch">Tìm kiếm</label>
                        <input id="auditSearch"
                               name="search"
                               value="@Model.Search"
                               class="form-control"
                               placeholder="Người thực hiện, nội dung, mã đối tượng, IP..." />
                    </div>

                    <div class="col-md-4 col-xl-2">
                        <label class="form-label fw-semibold" for="auditFromDate">Từ ngày</label>
                        <input id="auditFromDate"
                               name="fromDate"
                               type="text"
                               inputmode="numeric"
                               autocomplete="off"
                               value="@(Model.FromDate?.ToString("dd/MM/yyyy"))"
                               placeholder="dd/mm/yyyy"
                               pattern="[0-9]{1,2}/[0-9]{1,2}/[0-9]{4}"
                               title="Nhập ngày theo định dạng dd/mm/yyyy"
                               class="form-control" />
                    </div>

                    <div class="col-md-4 col-xl-2">
                        <label class="form-label fw-semibold" for="auditToDate">Đến ngày</label>
                        <input id="auditToDate"
                               name="toDate"
                               type="text"
                               inputmode="numeric"
                               autocomplete="off"
                               value="@(Model.ToDate?.ToString("dd/MM/yyyy"))"
                               placeholder="dd/mm/yyyy"
                               pattern="[0-9]{1,2}/[0-9]{1,2}/[0-9]{4}"
                               title="Nhập ngày theo định dạng dd/mm/yyyy"
                               class="form-control" />
                    </div>

                    <div class="col-md-4 col-xl-3">
                        <div class="d-flex gap-2">
                            <button class="btn btn-primary flex-grow-1" type="submit">Lọc</button>
                            <button class="btn btn-outline-secondary audit-advanced-toggle"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#auditAdvancedFilters"
                                    aria-expanded="@(hasAdvancedFilters ? "true" : "false")"
                                    aria-controls="auditAdvancedFilters">
                                Nâng cao <span aria-hidden="true">⌄</span>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="collapse @(hasAdvancedFilters ? "show" : string.Empty)" id="auditAdvancedFilters">
                    <div class="audit-advanced-panel mt-3 pt-3">
                        <div class="row g-3 align-items-end">
                            <div class="col-md-4">
                                <label class="form-label fw-semibold" for="auditUser">Người thực hiện</label>
                                <select id="auditUser" name="userId" class="form-select">
                                    <option value="">Tất cả</option>
                                    @foreach (var option in result.Users)
                                    {
                                        if (Model.UserId == option.UserId)
                                        {
                                            <option value="@option.UserId" selected>@option.DisplayName (@option.Count)</option>
                                        }
                                        else
                                        {
                                            <option value="@option.UserId">@option.DisplayName (@option.Count)</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-semibold" for="auditAction">Hành động</label>
                                <select id="auditAction" name="auditAction" class="form-select">
                                    <option value="">Tất cả</option>
                                    @foreach (var option in result.Actions)
                                    {
                                        if (Model.Action == option.Value)
                                        {
                                            <option value="@option.Value" selected>@option.Value.ToVietnameseAuditAction() (@option.Count)</option>
                                        }
                                        else
                                        {
                                            <option value="@option.Value">@option.Value.ToVietnameseAuditAction() (@option.Count)</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-semibold" for="auditEntity">Đối tượng</label>
                                <select id="auditEntity" name="entityName" class="form-select">
                                    <option value="">Tất cả</option>
                                    @foreach (var option in result.Entities)
                                    {
                                        if (Model.EntityName == option.Value)
                                        {
                                            <option value="@option.Value" selected>@option.Value.ToVietnameseEntity() (@option.Count)</option>
                                        }
                                        else
                                        {
                                            <option value="@option.Value">@option.Value.ToVietnameseEntity() (@option.Count)</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                @if (Model.HasFilters)
                {
                    <div class="d-flex justify-content-end mt-3">
                        <a class="btn btn-sm btn-link text-decoration-none" asp-action="Index">Đặt lại bộ lọc</a>
                    </div>
                }
            </form>
        </div>
    </section>

    @if (Model.HasFilters)
    {
        <div class="audit-active-filters mb-3">
            <span class="text-muted small fw-semibold">Đang lọc:</span>
            @if (!string.IsNullOrWhiteSpace(Model.Search))
            {
                <span class="badge rounded-pill text-bg-light border">Từ khóa: @Model.Search</span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.UserId))
            {
                var selectedUser = result.Users.FirstOrDefault(option => option.UserId == Model.UserId);
                <span class="badge rounded-pill text-bg-light border">Người: @(selectedUser?.DisplayName ?? Model.UserId)</span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Action))
            {
                <span class="badge rounded-pill text-bg-light border">Hành động: @Model.Action.ToVietnameseAuditAction()</span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.EntityName))
            {
                <span class="badge rounded-pill text-bg-light border">Đối tượng: @Model.EntityName.ToVietnameseEntity()</span>
            }
            @if (Model.FromDate.HasValue || Model.ToDate.HasValue)
            {
                <span class="badge rounded-pill text-bg-light border">
                    Thời gian: @(Model.FromDate?.ToString("dd/MM/yyyy") ?? "...") → @(Model.ToDate?.ToString("dd/MM/yyyy") ?? "...")
                </span>
            }
        </div>
    }

    <section class="card border-0 shadow-sm audit-table-card">
        <div class="card-header bg-white border-0 px-4 pt-4 pb-3 d-flex justify-content-between align-items-center gap-3 flex-wrap">
            <div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <h2 class="h5 fw-bold mb-0">Nhật ký thao tác</h2>
                    <span class="badge rounded-pill text-bg-light border">@result.TotalCount.ToString("N0") bản ghi</span>
                </div>
                @if (result.TotalCount > 0)
                {
                    <p class="small text-muted mb-0 mt-1">Hiển thị @firstRow–@lastRow trên @result.TotalCount.ToString("N0") bản ghi.</p>
                }
                else
                {
                    <p class="small text-muted mb-0 mt-1">Không tìm thấy bản ghi phù hợp.</p>
                }
            </div>

            <form method="get" class="audit-page-size-form">
                <input type="hidden" name="search" value="@Model.Search" />
                <input type="hidden" name="userId" value="@Model.UserId" />
                <input type="hidden" name="auditAction" value="@Model.Action" />
                <input type="hidden" name="entityName" value="@Model.EntityName" />
                <input type="hidden" name="fromDate" value="@(Model.FromDate?.ToString("dd/MM/yyyy"))" />
                <input type="hidden" name="toDate" value="@(Model.ToDate?.ToString("dd/MM/yyyy"))" />
                <label class="visually-hidden" for="auditPageSize">Số dòng mỗi trang</label>
                <select id="auditPageSize" name="pageSize" class="form-select form-select-sm" onchange="this.form.submit()">
                    @foreach (var size in new[] { 25, 50, 100, 200 })
                    {
                        if (result.PageSize == size)
                        {
                            <option value="@size" selected>@size dòng / trang</option>
                        }
                        else
                        {
                            <option value="@size">@size dòng / trang</option>
                        }
                    }
                </select>
            </form>
        </div>

        <div class="table-responsive audit-table-wrapper">
            <table class="table table-hover align-middle mb-0 audit-table">
                <thead>
                    <tr>
                        <th>Thời gian</th>
                        <th>Người thực hiện</th>
                        <th>Hành động</th>
                        <th>Đối tượng</th>
                        <th>Nội dung</th>
                        <th>IP</th>
                        <th class="text-end">Chi tiết</th>
                    </tr>
                </thead>
                <tbody>
                @if (result.Items.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center py-5">
                            <div class="audit-empty-icon">⌕</div>
                            <div class="fw-semibold">Không có nhật ký phù hợp</div>
                            <div class="small text-muted mt-1">Thử thay đổi điều kiện lọc.</div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in result.Items)
                    {
                        var showEntityId = !string.IsNullOrWhiteSpace(item.EntityId) && !IsGuidIdentifier(item.EntityId);
                        var friendlyIp = FriendlyIp(item.IpAddress);
                        var friendlyDescription =
                            item.Action == "UpdateRentalPolicy" && item.EntityName == "BusinessSetting"
                                ? BusinessPolicyAuditFormatter.BuildSummary(item.OldValues, item.NewValues)
                                : item.Description.ToFriendlyAuditDescription();
                        <tr>
                            <td class="text-nowrap audit-time-cell">
                                @item.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td>
                                <div class="fw-semibold audit-user-name">@(item.UserName ?? "Hệ thống")</div>
                            </td>
                            <td>
                                <span class="audit-action-badge @AuditBadgeClass(item.Action)">@item.Action.ToVietnameseAuditAction()</span>
                            </td>
                            <td>
                                <div class="fw-semibold audit-entity-name">
                                    @item.EntityName.ToVietnameseEntity()@if (showEntityId){<text> #@item.EntityId</text>}
                                </div>
                            </td>
                            <td>
                                <div class="audit-description" title="@friendlyDescription">
                                    @friendlyDescription
                                </div>
                            </td>
                            <td class="text-nowrap">
                                @if (string.IsNullOrWhiteSpace(item.IpAddress))
                                {
                                    <span class="audit-no-ip">@friendlyIp</span>
                                }
                                else if (item.IpAddress is "::1" or "127.0.0.1")
                                {
                                    <span class="audit-ip-friendly" title="@item.IpAddress">@friendlyIp</span>
                                }
                                else
                                {
                                    <span class="audit-ip-friendly">@friendlyIp</span>
                                }
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary audit-detail-button"
                                   asp-action="Details"
                                   asp-route-id="@item.AuditLogId">Xem</a>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>

        @if (result.TotalPages > 1)
        {
            <div class="card-footer bg-white border-0 px-4 py-3">
                <nav aria-label="Phân trang nhật ký thao tác">
                    <ul class="pagination pagination-sm mb-0 justify-content-end flex-wrap">
                        <li class="page-item @(result.Page <= 1 ? "disabled" : string.Empty)">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-search="@Model.Search"
                               asp-route-userId="@Model.UserId"
                               asp-route-auditAction="@Model.Action"
                               asp-route-entityName="@Model.EntityName"
                               asp-route-fromDate="@(Model.FromDate?.ToString("dd/MM/yyyy"))"
                               asp-route-toDate="@(Model.ToDate?.ToString("dd/MM/yyyy"))"
                               asp-route-pageSize="@result.PageSize"
                               asp-route-page="@(result.Page - 1)">‹ Trước</a>
                        </li>

                        @for (var currentPage = pageStart; currentPage <= pageEnd; currentPage++)
                        {
                            <li class="page-item @(currentPage == result.Page ? "active" : string.Empty)">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-search="@Model.Search"
                                   asp-route-userId="@Model.UserId"
                                   asp-route-auditAction="@Model.Action"
                                   asp-route-entityName="@Model.EntityName"
                                   asp-route-fromDate="@(Model.FromDate?.ToString("dd/MM/yyyy"))"
                                   asp-route-toDate="@(Model.ToDate?.ToString("dd/MM/yyyy"))"
                                   asp-route-pageSize="@result.PageSize"
                                   asp-route-page="@currentPage">@currentPage</a>
                            </li>
                        }

                        <li class="page-item @(result.Page >= result.TotalPages ? "disabled" : string.Empty)">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-search="@Model.Search"
                               asp-route-userId="@Model.UserId"
                               asp-route-auditAction="@Model.Action"
                               asp-route-entityName="@Model.EntityName"
                               asp-route-fromDate="@(Model.FromDate?.ToString("dd/MM/yyyy"))"
                               asp-route-toDate="@(Model.ToDate?.ToString("dd/MM/yyyy"))"
                               asp-route-pageSize="@result.PageSize"
                               asp-route-page="@(result.Page + 1)">Sau ›</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </section>
</div>
