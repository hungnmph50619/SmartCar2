@model SmartCar.Web.ViewModels.CustomerReturnReviewViewModel
@using SmartCar.Web.Services
@{
    ViewData["Title"] = "Đối chiếu bằng chứng tình trạng xe";
    var labels = VehicleEvidenceAuditHelper.StandardPhotoLabels;
    var customerPairCount = Math.Max(Model.CustomerHandoverImagePaths.Count, Model.CustomerCheckoutImagePaths.Count);
    var smartCarPairCount = Math.Max(Model.HandoverImagePaths.Count, Model.ReturnImagePaths.Count);
}

<div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4">
    <div>
        <div class="text-uppercase small text-primary fw-semibold">Hồ sơ bằng chứng sau chuyến</div>
        <h1 class="h3 mb-1">Đối chiếu trước ↔ sau · Đơn #@Model.BookingId</h1>
        <p class="text-muted mb-0">Hai nguồn bằng chứng được tách riêng: bộ ảnh do chính tài khoản của bạn tạo và bộ ảnh kiểm tra độc lập của SmartCar.</p>
    </div>
    <a class="btn btn-outline-secondary"
       asp-controller="Bookings"
       asp-action="Details"
       asp-route-id="@Model.BookingId">← Quay lại đơn</a>
</div>

@if (Model.ReviewStatus == "Pending")
{
    <div class="alert alert-warning shadow-sm">
        <strong>Đang chờ phản hồi của bạn.</strong> Hãy xem cả hai nguồn bằng chứng trước–sau. Nếu có điểm không đúng, gửi yêu cầu xem xét trước khi SmartCar quyết toán cọc/phụ phí.
    </div>
}
else if (Model.ReviewStatus == "Accepted")
{
    <div class="alert alert-success shadow-sm"><strong>✓ Bạn đã xác nhận bộ bằng chứng tình trạng xe.</strong> SmartCar có thể tiếp tục kiểm tra và quyết toán dựa trên hồ sơ đã lưu.</div>
}
else if (Model.ReviewStatus == "Disputed")
{
    <div class="alert alert-danger shadow-sm">
        <strong>Bạn đã yêu cầu xem xét lại.</strong>
        @if (!string.IsNullOrWhiteSpace(Model.DisputeReason))
        {
            <div class="mt-1">Lý do: @Model.DisputeReason</div>
        }
        <div class="small mt-1">SmartCar chưa được hoàn tất đơn theo luồng mới cho đến khi phản hồi này được xử lý.</div>
    </div>
}
else if (Model.ReviewStatus == "Resolved")
{
    <div class="alert alert-info shadow-sm"><strong>Phản hồi đã được SmartCar xử lý.</strong> Hồ sơ ảnh trước–sau và lịch sử xử lý vẫn được giữ để truy vết.</div>
}
else
{
    <div class="alert alert-secondary shadow-sm"><strong>Dữ liệu cũ.</strong> Chuyến này không có đủ toàn bộ checkpoint bằng chứng của flow mới; trang chỉ hiển thị các dữ liệu hiện có.</div>
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-4">
        <div class="row g-3">
            <div class="col-md-4"><div class="small text-muted">Xe</div><div class="fw-semibold">@Model.VehicleName · @Model.LicensePlate</div></div>
            <div class="col-md-4"><div class="small text-muted">Bàn giao</div><div class="fw-semibold">@Model.HandoverAt.ToString("dd/MM/yyyy HH:mm")</div></div>
            <div class="col-md-4"><div class="small text-muted">SmartCar nhận lại</div><div class="fw-semibold">@Model.ReturnedAt.ToString("dd/MM/yyyy HH:mm")</div></div>
        </div>

        <div class="table-responsive mt-4">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr><th>Nội dung</th><th>Trước chuyến</th><th>Khách check-out</th><th>SmartCar nhận lại</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <th>ODO</th>
                        <td>@Model.HandoverMileage.ToString("N0") km</td>
                        <td>@(Model.CustomerCheckoutMileage.HasValue ? $"{Model.CustomerCheckoutMileage.Value:N0} km" : "Không có dữ liệu")</td>
                        <td>@Model.ReturnMileage.ToString("N0") km</td>
                    </tr>
                    <tr>
                        <th>Nhiên liệu / pin</th>
                        <td>@Model.HandoverFuelLevel</td>
                        <td>@(string.IsNullOrWhiteSpace(Model.CustomerCheckoutFuelLevel) ? "Không có dữ liệu" : Model.CustomerCheckoutFuelLevel)</td>
                        <td>@Model.ReturnFuelLevel</td>
                    </tr>
                    <tr>
                        <th>Hiện trạng SmartCar</th>
                        <td>Ảnh bàn giao trước chuyến</td>
                        <td>—</td>
                        <td>@(string.IsNullOrWhiteSpace(Model.ReturnCondition) ? "Không có mô tả riêng" : Model.ReturnCondition)</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card shadow-sm border-primary mb-4">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3">
            <div>
                <div class="text-uppercase small text-primary fw-semibold">Nguồn bằng chứng 1 · Chính khách tạo</div>
                <h2 class="h5 mb-1">Customer check-in ↔ customer check-out</h2>
                <p class="small text-muted mb-0">Đây là bộ ảnh được tạo trên chính tài khoản người thuê ở hai đầu chuyến. Nó không phải ảnh do Admin tự nhập thay khách.</p>
            </div>
            <span class="badge bg-primary">@Model.CustomerHandoverImagePaths.Count check-in · @Model.CustomerCheckoutImagePaths.Count check-out</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.CustomerHandoverNote))
        {
            <div class="alert alert-light border py-2"><strong>Khách khai lúc check-in:</strong> @Model.CustomerHandoverNote</div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.CustomerCheckoutNote))
        {
            <div class="alert alert-light border py-2"><strong>Khách khai lúc check-out:</strong> @Model.CustomerCheckoutNote</div>
        }

        @if (customerPairCount == 0)
        {
            <div class="alert alert-secondary mb-0">Không có bộ ảnh check-in/check-out độc lập của khách cho chuyến này.</div>
        }
        else
        {
            <div class="d-grid gap-3">
                @for (var index = 0; index < customerPairCount; index++)
                {
                    var checkInPath = index < Model.CustomerHandoverImagePaths.Count ? Model.CustomerHandoverImagePaths[index] : null;
                    var checkOutPath = index < Model.CustomerCheckoutImagePaths.Count ? Model.CustomerCheckoutImagePaths[index] : null;
                    <div class="border rounded-3 p-3">
                        <div class="small fw-semibold mb-2">@(index < labels.Length ? labels[index] : $"Ảnh bổ sung {index + 1}")</div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="small text-muted mb-1">Khách tự chụp lúc nhận</div>
                                @if (!string.IsNullOrWhiteSpace(checkInPath))
                                {
                                    <a href="@checkInPath" target="_blank" rel="noopener noreferrer"><img src="@checkInPath" class="w-100 rounded border" style="height:260px;object-fit:contain;background:#f8f9fa" alt="Customer check-in @(index + 1)" /></a>
                                }
                                else
                                {
                                    <div class="bg-light rounded p-4 text-muted text-center">Không có ảnh tương ứng</div>
                                }
                            </div>
                            <div class="col-md-6">
                                <div class="small text-muted mb-1">Khách tự chụp lúc trả</div>
                                @if (!string.IsNullOrWhiteSpace(checkOutPath))
                                {
                                    <a href="@checkOutPath" target="_blank" rel="noopener noreferrer"><img src="@checkOutPath" class="w-100 rounded border" style="height:260px;object-fit:contain;background:#f8f9fa" alt="Customer check-out @(index + 1)" /></a>
                                }
                                else
                                {
                                    <div class="bg-light rounded p-4 text-muted text-center">Không có ảnh tương ứng</div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3">
            <div>
                <div class="text-uppercase small text-muted fw-semibold">Nguồn bằng chứng 2 · SmartCar kiểm tra độc lập</div>
                <h2 class="h5 mb-1">Ảnh SmartCar lúc giao ↔ ảnh SmartCar lúc nhận lại</h2>
                <p class="small text-muted mb-0">Nguồn thứ hai dùng để kiểm chứng chéo với bộ ảnh do khách tự tạo.</p>
            </div>
            <span class="badge bg-light text-dark border">@Model.HandoverImagePaths.Count ảnh giao · @Model.ReturnImagePaths.Count ảnh nhận lại</span>
        </div>

        @if (smartCarPairCount == 0)
        {
            <div class="alert alert-secondary mb-0">Không có ảnh SmartCar để đối chiếu.</div>
        }
        else
        {
            <div class="d-grid gap-3">
                @for (var index = 0; index < smartCarPairCount; index++)
                {
                    var handoverPath = index < Model.HandoverImagePaths.Count ? Model.HandoverImagePaths[index] : null;
                    var returnPath = index < Model.ReturnImagePaths.Count ? Model.ReturnImagePaths[index] : null;
                    <div class="border rounded-3 p-3">
                        <div class="small fw-semibold mb-2">@(index < labels.Length ? labels[index] : $"Ảnh {index + 1}")</div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="small text-muted mb-1">SmartCar lúc giao</div>
                                @if (!string.IsNullOrWhiteSpace(handoverPath))
                                {
                                    <a href="@handoverPath" target="_blank" rel="noopener noreferrer"><img src="@handoverPath" class="w-100 rounded border" style="height:260px;object-fit:contain;background:#f8f9fa" alt="Ảnh SmartCar lúc giao @(index + 1)" /></a>
                                }
                                else
                                {
                                    <div class="bg-light rounded p-4 text-muted text-center">Không có ảnh tương ứng</div>
                                }
                            </div>
                            <div class="col-md-6">
                                <div class="small text-muted mb-1">SmartCar lúc nhận lại</div>
                                @if (!string.IsNullOrWhiteSpace(returnPath))
                                {
                                    <a href="@returnPath" target="_blank" rel="noopener noreferrer"><img src="@returnPath" class="w-100 rounded border" style="height:260px;object-fit:contain;background:#f8f9fa" alt="Ảnh SmartCar lúc nhận lại @(index + 1)" /></a>
                                }
                                else
                                {
                                    <div class="bg-light rounded p-4 text-muted text-center">Không có ảnh tương ứng</div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ReturnNotes))
        {
            <div class="alert alert-light border mt-3 mb-0"><strong>Ghi chú biên bản nhận lại:</strong><br />@Model.ReturnNotes</div>
        }
    </div>
</div>

@if (Model.ReviewStatus == "Pending")
{
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <h2 class="h5">Phản hồi hồ sơ tình trạng xe</h2>
            <p class="text-muted small">Đồng ý nghĩa là bạn xác nhận các ảnh/dữ liệu phản ánh đúng tình trạng tại hai đầu chuyến; không đồng nghĩa tự động chấp nhận một mức phí chưa có báo giá/căn cứ.</p>

            <div class="row g-3">
                <div class="col-lg-5">
                    <form asp-action="Accept" method="post" data-loading-form data-confirm="Xác nhận bộ bằng chứng trước–sau phản ánh đúng tình trạng xe?">
                        <input type="hidden" name="bookingId" value="@Model.BookingId" />
                        <div class="border rounded-3 p-3 h-100">
                            <strong class="d-block text-success">Thông tin đúng</strong>
                            <div class="small text-muted my-2">Tôi đã xem cả bộ ảnh của mình và bộ ảnh SmartCar, không có điểm cần yêu cầu xem xét lại.</div>
                            <button class="btn btn-success w-100" type="submit" data-loading-text="Đang xác nhận...">✓ Đồng ý hiện trạng</button>
                        </div>
                    </form>
                </div>
                <div class="col-lg-7">
                    <form asp-action="Dispute" method="post" data-loading-form data-confirm="Gửi yêu cầu SmartCar xem xét lại hồ sơ hiện trạng xe?">
                        <input type="hidden" name="bookingId" value="@Model.BookingId" />
                        <div class="border border-danger rounded-3 p-3 h-100">
                            <strong class="d-block text-danger">Có điểm tôi không đồng ý</strong>
                            <textarea name="reason" minlength="10" maxlength="1000" rows="3" class="form-control my-2" required placeholder="Ví dụ: vết xước cản phải đã có từ check-in; xem ảnh check-in góc bên phải..."></textarea>
                            <button class="btn btn-outline-danger w-100" type="submit" data-loading-text="Đang gửi...">Không đồng ý / Yêu cầu xem xét</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
