@model SmartCar.Web.ViewModels.AdminStaffCreateViewModel
@{
    ViewData["Title"] = "Thêm nhân viên";
}

<style>
    /* Edge/IE có nút hiện mật khẩu mặc định. Ẩn nút mặc định để chỉ giữ một nút mắt của SmartCar. */
    #staffPassword::-ms-reveal,
    #staffPassword::-ms-clear,
    #confirmStaffPassword::-ms-reveal,
    #confirmStaffPassword::-ms-clear {
        display: none;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Thêm nhân viên</h1>
        <p class="text-muted mb-0">Admin tạo tài khoản nhân viên; mã nhân viên được hệ thống tự sinh.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">← Danh sách nhân viên</a>
</div>

<div class="row justify-content-center">
    <div class="col-xl-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Create" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label"></label>
                            <input asp-for="FullName" class="form-control" placeholder="Họ và tên nhân viên" autocomplete="name" maxlength="100" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" placeholder="nhanvien@smartcar.vn" autocomplete="email" maxlength="256" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label"></label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="09xxxxxxxx" autocomplete="tel" inputmode="numeric" maxlength="10" oninput="this.value=this.value.replace(/\D/g,'').slice(0,10)" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CitizenIdNumber" class="form-label"></label>
                            <input asp-for="CitizenIdNumber" class="form-control" placeholder="12 chữ số" inputmode="numeric" maxlength="12" autocomplete="off" oninput="this.value=this.value.replace(/\D/g,'').slice(0,12)" />
                            <span asp-validation-for="CitizenIdNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="TemporaryPassword" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="TemporaryPassword" id="staffPassword" class="form-control" placeholder="Nhập mật khẩu" autocomplete="new-password" />
                                <button class="btn btn-outline-secondary password-toggle" type="button" data-target="staffPassword" aria-label="Hiển thị mật khẩu" title="Hiển thị mật khẩu">
                                    <svg class="eye-open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"></path>
                                        <circle cx="12" cy="12" r="3"></circle>
                                    </svg>
                                    <svg class="eye-closed d-none" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M3 3l18 18"></path>
                                        <path d="M10.6 10.6a2 2 0 0 0 2.8 2.8"></path>
                                        <path d="M9.9 4.2A10.9 10.9 0 0 1 12 4c6.5 0 10 8 10 8a18.4 18.4 0 0 1-2.1 3.2"></path>
                                        <path d="M6.6 6.6C3.7 8.5 2 12 2 12s3.5 8 10 8a10.7 10.7 0 0 0 4.1-.8"></path>
                                    </svg>
                                </button>
                            </div>
                            <div class="form-text">Ít nhất 8 ký tự, có chữ hoa, chữ thường, số và ký tự đặc biệt.</div>
                            <span asp-validation-for="TemporaryPassword" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmTemporaryPassword" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="ConfirmTemporaryPassword" id="confirmStaffPassword" class="form-control" placeholder="Nhập lại mật khẩu" autocomplete="new-password" />
                                <button class="btn btn-outline-secondary password-toggle" type="button" data-target="confirmStaffPassword" aria-label="Hiển thị mật khẩu" title="Hiển thị mật khẩu">
                                    <svg class="eye-open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"></path>
                                        <circle cx="12" cy="12" r="3"></circle>
                                    </svg>
                                    <svg class="eye-closed d-none" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M3 3l18 18"></path>
                                        <path d="M10.6 10.6a2 2 0 0 0 2.8 2.8"></path>
                                        <path d="M9.9 4.2A10.9 10.9 0 0 1 12 4c6.5 0 10 8 10 8a18.4 18.4 0 0 1-2.1 3.2"></path>
                                        <path d="M6.6 6.6C3.7 8.5 2 12 2 12s3.5 8 10 8a10.7 10.7 0 0 0 4.1-.8"></path>
                                    </svg>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmTemporaryPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="alert alert-info mt-4 mb-3">
                        <strong>Sau khi tạo:</strong> hệ thống tự cấp mã nhân viên và quyền Nhân viên. Nhân viên đăng nhập bằng email + mật khẩu trên và bắt buộc đổi mật khẩu ở lần đầu.
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Tạo tài khoản nhân viên</button>
                        <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            document.querySelectorAll('.password-toggle').forEach(button => {
                button.addEventListener('click', () => {
                    const input = document.getElementById(button.dataset.target);
                    if (!input) return;

                    const showPassword = input.type === 'password';
                    input.type = showPassword ? 'text' : 'password';

                    const eyeOpen = button.querySelector('.eye-open');
                    const eyeClosed = button.querySelector('.eye-closed');
                    eyeOpen?.classList.toggle('d-none', showPassword);
                    eyeClosed?.classList.toggle('d-none', !showPassword);

                    const label = showPassword ? 'Ẩn mật khẩu' : 'Hiển thị mật khẩu';
                    button.setAttribute('aria-label', label);
                    button.setAttribute('title', label);
                });
            });
        })();
    </script>
}
