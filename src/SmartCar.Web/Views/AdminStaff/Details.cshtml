@model SmartCar.Web.ViewModels.AdminStaffDetailsViewModel
@{
    ViewData["Title"] = "Chi tiết nhân viên";
    var activationUrl = TempData["StaffActivationUrl"] as string;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">@Model.FullName</h1>
        <p class="text-muted mb-0">@(string.IsNullOrWhiteSpace(Model.EmployeeCode) ? "Chưa cập nhật mã nhân viên" : Model.EmployeeCode) · Role Staff</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">← Danh sách</a>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.UserId">Sửa thông tin</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(activationUrl))
{
    <div class="alert alert-warning shadow-sm">
        <div class="fw-semibold mb-2">Liên kết thiết lập mật khẩu cho nhân viên</div>
        <div class="input-group">
            <input id="staffActivationUrl" class="form-control" value="@activationUrl" readonly />
            <button class="btn btn-dark" type="button" id="copyActivationUrl">Sao chép</button>
        </div>
        <div class="small mt-2">Chỉ gửi liên kết này cho đúng nhân viên. Sau khi nhân viên đặt mật khẩu, trạng thái tài khoản sẽ chuyển sang đã thiết lập mật khẩu.</div>
    </div>
}

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white fw-semibold">Thông tin nhân viên</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Mã nhân viên</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.EmployeeCode) ? "Chưa cập nhật" : Model.EmployeeCode)</dd>

                    <dt class="col-sm-4">Họ và tên</dt>
                    <dd class="col-sm-8">@Model.FullName</dd>

                    <dt class="col-sm-4">Email đăng nhập</dt>
                    <dd class="col-sm-8">@Model.Email</dd>

                    <dt class="col-sm-4">Số điện thoại</dt>
                    <dd class="col-sm-8">@(Model.PhoneNumber ?? "-")</dd>

                    <dt class="col-sm-4">Số CCCD</dt>
                    <dd class="col-sm-8">@(Model.CitizenIdNumber ?? "Chưa cập nhật")</dd>

                    <dt class="col-sm-4">Role</dt>
                    <dd class="col-sm-8"><span class="badge text-bg-primary">Staff / Nhân viên</span></dd>

                    <dt class="col-sm-4">Trạng thái</dt>
                    <dd class="col-sm-8">
                        @if (Model.IsActive)
                        {
                            <span class="badge text-bg-success">Đang hoạt động</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Ngừng hoạt động / bị khóa</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Mật khẩu</dt>
                    <dd class="col-sm-8">
                        @if (Model.HasPassword)
                        {
                            <span class="badge text-bg-success">Đã thiết lập</span>
                        }
                        else
                        {
                            <span class="badge text-bg-warning">Chờ nhân viên kích hoạt</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white fw-semibold">Kiểm soát hồ sơ</div>
            <div class="card-body">
                <dl class="row small mb-0">
                    <dt class="col-5">Người tạo</dt>
                    <dd class="col-7">@(Model.CreatedByName ?? "Dữ liệu cũ / chưa ghi nhận")</dd>
                    <dt class="col-5">Ngày tạo</dt>
                    <dd class="col-7">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
                    <dt class="col-5">Người xác minh</dt>
                    <dd class="col-7">@(Model.VerifiedByName ?? "Chưa ghi nhận")</dd>
                    <dt class="col-5">Ngày xác minh</dt>
                    <dd class="col-7">@(Model.VerifiedAt.HasValue ? Model.VerifiedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "Chưa ghi nhận")</dd>
                </dl>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold">Quản lý tài khoản</div>
            <div class="card-body d-grid gap-2">
                @if (!Model.HasPassword && Model.IsActive)
                {
                    <form asp-action="ResendActivation" method="post">
                        <input type="hidden" name="id" value="@Model.UserId" />
                        <button class="btn btn-outline-primary w-100" type="submit">Gửi lại liên kết kích hoạt</button>
                    </form>
                }

                <form asp-action="ToggleStatus" method="post" onsubmit="return confirm('@(Model.IsActive ? "Khóa tài khoản nhân viên này? Dữ liệu lịch sử vẫn được giữ lại." : "Kích hoạt lại tài khoản nhân viên này?")');">
                    <input type="hidden" name="id" value="@Model.UserId" />
                    <button class="btn @(Model.IsActive ? "btn-outline-danger" : "btn-outline-success") w-100" type="submit">
                        @(Model.IsActive ? "Khóa tài khoản" : "Kích hoạt lại")
                    </button>
                </form>

                <div class="small text-muted mt-2">
                    SmartCar không xóa cứng tài khoản Staff để vẫn truy vết được người đã bàn giao xe, nhận xe, ghi nhận sự cố và các thao tác trong Audit Log.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(() => {
    const button = document.getElementById('copyActivationUrl');
    const input = document.getElementById('staffActivationUrl');
    if (!button || !input) return;
    button.addEventListener('click', async () => {
        try {
            await navigator.clipboard.writeText(input.value);
            button.textContent = 'Đã sao chép';
        } catch {
            input.select();
            document.execCommand('copy');
            button.textContent = 'Đã sao chép';
        }
    });
})();
</script>
}
