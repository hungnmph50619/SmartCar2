@model SmartCar.Web.ViewModels.AdminStaffDetailsViewModel
@{
    ViewData["Title"] = "Chi tiết nhân viên";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">@Model.FullName</h1>
        <p class="text-muted mb-0">
            @(string.IsNullOrWhiteSpace(Model.EmployeeCode) ? "Chưa cập nhật mã nhân viên" : Model.EmployeeCode)
            · @(Model.IsActive ? "Đang hoạt động" : "Ngừng hoạt động")
        </p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">← Danh sách</a>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.UserId">Sửa thông tin</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white fw-semibold">Thông tin nhân viên</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Mã nhân viên</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.EmployeeCode) ? "Chưa cập nhật" : Model.EmployeeCode)</dd>

                    <dt class="col-sm-4">Họ và tên</dt>
                    <dd class="col-sm-8">@Model.FullName</dd>

                    <dt class="col-sm-4">Email đăng nhập</dt>
                    <dd class="col-sm-8">@Model.Email</dd>

                    <dt class="col-sm-4">Số điện thoại</dt>
                    <dd class="col-sm-8">@(Model.PhoneNumber ?? "-")</dd>

                    <dt class="col-sm-4">Số CCCD</dt>
                    <dd class="col-sm-8">@(Model.CitizenIdNumber ?? "Chưa cập nhật")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white fw-semibold">Tài khoản nhân viên</div>
            <div class="card-body">
                <dl class="row small mb-0">
                    <dt class="col-5">Trạng thái</dt>
                    <dd class="col-7">
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success text-white">Đang hoạt động</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary text-white">Ngừng hoạt động</span>
                        }
                    </dd>

                    <dt class="col-5">Mật khẩu</dt>
                    <dd class="col-7">
                        @if (Model.MustChangePassword)
                        {
                            <span class="badge bg-warning text-dark">Chờ đổi mật khẩu lần đầu</span>
                        }
                        else if (Model.HasPassword)
                        {
                            <span class="badge bg-success text-white">Đã đổi mật khẩu</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary text-white">Chưa thiết lập</span>
                        }
                    </dd>

                    <dt class="col-5">Người tạo</dt>
                    <dd class="col-7">@(Model.CreatedByName ?? "Dữ liệu cũ / chưa ghi nhận")</dd>

                    <dt class="col-5">Ngày tạo</dt>
                    <dd class="col-7">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
                </dl>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold">Quản lý tài khoản</div>
            <div class="card-body d-grid gap-2">
                <form asp-action="ToggleStatus" method="post" onsubmit="return confirm('@(Model.IsActive ? "Khóa tài khoản nhân viên này? Dữ liệu lịch sử vẫn được giữ lại." : "Kích hoạt lại tài khoản nhân viên này?")');">
                    <input type="hidden" name="id" value="@Model.UserId" />
                    <button class="btn @(Model.IsActive ? "btn-outline-danger" : "btn-outline-success") w-100" type="submit">
                        @(Model.IsActive ? "Khóa tài khoản" : "Kích hoạt lại")
                    </button>
                </form>

                <div class="small text-muted mt-2">
                    SmartCar không xóa cứng tài khoản nhân viên để vẫn truy vết được các thao tác giao xe, nhận xe và nghiệp vụ đã thực hiện.
                </div>
            </div>
        </div>
    </div>
</div>
