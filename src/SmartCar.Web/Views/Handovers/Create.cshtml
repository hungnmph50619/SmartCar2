@model SmartCar.Web.ViewModels.HandoverViewModel
@{
    ViewData["Title"] = "Biên bản giao xe";

    var abnormalPrefix = "Có bất thường:";
    var hasAbnormalCondition = Model.ExteriorCondition?.StartsWith(
        abnormalPrefix,
        StringComparison.OrdinalIgnoreCase) == true;
    var abnormalConditionDetail = hasAbnormalCondition
        ? Model.ExteriorCondition!.Substring(abnormalPrefix.Length).Trim()
        : string.Empty;

    var currentMileage = ViewBag.CurrentMileage is int mileage ? mileage : 0;
    var vehicleFuelType = ViewBag.VehicleFuelType as string ?? string.Empty;
    var isElectricVehicle = string.Equals(
        vehicleFuelType,
        "Điện",
        StringComparison.OrdinalIgnoreCase);
}

<div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-3">
    <div>
        <h1 class="h3 mb-1">Lập biên bản giao xe - Đơn #@Model.BookingId</h1>
        <p class="text-muted mb-0">Ghi nhận ODO thực tế, nhiên liệu/pin, phụ kiện và bộ ảnh đối chiếu trước khi giao chìa khóa.</p>
    </div>
    <a class="btn btn-outline-secondary"
       asp-controller="AdminBookings"
       asp-action="Details"
       asp-route-id="@Model.BookingId">Quay lại đơn</a>
</div>

<div class="alert alert-info shadow-sm">
    <strong>Nguyên tắc bàn giao:</strong>
    ảnh là bằng chứng đối chiếu chính. Hãy nhìn trực tiếp đồng hồ trên xe để nhập đúng ODO và mức nhiên liệu/pin; đồng thời chụp rõ cụm đồng hồ cùng các góc xe trước khi giao chìa khóa.
</div>

<form asp-action="Create"
      method="post"
      enctype="multipart/form-data"
      class="card card-body shadow-sm"
      data-loading-form
      data-confirm="Xác nhận bàn giao xe? Sau thao tác này đơn sẽ chuyển sang trạng thái đang thuê.">
    <input asp-for="BookingId" type="hidden" />
    <input asp-for="ExteriorCondition" type="hidden" id="handover-condition-summary" />
    <input asp-for="InteriorCondition" type="hidden" id="handover-interior-summary" />
    <input asp-for="FuelLevel" type="hidden" id="handover-fuel-level" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

    <div class="row g-4">
        <div class="col-lg-8">
            <section class="border rounded-3 p-3 mb-4">
                <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-3">
                    <div>
                        <div class="text-uppercase small text-muted fw-semibold">Thông tin thực tế khi giao</div>
                        <h2 class="h5 mb-0">ODO & @(isElectricVehicle ? "mức pin" : "nhiên liệu")</h2>
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        @if (!string.IsNullOrWhiteSpace(vehicleFuelType))
                        {
                            <span class="badge bg-light text-dark border">@vehicleFuelType</span>
                        }
                        <span class="badge bg-light text-dark border">Bắt buộc</span>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="HandoverAt" class="form-label fw-semibold">Thời gian giao</label>
                        <input asp-for="HandoverAt" type="datetime-local" class="form-control" required />
                        <span asp-validation-for="HandoverAt" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Mileage" class="form-label fw-semibold">ODO thực tế khi giao</label>
                        <div class="input-group">
                            <input asp-for="Mileage"
                                   type="number"
                                   min="@currentMileage"
                                   step="1"
                                   class="form-control"
                                   required />
                            <span class="input-group-text">km</span>
                        </div>
                        <span asp-validation-for="Mileage" class="text-danger small"></span>
                        <div class="form-text">
                            Số km hiện tại trên hệ thống:
                            <strong>@currentMileage.ToString("N0") km</strong>.
                            Nhập đúng chỉ số ODO đang hiển thị trên xe; không nhập quãng đường dự kiến của chuyến thuê.
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            @(isElectricVehicle ? "Mức pin (SOC) khi giao" : "Mức nhiên liệu khi giao")
                        </label>

                        @if (isElectricVehicle)
                        {
                            <div class="input-group">
                                <input id="battery-percent-input"
                                       type="number"
                                       min="0"
                                       max="100"
                                       step="1"
                                       class="form-control"
                                       data-initial-fuel="@Model.FuelLevel"
                                       placeholder="Ví dụ: 82"
                                       required />
                                <span class="input-group-text">%</span>
                            </div>
                            <div class="form-text">
                                Nhập đúng SOC (%) trên bảng đồng hồ xe điện tại thời điểm giao.
                            </div>
                        }
                        else
                        {
                            <select id="fuel-gauge-select"
                                    class="form-select"
                                    data-initial-fuel="@Model.FuelLevel"
                                    required>
                                <option value="">-- Chọn đúng vạch trên đồng hồ --</option>
                                <option value="8/8 (100%)">8/8 - 100% - Đầy bình</option>
                                <option value="7/8 (~87.5%)">7/8 - khoảng 87,5%</option>
                                <option value="6/8 (75%)">6/8 - 75%</option>
                                <option value="5/8 (~62.5%)">5/8 - khoảng 62,5%</option>
                                <option value="4/8 (50%)">4/8 - 50%</option>
                                <option value="3/8 (~37.5%)">3/8 - khoảng 37,5%</option>
                                <option value="2/8 (25%)">2/8 - 25%</option>
                                <option value="1/8 (~12.5%)">1/8 - khoảng 12,5%</option>
                                <option value="0/8 (Gần cạn)">0/8 - Gần cạn</option>
                            </select>
                            <div class="form-text">
                                Chọn theo đúng số vạch thực tế trên đồng hồ nhiên liệu. Không ước lượng tùy ý bằng 25% / 50% / 75% nếu đồng hồ đang nằm ở vạch khác.
                            </div>
                        }

                        <span asp-validation-for="FuelLevel" class="text-danger small"></span>
                        <div class="alert alert-light border py-2 px-3 small mt-2 mb-0">
                            <strong>Ảnh bắt buộc đối chiếu:</strong>
                            chụp rõ cụm đồng hồ để nhìn thấy đồng thời ODO và @(isElectricVehicle ? "SOC pin" : "mức nhiên liệu") nếu có thể.
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Accessories" class="form-label fw-semibold">Phụ kiện / giấy tờ đi kèm</label>
                        <input asp-for="Accessories"
                               class="form-control"
                               placeholder="Ví dụ: 2 chìa khóa, đăng ký xe, lốp dự phòng, bộ dụng cụ..." />
                    </div>
                </div>
            </section>

            <section class="border rounded-3 p-3 mb-4">
                <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-3">
                    <div>
                        <div class="text-uppercase small text-muted fw-semibold">Tình trạng xe</div>
                        <h2 class="h5 mb-0">Chỉ ghi khi có bất thường</h2>
                    </div>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Ảnh là căn cứ chính</span>
                </div>

                <p class="text-muted small mb-3">
                    Không cần mô tả dài riêng ngoại thất và nội thất. Nếu xe bình thường, chỉ cần xác nhận không phát hiện bất thường; nếu có vết xước, móp, hư hỏng hoặc vấn đề nội thất thì ghi rõ và chụp cận cảnh.
                </p>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="border rounded-3 p-3 w-100 h-100 d-flex gap-3 align-items-start" for="condition-normal">
                            <input class="form-check-input mt-1"
                                   type="radio"
                                   name="conditionState"
                                   id="condition-normal"
                                   value="normal"
                                   checked="@(!hasAbnormalCondition)" />
                            <span>
                                <strong class="d-block">Không phát hiện bất thường</strong>
                                <span class="small text-muted">Tình trạng xe được xác nhận bằng bộ ảnh bàn giao.</span>
                            </span>
                        </label>
                    </div>

                    <div class="col-md-6">
                        <label class="border rounded-3 p-3 w-100 h-100 d-flex gap-3 align-items-start" for="condition-abnormal">
                            <input class="form-check-input mt-1"
                                   type="radio"
                                   name="conditionState"
                                   id="condition-abnormal"
                                   value="abnormal"
                                   checked="@hasAbnormalCondition" />
                            <span>
                                <strong class="d-block">Có bất thường</strong>
                                <span class="small text-muted">Phải mô tả vị trí/vấn đề và chụp ảnh cận cảnh.</span>
                            </span>
                        </label>
                    </div>
                </div>

                <div id="abnormal-condition-wrap" class="mt-3 @(hasAbnormalCondition ? string.Empty : "d-none")">
                    <label for="abnormal-condition-detail" class="form-label fw-semibold">Mô tả bất thường</label>
                    <textarea id="abnormal-condition-detail"
                              class="form-control"
                              rows="3"
                              maxlength="1000"
                              placeholder="Ví dụ: xước cản trước bên phải khoảng 5 cm; ghế sau có vết bẩn nhỏ...">@abnormalConditionDetail</textarea>
                    <div class="form-text">Mô tả ngắn, xác định được vị trí. Ảnh cận cảnh dùng để đối chiếu khi trả xe.</div>
                </div>

                <span asp-validation-for="ExteriorCondition" class="text-danger small d-block mt-2"></span>
            </section>

            <section class="border rounded-3 p-3 mb-4">
                <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-3">
                    <div>
                        <div class="text-uppercase small text-muted fw-semibold">Bằng chứng bàn giao</div>
                        <h2 class="h5 mb-0">Bộ ảnh đối chiếu khi giao xe</h2>
                    </div>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Tối thiểu 6 ảnh</span>
                </div>

                <div class="row g-2 mb-3 small">
                    <div class="col-md-4"><div class="bg-light rounded p-2 h-100">① Chính diện xe</div></div>
                    <div class="col-md-4"><div class="bg-light rounded p-2 h-100">② Phía sau xe</div></div>
                    <div class="col-md-4"><div class="bg-light rounded p-2 h-100">③ Bên trái thân xe</div></div>
                    <div class="col-md-4"><div class="bg-light rounded p-2 h-100">④ Bên phải thân xe</div></div>
                    <div class="col-md-4"><div class="bg-light rounded p-2 h-100">⑤ Đồng hồ ODO + @(isElectricVehicle ? "pin" : "nhiên liệu")</div></div>
                    <div class="col-md-4"><div class="bg-light rounded p-2 h-100">⑥ Nội thất xe</div></div>
                </div>

                <div class="alert alert-warning py-2 small">
                    Nếu có vết xước/hư hỏng hiện hữu, hãy tải thêm ảnh cận cảnh. Bộ ảnh này sẽ được đối chiếu với ảnh khi nhận lại xe.
                </div>

                <label asp-for="Images" class="form-label fw-semibold">Chọn ảnh bàn giao</label>
                <input asp-for="Images"
                       type="file"
                       multiple
                       accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                       class="form-control"
                       data-image-input
                       data-max-files="15"
                       data-preview-target="#handover-image-preview"
                       data-file-info-target="#handover-file-info" />
                <span asp-validation-for="Images" class="text-danger small"></span>
                <div class="form-text">Tải từ 6 đến 15 ảnh, mỗi ảnh tối đa 5 MB. Hỗ trợ JPG, JPEG, PNG và WEBP.</div>

                <div id="handover-file-info" class="small text-muted mt-2 d-none"></div>
                <div id="handover-image-preview" class="mt-3 d-none">
                    <div class="row g-2" data-preview-list></div>
                    <button type="button" class="btn btn-sm btn-outline-secondary mt-2" data-clear-image>Chọn lại ảnh</button>
                </div>
            </section>

            <section class="border rounded-3 p-3">
                <label asp-for="Notes" class="form-label fw-semibold">Ghi chú bàn giao</label>
                <textarea asp-for="Notes"
                          class="form-control"
                          rows="3"
                          placeholder="Thông tin bổ sung đã thống nhất với khách hàng (nếu có)"></textarea>
            </section>
        </div>

        <div class="col-lg-4">
            <div class="card bg-light border-0 sticky-top" style="top: 1rem;">
                <div class="card-body">
                    <div class="text-uppercase small text-muted fw-semibold mb-2">Checklist trước khi giao chìa khóa</div>
                    <h2 class="h5">Admin cần xác nhận đủ</h2>

                    <div class="d-grid gap-2 small mt-3">
                        <div class="d-flex gap-2"><span class="text-success">✓</span><span>Đúng khách hàng và đúng xe/biển số</span></div>
                        <div class="d-flex gap-2"><span class="text-success">✓</span><span>Đã đối chiếu CCCD/GPLX thực tế</span></div>
                        <div class="d-flex gap-2"><span class="text-success">✓</span><span>ODO nhập đúng theo đồng hồ thật của xe</span></div>
                        <div class="d-flex gap-2"><span class="text-success">✓</span><span>@(isElectricVehicle ? "SOC pin" : "Mức nhiên liệu") nhập đúng theo đồng hồ</span></div>
                        <div class="d-flex gap-2"><span class="text-success">✓</span><span>Đã kiểm tra phụ kiện/giấy tờ đi kèm</span></div>
                        <div class="d-flex gap-2"><span class="text-success">✓</span><span>Đã chụp ít nhất 6 ảnh đối chiếu</span></div>
                        <div class="d-flex gap-2"><span class="text-success">✓</span><span>Bất thường hiện hữu đã được mô tả và chụp cận cảnh</span></div>
                    </div>

                    <hr />
                    <div class="small mb-3">
                        <div class="text-muted">ODO đang lưu trên hệ thống</div>
                        <div class="fs-5 fw-bold">@currentMileage.ToString("N0") km</div>
                        <div class="text-muted">Biên bản không chấp nhận ODO nhỏ hơn giá trị này.</div>
                    </div>
                    <p class="small text-muted mb-0">
                        Sau khi lưu biên bản, hệ thống chuyển đơn sang <strong>Đang thuê</strong>. Chỉ xác nhận khi xe đã được kiểm tra cùng khách và sẵn sàng giao chìa khóa.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4 d-flex gap-2 flex-wrap border-top pt-3">
        <button class="btn btn-primary px-4"
                type="submit"
                data-loading-text="Đang lưu biên bản...">Xác nhận giao xe</button>
        <a class="btn btn-outline-secondary"
           asp-controller="AdminBookings"
           asp-action="Details"
           asp-route-id="@Model.BookingId">Hủy thao tác</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (() => {
            const normalRadio = document.getElementById('condition-normal');
            const abnormalRadio = document.getElementById('condition-abnormal');
            const abnormalWrap = document.getElementById('abnormal-condition-wrap');
            const abnormalDetail = document.getElementById('abnormal-condition-detail');
            const conditionSummary = document.getElementById('handover-condition-summary');
            const interiorSummary = document.getElementById('handover-interior-summary');

            if (!normalRadio || !abnormalRadio || !abnormalWrap || !abnormalDetail || !conditionSummary || !interiorSummary) {
                return;
            }

            const syncCondition = () => {
                if (abnormalRadio.checked) {
                    abnormalWrap.classList.remove('d-none');
                    abnormalDetail.required = true;
                    conditionSummary.value = `Có bất thường: ${abnormalDetail.value.trim()}`;
                    interiorSummary.value = 'Tình trạng nội thất được đối chiếu bằng bộ ảnh bàn giao; bất thường nếu có được ghi trong tình trạng chung.';
                    return;
                }

                abnormalWrap.classList.add('d-none');
                abnormalDetail.required = false;
                conditionSummary.value = 'Không phát hiện bất thường tại thời điểm bàn giao.';
                interiorSummary.value = 'Không phát hiện bất thường tại thời điểm bàn giao.';
            };

            normalRadio.addEventListener('change', syncCondition);
            abnormalRadio.addEventListener('change', syncCondition);
            abnormalDetail.addEventListener('input', syncCondition);

            const form = normalRadio.closest('form');
            form?.addEventListener('submit', syncCondition);

            syncCondition();
        })();

        (() => {
            const fuelLevel = document.getElementById('handover-fuel-level');
            const fuelGauge = document.getElementById('fuel-gauge-select');
            const batteryPercent = document.getElementById('battery-percent-input');

            if (!fuelLevel) {
                return;
            }

            if (fuelGauge) {
                const initialValue = fuelGauge.dataset.initialFuel || fuelLevel.value || '';
                if (initialValue && Array.from(fuelGauge.options).some(option => option.value === initialValue)) {
                    fuelGauge.value = initialValue;
                }

                const syncFuelGauge = () => {
                    fuelLevel.value = fuelGauge.value;
                };

                fuelGauge.addEventListener('change', syncFuelGauge);
                fuelGauge.closest('form')?.addEventListener('submit', syncFuelGauge);
                syncFuelGauge();
            }

            if (batteryPercent) {
                const initialValue = (batteryPercent.dataset.initialFuel || fuelLevel.value || '')
                    .replace('%', '')
                    .trim();
                if (initialValue) {
                    batteryPercent.value = initialValue;
                }

                const syncBattery = () => {
                    const value = batteryPercent.value.trim();
                    fuelLevel.value = value ? `${value}%` : '';
                };

                batteryPercent.addEventListener('input', syncBattery);
                batteryPercent.closest('form')?.addEventListener('submit', syncBattery);
                syncBattery();
            }
        })();
    </script>
}
