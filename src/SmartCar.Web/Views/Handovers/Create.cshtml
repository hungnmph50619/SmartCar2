@model SmartCar.Web.ViewModels.HandoverViewModel
@using SmartCar.Domain.Constants

@{
    ViewData["Title"] = "Biên bản giao xe";
    var handoverDate = Model.HandoverAt.ToString("yyyy-MM-dd");
    var handoverTime = Model.HandoverAt.ToString("HH:mm");
    var includedDays = Math.Max(1, Model.IncludedKilometers / RentalPolicy.IncludedKilometersPerDay);
    const string imageAccept = ".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp";
}

<div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-3">
    <div>
        <h1 class="h3 mb-1">Biên bản giao xe · #@Model.BookingId</h1>
        <p class="text-muted mb-0">Thông tin và ảnh này là căn cứ đối chiếu khi trả xe.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-controller="AdminBookings" asp-action="Details" asp-route-id="@Model.BookingId">Quay lại</a>
</div>

<form asp-controller="Handovers"
      asp-action="Create"
      method="post"
      enctype="multipart/form-data"
      class="card card-body shadow-sm"
      data-loading-form
      data-confirm="Lưu biên bản giao xe điện tử? Sau đó cần in, ký và tải bản ký trước khi bắt đầu chuyến thuê.">

    <input asp-for="BookingId" type="hidden" />
    <input asp-for="HandoverAt" type="hidden" id="handover-at-value" />

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger" id="handover-validation-summary">
            <strong>Chưa thể lưu biên bản.</strong>
            <div asp-validation-summary="All" class="mb-0 mt-1"></div>
        </div>
    }

    <h2 class="h5 mb-3">1. Thông tin giao xe</h2>
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label fw-semibold">Thời gian giao</label>
            <div class="row g-2">
                <div class="col-7"><input type="date" id="handover-date" value="@handoverDate" class="form-control" required /></div>
                <div class="col-5"><input type="text" id="handover-time" value="@handoverTime" class="form-control" inputmode="numeric" maxlength="5" pattern="(?:[01][0-9]|2[0-3]):[0-5][0-9]" placeholder="HH:mm" title="Giờ 24h, ví dụ 14:30" required /></div>
            </div>
            <div class="form-text">Giờ 24h · ví dụ 14:30.</div>
            <span asp-validation-for="HandoverAt" class="text-danger small"></span>
        </div>

        <div class="col-md-3">
            <label asp-for="Mileage" class="form-label fw-semibold">Số km</label>
            <input asp-for="Mileage" type="number" min="0" step="1" class="form-control" required />
            <span asp-validation-for="Mileage" class="text-danger small"></span>
        </div>

        <div class="col-md-3">
            <label asp-for="FuelLevel" class="form-label fw-semibold">Nhiên liệu</label>
            <div class="input-group">
                <input asp-for="FuelLevel" type="number" min="0" max="100" step="1" class="form-control" required />
                <span class="input-group-text">%</span>
            </div>
            <span asp-validation-for="FuelLevel" class="text-danger small"></span>
        </div>

        <div class="col-12">
            <label asp-for="Accessories" class="form-label fw-semibold">Phụ kiện</label>
            <input asp-for="Accessories" class="form-control" maxlength="1000" placeholder="VD: 2 chìa khóa, kích, lốp dự phòng" />
            <div class="form-text">Ghi các phụ kiện bàn giao để đối chiếu khi trả xe.</div>
        </div>
    </div>

    <hr class="my-4" />

    <div class="d-flex justify-content-between align-items-end gap-2 flex-wrap mb-2">
        <div>
            <h2 class="h5 mb-1">2. Ảnh đối chiếu</h2>
            <div class="text-muted small">Chọn nhiều ảnh trong một lần · tối thiểu 7, tối đa 14 ảnh · tối đa 5 MB/ảnh.</div>
        </div>
        <span class="badge text-bg-light">Nên có: trước · sau · trái · phải · nội thất · đồng hồ km · nhiên liệu</span>
    </div>

    <div class="border rounded p-3 bg-light">
        <label asp-for="Images" class="form-label fw-semibold">Chọn ảnh bàn giao *</label>
        <input asp-for="Images" id="handover-images" type="file" multiple accept="@imageAccept" class="form-control" required />
        <span asp-validation-for="Images" class="text-danger small"></span>
        <div class="d-flex justify-content-between align-items-center gap-2 mt-2 flex-wrap">
            <div class="form-text m-0">Giữ Ctrl/Shift khi chọn trên máy tính hoặc chọn nhiều ảnh từ thư viện điện thoại.</div>
            <span id="handover-image-count" class="badge text-bg-secondary">Chưa chọn ảnh</span>
        </div>
        <div id="handover-image-preview" class="d-flex flex-wrap gap-2 mt-3"></div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-warning py-2 mt-3 mb-0 small">Form có lỗi thì trình duyệt không giữ ảnh. Hãy chọn lại ảnh trước khi lưu.</div>
    }

    <hr class="my-4" />

    <h2 class="h5 mb-3">3. Chính sách đã thông báo</h2>
    <div class="row g-2 mb-3">
        <div class="col-md-4">
            <div class="border rounded p-3 h-100">
                <div class="small text-muted">Định mức</div>
                <strong>@RentalPolicy.IncludedKilometersPerDay.ToString("N0") km/ngày</strong>
                <div class="small text-muted mt-1">Chuyến này: @Model.IncludedKilometers.ToString("N0") km / @includedDays ngày</div>
            </div>
        </div>
        <div class="col-md-4"><div class="border rounded p-3 h-100"><div class="small text-muted">Vượt km</div><strong>@Model.ExcessKmFeePerKm.ToString("N0") đ/km</strong></div></div>
        <div class="col-md-4"><div class="border rounded p-3 h-100"><div class="small text-muted">Trả muộn</div><strong>@Model.LateReturnFeeMultiplier.ToString("0.##") × giá/ngày</strong></div></div>
    </div>

    <div class="border rounded p-3 mb-2">
        <strong>Vi phạm giao thông / phạt nguội</strong>
        <div class="small mt-1">@Model.TrafficFineTerms</div>
    </div>
    <div class="border rounded p-3 mb-3">
        <strong>Hư hỏng / thiếu / trả muộn</strong>
        <div class="small mt-1">@Model.DamageCompensationTerms</div>
    </div>

    <label asp-for="Notes" class="form-label fw-semibold">Ghi chú</label>
    <textarea asp-for="Notes" class="form-control" rows="2" maxlength="1500" placeholder="Chỉ ghi khi cần, ví dụ vết xước sẵn có"></textarea>
    <span asp-validation-for="Notes" class="text-danger small"></span>

    <div class="mt-4 d-flex gap-2 flex-wrap">
        <button class="btn btn-primary" type="submit" data-loading-text="Đang lưu...">Lưu biên bản</button>
        <a class="btn btn-outline-secondary" asp-controller="AdminBookings" asp-action="Details" asp-route-id="@Model.BookingId">Hủy</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const form = document.querySelector('form[data-loading-form]');
            const hidden = document.getElementById('handover-at-value');
            const date = document.getElementById('handover-date');
            const time = document.getElementById('handover-time');
            const imageInput = document.getElementById('handover-images');
            const imagePreview = document.getElementById('handover-image-preview');
            const imageCount = document.getElementById('handover-image-count');
            const timePattern = /^(?:[01]\d|2[0-3]):[0-5]\d$/;
            let previewUrls = [];

            function syncDateTime() {
                if (!date?.value || !timePattern.test(time?.value || '')) return false;
                hidden.value = `${date.value}T${time.value}`;
                return true;
            }

            function clearPreviewUrls() {
                previewUrls.forEach(url => URL.revokeObjectURL(url));
                previewUrls = [];
            }

            function renderImagePreview() {
                if (!imageInput || !imagePreview || !imageCount) return;

                clearPreviewUrls();
                imagePreview.innerHTML = '';
                const files = Array.from(imageInput.files || []);
                imageCount.textContent = files.length > 0 ? `Đã chọn ${files.length} ảnh` : 'Chưa chọn ảnh';
                imageCount.className = `badge ${files.length >= 7 && files.length <= 14 ? 'text-bg-success' : 'text-bg-secondary'}`;

                files.forEach((file, index) => {
                    const url = URL.createObjectURL(file);
                    previewUrls.push(url);

                    const wrapper = document.createElement('div');
                    wrapper.className = 'border rounded bg-white p-1';
                    wrapper.style.width = '116px';

                    const image = document.createElement('img');
                    image.src = url;
                    image.alt = `Ảnh bàn giao ${index + 1}`;
                    image.className = 'rounded d-block w-100';
                    image.style.height = '78px';
                    image.style.objectFit = 'cover';
                    image.style.cursor = 'zoom-in';
                    image.title = 'Bấm để xem ảnh lớn';
                    image.addEventListener('click', () => window.open(url, '_blank'));

                    const caption = document.createElement('div');
                    caption.className = 'small text-muted text-center text-truncate mt-1';
                    caption.textContent = `${index + 1}. ${file.name}`;
                    caption.title = file.name;

                    wrapper.append(image, caption);
                    imagePreview.appendChild(wrapper);
                });
            }

            date?.addEventListener('change', syncDateTime);
            time?.addEventListener('input', syncDateTime);
            imageInput?.addEventListener('change', renderImagePreview);

            form?.addEventListener('submit', event => {
                if (!syncDateTime()) {
                    event.preventDefault();
                    time?.setCustomValidity('Nhập giờ 24h theo dạng HH:mm.');
                    time?.reportValidity();
                    return;
                }

                time?.setCustomValidity('');
                const imageTotal = imageInput?.files?.length || 0;
                if (imageTotal < 7 || imageTotal > 14) {
                    event.preventDefault();
                    imageInput?.setCustomValidity('Vui lòng chọn từ 7 đến 14 ảnh bàn giao.');
                    imageInput?.reportValidity();
                    return;
                }

                imageInput?.setCustomValidity('');
            });

            syncDateTime();
            renderImagePreview();
            document.getElementById('handover-validation-summary')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        })();
    </script>
}
