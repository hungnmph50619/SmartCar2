@model SmartCar.Web.ViewModels.HandoverViewModel
@{
    ViewData["Title"] = "Lập hồ sơ bàn giao";

    var currentMileage = ViewBag.CurrentMileage is int mileage ? mileage : 0;
    var vehicleFuelType = ViewBag.VehicleFuelType as string ?? string.Empty;
    var isElectricVehicle = string.Equals(vehicleFuelType, "Điện", StringComparison.OrdinalIgnoreCase);
    var customerName = ViewBag.HandoverCustomerName as string ?? "Khách thuê";
    var customerPhone = ViewBag.HandoverCustomerPhone as string ?? string.Empty;
    var vehicleName = ViewBag.HandoverVehicleName as string ?? "Xe thuê";
    var licensePlate = ViewBag.HandoverLicensePlate as string ?? string.Empty;
    var pickupLocation = ViewBag.HandoverPickupLocation as string ?? string.Empty;
    var pickupDate = ViewBag.HandoverPickupDate is DateTime pickupAt ? pickupAt : Model.HandoverAt;
    var returnDate = ViewBag.HandoverReturnDate is DateTime returnAt ? returnAt : Model.HandoverAt;
}

<div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-3">
    <div>
        <div class="text-uppercase small text-primary fw-semibold">SmartCar pre-trip inspection</div>
        <h1 class="h3 mb-1">Lập hồ sơ bàn giao · Đơn #@Model.BookingId</h1>
        <p class="text-muted mb-0">Nhân viên tạo bộ bằng chứng độc lập của SmartCar. Sau đó khách phải tự check-in 6 ảnh trên tài khoản của mình trước khi nhận chìa khóa.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-controller="AdminBookings" asp-action="Details" asp-route-id="@Model.BookingId">← Quay lại đơn</a>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body py-3">
        <div class="row g-3">
            <div class="col-md-3"><div class="small text-muted">Khách</div><div class="fw-semibold">@customerName</div><div class="small">@customerPhone</div></div>
            <div class="col-md-3"><div class="small text-muted">Xe</div><div class="fw-semibold">@vehicleName</div><div class="small">@licensePlate</div></div>
            <div class="col-md-3"><div class="small text-muted">Lịch nhận</div><div class="fw-semibold">@pickupDate.ToString("dd/MM/yyyy HH:mm")</div><div class="small">@pickupLocation</div></div>
            <div class="col-md-3"><div class="small text-muted">Lịch trả</div><div class="fw-semibold">@returnDate.ToString("dd/MM/yyyy HH:mm")</div></div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body py-3">
        <div class="row g-2 text-center">
            <div class="col-6 col-lg-3"><div class="handover-step active rounded-3 p-2" data-step-indicator="1"><strong class="small">1. Người nhận</strong><div class="small text-muted">CCCD · GPLX</div></div></div>
            <div class="col-6 col-lg-3"><div class="handover-step rounded-3 p-2" data-step-indicator="2"><strong class="small">2. Ảnh SmartCar</strong><div class="small text-muted">6–15 ảnh</div></div></div>
            <div class="col-6 col-lg-3"><div class="handover-step rounded-3 p-2" data-step-indicator="3"><strong class="small">3. Thông số</strong><div class="small text-muted">ODO · nhiên liệu</div></div></div>
            <div class="col-6 col-lg-3"><div class="handover-step rounded-3 p-2" data-step-indicator="4"><strong class="small">4. Chốt hồ sơ</strong><div class="small text-muted">Yêu cầu khách check-in</div></div></div>
        </div>
    </div>
</div>

<form asp-action="Create"
      method="post"
      enctype="multipart/form-data"
      id="handover-form"
      data-loading-form
      data-confirm="Tạo hồ sơ bằng chứng SmartCar và chuyển sang chờ khách tự check-in 6 ảnh? Chưa giao chìa khóa ở bước này.">
    <input asp-for="BookingId" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

    <section class="handover-panel" data-step-panel="1">
        <div class="card shadow-sm border-0"><div class="card-body p-4">
            <div class="text-uppercase small text-primary fw-semibold">Bước 1/4</div>
            <h2 class="h4">Xác minh đúng người nhận</h2>
            <p class="text-muted">Đây là checkpoint danh tính trước khi SmartCar tạo bộ ảnh bàn giao.</p>

            <div class="d-grid gap-3 mt-4">
                <label class="border rounded-3 p-3 d-flex gap-3 align-items-start">
                    <input asp-for="RecipientConfirmed" class="form-check-input mt-1" required />
                    <span><strong class="d-block">Đúng khách của đơn #@Model.BookingId</strong><span class="small text-muted">Người đang có mặt đúng với hồ sơ khách thuê.</span></span>
                </label>
                <label class="border rounded-3 p-3 d-flex gap-3 align-items-start">
                    <input asp-for="CitizenIdOriginalChecked" class="form-check-input mt-1" required />
                    <span><strong class="d-block">Đã đối chiếu CCCD bản gốc</strong><span class="small text-muted">Thông tin và ảnh khớp hồ sơ đã xác minh.</span></span>
                </label>
                <label class="border rounded-3 p-3 d-flex gap-3 align-items-start">
                    <input asp-for="DrivingLicenseOriginalChecked" class="form-check-input mt-1" required />
                    <span><strong class="d-block">Đã đối chiếu GPLX bản gốc</strong><span class="small text-muted">GPLX đúng người nhận và còn phù hợp.</span></span>
                </label>
            </div>

            <div class="d-flex justify-content-end mt-4"><button type="button" class="btn btn-primary" data-next-step="2">Tiếp tục →</button></div>
        </div></div>
    </section>

    <section class="handover-panel d-none" data-step-panel="2">
        <div class="card shadow-sm border-0"><div class="card-body p-4">
            <div class="text-uppercase small text-primary fw-semibold">Bước 2/4</div>
            <h2 class="h4">Bộ ảnh độc lập của SmartCar</h2>
            <p class="text-muted">Chụp đủ các góc chính. Khách sẽ tạo một bộ ảnh riêng ở bước customer check-in, vì vậy hai bên có hai nguồn bằng chứng độc lập.</p>

            <div class="row g-2 small mb-3">
                <div class="col-md-4"><div class="bg-light rounded p-2">① Chính diện xe</div></div>
                <div class="col-md-4"><div class="bg-light rounded p-2">② Phía sau xe</div></div>
                <div class="col-md-4"><div class="bg-light rounded p-2">③ Bên trái thân xe</div></div>
                <div class="col-md-4"><div class="bg-light rounded p-2">④ Bên phải thân xe</div></div>
                <div class="col-md-4"><div class="bg-light rounded p-2">⑤ ODO + nhiên liệu/pin</div></div>
                <div class="col-md-4"><div class="bg-light rounded p-2">⑥ Nội thất xe</div></div>
            </div>

            <label asp-for="Images" class="form-label fw-semibold">Ảnh SmartCar tại thời điểm giao</label>
            <input asp-for="Images" id="handover-images" type="file" multiple accept="image/jpeg,image/png,image/webp" class="form-control" required />
            <span asp-validation-for="Images" class="text-danger small"></span>
            <div class="form-text">Tối thiểu 6, tối đa 15 ảnh; mỗi ảnh tối đa 5 MB.</div>
            <div id="photo-count" class="small fw-semibold text-primary mt-2">Chưa chọn ảnh</div>

            <div class="mt-4">
                <label asp-for="Notes" class="form-label fw-semibold">Ghi chú hiện trạng có sẵn <span class="text-muted fw-normal">(nếu có)</span></label>
                <textarea asp-for="Notes" class="form-control" rows="3" maxlength="1000" placeholder="Ví dụ: cản trước bên phải có vết xước cũ khoảng 5 cm..."></textarea>
                <div class="form-text">Nếu có vết cũ, ghi đúng vị trí và bảo đảm có ảnh thể hiện rõ.</div>
            </div>

            <div class="d-flex justify-content-between mt-4"><button type="button" class="btn btn-outline-secondary" data-prev-step="1">← Quay lại</button><button type="button" class="btn btn-primary" data-next-step="3">Tiếp tục →</button></div>
        </div></div>
    </section>

    <section class="handover-panel d-none" data-step-panel="3">
        <div class="card shadow-sm border-0"><div class="card-body p-4">
            <div class="text-uppercase small text-primary fw-semibold">Bước 3/4</div>
            <h2 class="h4">Thông số bàn giao</h2>
            <div class="row g-3 mt-2">
                <div class="col-md-6">
                    <label asp-for="HandoverAt" class="form-label fw-semibold">Thời gian giao ghi nhận</label>
                    <input asp-for="HandoverAt" type="datetime-local" class="form-control" required />
                    <span asp-validation-for="HandoverAt" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Mileage" class="form-label fw-semibold">ODO</label>
                    <div class="input-group"><input asp-for="Mileage" type="number" min="@currentMileage" class="form-control" required /><span class="input-group-text">km</span></div>
                    <span asp-validation-for="Mileage" class="text-danger small"></span>
                    <div class="form-text">ODO hệ thống hiện tại: @currentMileage.ToString("N0") km.</div>
                </div>
                <div class="col-md-6">
                    <label asp-for="FuelLevel" class="form-label fw-semibold">@(isElectricVehicle ? "Mức pin" : "Mức nhiên liệu")</label>
                    @if (isElectricVehicle)
                    {
                        <div class="input-group"><input asp-for="FuelLevel" type="number" min="0" max="100" class="form-control" required /><span class="input-group-text">% SOC</span></div>
                    }
                    else
                    {
                        <select asp-for="FuelLevel" class="form-select" required>
                            <option value="">-- Chọn mức --</option>
                            <option value="8/8 (100%)">8/8 - 100%</option>
                            <option value="7/8 (~87.5%)">7/8 - ~87,5%</option>
                            <option value="6/8 (75%)">6/8 - 75%</option>
                            <option value="5/8 (~62.5%)">5/8 - ~62,5%</option>
                            <option value="4/8 (50%)">4/8 - 50%</option>
                            <option value="3/8 (~37.5%)">3/8 - ~37,5%</option>
                            <option value="2/8 (25%)">2/8 - 25%</option>
                            <option value="1/8 (~12.5%)">1/8 - ~12,5%</option>
                            <option value="0/8 (Gần cạn)">0/8 - Gần cạn</option>
                        </select>
                    }
                    <span asp-validation-for="FuelLevel" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Accessories" class="form-label fw-semibold">Phụ kiện / giấy tờ giao kèm</label>
                    <textarea asp-for="Accessories" class="form-control" rows="3" maxlength="1000" placeholder="Ví dụ: 2 chìa khóa, đăng kiểm, bộ bơm lốp..."></textarea>
                </div>
            </div>

            <div class="d-flex justify-content-between mt-4"><button type="button" class="btn btn-outline-secondary" data-prev-step="2">← Quay lại</button><button type="button" class="btn btn-primary" data-next-step="4">Tiếp tục →</button></div>
        </div></div>
    </section>

    <section class="handover-panel d-none" data-step-panel="4">
        <div class="card shadow-sm border-0"><div class="card-body p-4">
            <div class="text-uppercase small text-success fw-semibold">Bước 4/4</div>
            <h2 class="h4">Chốt hồ sơ SmartCar và chuyển khách sang check-in</h2>
            <p class="text-muted">Nút dưới đây không xác nhận thay khách và chưa chuyển đơn sang Đang thuê. Nó chỉ khóa bộ dữ liệu do SmartCar lập và yêu cầu khách tự tạo bộ ảnh check-in độc lập.</p>

            <div class="alert alert-info">
                <strong>Luồng tiếp theo:</strong><br />
                SmartCar tạo hồ sơ → khách tự chụp 6 ảnh check-in trên tài khoản → khách khai vết cũ nếu có → hệ thống khóa bằng chứng → lúc đó Booking mới chuyển sang <strong>Đang thuê</strong> và mới giao chìa khóa.
            </div>

            <label class="border rounded-3 p-3 d-flex gap-3 align-items-start">
                <input asp-for="FinalHandoverConfirmed" class="form-check-input mt-1" required />
                <span><strong class="d-block">Tôi xác nhận đã ghi đầy đủ bộ ảnh và thông số thực tế của SmartCar</strong><span class="small text-muted">Tôi hiểu khách vẫn phải tự check-in và chưa được coi là đã nhận xe ở bước này.</span></span>
            </label>

            <div class="d-flex justify-content-between mt-4"><button type="button" class="btn btn-outline-secondary" data-prev-step="3">← Quay lại</button><button type="submit" class="btn btn-success px-4" data-loading-text="Đang tạo hồ sơ...">Tạo hồ sơ & yêu cầu khách check-in</button></div>
        </div></div>
    </section>
</form>

<style>
    .handover-step { background:#f8f9fa; border:1px solid transparent; }
    .handover-step.active { background:#e9f2ff; border-color:#9ec5fe; }
    .handover-step.done { background:#e8f5ee; border-color:#a3cfbb; }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const form = document.getElementById('handover-form');
            const panels = Array.from(document.querySelectorAll('[data-step-panel]'));
            const indicators = Array.from(document.querySelectorAll('[data-step-indicator]'));
            const images = document.getElementById('handover-images');
            const photoCount = document.getElementById('photo-count');
            let currentStep = 1;

            const showStep = step => {
                currentStep = step;
                panels.forEach(panel => panel.classList.toggle('d-none', Number(panel.dataset.stepPanel) !== step));
                indicators.forEach(indicator => {
                    const value = Number(indicator.dataset.stepIndicator);
                    indicator.classList.toggle('active', value === step);
                    indicator.classList.toggle('done', value < step);
                });
                window.scrollTo({ top: Math.max(0, form.offsetTop - 120), behavior: 'smooth' });
            };

            const validateCurrent = () => {
                const panel = panels.find(item => Number(item.dataset.stepPanel) === currentStep);
                if (!panel) return true;
                for (const element of panel.querySelectorAll('input,select,textarea')) {
                    if (!element.checkValidity()) { element.reportValidity(); return false; }
                }
                if (currentStep === 2) {
                    const count = images?.files?.length ?? 0;
                    if (count < 6 || count > 15) {
                        alert('Bộ ảnh SmartCar phải từ 6 đến 15 ảnh.');
                        return false;
                    }
                }
                return true;
            };

            document.querySelectorAll('[data-next-step]').forEach(button => button.addEventListener('click', () => {
                if (validateCurrent()) showStep(Number(button.dataset.nextStep));
            }));
            document.querySelectorAll('[data-prev-step]').forEach(button => button.addEventListener('click', () => showStep(Number(button.dataset.prevStep))));

            images?.addEventListener('change', () => {
                const count = images.files?.length ?? 0;
                if (photoCount) photoCount.textContent = count ? `${count} ảnh đã chọn` : 'Chưa chọn ảnh';
            });

            form?.addEventListener('submit', event => {
                if (!validateCurrent()) event.preventDefault();
            });
        })();
    </script>
}
