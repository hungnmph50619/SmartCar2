@model SmartCar.Web.ViewModels.HandoverViewModel
@{
    ViewData["Title"] = "Biên bản bàn giao xe";

    var currentMileage = ViewBag.CurrentMileage is int mileage ? mileage : 0;
    var vehicleFuelType = ViewBag.VehicleFuelType as string ?? string.Empty;
    var isElectricVehicle = string.Equals(vehicleFuelType, "Điện", StringComparison.OrdinalIgnoreCase);
    var customerName = ViewBag.HandoverCustomerName as string ?? "Khách thuê";
    var customerPhone = ViewBag.HandoverCustomerPhone as string ?? string.Empty;
    var vehicleName = ViewBag.HandoverVehicleName as string ?? "Xe thuê";
    var licensePlate = ViewBag.HandoverLicensePlate as string ?? string.Empty;
    var pickupLocation = ViewBag.HandoverPickupLocation as string ?? string.Empty;
    var pickupDate = ViewBag.HandoverPickupDate is DateTime pickupAt ? pickupAt : Model.HandoverAt;
}

<div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
    <div>
        <div class="text-uppercase small text-primary fw-semibold">Bàn giao xe</div>
        <h1 class="h3 mb-1">Biên bản bàn giao · Đơn #@Model.BookingId</h1>
        <p class="text-muted mb-0">Nhân viên SmartCar chụp ảnh hiện trạng, khách ký biên bản giấy trực tiếp, sau đó ảnh biên bản có chữ ký được lưu vào hồ sơ trên hệ thống.</p>
    </div>
    <a class="btn btn-outline-secondary"
       asp-controller="AdminBookings"
       asp-action="Details"
       asp-route-id="@Model.BookingId">← Quay lại đơn</a>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-4">
        <div class="row g-3">
            <div class="col-md-3">
                <div class="small text-muted">Khách nhận xe</div>
                <div class="fw-semibold">@customerName</div>
                <div class="small">@customerPhone</div>
            </div>
            <div class="col-md-3">
                <div class="small text-muted">Xe</div>
                <div class="fw-semibold">@vehicleName</div>
                <div class="small">@licensePlate</div>
            </div>
            <div class="col-md-3">
                <div class="small text-muted">Lịch nhận xe</div>
                <div class="fw-semibold">@pickupDate.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
            <div class="col-md-3">
                <div class="small text-muted">Địa điểm</div>
                <div class="fw-semibold">@(string.IsNullOrWhiteSpace(pickupLocation) ? "Chưa cập nhật" : pickupLocation)</div>
            </div>
        </div>
    </div>
</div>

<form asp-action="Create"
      method="post"
      enctype="multipart/form-data"
      data-loading-form
      data-confirm="Xác nhận khách đã ký biên bản giấy, ảnh biên bản đã được lưu rõ và hoàn tất bàn giao xe?">
    <input asp-for="BookingId" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3">
                <div>
                    <div class="text-uppercase small text-primary fw-semibold">Bước 1</div>
                    <h2 class="h5 mb-1">Xác minh người nhận xe</h2>
                    <p class="small text-muted mb-0">Đối chiếu trực tiếp khách đang có mặt với hồ sơ đã xác minh trên SmartCar.</p>
                </div>
                <span class="badge bg-light text-dark border">Bắt buộc</span>
            </div>

            <div class="d-grid gap-3">
                <label class="border rounded-3 p-3 d-flex gap-3 align-items-start">
                    <input asp-for="RecipientConfirmed" class="form-check-input mt-1" type="checkbox" />
                    <span><strong class="d-block">Đúng người nhận xe</strong><span class="small text-muted">Người đang nhận xe đúng là khách thuê của đơn #@Model.BookingId.</span></span>
                </label>
                <span asp-validation-for="RecipientConfirmed" class="text-danger small"></span>

                <label class="border rounded-3 p-3 d-flex gap-3 align-items-start">
                    <input asp-for="CitizenIdOriginalChecked" class="form-check-input mt-1" type="checkbox" />
                    <span><strong class="d-block">Đã đối chiếu CCCD bản gốc</strong><span class="small text-muted">Thông tin và ảnh trên CCCD khớp với khách thuê.</span></span>
                </label>
                <span asp-validation-for="CitizenIdOriginalChecked" class="text-danger small"></span>

                <label class="border rounded-3 p-3 d-flex gap-3 align-items-start">
                    <input asp-for="DrivingLicenseOriginalChecked" class="form-check-input mt-1" type="checkbox" />
                    <span><strong class="d-block">Đã đối chiếu GPLX bản gốc</strong><span class="small text-muted">GPLX đúng người nhận và còn phù hợp để điều khiển xe.</span></span>
                </label>
                <span asp-validation-for="DrivingLicenseOriginalChecked" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3">
                <div>
                    <div class="text-uppercase small text-primary fw-semibold">Bước 2</div>
                    <h2 class="h5 mb-1">Ảnh hiện trạng xe khi giao</h2>
                    <p class="small text-muted mb-0">Ảnh do nhân viên SmartCar chụp tại thời điểm giao xe để làm căn cứ đối chiếu khi nhận lại xe.</p>
                </div>
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">6–15 ảnh</span>
            </div>

            <div class="row g-2 small mb-3">
                <div class="col-md-4"><div class="bg-light rounded p-2">① Chính diện xe</div></div>
                <div class="col-md-4"><div class="bg-light rounded p-2">② Phía sau xe</div></div>
                <div class="col-md-4"><div class="bg-light rounded p-2">③ Bên trái thân xe</div></div>
                <div class="col-md-4"><div class="bg-light rounded p-2">④ Bên phải thân xe</div></div>
                <div class="col-md-4"><div class="bg-light rounded p-2">⑤ Số km + nhiên liệu/pin</div></div>
                <div class="col-md-4"><div class="bg-light rounded p-2">⑥ Nội thất xe</div></div>
            </div>

            <label asp-for="Images" class="form-label fw-semibold">Ảnh xe tại thời điểm bàn giao</label>
            <input asp-for="Images"
                   type="file"
                   multiple
                   accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                   class="form-control"
                   data-image-input
                   data-max-files="15"
                   data-preview-target="#handover-image-preview"
                   data-file-info-target="#handover-file-info" />
            <span asp-validation-for="Images" class="text-danger small"></span>
            <div class="form-text">Tối thiểu 6 ảnh, tối đa 15 ảnh; mỗi ảnh tối đa 5 MB.</div>
            <div id="handover-file-info" class="small text-muted mt-2 d-none"></div>
            <div id="handover-image-preview" class="mt-3 d-none">
                <div class="row g-2" data-preview-list></div>
                <button type="button" class="btn btn-sm btn-outline-secondary mt-2" data-clear-image>Chọn lại ảnh</button>
            </div>

            <div class="mt-3">
                <label asp-for="Notes" class="form-label fw-semibold">Ghi chú hiện trạng nếu cần</label>
                <textarea asp-for="Notes" class="form-control" rows="3" maxlength="1000" placeholder="Ví dụ: cản trước bên phải có vết xước cũ khoảng 5 cm..."></textarea>
                <div class="form-text">Nếu xe có vết xước hoặc dấu vết cũ, ghi rõ vị trí và chụp ảnh tương ứng.</div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <div class="text-uppercase small text-primary fw-semibold">Bước 3</div>
            <h2 class="h5 mb-3">Thông tin bàn giao thực tế</h2>

            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="HandoverAt" class="form-label fw-semibold">Thời gian giao xe thực tế</label>
                    <input asp-for="HandoverAt" type="datetime-local" class="form-control" required />
                    <span asp-validation-for="HandoverAt" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Mileage" class="form-label fw-semibold">Số km trên đồng hồ khi giao</label>
                    <div class="input-group">
                        <input asp-for="Mileage" type="number" min="@currentMileage" class="form-control" required />
                        <span class="input-group-text">km</span>
                    </div>
                    <span asp-validation-for="Mileage" class="text-danger small"></span>
                    <div class="form-text">Số km hiện tại trên hệ thống: @currentMileage.ToString("N0") km.</div>
                </div>
                <div class="col-md-4">
                    <label asp-for="FuelLevel" class="form-label fw-semibold">@(isElectricVehicle ? "Mức pin khi giao" : "Mức nhiên liệu khi giao")</label>
                    @if (isElectricVehicle)
                    {
                        <div class="input-group">
                            <input asp-for="FuelLevel" type="number" min="0" max="100" class="form-control" required />
                            <span class="input-group-text">%</span>
                        </div>
                    }
                    else
                    {
                        <select asp-for="FuelLevel" class="form-select" required>
                            <option value="">-- Chọn mức trên đồng hồ --</option>
                            <option value="8/8 (100%)">8/8 - Đầy bình</option>
                            <option value="7/8 (~87.5%)">7/8 - khoảng 87,5%</option>
                            <option value="6/8 (75%)">6/8 - 75%</option>
                            <option value="5/8 (~62.5%)">5/8 - khoảng 62,5%</option>
                            <option value="4/8 (50%)">4/8 - 50%</option>
                            <option value="3/8 (~37.5%)">3/8 - khoảng 37,5%</option>
                            <option value="2/8 (25%)">2/8 - 25%</option>
                            <option value="1/8 (~12.5%)">1/8 - khoảng 12,5%</option>
                            <option value="0/8 (Gần cạn)">0/8 - Gần cạn</option>
                        </select>
                    }
                    <span asp-validation-for="FuelLevel" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-primary mb-4">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3">
                <div>
                    <div class="text-uppercase small text-primary fw-semibold">Bước 4</div>
                    <h2 class="h5 mb-1">Biên bản giấy có chữ ký khách</h2>
                    <p class="small text-muted mb-0">Khách kiểm tra tình trạng xe trực tiếp, ký vào biên bản giấy. Nhân viên chụp/scan rõ biên bản đã ký và tải lên hệ thống.</p>
                </div>
                <span class="badge bg-primary">Bằng chứng bắt buộc</span>
            </div>

            <div class="alert alert-danger">
                <strong>Nếu khách từ chối ký tại thời điểm giao xe:</strong>
                không giao chìa khóa, không hoàn tất bàn giao và không chuyển đơn sang Đang thuê. Quay lại đơn để xử lý hủy theo chính sách hiện hành.
            </div>

            <label asp-for="SignedDocumentImages" class="form-label fw-semibold">Ảnh biên bản bàn giao đã có chữ ký khách</label>
            <input asp-for="SignedDocumentImages"
                   type="file"
                   multiple
                   accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                   class="form-control"
                   data-image-input
                   data-max-files="3"
                   data-preview-target="#handover-document-preview"
                   data-file-info-target="#handover-document-info" />
            <span asp-validation-for="SignedDocumentImages" class="text-danger small"></span>
            <div class="form-text">Bắt buộc ít nhất 1 ảnh, tối đa 3 ảnh. Ảnh phải đọc được nội dung biên bản và nhìn rõ chữ ký khách.</div>
            <div id="handover-document-info" class="small text-muted mt-2 d-none"></div>
            <div id="handover-document-preview" class="mt-3 d-none">
                <div class="row g-2" data-preview-list></div>
                <button type="button" class="btn btn-sm btn-outline-secondary mt-2" data-clear-image>Chọn lại ảnh biên bản</button>
            </div>

            <label class="border rounded-3 p-3 d-flex gap-3 align-items-start mt-4">
                <input asp-for="FinalHandoverConfirmed" class="form-check-input mt-1" type="checkbox" />
                <span>
                    <strong class="d-block">Khách đã ký trực tiếp trên biên bản giấy</strong>
                    <span class="small text-muted">Tôi xác nhận ảnh biên bản tải lên là biên bản của đúng đơn này, có chữ ký khách và đã được kiểm tra rõ ràng.</span>
                </span>
            </label>
            <span asp-validation-for="FinalHandoverConfirmed" class="text-danger small"></span>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap border-top pt-3 mb-5">
        <div class="small text-muted">Sau khi hoàn tất, đơn chuyển sang <strong>Đang thuê</strong> và ảnh biên bản được giữ cùng hồ sơ giao xe.</div>
        <button class="btn btn-success px-4" type="submit" data-loading-text="Đang hoàn tất bàn giao...">Hoàn tất bàn giao xe</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
