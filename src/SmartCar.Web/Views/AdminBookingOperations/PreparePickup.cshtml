@model SmartCar.Application.Features.Operations.PickupPreparationDto
@using SmartCar.Domain.Constants
@{
    ViewData["Title"] = $"Xác nhận lịch giao xe - Đơn #{Model.BookingId}";
    var isHomeDelivery = Model.PickupMethod == DeliveryConstants.HomeDelivery;
    var pickupLocation = string.IsNullOrWhiteSpace(Model.PickupLocation) ? "Chưa cập nhật" : Model.PickupLocation;
    var directionsUrl = isHomeDelivery
        ? $"https://www.google.com/maps/dir/?api=1&origin={Uri.EscapeDataString(DeliveryConstants.SmartCarMapQuery)}&destination={Uri.EscapeDataString(pickupLocation)}"
        : $"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(pickupLocation)}";
}

<div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-3">
    <div>
        <div class="text-uppercase small text-primary fw-semibold">Bước 3 · Xác nhận khách</div>
        <h1 class="h3 mb-1">Liên hệ trước khi giao xe</h1>
        <p class="text-muted mb-0">Chỉ chuyển đơn sang Sẵn sàng giao xe sau khi khách xác nhận giờ và địa điểm nhận.</p>
    </div>
    <a class="btn btn-outline-secondary"
       asp-controller="AdminBookings"
       asp-action="Details"
       asp-route-id="@Model.BookingId">← Quay lại đơn</a>
</div>

<div class="row justify-content-center">
    <div class="col-xl-9">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3">
                    <div>
                        <div class="small text-muted">Lịch giao xe</div>
                        <div class="fs-4 fw-semibold">@Model.PickupDate.ToString("HH:mm · dd/MM/yyyy")</div>
                    </div>
                    <span class="badge @(isHomeDelivery ? "bg-primary" : "bg-success") px-3 py-2">
                        @(isHomeDelivery ? "SmartCar giao tận nơi" : "Khách tự đến")
                    </span>
                </div>

                <div class="border rounded-3 p-3 mb-3">
                    <div class="small text-muted">Địa điểm nhận xe</div>
                    <div class="fw-semibold mb-3">@pickupLocation</div>
                    <div class="d-flex gap-2 flex-wrap">
                        @if (!string.IsNullOrWhiteSpace(Model.CustomerPhone))
                        {
                            <a class="btn btn-success" href="tel:@Model.CustomerPhone">☎ Gọi khách @Model.CustomerPhone</a>
                        }
                        <a class="btn btn-outline-primary" href="@directionsUrl" target="_blank" rel="noopener noreferrer">
                            @(isHomeDelivery ? "⌖ Mở chỉ đường" : "⌖ Xem vị trí")
                        </a>
                    </div>
                </div>

                <div class="alert alert-light border small mb-0">
                    <strong>Quy tắc:</strong> nếu khách chưa phản hồi, chưa xác nhận bước này và chưa đưa xe đi giao. Tiếp tục liên hệ cho đến khi có phản hồi rõ ràng.
                </div>
            </div>
        </div>

        <form asp-action="ConfirmPickupDeparture"
              method="post"
              class="card shadow-sm border-primary"
              data-loading-form
              data-confirm="Xác nhận khách đã phản hồi và đồng ý nhận xe đúng giờ, đúng địa điểm?">
            <input type="hidden" name="bookingId" value="@Model.BookingId" />
            <input type="hidden" name="contactNote" value="Khách đã xác nhận lịch nhận xe." />

            <div class="card-body p-4">
                <div class="text-uppercase small text-primary fw-semibold">Kết quả liên hệ</div>
                <h2 class="h5 mb-3">Khách đã xác nhận lịch nhận?</h2>

                <label class="border rounded-3 p-3 d-flex gap-3 align-items-start mb-3" for="customerConfirmed">
                    <input class="form-check-input mt-1"
                           type="checkbox"
                           name="customerConfirmed"
                           value="true"
                           id="customerConfirmed"
                           required />
                    <span>
                        <strong class="d-block">Có, khách đã xác nhận sẽ nhận xe theo lịch trên</strong>
                        <span class="small text-muted">Admin đã gọi hoặc nhắn và nhận được phản hồi rõ ràng từ khách.</span>
                    </span>
                </label>

                <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap">
                    <div class="small text-muted">Sau khi xác nhận, đơn chuyển sang trạng thái <strong>Sẵn sàng giao xe</strong>.</div>
                    <button class="btn btn-primary px-4" type="submit" data-loading-text="Đang xác nhận...">✓ Xác nhận lịch giao xe</button>
                </div>
            </div>
        </form>
    </div>
</div>
