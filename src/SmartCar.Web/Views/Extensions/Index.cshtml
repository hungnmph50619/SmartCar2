@model IReadOnlyList<SmartCar.Application.Features.Extensions.ExtensionDto>
@using System.Globalization
@using SmartCar.Domain.Enums
@{
    ViewData["Title"] = "Lịch sử gia hạn";

    string StatusText(BookingExtensionStatus status) => status switch
    {
        BookingExtensionStatus.Pending => "Chờ quản trị viên duyệt",
        BookingExtensionStatus.NeedsEvidence => "Cần bổ sung minh chứng",
        BookingExtensionStatus.Approved => "Đã duyệt - chờ thanh toán",
        BookingExtensionStatus.Paid => "Đã thanh toán - gia hạn có hiệu lực",
        BookingExtensionStatus.Rejected => "Đã từ chối",
        BookingExtensionStatus.Cancelled => "Đã hủy",
        _ => status.ToString()
    };

    string BadgeClass(BookingExtensionStatus status) => status switch
    {
        BookingExtensionStatus.Paid => "bg-success",
        BookingExtensionStatus.Approved => "bg-primary",
        BookingExtensionStatus.Pending or BookingExtensionStatus.NeedsEvidence => "bg-warning text-dark",
        BookingExtensionStatus.Rejected or BookingExtensionStatus.Cancelled => "bg-danger",
        _ => "bg-secondary"
    };

    decimal? ParseCoordinate(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;
        return decimal.TryParse(
            value.Trim().Replace(',', '.'),
            NumberStyles.Float,
            CultureInfo.InvariantCulture,
            out var parsed)
            ? parsed
            : null;
    }

    (string Text, IReadOnlyList<string> ImagePaths, decimal? Latitude, decimal? Longitude, string? PlaceName) ParseEvidence(string? value)
    {
        const string imageMarker = "Ảnh minh chứng: ";
        if (string.IsNullOrWhiteSpace(value))
        {
            return (string.Empty, Array.Empty<string>(), null, null, null);
        }

        var rawText = value.Trim();
        var imagePaths = Array.Empty<string>();
        var imageIndex = rawText.IndexOf(imageMarker, StringComparison.OrdinalIgnoreCase);
        if (imageIndex >= 0)
        {
            var imageText = rawText[(imageIndex + imageMarker.Length)..].Trim();
            imagePaths = imageText
                .Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Where(path => !string.IsNullOrWhiteSpace(path))
                .ToArray();
            rawText = rawText[..imageIndex].Trim().TrimEnd('|').Trim();
        }

        decimal? latitude = null;
        decimal? longitude = null;
        string? placeName = null;
        var textParts = new List<string>();

        foreach (var part in rawText.Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            var locationMatch = System.Text.RegularExpressions.Regex.Match(
                part,
                @"Vị trí trực tiếp:\s*(-?\d+(?:[\.,]\d+)?)\s*,\s*(-?\d+(?:[\.,]\d+)?)",
                System.Text.RegularExpressions.RegexOptions.IgnoreCase);

            if (locationMatch.Success)
            {
                latitude = ParseCoordinate(locationMatch.Groups[1].Value);
                longitude = ParseCoordinate(locationMatch.Groups[2].Value);
                continue;
            }

            if (part.StartsWith("Địa điểm:", StringComparison.OrdinalIgnoreCase))
            {
                placeName = part["Địa điểm:".Length..].Trim();
                continue;
            }

            if (!part.StartsWith("Ảnh minh chứng:", StringComparison.OrdinalIgnoreCase))
            {
                textParts.Add(part.Trim());
            }
        }

        return (string.Join(" | ", textParts), imagePaths, latitude, longitude, placeName);
    }

    string MapUrl(decimal latitude, decimal longitude)
    {
        const decimal delta = 0.004m;
        var bbox = string.Join(',', new[]
        {
            (longitude - delta).ToString(CultureInfo.InvariantCulture),
            (latitude - delta).ToString(CultureInfo.InvariantCulture),
            (longitude + delta).ToString(CultureInfo.InvariantCulture),
            (latitude + delta).ToString(CultureInfo.InvariantCulture)
        });
        var marker = string.Join(',', new[]
        {
            latitude.ToString(CultureInfo.InvariantCulture),
            longitude.ToString(CultureInfo.InvariantCulture)
        });

        return $"https://www.openstreetmap.org/export/embed.html?bbox={Uri.EscapeDataString(bbox)}&layer=mapnik&marker={Uri.EscapeDataString(marker)}";
    }
}

<div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-4">
    <div>
        <h1 class="h3 mb-1">Lịch sử gia hạn</h1>
        <p class="text-muted mb-0">Theo dõi yêu cầu, minh chứng, phản hồi và khoản tiền cần thanh toán.</p>
    </div>
    <a class="btn btn-outline-primary" asp-controller="Bookings" asp-action="MyBookings">Đơn thuê của tôi</a>
</div>

<div class="alert alert-light border small">
    Nếu xe đã có đơn kế tiếp, gia hạn thông thường sẽ bị từ chối. Trường hợp bất khả kháng phải có minh chứng và vị trí.
    SmartCar ưu tiên đổi xe cho khách kế tiếp; nếu phải hủy đơn đó và có <strong>thiệt hại thực tế có căn cứ</strong>, khoản bồi thường sẽ được thông báo rõ và khấu trừ từ tiền cọc trước khi gia hạn được thanh toán.
    Khoản này không tự động bằng giá hợp đồng của khách kế tiếp và không phải khoản bạn chuyển thêm lần nữa.
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Bạn chưa có yêu cầu gia hạn nào.</div>
}
else
{
    <div class="d-grid gap-3">
        @foreach (var item in Model)
        {
            var evidence = ParseEvidence(item.EvidenceNote);

            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3">
                        <div>
                            <h2 class="h5 mb-1">
                                <a class="text-decoration-none" asp-controller="Bookings" asp-action="Details" asp-route-id="@item.BookingId">Đơn #@item.BookingId</a>
                                · @item.VehicleName
                            </h2>
                            <span class="badge @(item.IsForceMajeure ? "bg-danger" : "bg-light text-dark border")">@(item.IsForceMajeure ? "Bất khả kháng" : "Gia hạn thông thường")</span>
                        </div>
                        <span class="badge @BadgeClass(item.Status)">@StatusText(item.Status)</span>
                    </div>

                    <div class="row g-3 small">
                        <div class="col-md-3"><span class="text-muted">Trả cũ</span><div class="fw-semibold">@item.OriginalReturnDate.ToString("dd/MM/yyyy HH:mm")</div></div>
                        <div class="col-md-3"><span class="text-muted">Đề nghị trả mới</span><div class="fw-semibold">@item.RequestedReturnDate.ToString("dd/MM/yyyy HH:mm")</div></div>
                        <div class="col-md-3"><span class="text-muted">Phí gia hạn</span><div class="fw-semibold">@item.AdditionalAmount.ToString("N0") đ</div></div>
                        <div class="col-md-3"><span class="text-muted">Gửi lúc</span><div class="fw-semibold">@item.RequestedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div></div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(item.CustomerNote))
                    {
                        <div class="mt-3"><strong>Lý do gia hạn:</strong> @item.CustomerNote</div>
                    }

                    @if (item.IsForceMajeure && !string.IsNullOrWhiteSpace(item.EvidenceNote))
                    {
                        <div class="border rounded p-3 mt-3 bg-light">
                            <strong>Minh chứng đã gửi</strong>
                            @if (!string.IsNullOrWhiteSpace(evidence.Text))
                            {
                                <div class="mt-1">@evidence.Text</div>
                            }
                            @if (evidence.ImagePaths.Count > 0)
                            {
                                <div class="row g-2 mt-2">
                                    @for (var imageIndex = 0; imageIndex < evidence.ImagePaths.Count; imageIndex++)
                                    {
                                        var evidenceUrl = Url.Action(
                                            "Image",
                                            "ExtensionEvidenceFiles",
                                            new { extensionId = item.BookingExtensionId, index = imageIndex });
                                        <div class="col-6 col-md-3">
                                            <a href="@evidenceUrl" target="_blank" rel="noopener" class="d-block text-decoration-none">
                                                <img src="@evidenceUrl" alt="Ảnh minh chứng @(imageIndex + 1)" class="img-thumbnail w-100" style="height:130px;object-fit:contain;background:#f8f9fa" />
                                                <div class="small text-muted mt-1">Ảnh @(imageIndex + 1)</div>
                                            </a>
                                        </div>
                                    }
                                </div>
                            }
                            @if (evidence.Latitude.HasValue && evidence.Longitude.HasValue)
                            {
                                var lat = evidence.Latitude.Value;
                                var lng = evidence.Longitude.Value;
                                <div class="mt-3">
                                    <div class="small border rounded bg-white p-2 mb-2">
                                        <strong>Vị trí đã gửi:</strong> @lat.ToString("0.000000", CultureInfo.InvariantCulture), @lng.ToString("0.000000", CultureInfo.InvariantCulture)
                                        @if (!string.IsNullOrWhiteSpace(evidence.PlaceName))
                                        {
                                            <br />
                                            <strong>Địa điểm:</strong> @evidence.PlaceName
                                        }
                                    </div>
                                    <iframe title="Bản đồ vị trí minh chứng" class="w-100 rounded border" style="height:230px" loading="lazy" src="@MapUrl(lat, lng)"></iframe>
                                </div>
                            }
                        </div>
                    }

                    @if (item.HasScheduleConflict && item.IsForceMajeure && item.Status == BookingExtensionStatus.Pending)
                    {
                        <div class="alert alert-warning py-2 mt-3 mb-0">
                            Xe có lịch thuê tiếp theo trong khoảng bạn đề nghị. SmartCar đang liên hệ khách kế tiếp và ưu tiên phương án đổi xe.
                            Nếu phải hủy đơn kế tiếp, SmartCar sẽ xác định riêng thiệt hại thực tế (nếu có) và thông báo số tiền khấu trừ từ cọc trước khi duyệt gia hạn.
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(item.AdminNote))
                    {
                        <div class="alert @(item.Status == BookingExtensionStatus.Rejected ? "alert-danger" : "alert-info") py-2 mt-3 mb-0">
                            <strong>Phản hồi của SmartCar:</strong> @item.AdminNote
                        </div>
                    }

                    @if (item.Status == BookingExtensionStatus.NeedsEvidence && item.IsForceMajeure)
                    {
                        <form asp-action="SupplementEvidence" method="post" enctype="multipart/form-data" class="border rounded p-3 mt-3 bg-light">
                            <input type="hidden" name="extensionId" value="@item.BookingExtensionId" />
                            <input type="hidden" name="bookingId" value="@item.BookingId" />
                            <div class="fw-semibold mb-1">Bổ sung minh chứng bất khả kháng</div>
                            <div class="small text-muted mb-2">Không cần nhập lại lý do gia hạn. Chỉ bổ sung phần SmartCar yêu cầu để xác minh bất khả kháng.</div>
                            @if (!string.IsNullOrWhiteSpace(item.AdminNote))
                            {
                                <div class="alert alert-info py-2 small mb-3"><strong>SmartCar yêu cầu:</strong> @item.AdminNote</div>
                            }
                            <div class="row g-3 align-items-start">
                                <div class="col-lg-6 col-md-6">
                                    <label class="form-label small fw-semibold">Ảnh minh chứng bổ sung</label>
                                    <input name="evidenceImages" type="file" accept="image/jpeg,image/png,image/webp" class="form-control" multiple required />
                                    <div class="form-text">Chọn 2-8 ảnh JPG/PNG/WEBP, tối đa 5 MB/ảnh. Có thể bấm Chọn tệp nhiều lần để cộng thêm ảnh.</div>
                                </div>
                                <div class="col-lg-6 col-md-6">
                                    <label class="form-label small fw-semibold">Vị trí hiện tại</label>
                                    <button type="button" class="btn btn-outline-primary w-100 js-smart-current-location">Lấy vị trí hiện tại</button>
                                    <div class="form-text js-smart-location-status">Chưa lấy vị trí.</div>
                                </div>
                                <div class="col-12">
                                    <label class="form-label small fw-semibold">Mô tả bổ sung</label>
                                    <textarea name="evidenceNote" class="form-control" rows="3" maxlength="1000" required placeholder="Ghi rõ sự cố hiện tại, tình trạng xe và nội dung ảnh minh chứng bổ sung..."></textarea>
                                    <div class="form-text">Không nhập lại lý do gia hạn cũ; chỉ ghi nội dung cần bổ sung theo yêu cầu của SmartCar.</div>
                                </div>
                                <div class="col-12 d-flex justify-content-end">
                                    <button class="btn btn-primary px-4" type="submit">Gửi lại để duyệt</button>
                                </div>
                            </div>
                        </form>
                    }
                    else if (item.Status == BookingExtensionStatus.NeedsEvidence)
                    {
                        <div class="alert alert-warning mt-3 mb-0">
                            Yêu cầu này là dữ liệu gia hạn thông thường cũ nhưng đang ở trạng thái cần minh chứng.
                            Không gửi ảnh/GPS bất khả kháng; vui lòng liên hệ SmartCar để Admin duyệt hoặc từ chối lại yêu cầu.
                        </div>
                    }
                    else if (item.Status == BookingExtensionStatus.Approved)
                    {
                        <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mt-3 border-top pt-3">
                            <div class="small text-muted">
                                Yêu cầu đã được duyệt. Chỉ chuyển <strong>phí gia hạn hiển thị trên đơn</strong>;
                                khoản bồi thường từ cọc (nếu có) đã được SmartCar đối soát riêng và không chuyển lại lần nữa.
                            </div>
                            <a class="btn btn-primary" asp-controller="Bookings" asp-action="Details" asp-route-id="@item.BookingId">Mở đơn để thanh toán</a>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}