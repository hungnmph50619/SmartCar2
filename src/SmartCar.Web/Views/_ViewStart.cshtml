@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;

    var adminControllers = new System.Collections.Generic.HashSet<string>(System.StringComparer.OrdinalIgnoreCase)
    {
        "Dashboard",
        "AdminBookings",
        "AdminBookingOperations",
        "Handovers",
        "Returns",
        "AdminDocuments",
        "AdminCustomers",
        "AdminKyc",
        "AdminExtensions",
        "AdminVehicles",
        "VehicleDocuments",
        "Maintenance",
        "Incidents",
        "Brands",
        "Reports",
        "AuditLogs",
        "AdminRentalDocuments",
        "AdminSignedDocuments"
    };

    var staffControllers = new System.Collections.Generic.HashSet<string>(System.StringComparer.OrdinalIgnoreCase)
    {
        "Staff",
        "Handovers",
        "Returns",
        "AdminRentalDocuments",
        "AdminSignedDocuments",
        "ReturnHandoverPreview"
    };

    var isAdmin = ViewContext.HttpContext.User.IsInRole(RoleNames.Admin);
    var isStaff = ViewContext.HttpContext.User.IsInRole(RoleNames.Staff);

    var useStaffLayout = isStaff && staffControllers.Contains(controller);

    var useAdminLayout = isAdmin &&
        (adminControllers.Contains(controller) ||
         controller.Equals("Notifications", System.StringComparison.OrdinalIgnoreCase) ||
         controller.Equals("Profile", System.StringComparison.OrdinalIgnoreCase));

    Layout = useStaffLayout
        ? "_StaffLayout"
        : useAdminLayout
            ? "_AdminLayout"
            : "_Layout";
}