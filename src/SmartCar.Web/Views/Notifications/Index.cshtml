@model IReadOnlyList<SmartCar.Application.Features.Notifications.NotificationDto>
@{
    var isAdmin =
        User.IsInRole(
            SmartCar.Domain.Constants.RoleNames.Admin);

    ViewData["Title"] =
        isAdmin
            ? "Công việc & Thông báo"
            : "Thông báo";

    var workTitles = new[]
    {
        "Hồ sơ KYC chờ duyệt",
        "CCCD chờ xác minh",
        "GPLX chờ xác minh",
        "CCCD cập nhật chờ duyệt",
        "GPLX cập nhật chờ duyệt",
        "Đơn thuê chờ xử lý",
        "Yêu cầu gia hạn chờ xử lý",
        "Thanh toán QR chờ xác nhận"
    };

    string RawTitle(string title)
    {
        var separatorIndex = title.IndexOf('|');
        return separatorIndex > 0
            ? title[..separatorIndex]
            : title;
    }

    bool IsWorkTitle(string title) =>
        workTitles.Contains(
            RawTitle(title),
            StringComparer.Ordinal);

    var pendingWorkCount =
        Model.Count(item =>
            IsWorkTitle(item.Title) &&
            !item.IsRead);

    // ReadAt phản ánh người dùng đã mở/đọc.
    // IsRead của work item phản ánh nghiệp vụ đã hoàn tất.
    var unreadCount =
        Model.Count(item =>
            item.ReadAt is null);

    var unreadRegularCount =
        Model.Count(item =>
            item.ReadAt is null &&
            !IsWorkTitle(item.Title));

    var handledWorkCount =
        Model.Count(item =>
            IsWorkTitle(item.Title) &&
            item.IsRead);

    string FriendlyNotificationText(string value) =>
        value
            .Replace(
                "Hồ sơ KYC đã được xác minh",
                "Hồ sơ giấy tờ đã được duyệt",
                StringComparison.Ordinal)
            .Replace(
                "Hồ sơ KYC cần cập nhật",
                "Hồ sơ giấy tờ cần cập nhật",
                StringComparison.Ordinal)
            .Replace(
                "Hồ sơ KYC đã hoàn tất",
                "Xác minh giấy tờ đã hoàn tất",
                StringComparison.Ordinal)
            .Replace(
                "quyết định KYC",
                "quyết định xác minh hồ sơ",
                StringComparison.Ordinal)
            .Replace(
                "Hồ sơ KYC",
                "Hồ sơ xác minh giấy tờ",
                StringComparison.Ordinal)
            .Replace(
                "KYC",
                "xác minh giấy tờ",
                StringComparison.Ordinal);

    string FriendlyPolicyTitle(string title) =>
        title switch
        {
            "Cập nhật chính sách Tiền cọc" =>
                "Thay đổi quy định tiền cọc",
            "Cập nhật chính sách Quãng đường" =>
                "Thay đổi quy định quãng đường",
            "Cập nhật chính sách Trả muộn" =>
                "Thay đổi quy định trả xe muộn",
            "Cập nhật chính sách Đặt xe & thanh toán" =>
                "Thay đổi quy định đặt xe và thanh toán",
            "Cập nhật chính sách Giao xe tận nơi" =>
                "Thay đổi quy định giao xe tận nơi",
            "Cập nhật chính sách Hủy đơn & hoàn tiền" =>
                "Thay đổi quy định hủy đơn và hoàn tiền",
            "Cập nhật chính sách Không đến nhận xe" =>
                "Thay đổi quy định khi khách không đến nhận xe",
            "Cập nhật chính sách Điều khoản biên bản" =>
                "Thay đổi quy định trong biên bản",
            _ => title.Replace(
                "Cập nhật chính sách",
                "Thay đổi quy định",
                StringComparison.Ordinal)
        };

    string FriendlyPolicyLabel(string label) =>
        label switch
        {
            "Tỷ lệ cọc" =>
                "Tiền cọc tính theo tiền thuê",
            "Giữ cọc" =>
                "Thời gian giữ cọc sau khi trả xe",
            "Định mức quãng đường" =>
                "Số km được sử dụng mỗi ngày",
            "Phí vượt km" =>
                "Phí khi vượt số km quy định",
            "Hệ số trả muộn" =>
                "Mức phí trả xe muộn",
            "Miễn phí trả muộn" =>
                "Thời gian được miễn phí khi trả xe muộn",
            "Km trong phí giao" =>
                "Số km đã bao gồm trong phí giao xe",
            "Phí giao cơ bản" =>
                "Phí giao xe cơ bản",
            "Phí mỗi km giao thêm" =>
                "Phí cho mỗi km giao thêm",
            "Phạm vi giao tối đa" =>
                "Khoảng cách giao xe tối đa",
            "Chờ duyệt đơn" =>
                "Thời gian SmartCar chờ để xác nhận đơn",
            "Chờ khách thanh toán" =>
                "Thời gian khách được chờ để thanh toán",
            "Kiểm tra chuyển khoản" =>
                "Thời gian chờ SmartCar kiểm tra chuyển khoản",
            "Đặt trước giờ nhận" =>
                "Thời gian phải đặt xe trước giờ nhận",
            "Xoay vòng giữa hai lượt thuê" =>
                "Thời gian chuẩn bị xe giữa hai lượt thuê",
            "Chờ khách đến nhận" =>
                "Thời gian SmartCar chờ khách sau giờ nhận xe",
            "Tỷ lệ giữ tiền thuê khi No-show" =>
                "Phần tiền thuê bị giữ nếu khách không đến nhận xe",
            "Cửa sổ hủy miễn phí" =>
                "Thời gian được hủy miễn phí sau khi thanh toán",
            "Còn tối thiểu để hoàn 100%" =>
                "Thời gian tối thiểu còn lại để được hoàn 100%",
            "Xử lý hoàn tiền sau hủy" =>
                "Thời gian dự kiến xử lý hoàn tiền sau khi hủy",
            "Mốc hủy 1" =>
                "Mốc thời gian hủy 1",
            "Hoàn ở mốc 1" =>
                "Tỷ lệ hoàn tiền ở mốc 1",
            "Mốc hủy 2" =>
                "Mốc thời gian hủy 2",
            "Hoàn ở mốc 2" =>
                "Tỷ lệ hoàn tiền ở mốc 2",
            "Mốc hủy 3" =>
                "Mốc thời gian hủy 3",
            "Hoàn ở mốc 3" =>
                "Tỷ lệ hoàn tiền ở mốc 3",
            "Mốc hủy 4" =>
                "Mốc thời gian hủy 4",
            "Hoàn ở mốc 4" =>
                "Tỷ lệ hoàn tiền ở mốc 4",
            "Hoàn dưới mốc cuối" =>
                "Tỷ lệ hoàn tiền khi hủy sát giờ nhận",
            "Điều khoản phạt nguội" =>
                "Quy định về vi phạm giao thông / phạt nguội",
            "Điều khoản hư hỏng / bồi thường" =>
                "Quy định về hư hỏng / bồi thường",
            _ => label
        };

    var requestedAdminFilter =
        ViewBag.ActiveTab as string;

    var defaultAdminFilter =
        requestedAdminFilter is "work" or "unread" or "handled"
            ? requestedAdminFilter
            : pendingWorkCount > 0
                ? "work"
                : unreadCount > 0
                    ? "unread"
                    : "handled";
}

<style>
    .notifications-page {
        max-width: 1040px;
        margin: 0 auto;
    }

    .notifications-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .notifications-header h1 {
        font-weight: 750;
        letter-spacing: -.02em;
    }

    .notifications-summary {
        color: #687386;
        margin: .2rem 0 0;
    }

    .notifications-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: .5rem;
        margin-bottom: 1rem;
        padding: .35rem;
        border: 1px solid #e3e8ef;
        border-radius: 14px;
        background: #fff;
    }

    .notifications-tab {
        border: 0;
        border-radius: 10px;
        padding: .55rem .8rem;
        background: transparent;
        color: #596579;
        font-weight: 700;
        transition: background-color .18s ease, color .18s ease;
    }

    .notifications-tab:hover {
        background: #f5f7fa;
    }

    .notifications-tab.active {
        color: #0d6efd;
        background: #edf4ff;
    }

    .notifications-tab-count {
        display: inline-flex;
        min-width: 22px;
        min-height: 22px;
        align-items: center;
        justify-content: center;
        margin-left: .35rem;
        padding: 0 .35rem;
        border-radius: 999px;
        background: #e9edf3;
        color: #4a5568;
        font-size: .72rem;
    }

    .notifications-tab.active .notifications-tab-count {
        background: #0d6efd;
        color: #fff;
    }

    .notifications-admin-note {
        border: 0;
        border-radius: 12px;
        background: #f1f7ff;
        color: #345071;
    }

    .notifications-list {
        display: flex;
        flex-direction: column;
        gap: .75rem;
    }

    .notification-card {
        position: relative;
        display: flex;
        gap: .9rem;
        padding: 1rem;
        border: 1px solid #e3e8ef;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 4px 16px rgba(15, 23, 42, .045);
        transition:
            border-color .18s ease,
            box-shadow .18s ease,
            transform .18s ease;
    }

    .notification-card:has(.stretched-link):hover {
        border-color: #bfcde0;
        box-shadow: 0 8px 22px rgba(15, 23, 42, .08);
        transform: translateY(-1px);
    }

    .notification-card-work {
        background: #fffdf7;
        border-color: #f4cf83;
        box-shadow: 0 5px 18px rgba(168, 103, 0, .07);
    }

    .notification-card-unread {
        background: #f8fbff;
        border-color: #cfe0ff;
    }

    .notification-card-handled {
        background: #fbfcfe;
        opacity: .9;
    }

    .notification-icon {
        flex: 0 0 40px;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        font-weight: 800;
        line-height: 1;
    }

    .notification-tone-work .notification-icon,
    .notification-tone-warning .notification-icon {
        color: #9a5a00;
        background: #fff1d5;
    }

    .notification-tone-success .notification-icon {
        color: #147a45;
        background: #eaf8f0;
    }

    .notification-tone-info .notification-icon {
        color: #1967d2;
        background: #eaf2ff;
    }

    .notification-tone-policy .notification-icon {
        color: #b42318;
        background: #fee4e2;
        border-radius: 12px;
        box-shadow: inset 0 0 0 1px #fda29b;
    }

    .notification-card-policy {
        border-color: #fda29b;
        border-left: 5px solid #d92d20;
        background:
            linear-gradient(135deg, #fff5f4 0%, #fffafa 72%, #ffffff 100%);
        box-shadow: 0 7px 22px rgba(185, 28, 28, .08);
    }

    .notification-card-policy.notification-card-unread {
        border-color: #f97066;
        border-left-color: #d92d20;
        background:
            linear-gradient(135deg, #ffeceb 0%, #fff6f5 72%, #ffffff 100%);
        box-shadow: 0 9px 26px rgba(185, 28, 28, .12);
    }

    .notification-card-policy .notification-title {
        color: #9f1c12;
    }

    .notification-policy-change-list {
        display: grid;
        gap: .65rem;
        margin-top: .55rem;
    }

    .notification-policy-change {
        padding: .75rem .85rem;
        border: 1px solid #f9b4ae;
        border-radius: 11px;
        background: rgba(255, 255, 255, .82);
    }

    .notification-policy-change-label {
        margin-bottom: .5rem;
        color: #40211f;
        font-weight: 800;
        line-height: 1.4;
    }

    .notification-policy-value-row {
        display: flex;
        align-items: stretch;
        gap: .55rem;
    }

    .notification-policy-value {
        flex: 1 1 0;
        display: grid;
        gap: .12rem;
        padding: .55rem .7rem;
        border-radius: 9px;
    }

    .notification-policy-value span {
        font-size: .76rem;
        font-weight: 700;
    }

    .notification-policy-value strong {
        font-size: .98rem;
        line-height: 1.35;
    }

    .notification-policy-value-current {
        color: #596579;
        background: #f3f5f8;
    }

    .notification-policy-value-new {
        color: #b42318;
        background: #fee4e2;
    }

    .notification-policy-arrow {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 24px;
        color: #b42318;
        font-weight: 900;
    }

    .notification-policy-change-note {
        color: #b42318;
        font-weight: 700;
    }

    .notification-policy-details {
        display: flex;
        flex-wrap: wrap;
        gap: .45rem;
        margin-top: .55rem;
    }

    .notification-policy-chip {
        display: inline-flex;
        align-items: center;
        min-height: 28px;
        padding: .28rem .65rem;
        border-radius: 999px;
        font-size: .78rem;
        font-weight: 750;
    }

    .notification-policy-effective {
        color: #b42318;
        background: #fee4e2;
    }

    .notification-policy-protected {
        color: #12673c;
        background: #e9f7ef;
    }

    .notification-body {
        min-width: 0;
        flex: 1;
        padding-right: .35rem;
    }

    .notification-title-row {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: .45rem;
        padding-right: 1rem;
    }

    .notification-title {
        margin: 0;
        font-size: 1rem;
        font-weight: 750;
        color: #172033;
    }

    .notification-message {
        margin: .3rem 0 0;
        color: #465166;
        line-height: 1.5;
    }

    .notification-meta {
        margin-top: .45rem;
        color: #7b8495;
        font-size: .82rem;
    }

    .notification-actions {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: .5rem;
        margin-top: .75rem;
    }

    .notification-actions form {
        margin: 0;
    }

    .notification-unread-dot {
        position: absolute;
        z-index: 2;
        top: 1rem;
        right: 1rem;
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: #0d6efd;
        box-shadow: 0 0 0 3px #e8f1ff;
        pointer-events: none;
    }

    .notification-status {
        display: inline-flex;
        align-items: center;
        min-height: 22px;
        border-radius: 999px;
        padding: .18rem .55rem;
        font-size: .72rem;
        font-weight: 700;
    }

    .notification-status-work {
        color: #8a5200;
        background: #fff1d6;
    }

    .notification-status-new {
        color: #165ebd;
        background: #e7f0ff;
    }

    .notification-status-success {
        color: #12673c;
        background: #e9f7ef;
    }

    .notification-status-warning {
        color: #8a5200;
        background: #fff1d6;
    }

    .notification-status-policy {
        color: #b42318;
        background: #fee4e2;
        box-shadow: inset 0 0 0 1px #fda29b;
    }

    .notification-status-critical {
        color: #fff;
        background: #d92d20;
        box-shadow: inset 0 0 0 1px #b42318;
    }

    .notifications-empty {
        padding: 2.5rem 1.25rem;
        text-align: center;
        border: 1px dashed #d4dae3;
        border-radius: 14px;
        background: #fff;
        color: #667085;
    }

    @@media (max-width: 575.98px) {
        .notifications-header {
            flex-direction: column;
        }

        .notification-card {
            padding: .85rem;
            gap: .7rem;
        }

        .notification-icon {
            flex-basis: 36px;
            width: 36px;
            height: 36px;
        }

        .notification-policy-value-row {
            flex-direction: column;
        }

        .notification-policy-arrow {
            min-height: 18px;
            transform: rotate(90deg);
        }
    }
</style>

<div class="notifications-page"
     data-notifications-page
     data-default-filter="@defaultAdminFilter">

    <div class="notifications-header">
        <div>
            <h1 class="h3 mb-1">
                @(isAdmin ? "Công việc & Thông báo" : "Thông báo")
            </h1>

            <p class="notifications-summary">
                @if (isAdmin)
                {
                    <span>
                        <strong>@pendingWorkCount</strong> việc cần xử lý
                        · <strong>@unreadCount</strong> thông báo chưa đọc.
                    </span>
                }
                else if (unreadCount > 0)
                {
                    <span>
                        @unreadCount thông báo chưa đọc.
                    </span>
                }
                else
                {
                    <span>
                        Bạn đã đọc hết các thông báo hiện tại.
                    </span>
                }
            </p>
        </div>

        @if (unreadRegularCount > 0)
        {
            <form asp-action="MarkAllRead" method="post">
                <button class="btn btn-link text-decoration-none fw-semibold"
                        type="submit">
                    ✓✓ Đánh dấu tất cả thông báo đã đọc
                </button>
            </form>
        }
    </div>

    @if (isAdmin)
    {
        <div class="notifications-tabs"
             role="tablist"
             aria-label="Lọc công việc và thông báo">

            <button class="notifications-tab"
                    type="button"
                    data-notification-filter="work">
                Cần xử lý
                <span class="notifications-tab-count">
                    @pendingWorkCount
                </span>
            </button>

            <button class="notifications-tab"
                    type="button"
                    data-notification-filter="unread">
                Chưa đọc
                <span class="notifications-tab-count">
                    @unreadCount
                </span>
            </button>

            <button class="notifications-tab"
                    type="button"
                    data-notification-filter="handled">
                Đã xử lý
                <span class="notifications-tab-count">
                    @handledWorkCount
                </span>
            </button>
        </div>

        <div class="alert notifications-admin-note py-2 px-3 mb-3">
            <strong>Đã đọc</strong> và <strong>Đã xử lý</strong>
            là hai trạng thái khác nhau.
            Mở một việc chỉ làm mất trạng thái <strong>Mới</strong>;
            việc vẫn nằm trong <strong>Cần xử lý</strong>
            cho đến khi nghiệp vụ thực sự hoàn tất.
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="notifications-empty">
            Chưa có thông báo hoặc công việc nào.
        </div>
    }
    else
    {
        <div class="notifications-list"
             data-notifications-list>

        @foreach (var item in Model)
        {
            var rawDisplayTitle =
                RawTitle(item.Title);

            var isWorkItem =
                IsWorkTitle(item.Title);

            var isUnread =
                item.ReadAt is null;

            var isHandledWork =
                isWorkItem && item.IsRead;

            var displayTitle =
                rawDisplayTitle switch
                {
                    "Hồ sơ KYC chờ duyệt" =>
                        "Hồ sơ xác minh chờ duyệt",

                    "CCCD chờ xác minh" =>
                        "CCCD cần xác minh",

                    "GPLX chờ xác minh" =>
                        "GPLX cần xác minh",

                    "CCCD cập nhật chờ duyệt" =>
                        "CCCD cần xác minh lại",

                    "GPLX cập nhật chờ duyệt" =>
                        "GPLX cần xác minh lại",

                    "Đơn thuê chờ xử lý" =>
                        "Đơn thuê mới cần xác nhận",

                    "Yêu cầu gia hạn chờ xử lý" =>
                        "Yêu cầu gia hạn cần xử lý",

                    "Thanh toán QR chờ xác nhận" =>
                        "Thanh toán QR cần xác nhận",

                    _ =>
                        FriendlyNotificationText(
                            rawDisplayTitle)
                };

            var displayMessage =
                FriendlyNotificationText(
                    item.Message);

            var isPolicyUpdate =
                rawDisplayTitle.StartsWith(
                    "Cập nhật chính sách ",
                    StringComparison.OrdinalIgnoreCase);

            var policyChanges =
                new List<(string Label, string? CurrentValue, string? NewValue)>();
            string? policyAppliedAt = null;

            if (isPolicyUpdate)
            {
                displayTitle =
                    FriendlyPolicyTitle(rawDisplayTitle);

                const string applyMarker =
                    ". Áp dụng cho đơn tạo từ ";
                const string oldBookingMarker =
                    ". Đơn đã đặt trước thời điểm này giữ nguyên chính sách đã chốt.";

                var applyIndex =
                    displayMessage.IndexOf(
                        applyMarker,
                        StringComparison.Ordinal);

                var changeSummary =
                    applyIndex >= 0
                        ? displayMessage[..applyIndex]
                            .Trim()
                            .TrimEnd('.')
                        : displayMessage.Trim();

                if (applyIndex >= 0)
                {
                    var afterApply =
                        displayMessage[
                            (applyIndex + applyMarker.Length)..];

                    var oldBookingIndex =
                        afterApply.IndexOf(
                            oldBookingMarker,
                            StringComparison.Ordinal);

                    policyAppliedAt =
                        (oldBookingIndex >= 0
                            ? afterApply[..oldBookingIndex]
                            : afterApply)
                        .Trim()
                        .TrimEnd('.');
                }

                foreach (var changePart in changeSummary.Split(
                             " · ",
                             StringSplitOptions.RemoveEmptyEntries |
                             StringSplitOptions.TrimEntries))
                {
                    var colonIndex =
                        changePart.IndexOf(
                            ": ",
                            StringComparison.Ordinal);
                    var arrowIndex =
                        changePart.IndexOf(
                            " → ",
                            StringComparison.Ordinal);

                    if (colonIndex > 0 &&
                        arrowIndex > colonIndex)
                    {
                        var rawLabel =
                            changePart[..colonIndex].Trim();
                        var currentValue =
                            changePart[
                                (colonIndex + 2)..arrowIndex]
                            .Trim();
                        var newValue =
                            changePart[
                                (arrowIndex + 3)..]
                            .Trim();

                        policyChanges.Add((
                            FriendlyPolicyLabel(rawLabel),
                            currentValue,
                            newValue));
                    }
                    else
                    {
                        var rawLabel =
                            colonIndex > 0
                                ? changePart[..colonIndex].Trim()
                                : changePart.Trim();

                        policyChanges.Add((
                            FriendlyPolicyLabel(rawLabel),
                            null,
                            null));
                    }
                }
            }

            var isNeedsUpdate =
                displayTitle.Contains(
                    "cần cập nhật",
                    StringComparison.OrdinalIgnoreCase) ||
                displayMessage.Contains(
                    "cần cập nhật",
                    StringComparison.OrdinalIgnoreCase) ||
                displayMessage.Contains(
                    "không khớp",
                    StringComparison.OrdinalIgnoreCase);

            var isApproved =
                displayTitle.Contains(
                    "đã được duyệt",
                    StringComparison.OrdinalIgnoreCase) ||
                displayTitle.Contains(
                    "đã hoàn tất",
                    StringComparison.OrdinalIgnoreCase) ||
                displayMessage.Contains(
                    "đã hoàn tất",
                    StringComparison.OrdinalIgnoreCase) ||
                displayMessage.Contains(
                    "đã được xác minh",
                    StringComparison.OrdinalIgnoreCase);

            var isIdentityNotification =
                displayTitle.Contains(
                    "xác minh",
                    StringComparison.OrdinalIgnoreCase) ||
                displayMessage.Contains(
                    "CCCD",
                    StringComparison.OrdinalIgnoreCase) ||
                displayMessage.Contains(
                    "GPLX",
                    StringComparison.OrdinalIgnoreCase);

            var opensProfileDocuments =
                !isWorkItem &&
                isIdentityNotification &&
                User.IsInRole(
                    SmartCar.Domain.Constants.RoleNames.Customer);

            var toneClass =
                isPolicyUpdate
                    ? "notification-tone-policy"
                    : isWorkItem && !item.IsRead
                        ? "notification-tone-work"
                        : isHandledWork || isApproved
                            ? "notification-tone-success"
                            : isNeedsUpdate
                                ? "notification-tone-warning"
                                : "notification-tone-info";

            var iconText =
                isPolicyUpdate
                    ? "!"
                    : isWorkItem
                        ? item.IsRead ? "✓" : "!"
                        : isNeedsUpdate
                            ? "!"
                            : isApproved
                                ? "✓"
                                : "i";

            var states = new List<string>();

            if (isWorkItem && !item.IsRead)
            {
                states.Add("work");
            }

            if (isUnread)
            {
                states.Add("unread");
            }

            if (isHandledWork)
            {
                states.Add("handled");
            }

            var stateValue =
                string.Join(' ', states);

            var cardClass =
                isWorkItem && !item.IsRead
                    ? "notification-card-work"
                    : isUnread
                        ? "notification-card-unread"
                        : isHandledWork
                            ? "notification-card-handled"
                            : string.Empty;

            if (isPolicyUpdate)
            {
                cardClass =
                    $"{cardClass} notification-card-policy"
                        .Trim();
            }

            var actionText =
                rawDisplayTitle switch
                {
                    "Hồ sơ KYC chờ duyệt" =>
                        item.IsRead
                            ? "Xem hồ sơ →"
                            : "Xem & xử lý hồ sơ →",

                    "CCCD chờ xác minh" or
                    "CCCD cập nhật chờ duyệt" =>
                        item.IsRead
                            ? "Xem CCCD →"
                            : "Xem & xác minh CCCD →",

                    "GPLX chờ xác minh" or
                    "GPLX cập nhật chờ duyệt" =>
                        item.IsRead
                            ? "Xem GPLX →"
                            : "Xem & xác minh GPLX →",

                    "Đơn thuê chờ xử lý" =>
                        item.IsRead
                            ? "Xem đơn →"
                            : "Xem & xử lý đơn →",

                    "Yêu cầu gia hạn chờ xử lý" =>
                        item.IsRead
                            ? "Xem gia hạn →"
                            : "Xem & xử lý gia hạn →",

                    "Thanh toán QR chờ xác nhận" =>
                        item.IsRead
                            ? "Xem thanh toán →"
                            : "Xem & xác nhận thanh toán →",

                    _ => "Xem chi tiết →"
                };

            <article class="notification-card @toneClass @cardClass"
                     data-notification-card
                     data-notification-states="@stateValue">

                <div class="notification-icon"
                     aria-hidden="true">
                    @iconText
                </div>

                <div class="notification-body">
                    <div class="notification-title-row">
                        <h2 class="notification-title">
                            @displayTitle
                        </h2>

                        @if (isPolicyUpdate)
                        {
                            <span class="notification-status notification-status-critical">
                                Quan trọng
                            </span>

                            <span class="notification-status notification-status-policy">
                                Quy định mới
                            </span>
                        }

                        @if (isWorkItem && !item.IsRead)
                        {
                            <span class="notification-status notification-status-work">
                                Cần xử lý
                            </span>
                        }

                        @if (isUnread)
                        {
                            <span class="notification-status notification-status-new">
                                Mới
                            </span>
                        }

                        @if (isHandledWork)
                        {
                            <span class="notification-status notification-status-success">
                                Đã xử lý
                            </span>
                        }
                        else if (!isWorkItem && isNeedsUpdate)
                        {
                            <span class="notification-status notification-status-warning">
                                Cần cập nhật
                            </span>
                        }
                        else if (!isWorkItem && isApproved)
                        {
                            <span class="notification-status notification-status-success">
                                Đã duyệt
                            </span>
                        }
                    </div>

                    @if (isPolicyUpdate)
                    {
                        <div class="notification-policy-change-list">
                            @foreach (var change in policyChanges)
                            {
                                <div class="notification-policy-change">
                                    <div class="notification-policy-change-label">
                                        @change.Label
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(change.CurrentValue) &&
                                         !string.IsNullOrWhiteSpace(change.NewValue))
                                    {
                                        <div class="notification-policy-value-row">
                                            <div class="notification-policy-value notification-policy-value-current">
                                                <span>Hiện tại</span>
                                                <strong>@change.CurrentValue</strong>
                                            </div>

                                            <span class="notification-policy-arrow"
                                                  aria-hidden="true">→</span>

                                            <div class="notification-policy-value notification-policy-value-new">
                                                <span>Thay đổi thành</span>
                                                <strong>@change.NewValue</strong>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="notification-policy-change-note">
                                            Nội dung quy định đã được cập nhật.
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <div class="notification-policy-details">
                            @if (!string.IsNullOrWhiteSpace(policyAppliedAt))
                            {
                                <span class="notification-policy-chip notification-policy-effective">
                                    Bắt đầu áp dụng: @policyAppliedAt
                                </span>
                            }

                            <span class="notification-policy-chip notification-policy-protected">
                                ✓ Đơn đã đặt trước thời điểm này không thay đổi
                            </span>
                        </div>
                    }
                    else
                    {
                        <p class="notification-message">
                            @displayMessage
                        </p>
                    }

                    <div class="notification-meta">
                        @(item.CreatedAt
                            .ToLocalTime()
                            .ToString("HH:mm · dd/MM/yyyy"))
                    </div>

                    <div class="notification-actions">
                        @if (isWorkItem)
                        {
                            <form asp-action="OpenAdminWork"
                                  method="post">
                                <input type="hidden"
                                       name="id"
                                       value="@item.NotificationId" />

                                <button class="btn btn-sm @(item.IsRead ? "btn-outline-secondary" : "btn-primary") stretched-link"
                                        type="submit">
                                    @actionText
                                </button>
                            </form>
                        }
                        else if (opensProfileDocuments)
                        {
                            <form asp-action="OpenProfileDocuments"
                                  method="post">
                                <input type="hidden"
                                       name="id"
                                       value="@item.NotificationId" />

                                <button class="btn btn-sm @(isNeedsUpdate ? "btn-primary" : "btn-outline-primary") stretched-link"
                                        type="submit">
                                    @(isNeedsUpdate
                                        ? "Cập nhật hồ sơ →"
                                        : "Xem hồ sơ →")
                                </button>
                            </form>
                        }
                        else if (isUnread)
                        {
                            <form asp-action="MarkRead"
                                  method="post">
                                <input type="hidden"
                                       name="id"
                                       value="@item.NotificationId" />

                                <button class="btn btn-sm btn-link text-decoration-none px-0"
                                        type="submit">
                                    Đánh dấu đã đọc
                                </button>
                            </form>
                        }
                    </div>
                </div>

                @if (isUnread)
                {
                    <span class="notification-unread-dot"
                          title="Chưa đọc"
                          aria-label="Chưa đọc"></span>
                }
            </article>
        }
        </div>

        @if (isAdmin)
        {
            <div class="notifications-empty d-none mt-3"
                 data-filter-empty>
                Không có mục nào trong nhóm này.
            </div>
        }
    }
</div>

@if (isAdmin)
{
    <script>
        (() => {
            const page =
                document.querySelector(
                    '[data-notifications-page]');

            if (!page) return;

            const buttons =
                [...page.querySelectorAll(
                    '[data-notification-filter]')];

            const cards =
                [...page.querySelectorAll(
                    '[data-notification-card]')];

            const empty =
                page.querySelector(
                    '[data-filter-empty]');

            const applyFilter = filter => {
                let visible = 0;

                cards.forEach(card => {
                    const states =
                        (card.dataset.notificationStates || '')
                            .split(' ')
                            .filter(Boolean);

                    const show =
                        states.includes(filter);

                    card.classList.toggle(
                        'd-none',
                        !show);

                    if (show) visible++;
                });

                buttons.forEach(button => {
                    button.classList.toggle(
                        'active',
                        button.dataset.notificationFilter ===
                        filter);
                });

                empty?.classList.toggle(
                    'd-none',
                    visible !== 0);
            };

            buttons.forEach(button => {
                button.addEventListener(
                    'click',
                    () => applyFilter(
                        button.dataset.notificationFilter));
            });

            applyFilter(
                page.dataset.defaultFilter ||
                'work');
        })();
    </script>
}
