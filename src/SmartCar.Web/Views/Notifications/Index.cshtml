@model IReadOnlyList<SmartCar.Application.Features.Notifications.NotificationDto>
@{
    ViewData["Title"] = "Thông báo";
    var unreadCount = (int)(ViewBag.UnreadCount ?? 0);
    var unreadRegularCount = Model.Count(item =>
        !item.IsRead &&
        !item.Title.StartsWith("Hồ sơ KYC chờ duyệt|", StringComparison.Ordinal));

    string FriendlyNotificationText(string value) => value
        .Replace("Hồ sơ KYC đã được xác minh", "Hồ sơ xác minh danh tính đã được duyệt", StringComparison.Ordinal)
        .Replace("Hồ sơ KYC cần cập nhật", "Hồ sơ xác minh danh tính cần cập nhật", StringComparison.Ordinal)
        .Replace("Hồ sơ KYC đã hoàn tất", "Xác minh danh tính đã hoàn tất", StringComparison.Ordinal)
        .Replace("quyết định KYC", "quyết định xác minh hồ sơ", StringComparison.Ordinal)
        .Replace("Hồ sơ KYC", "Hồ sơ xác minh danh tính", StringComparison.Ordinal)
        .Replace("KYC", "xác minh danh tính", StringComparison.Ordinal);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Thông báo</h1>
        <p class="text-muted mb-0">@unreadCount thông báo chưa xử lý.</p>
    </div>
    @if (unreadRegularCount > 0)
    {
        <form asp-action="MarkAllRead" method="post">
            <button class="btn btn-outline-primary" type="submit">Đánh dấu thông báo thường đã đọc</button>
        </form>
    }
</div>

@if (User.IsInRole(SmartCar.Domain.Constants.RoleNames.Admin))
{
    <div class="alert alert-info py-2">
        <strong>Lưu ý:</strong> mục <strong>Hồ sơ xác minh chờ duyệt</strong> là công việc cần xử lý, không phải thông báo đọc xong là hết. Mục này chỉ được đóng sau khi bạn duyệt hồ sơ hoặc yêu cầu khách hàng cập nhật.
    </div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">Bạn chưa có thông báo nào.</div>
}
else
{
    <div class="list-group shadow-sm">
    @foreach (var item in Model)
    {
        var separatorIndex = item.Title.IndexOf('|');
        var rawDisplayTitle = separatorIndex > 0 ? item.Title[..separatorIndex] : item.Title;
        var isKycTitle = rawDisplayTitle == "Hồ sơ KYC chờ duyệt";
        var displayTitle = isKycTitle
            ? "Hồ sơ xác minh chờ duyệt"
            : FriendlyNotificationText(rawDisplayTitle);
        var displayMessage = FriendlyNotificationText(item.Message);
        var kycCustomerId = isKycTitle && separatorIndex > 0
            ? item.Title[(separatorIndex + 1)..]
            : null;
        var isKycAction = !string.IsNullOrWhiteSpace(kycCustomerId);

        <div class="list-group-item @(item.IsRead ? "" : "list-group-item-primary")">
            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                <div class="flex-grow-1">
                    <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                        <h2 class="h6 mb-0">@displayTitle</h2>
                        @if (isKycAction && !item.IsRead)
                        {
                            <span class="badge bg-warning text-dark">Cần xử lý</span>
                        }
                        else if (isKycAction)
                        {
                            <span class="badge bg-success">Đã xử lý</span>
                        }
                    </div>
                    <p class="mb-1">@displayMessage</p>
                    <small class="text-muted">@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>

                    @if (isKycAction && !item.IsRead)
                    {
                        <form asp-action="OpenKyc" method="post" class="mt-3">
                            <input type="hidden" name="id" value="@item.NotificationId" />
                            <input type="hidden" name="customerId" value="@kycCustomerId" />
                            <button class="btn btn-sm btn-primary" type="submit">Mở hồ sơ xác minh để xử lý</button>
                        </form>
                    }
                </div>
                @if (!item.IsRead && !isKycAction)
                {
                    <form asp-action="MarkRead" method="post">
                        <input type="hidden" name="id" value="@item.NotificationId" />
                        <button class="btn btn-sm btn-outline-primary" type="submit">Đã đọc</button>
                    </form>
                }
            </div>
        </div>
    }
    </div>
}