@model IReadOnlyList<SmartCar.Application.Features.Notifications.NotificationDto>
@{
    ViewData["Title"] = "Thông báo";
    var unreadRegularCount = Model.Count(item =>
        !item.IsRead &&
        !item.Title.StartsWith("Hồ sơ KYC chờ duyệt|", StringComparison.Ordinal));

    string FriendlyNotificationText(string value) => value
        .Replace("Hồ sơ KYC đã được xác minh", "Hồ sơ xác minh danh tính đã được duyệt", StringComparison.Ordinal)
        .Replace("Hồ sơ KYC cần cập nhật", "Hồ sơ xác minh danh tính cần cập nhật", StringComparison.Ordinal)
        .Replace("Hồ sơ KYC đã hoàn tất", "Xác minh danh tính đã hoàn tất", StringComparison.Ordinal)
        .Replace("quyết định KYC", "quyết định xác minh hồ sơ", StringComparison.Ordinal)
        .Replace("Hồ sơ KYC", "Hồ sơ xác minh danh tính", StringComparison.Ordinal)
        .Replace("KYC", "xác minh danh tính", StringComparison.Ordinal);
}

<style>
    .notifications-page {
        max-width: 980px;
        margin: 0 auto;
    }

    .notifications-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 1.25rem;
    }

    .notifications-header h1 {
        font-weight: 700;
        letter-spacing: -0.02em;
    }

    .notifications-mark-all {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .35rem .25rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .notifications-list {
        display: flex;
        flex-direction: column;
        gap: .75rem;
    }

    .notification-card {
        position: relative;
        display: flex;
        gap: 1rem;
        padding: 1rem 1.15rem;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        background: #fff;
        box-shadow: 0 4px 16px rgba(15, 23, 42, .045);
        transition: border-color .18s ease, box-shadow .18s ease, transform .18s ease;
    }

    .notification-card:has(.stretched-link):hover {
        border-color: #cbd5e1;
        box-shadow: 0 8px 22px rgba(15, 23, 42, .08);
        transform: translateY(-1px);
    }

    .notification-card-unread {
        background: #f8fbff;
        border-color: #cfe0ff;
    }

    .notification-icon {
        flex: 0 0 42px;
        width: 42px;
        height: 42px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        font-weight: 800;
        line-height: 1;
    }

    .notification-tone-success .notification-icon {
        color: #147a45;
        background: #eaf8f0;
    }

    .notification-tone-warning .notification-icon,
    .notification-tone-work .notification-icon {
        color: #9a5a00;
        background: #fff4df;
    }

    .notification-tone-info .notification-icon,
    .notification-icon.notification-tone-info {
        color: #1967d2;
        background: #eaf2ff;
    }

    .notification-body {
        min-width: 0;
        flex: 1;
        padding-right: .4rem;
    }

    .notification-title-row {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: .5rem;
        padding-right: 1rem;
    }

    .notification-title {
        margin: 0;
        font-size: .98rem;
        font-weight: 700;
        color: #172033;
    }

    .notification-message {
        margin: .35rem 0 0;
        color: #465166;
        line-height: 1.5;
    }

    .notification-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: .65rem;
        margin-top: .65rem;
        color: #7b8495;
        font-size: .82rem;
    }

    .notification-actions {
        display: flex;
        align-items: center;
        gap: .5rem;
        margin-top: .8rem;
    }

    .notification-actions form {
        margin: 0;
    }

    .notification-unread-dot {
        position: absolute;
        z-index: 2;
        top: 1.05rem;
        right: 1.05rem;
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: #0d6efd;
        box-shadow: 0 0 0 3px #e8f1ff;
        pointer-events: none;
    }

    .notification-status {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: .16rem .5rem;
        font-size: .72rem;
        font-weight: 700;
    }

    .notification-status-success {
        color: #12673c;
        background: #e9f7ef;
    }

    .notification-status-warning {
        color: #8a5200;
        background: #fff1d6;
    }

    .notification-status-info {
        color: #165ebd;
        background: #e7f0ff;
    }

    .notifications-empty {
        padding: 2.5rem 1.25rem;
        text-align: center;
        border: 1px dashed #d4dae3;
        border-radius: 14px;
        background: #fff;
    }

    .notifications-admin-note {
        border: 0;
        border-radius: 12px;
        background: #f1f7ff;
        color: #345071;
    }

    @@media (max-width: 575.98px) {
        .notifications-header {
            flex-direction: column;
        }

        .notification-card {
            padding: .9rem;
            gap: .75rem;
        }

        .notification-icon {
            flex-basis: 36px;
            width: 36px;
            height: 36px;
        }
    }
</style>

<div class="notifications-page">
    <div class="notifications-header">
        <div>
            <h1 class="h3 mb-1">Thông báo</h1>
            <p class="text-muted mb-0">
                @if (unreadRegularCount > 0)
                {
                    <span>@unreadRegularCount thông báo chưa đọc.</span>
                }
                else
                {
                    <span>Bạn đã đọc tất cả thông báo.</span>
                }
            </p>
        </div>

        @if (unreadRegularCount > 0)
        {
            <form asp-action="MarkAllRead" method="post">
                <button class="btn btn-link text-decoration-none notifications-mark-all" type="submit">
                    <span aria-hidden="true">✓✓</span>
                    <span>Đánh dấu tất cả đã đọc</span>
                </button>
            </form>
        }
    </div>

    @if (User.IsInRole(SmartCar.Domain.Constants.RoleNames.Admin))
    {
        <div class="alert notifications-admin-note py-2 px-3 mb-3">
            <strong>Lưu ý:</strong> mục <strong>Hồ sơ xác minh chờ duyệt</strong> là công việc cần xử lý. Mục này chỉ được đóng sau khi bạn duyệt hồ sơ hoặc yêu cầu khách hàng cập nhật.
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="notifications-empty">
            <div class="notification-icon notification-tone-info mx-auto mb-3" aria-hidden="true">✓</div>
            <h2 class="h6 fw-bold mb-1">Chưa có thông báo</h2>
            <p class="text-muted mb-0">Các cập nhật quan trọng về tài khoản và đơn thuê sẽ xuất hiện tại đây.</p>
        </div>
    }
    else
    {
        <div class="notifications-list">
        @foreach (var item in Model)
        {
            var separatorIndex = item.Title.IndexOf('|');
            var rawDisplayTitle = separatorIndex > 0 ? item.Title[..separatorIndex] : item.Title;
            var isKycWorkItem = rawDisplayTitle == "Hồ sơ KYC chờ duyệt";
            var displayTitle = isKycWorkItem
                ? "Hồ sơ xác minh chờ duyệt"
                : FriendlyNotificationText(rawDisplayTitle);
            var displayMessage = FriendlyNotificationText(item.Message);
            var kycCustomerId = isKycWorkItem && separatorIndex > 0
                ? item.Title[(separatorIndex + 1)..]
                : null;
            var isKycAction = !string.IsNullOrWhiteSpace(kycCustomerId);

            var isNeedsUpdate = displayTitle.Contains("cần cập nhật", StringComparison.OrdinalIgnoreCase) ||
                                displayMessage.Contains("cần cập nhật", StringComparison.OrdinalIgnoreCase) ||
                                displayMessage.Contains("không khớp", StringComparison.OrdinalIgnoreCase);
            var isApproved = displayTitle.Contains("đã được duyệt", StringComparison.OrdinalIgnoreCase) ||
                             displayTitle.Contains("đã hoàn tất", StringComparison.OrdinalIgnoreCase) ||
                             displayMessage.Contains("đã hoàn tất", StringComparison.OrdinalIgnoreCase) ||
                             displayMessage.Contains("đã được xác minh", StringComparison.OrdinalIgnoreCase);
            var isIdentityNotification = displayTitle.Contains("xác minh danh tính", StringComparison.OrdinalIgnoreCase) ||
                                         displayMessage.Contains("CCCD", StringComparison.OrdinalIgnoreCase) ||
                                         displayMessage.Contains("GPLX", StringComparison.OrdinalIgnoreCase) ||
                                         displayMessage.Contains("giấy phép lái xe", StringComparison.OrdinalIgnoreCase);
            var opensProfileDocuments = !isKycAction &&
                                        isIdentityNotification &&
                                        User.IsInRole(SmartCar.Domain.Constants.RoleNames.Customer);

            var toneClass = isKycAction
                ? "notification-tone-work"
                : isNeedsUpdate
                    ? "notification-tone-warning"
                    : isApproved
                        ? "notification-tone-success"
                        : "notification-tone-info";
            var iconText = isKycAction || isNeedsUpdate
                ? "!"
                : isApproved
                    ? "✓"
                    : "i";
            var statusText = isKycAction
                ? (item.IsRead ? "Đã xử lý" : "Cần xử lý")
                : isNeedsUpdate
                    ? "Cần cập nhật"
                    : isApproved
                        ? "Đã duyệt"
                        : (!item.IsRead ? "Mới" : string.Empty);
            var statusClass = isKycAction || isNeedsUpdate
                ? "notification-status-warning"
                : isApproved
                    ? "notification-status-success"
                    : "notification-status-info";

            <article class="notification-card @toneClass @(item.IsRead ? string.Empty : "notification-card-unread")">
                <div class="notification-icon" aria-hidden="true">@iconText</div>

                <div class="notification-body">
                    <div class="notification-title-row">
                        <h2 class="notification-title">@displayTitle</h2>
                        @if (!string.IsNullOrWhiteSpace(statusText))
                        {
                            <span class="notification-status @statusClass">@statusText</span>
                        }
                    </div>

                    <p class="notification-message">@displayMessage</p>
                    <div class="notification-meta">
                        <span>@item.CreatedAt.ToLocalTime().ToString("HH:mm · dd/MM/yyyy")</span>
                    </div>

                    <div class="notification-actions">
                        @if (isKycAction && !item.IsRead)
                        {
                            <form asp-action="OpenKyc" method="post">
                                <input type="hidden" name="id" value="@item.NotificationId" />
                                <input type="hidden" name="customerId" value="@kycCustomerId" />
                                <button class="btn btn-sm btn-primary stretched-link" type="submit">Mở hồ sơ để xử lý →</button>
                            </form>
                        }
                        else if (opensProfileDocuments)
                        {
                            <form asp-action="OpenProfileDocuments" method="post">
                                <input type="hidden" name="id" value="@item.NotificationId" />
                                <button class="btn btn-sm @(isNeedsUpdate ? "btn-primary" : "btn-outline-primary") stretched-link" type="submit">
                                    @(isNeedsUpdate ? "Cập nhật hồ sơ →" : "Xem hồ sơ →")
                                </button>
                            </form>
                        }
                        else if (!item.IsRead && !isKycAction)
                        {
                            <form asp-action="MarkRead" method="post">
                                <input type="hidden" name="id" value="@item.NotificationId" />
                                <button class="btn btn-sm btn-link text-decoration-none px-0" type="submit">Đánh dấu đã đọc</button>
                            </form>
                        }
                    </div>
                </div>

                @if (!item.IsRead && !isKycAction)
                {
                    <span class="notification-unread-dot" title="Chưa đọc" aria-label="Chưa đọc"></span>
                }
            </article>
        }
        </div>
    }
</div>
