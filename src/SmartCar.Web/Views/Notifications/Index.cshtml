@model IReadOnlyList<SmartCar.Application.Features.Notifications.NotificationDto>
@{
    ViewData["Title"] = "Thông báo";

    var isAdmin = User.IsInRole(SmartCar.Domain.Constants.RoleNames.Admin);

    bool IsBookingWorkTitle(string title) =>
        title.StartsWith("Đơn #", StringComparison.Ordinal) &&
        title.EndsWith(" cần xác nhận", StringComparison.Ordinal);

    bool IsRefundWorkTitle(string title) =>
        title.StartsWith("Đơn #", StringComparison.Ordinal) &&
        title.EndsWith(" cần hoàn cọc", StringComparison.Ordinal);

    bool IsPaymentReviewTitle(string title) =>
        title == "Có giao dịch QR chờ xác nhận";

    int? BookingIdFromWorkTitle(string title, string suffix)
    {
        if (!title.StartsWith("Đơn #", StringComparison.Ordinal) ||
            !title.EndsWith(suffix, StringComparison.Ordinal))
        {
            return null;
        }

        var value = title["Đơn #".Length..^suffix.Length];
        return int.TryParse(value, out var bookingId) ? bookingId : null;
    }

    int? BookingIdFromMessage(string message)
    {
        const string marker = "Đơn #";
        var start = message.IndexOf(marker, StringComparison.OrdinalIgnoreCase);
        if (start < 0)
        {
            return null;
        }

        start += marker.Length;
        var end = start;
        while (end < message.Length && char.IsDigit(message[end]))
        {
            end++;
        }

        return end > start && int.TryParse(message[start..end], out var bookingId)
            ? bookingId
            : null;
    }

    string CompactPaymentMessage(string message)
    {
        var bookingId = BookingIdFromMessage(message);
        if (!bookingId.HasValue)
        {
            return message;
        }

        var transferIndex = message.IndexOf("chuyển", StringComparison.OrdinalIgnoreCase);
        var currencyIndex = transferIndex >= 0
            ? message.IndexOf(" đồng", transferIndex, StringComparison.OrdinalIgnoreCase)
            : -1;

        if (transferIndex < 0 || currencyIndex <= transferIndex)
        {
            return message;
        }

        var amount = message[(transferIndex + "chuyển".Length)..currencyIndex]
            .Replace("một lần", string.Empty, StringComparison.OrdinalIgnoreCase)
            .Trim();

        var label = message.Contains("phụ phí", StringComparison.OrdinalIgnoreCase)
            ? "Phụ phí"
            : message.Contains("gia hạn", StringComparison.OrdinalIgnoreCase)
                ? "Gia hạn"
                : "Thuê + cọc";

        return $"Đơn #{bookingId.Value} · {amount} đ · {label}";
    }

    bool IsAdminWorkNotification(string title) =>
        isAdmin &&
        (IsBookingWorkTitle(title) ||
         IsPaymentReviewTitle(title) ||
         IsRefundWorkTitle(title));

    var unreadRegularCount = Model.Count(item =>
        !item.IsRead &&
        !item.Title.StartsWith("Hồ sơ KYC chờ duyệt|", StringComparison.Ordinal) &&
        !IsAdminWorkNotification(item.Title));

    var pendingWorkCount = Model.Count(item =>
        !item.IsRead &&
        (item.Title.StartsWith("Hồ sơ KYC chờ duyệt|", StringComparison.Ordinal) ||
         IsAdminWorkNotification(item.Title)));

    var hasAdminWorkHistory = Model.Any(item =>
        item.Title.StartsWith("Hồ sơ KYC chờ duyệt|", StringComparison.Ordinal) ||
        IsAdminWorkNotification(item.Title));

    string FriendlyNotificationText(string value) => value
        .Replace("Hồ sơ KYC đã được xác minh", "Hồ sơ giấy tờ đã được duyệt", StringComparison.Ordinal)
        .Replace("Hồ sơ KYC cần cập nhật", "Hồ sơ giấy tờ cần cập nhật", StringComparison.Ordinal)
        .Replace("Hồ sơ KYC đã hoàn tất", "Xác minh giấy tờ đã hoàn tất", StringComparison.Ordinal)
        .Replace("quyết định KYC", "quyết định xác minh hồ sơ", StringComparison.Ordinal)
        .Replace("Hồ sơ KYC", "Hồ sơ xác minh giấy tờ", StringComparison.Ordinal)
        .Replace("KYC", "xác minh giấy tờ", StringComparison.Ordinal);
}

<style>
    .notifications-page {
        max-width: 980px;
        margin: 0 auto;
    }

    .notifications-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 1rem;
    }

        .notifications-header h1 {
            font-weight: 700;
            letter-spacing: -0.02em;
        }

    .notifications-mark-all {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .35rem .25rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .notifications-list {
        display: flex;
        flex-direction: column;
        gap: .65rem;
    }

    .notification-card {
        position: relative;
        display: flex;
        gap: .85rem;
        padding: .85rem 1rem;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        background: #fff;
        box-shadow: 0 4px 16px rgba(15, 23, 42, .045);
        transition: border-color .18s ease, box-shadow .18s ease, transform .18s ease;
    }

        .notification-card:has(.stretched-link):hover {
            border-color: #cbd5e1;
            box-shadow: 0 8px 22px rgba(15, 23, 42, .08);
            transform: translateY(-1px);
        }

    .notification-card-unread {
        background: #f8fbff;
        border-color: #cfe0ff;
    }

    .notification-card-handled {
        background: #fbfcfe;
    }

    .notification-icon {
        flex: 0 0 38px;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        font-weight: 800;
        line-height: 1;
    }

    .notification-tone-success .notification-icon {
        color: #147a45;
        background: #eaf8f0;
    }

    .notification-tone-warning .notification-icon,
    .notification-tone-work .notification-icon {
        color: #9a5a00;
        background: #fff4df;
    }

    .notification-tone-info .notification-icon,
    .notification-icon.notification-tone-info {
        color: #1967d2;
        background: #eaf2ff;
    }

    .notification-body {
        min-width: 0;
        flex: 1;
        padding-right: .4rem;
    }

    .notification-title-row {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: .5rem;
        padding-right: 1rem;
    }

    .notification-title {
        margin: 0;
        font-size: .98rem;
        font-weight: 700;
        color: #172033;
    }

    .notification-message {
        margin: .25rem 0 0;
        color: #465166;
        line-height: 1.45;
    }

    .notification-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: .55rem;
        margin-top: .45rem;
        color: #7b8495;
        font-size: .82rem;
    }

    .notification-actions {
        display: flex;
        align-items: center;
        gap: .5rem;
        margin-top: .6rem;
    }

        .notification-actions form {
            margin: 0;
        }

    .notification-unread-dot {
        position: absolute;
        z-index: 2;
        top: 1rem;
        right: 1rem;
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: #0d6efd;
        box-shadow: 0 0 0 3px #e8f1ff;
        pointer-events: none;
    }

    .notification-status {
        display: inline-flex;
        align-items: center;
        min-height: 22px;
        border-radius: 999px;
        padding: .18rem .55rem;
        font-size: .72rem;
        font-weight: 700;
        line-height: 1.15;
    }

    .notification-status-success {
        color: #12673c;
        background: #e9f7ef;
    }

    .notification-status-warning {
        color: #8a5200;
        background: #fff1d6;
    }

    .notification-status-info {
        color: #165ebd;
        background: #e7f0ff;
    }

    .notifications-empty {
        padding: 2.5rem 1.25rem;
        text-align: center;
        border: 1px dashed #d4dae3;
        border-radius: 14px;
        background: #fff;
    }

    .notifications-admin-note {
        border: 0;
        border-radius: 12px;
        background: #f1f7ff;
        color: #345071;
    }

    @@media (max-width: 575.98px) {
        .notifications-header {
            flex-direction: column;
        }

        .notification-card {
            padding: .8rem;
            gap: .7rem;
        }

        .notification-icon {
            flex-basis: 36px;
            width: 36px;
            height: 36px;
        }
    }
</style>

<div class="notifications-page">
    <div class="notifications-header">
        <div>
            <h1 class="h3 mb-1">Thông báo</h1>
            <p class="text-muted mb-0">
                @if (pendingWorkCount > 0 && unreadRegularCount > 0)
                {
                    <span><strong>@pendingWorkCount</strong> việc cần xử lý · @unreadRegularCount chưa đọc.</span>
                }
                else if (pendingWorkCount > 0)
                {
                    <span><strong>@pendingWorkCount</strong> việc cần xử lý.</span>
                }
                else if (unreadRegularCount > 0)
                {
                    <span>@unreadRegularCount thông báo chưa đọc.</span>
                }
                else
                {
                    <span>Không còn việc cần xử lý.</span>
                }
            </p>
        </div>

        @if (unreadRegularCount > 0)
        {
            <form asp-action="MarkAllRead" method="post">
                <button class="btn btn-link text-decoration-none notifications-mark-all" type="submit">
                    <span aria-hidden="true">✓✓</span>
                    <span>Đã đọc tất cả</span>
                </button>
            </form>
        }
    </div>

    @if (isAdmin && hasAdminWorkHistory)
    {
        <div class="alert notifications-admin-note py-2 px-3 mb-3">
            Việc cần xử lý sẽ tự chuyển sang <strong>Đã xử lý</strong> khi hoàn tất.
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="notifications-empty">
            <div class="notification-icon notification-tone-info mx-auto mb-3" aria-hidden="true">✓</div>
            <h2 class="h6 fw-bold mb-1">Chưa có thông báo</h2>
            <p class="text-muted mb-0">Thông báo mới sẽ xuất hiện tại đây.</p>
        </div>
    }
    else
    {
        <div class="notifications-list">
            @foreach (var item in Model)
            {
                var separatorIndex = item.Title.IndexOf('|');
                var rawDisplayTitle = separatorIndex > 0 ? item.Title[..separatorIndex] : item.Title;
                var isKycWorkItem = rawDisplayTitle == "Hồ sơ KYC chờ duyệt";
                var bookingWorkId = isAdmin && IsBookingWorkTitle(rawDisplayTitle)
                    ? BookingIdFromWorkTitle(rawDisplayTitle, " cần xác nhận")
                    : null;
                var refundWorkId = isAdmin && IsRefundWorkTitle(rawDisplayTitle)
                    ? BookingIdFromWorkTitle(rawDisplayTitle, " cần hoàn cọc")
                    : null;
                var isPaymentReviewAction = isAdmin && IsPaymentReviewTitle(rawDisplayTitle);
                var paymentBookingId = isPaymentReviewAction
                    ? BookingIdFromMessage(item.Message)
                    : null;

                var displayTitle = isKycWorkItem
                    ? "Hồ sơ chờ duyệt"
                    : isPaymentReviewAction
                        ? (item.IsRead ? "Thanh toán đã xử lý" : "Thanh toán chờ xác nhận")
                        : refundWorkId.HasValue
                            ? (item.IsRead
                                ? $"Đơn #{refundWorkId.Value} đã hoàn cọc"
                                : $"Đơn #{refundWorkId.Value} cần hoàn cọc")
                            : FriendlyNotificationText(rawDisplayTitle);

                var displayMessage = isPaymentReviewAction
                    ? CompactPaymentMessage(item.Message)
                    : FriendlyNotificationText(item.Message);
                var kycCustomerId = isKycWorkItem && separatorIndex > 0
                    ? item.Title[(separatorIndex + 1)..]
                    : null;
                var isKycAction = !string.IsNullOrWhiteSpace(kycCustomerId);
                var isBookingAction = bookingWorkId.HasValue;
                var isRefundAction = refundWorkId.HasValue;

                var isNeedsUpdate = displayTitle.Contains("cần cập nhật", StringComparison.OrdinalIgnoreCase) ||
                                    displayMessage.Contains("cần cập nhật", StringComparison.OrdinalIgnoreCase) ||
                                    displayMessage.Contains("không khớp", StringComparison.OrdinalIgnoreCase);
                var isApproved = displayTitle.Contains("đã được duyệt", StringComparison.OrdinalIgnoreCase) ||
                                 displayTitle.Contains("đã hoàn tất", StringComparison.OrdinalIgnoreCase) ||
                                 displayMessage.Contains("đã hoàn tất", StringComparison.OrdinalIgnoreCase) ||
                                 displayMessage.Contains("đã được xác minh", StringComparison.OrdinalIgnoreCase);
                var isIdentityNotification = displayTitle.Contains("xác minh giấy tờ", StringComparison.OrdinalIgnoreCase) ||
                                             displayMessage.Contains("CCCD", StringComparison.OrdinalIgnoreCase) ||
                                             displayMessage.Contains("GPLX", StringComparison.OrdinalIgnoreCase) ||
                                             displayMessage.Contains("giấy phép lái xe", StringComparison.OrdinalIgnoreCase);
                var opensProfileDocuments = !isKycAction &&
                                            isIdentityNotification &&
                                            User.IsInRole(SmartCar.Domain.Constants.RoleNames.Customer);

                var isWorkItem = isKycAction || isBookingAction || isPaymentReviewAction || isRefundAction;

                var toneClass = isWorkItem
                    ? (item.IsRead ? "notification-tone-success" : "notification-tone-work")
                    : isNeedsUpdate
                        ? "notification-tone-warning"
                        : isApproved
                            ? "notification-tone-success"
                            : "notification-tone-info";
                var iconText = isWorkItem
                    ? (item.IsRead ? "✓" : "!")
                    : isNeedsUpdate
                        ? "!"
                        : isApproved
                            ? "✓"
                            : "i";
                var statusText = isWorkItem
                    ? (item.IsRead ? "Đã xử lý" : "Cần xử lý")
                    : isNeedsUpdate
                        ? "Cần cập nhật"
                        : isApproved
                            ? "Đã duyệt"
                            : (!item.IsRead ? "Mới" : string.Empty);
                var statusClass = isWorkItem
                    ? (item.IsRead ? "notification-status-success" : "notification-status-warning")
                    : isNeedsUpdate
                        ? "notification-status-warning"
                        : isApproved
                            ? "notification-status-success"
                            : "notification-status-info";

                <article class="notification-card @toneClass @(item.IsRead ? string.Empty : "notification-card-unread") @(isWorkItem && item.IsRead ? "notification-card-handled" : string.Empty)">
                    <div class="notification-icon" aria-hidden="true">@iconText</div>

                    <div class="notification-body">
                        <div class="notification-title-row">
                            <h2 class="notification-title">@displayTitle</h2>
                            @if (!string.IsNullOrWhiteSpace(statusText))
                            {
                                <span class="notification-status @statusClass">@statusText</span>
                            }
                        </div>

                        <p class="notification-message">@displayMessage</p>
                        <div class="notification-meta">
                            <span>@item.CreatedAt.ToLocalTime().ToString("HH:mm · dd/MM/yyyy")</span>
                        </div>

                        @if (isKycAction || isBookingAction || isPaymentReviewAction || isRefundAction || opensProfileDocuments || (!item.IsRead && !isWorkItem))
                        {
                            <div class="notification-actions">
                                @if (isBookingAction && !item.IsRead)
                                {
                                    <a class="btn btn-sm btn-success stretched-link"
                                       asp-controller="AdminBookingReview"
                                       asp-action="Index"
                                       asp-route-id="@bookingWorkId!.Value">
                                        Xác nhận →
                                    </a>
                                }
                                else if (isBookingAction && item.IsRead)
                                {
                                    <a class="btn btn-sm btn-outline-secondary stretched-link"
                                       asp-controller="AdminBookings"
                                       asp-action="Details"
                                       asp-route-id="@bookingWorkId!.Value">
                                        Xem đơn →
                                    </a>
                                }
                                else if (isKycAction && !item.IsRead)
                                {
                                    <form asp-action="OpenKyc" method="post">
                                        <input type="hidden" name="id" value="@item.NotificationId" />
                                        <input type="hidden" name="customerId" value="@kycCustomerId" />
                                        <button class="btn btn-sm btn-primary stretched-link" type="submit">Duyệt →</button>
                                    </form>
                                }
                                else if (isKycAction && item.IsRead)
                                {
                                    <a class="btn btn-sm btn-outline-secondary stretched-link"
                                       asp-controller="AdminCustomers"
                                       asp-action="Details"
                                       asp-route-id="@kycCustomerId"
                                       asp-route-tab="documents">
                                        Xem hồ sơ →
                                    </a>
                                }
                                else if (isPaymentReviewAction && !item.IsRead)
                                {
                                    <a class="btn btn-sm btn-primary stretched-link"
                                       asp-controller="AdminPayments"
                                       asp-action="Index"
                                       asp-route-status="@SmartCar.Domain.Enums.PaymentStatus.AwaitingConfirmation">
                                        Đối soát →
                                    </a>
                                }
                                else if (isPaymentReviewAction && item.IsRead && paymentBookingId.HasValue)
                                {
                                    <a class="btn btn-sm btn-outline-secondary stretched-link"
                                       asp-controller="AdminBookings"
                                       asp-action="Details"
                                       asp-route-id="@paymentBookingId.Value">
                                        Xem đơn →
                                    </a>
                                }
                                else if (isRefundAction && !item.IsRead)
                                {
                                    <a class="btn btn-sm btn-primary stretched-link"
                                       asp-controller="AdminPayments"
                                       asp-action="Index"
                                       asp-route-status="@SmartCar.Domain.Enums.PaymentStatus.AwaitingRefund"
                                       asp-route-type="@SmartCar.Domain.Enums.PaymentType.Refund">
                                        Hoàn cọc →
                                    </a>
                                }
                                else if (isRefundAction && item.IsRead)
                                {
                                    <a class="btn btn-sm btn-outline-secondary stretched-link"
                                       asp-controller="AdminBookings"
                                       asp-action="Details"
                                       asp-route-id="@refundWorkId!.Value">
                                        Xem đơn →
                                    </a>
                                }
                                else if (opensProfileDocuments)
                                {
                                    <form asp-action="OpenProfileDocuments" method="post">
                                        <input type="hidden" name="id" value="@item.NotificationId" />
                                        <button class="btn btn-sm @(isNeedsUpdate ? "btn-primary" : "btn-outline-primary") stretched-link" type="submit">
                                            @(isNeedsUpdate ? "Cập nhật →" : "Xem hồ sơ →")
                                        </button>
                                    </form>
                                }
                                else if (!item.IsRead && !isWorkItem)
                                {
                                    <form asp-action="MarkRead" method="post">
                                        <input type="hidden" name="id" value="@item.NotificationId" />
                                        <button class="btn btn-sm btn-link text-decoration-none px-0" type="submit">Đã đọc</button>
                                    </form>
                                }
                            </div>
                        }
                    </div>

                    @if (!item.IsRead && !isWorkItem)
                    {
                        <span class="notification-unread-dot" title="Chưa đọc" aria-label="Chưa đọc"></span>
                    }
                </article>
            }
        </div>
    }
</div>
