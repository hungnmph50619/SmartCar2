@model SmartCar.Web.ViewModels.PromotionViewModel
@using SmartCar.Domain.Enums
@{
    ViewData["Title"] = "Tạo mã khuyến mãi";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card card-body shadow-sm">
            <h1 class="h3 mb-3">Tạo mã khuyến mãi</h1>
            <form asp-action="Create" method="post" class="row g-3">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="col-md-4">
                    <label class="form-label">Mã</label>
                    <input asp-for="Code" class="form-control text-uppercase" placeholder="SMARTCAR10" />
                    <span asp-validation-for="Code" class="text-danger"></span>
                </div>
                <div class="col-md-8">
                    <label class="form-label">Tên chương trình</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Loại giảm</label>
                    <select asp-for="PromotionType" asp-items="Html.GetEnumSelectList<PromotionType>()" class="form-select"></select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Giá trị</label>
                    <input asp-for="Value" type="number" min="0.01" step="0.01" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Giảm tối đa</label>
                    <input asp-for="MaximumDiscount" type="number" min="0" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Giá trị đơn tối thiểu</label>
                    <input asp-for="MinimumRentalAmount" type="number" min="0" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Giới hạn lượt sử dụng</label>
                    <input asp-for="UsageLimit" type="number" min="1" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Bắt đầu</label>
                    <input asp-for="StartAt" type="datetime-local" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Kết thúc</label>
                    <input asp-for="EndAt" type="datetime-local" class="form-control" />
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label">Kích hoạt ngay</label>
                    </div>
                </div>
                <div class="col-12 d-flex gap-2">
                    <button class="btn btn-primary" type="submit">Tạo mã</button>
                    <a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
