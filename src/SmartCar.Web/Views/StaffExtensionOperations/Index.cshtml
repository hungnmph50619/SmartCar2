@model IReadOnlyList<SmartCar.Application.Features.Extensions.ExtensionDto>
@using SmartCar.Domain.Constants
@using SmartCar.Web.ViewModels
@using System.Globalization

@{
    ViewData["Title"] = "Xử lý xung đột gia hạn";
    var conflictResolutions =
        ViewBag.ConflictResolutions as
            IReadOnlyDictionary<int, ExtensionConflictResolutionViewModel>
        ?? new Dictionary<int, ExtensionConflictResolutionViewModel>();

    decimal? ParseCoordinate(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;
        return decimal.TryParse(
            value.Trim().Replace(',', '.'),
            NumberStyles.Float,
            CultureInfo.InvariantCulture,
            out var parsed)
            ? parsed
            : null;
    }

    (string Text, IReadOnlyList<string> ImagePaths, decimal? Latitude, decimal? Longitude, string? PlaceName) ParseEvidence(string? value)
    {
        const string imageMarker = "Ảnh minh chứng: ";
        if (string.IsNullOrWhiteSpace(value))
        {
            return (string.Empty, Array.Empty<string>(), null, null, null);
        }

        var rawText = value.Trim();
        var imagePaths = Array.Empty<string>();
        var imageIndex = rawText.IndexOf(imageMarker, StringComparison.OrdinalIgnoreCase);
        if (imageIndex >= 0)
        {
            var imageText = rawText[(imageIndex + imageMarker.Length)..].Trim();
            imagePaths = imageText
                .Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Where(path => !string.IsNullOrWhiteSpace(path))
                .ToArray();
            rawText = rawText[..imageIndex].Trim().TrimEnd('|').Trim();
        }

        decimal? latitude = null;
        decimal? longitude = null;
        string? placeName = null;
        var textParts = new List<string>();

        foreach (var part in rawText.Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            var locationMatch = System.Text.RegularExpressions.Regex.Match(
                part,
                @"Vị trí trực tiếp:\s*(-?\d+(?:[\.,]\d+)?)\s*,\s*(-?\d+(?:[\.,]\d+)?)",
                System.Text.RegularExpressions.RegexOptions.IgnoreCase);
            if (locationMatch.Success)
            {
                latitude = ParseCoordinate(locationMatch.Groups[1].Value);
                longitude = ParseCoordinate(locationMatch.Groups[2].Value);
                continue;
            }

            if (part.StartsWith("Địa điểm:", StringComparison.OrdinalIgnoreCase))
            {
                placeName = part["Địa điểm:".Length..].Trim();
                continue;
            }

            if (!part.StartsWith("Ảnh minh chứng:", StringComparison.OrdinalIgnoreCase))
            {
                textParts.Add(part.Trim());
            }
        }

        return (string.Join(" | ", textParts), imagePaths, latitude, longitude, placeName);
    }
}

<div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4">
    <div>
        <h1 class="h3 mb-1">Xử lý xung đột gia hạn</h1>
        <p class="text-muted mb-0">
            Staff xử lý phần vận hành: liên hệ khách có đơn kế tiếp, đề xuất xe thay thế và ghi nhận đổi xe.
            Admin chỉ duyệt/từ chối yêu cầu gia hạn và các quyết định tài chính cần phê duyệt.
        </p>
    </div>
    <span class="badge bg-warning text-dark fs-6">@Model.Count việc cần xử lý</span>
</div>

<div class="alert alert-light border small mb-4">
    Chỉ bấm <strong>Xác nhận đổi xe</strong> sau khi khách có đơn kế tiếp đã đồng ý đúng chiếc xe
    và phần chênh lệch giá. Nếu khách không chấp nhận hoặc không có xe phù hợp, chuyển trường hợp đó
    cho Admin xử lý quyết định hủy/bồi thường; Staff không tự duyệt khoản bồi thường.
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-success">
        Không có xung đột gia hạn bất khả kháng nào đang chờ Staff xử lý.
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var extension in Model)
        {
            conflictResolutions.TryGetValue(
                extension.BookingExtensionId,
                out var conflict);
            var evidence = ParseEvidence(extension.EvidenceNote);

            <div class="col-xl-6">
                <div class="card shadow-sm h-100 border-0 rounded-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between gap-3 mb-3">
                            <div>
                                <h2 class="h5 mb-1">
                                    Gia hạn đơn #@extension.BookingId
                                </h2>
                                <div class="text-muted">
                                    @extension.CustomerName · @extension.VehicleName
                                </div>
                            </div>
                            <span class="badge bg-danger align-self-start">
                                Bất khả kháng
                            </span>
                        </div>

                        <div class="row g-2 small mb-3">
                            <div class="col-sm-6">
                                <span class="text-muted">Trả hiện tại</span>
                                <div class="fw-semibold">
                                    @extension.OriginalReturnDate.ToString("dd/MM/yyyy HH:mm")
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-muted">Đề nghị trả mới</span>
                                <div class="fw-semibold">
                                    @extension.RequestedReturnDate.ToString("dd/MM/yyyy HH:mm")
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-muted">Phí gia hạn dự kiến</span>
                                <div class="fw-semibold text-primary">
                                    @extension.AdditionalAmount.ToString("N0") đ
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-muted">Đơn bị ảnh hưởng</span>
                                <div class="fw-semibold">
                                    @(conflict is null ? "Đang tải lại dữ liệu" : $"#{conflict.BookingId}")
                                </div>
                            </div>
                        </div>

                        <div class="border rounded-3 p-3 mb-3">
                            <div class="small text-muted">Lý do khách yêu cầu gia hạn</div>
                            <div class="fw-semibold mb-2">@extension.CustomerNote</div>
                            <div class="small text-muted">Minh chứng bất khả kháng</div>
                            <div>@(string.IsNullOrWhiteSpace(evidence.Text) ? "Chưa có mô tả minh chứng." : evidence.Text)</div>

                            @if (evidence.ImagePaths.Count > 0)
                            {
                                <div class="row g-2 mt-2">
                                    @for (var imageIndex = 0; imageIndex < evidence.ImagePaths.Count; imageIndex++)
                                    {
                                        var evidenceUrl = Url.Action(
                                            "Image",
                                            "ExtensionEvidenceFiles",
                                            new { extensionId = extension.BookingExtensionId, index = imageIndex });
                                        <div class="col-6 col-md-4">
                                            <a href="@evidenceUrl" target="_blank" rel="noopener" class="d-block text-decoration-none">
                                                <img src="@evidenceUrl"
                                                     alt="Ảnh minh chứng @(imageIndex + 1)"
                                                     class="img-thumbnail w-100"
                                                     style="height:130px;object-fit:contain;background:#f8f9fa" />
                                                <div class="small text-muted mt-1">Ảnh @(imageIndex + 1)</div>
                                            </a>
                                        </div>
                                    }
                                </div>
                            }

                            @if (evidence.Latitude.HasValue && evidence.Longitude.HasValue)
                            {
                                var latitudeText = evidence.Latitude.Value.ToString(CultureInfo.InvariantCulture);
                                var longitudeText = evidence.Longitude.Value.ToString(CultureInfo.InvariantCulture);
                                var mapsUrl = $"https://www.google.com/maps/search/?api=1&query={latitudeText},{longitudeText}";
                                <div class="alert alert-light border py-2 mt-3 mb-0 small">
                                    <strong>Vị trí khách tự gửi:</strong>
                                    @evidence.Latitude.Value.ToString("0.000000", CultureInfo.InvariantCulture),
                                    @evidence.Longitude.Value.ToString("0.000000", CultureInfo.InvariantCulture)
                                    @if (!string.IsNullOrWhiteSpace(evidence.PlaceName))
                                    {
                                        <div><strong>Địa điểm:</strong> @evidence.PlaceName</div>
                                    }
                                    <a href="@mapsUrl" target="_blank" rel="noopener">Mở tọa độ trên bản đồ →</a>
                                </div>
                            }
                        </div>

                        @if (conflict is null)
                        {
                            <div class="alert alert-warning mb-0">
                                Xung đột vừa thay đổi hoặc không còn tồn tại. Hãy tải lại trang trước khi thao tác.
                            </div>
                        }
                        else
                        {
                            <div class="border rounded-3 p-3 mb-3 bg-light">
                                <div class="fw-semibold mb-1">
                                    Khách có đơn kế tiếp: @conflict.CustomerName
                                </div>
                                <div class="small">
                                    @conflict.VehicleName · @conflict.LicensePlate
                                </div>
                                <div class="small text-muted">
                                    @conflict.PickupDate.ToString("dd/MM HH:mm")
                                    →
                                    @conflict.ReturnDate.ToString("dd/MM HH:mm")
                                </div>
                                <a class="small"
                                   asp-controller="Staff"
                                   asp-action="Details"
                                   asp-route-id="@conflict.BookingId">
                                    Mở đơn bị ảnh hưởng →
                                </a>
                            </div>

                            @if (conflict.Alternatives.Count == 0)
                            {
                                <div class="alert alert-warning mb-0">
                                    Không có xe thay thế phù hợp lịch hiện tại.
                                    Liên hệ khách rồi chuyển trường hợp này cho Admin để quyết định hủy/bồi thường.
                                </div>
                            }
                            else
                            {
                                <form asp-controller="StaffExtensionOperations"
                                      asp-action="MoveConflictingBooking"
                                      method="post"
                                      class="row g-3"
                                      data-loading-form
                                      data-confirm="Xác nhận khách có đơn kế tiếp đã đồng ý chiếc xe thay thế và phần chênh lệch giá?">
                                    <input type="hidden"
                                           name="extensionId"
                                           value="@extension.BookingExtensionId" />
                                    <div class="col-12">
                                        <label class="form-label">
                                            Xe thay thế khách đã đồng ý
                                        </label>
                                        <select class="form-select"
                                                name="replacementVehicleId"
                                                required>
                                            <option value="">Chọn xe...</option>
                                            @foreach (var alternative in conflict.Alternatives)
                                            {
                                                var currentUpfront =
                                                    alternative.CurrentRentalAmount +
                                                    conflict.CurrentDepositAmount;
                                                var newUpfront =
                                                    alternative.EstimatedRentalAmount +
                                                    conflict.Policy.CalculateDeposit(
                                                        alternative.EstimatedRentalAmount);
                                                var difference =
                                                    newUpfront - currentUpfront;
                                                var differenceText =
                                                    difference == 0
                                                        ? "không chênh lệch"
                                                        : difference > 0
                                                            ? $"thu thêm {difference:N0} đ"
                                                            : $"hoàn {Math.Abs(difference):N0} đ";

                                                <option value="@alternative.VehicleId">
                                                    @alternative.VehicleName ·
                                                    @alternative.LicensePlate ·
                                                    @differenceText
                                                </option>
                                            }
                                        </select>
                                    </div>

                                    <div class="col-12">
                                        <div class="form-check">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   id="accepted-@extension.BookingExtensionId"
                                                   name="customerAccepted"
                                                   value="true"
                                                   required />
                                            <label class="form-check-label"
                                                   for="accepted-@extension.BookingExtensionId">
                                                Tôi đã liên hệ và khách xác nhận đồng ý xe cùng chênh lệch giá.
                                            </label>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <button class="btn btn-primary w-100"
                                                type="submit">
                                            Xác nhận đổi xe cho đơn kế tiếp
                                        </button>
                                    </div>
                                </form>
                            }
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

