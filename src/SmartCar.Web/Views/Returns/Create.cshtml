@model SmartCar.Web.ViewModels.ReturnViewModel
@using SmartCar.Domain.Constants
@{
    ViewData["Title"] = "Biên bản trả xe";
    var handoverMileage = ViewBag.HandoverMileage as int?;
    var handoverFuelLevel = ViewBag.HandoverFuelLevel as string;
    var handoverAt = ViewBag.HandoverAt as DateTime?;
    var includedKilometers = ViewBag.HandoverIncludedKilometers as int? ?? 0;
    var excessKmFee = ViewBag.HandoverExcessKmFeePerKm as decimal? ?? 0m;
    var handoverAccessories = ViewBag.HandoverAccessories as string;
    var returnDate = Model.ReturnedAt.ToString("yyyy-MM-dd");
    var returnTime = Model.ReturnedAt.ToString("HH:mm");
    var storedAccessoryStatus = Model.InteriorCondition?.Trim() ?? "Đủ";
    var accessoryIsMissing = storedAccessoryStatus.StartsWith("Thiếu/mất:", StringComparison.OrdinalIgnoreCase);
    var missingAccessoryText = accessoryIsMissing
        ? storedAccessoryStatus["Thiếu/mất:".Length..].Trim()
        : string.Empty;
    var handoverPreviewUrl = Url.Action("Index", "ReturnHandoverPreview", new { bookingId = Model.BookingId }) ?? "#";
    const string imageAccept = ".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp";
}

<div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-3">
    <div>
        <h1 class="h3 mb-1">Biên bản trả xe · #@Model.BookingId</h1>
        <p class="text-muted mb-0">Ghi nhận tình trạng xe khi trả và mở biên bản giao khi cần đối chiếu.</p>
    </div>
    @if (User.IsInRole(SmartCar.Domain.Constants.RoleNames.Staff))
    {
        <a class="btn btn-outline-secondary" asp-controller="Staff" asp-action="Details" asp-route-id="@Model.BookingId">Quay lại</a>
    }
    else
    {
        <a class="btn btn-outline-secondary" asp-controller="AdminBookings" asp-action="Details" asp-route-id="@Model.BookingId">Quay lại</a>
    }
</div>

@if (handoverMileage.HasValue)
{
    <details class="card card-body shadow-sm mb-3">
        <summary class="fw-semibold" style="cursor:pointer">
            Xem biên bản giao để đối chiếu
        </summary>
        <div class="mt-3">
            <iframe src="@handoverPreviewUrl"
                    title="Biên bản giao xe để đối chiếu"
                    class="w-100 border rounded"
                    style="height:360px;background:#fff"></iframe>
        </div>
    </details>
}

<form asp-action="Create"
      method="post"
      enctype="multipart/form-data"
      class="card card-body shadow-sm"
      data-loading-form
      data-confirm="Lưu biên bản trả xe và chuyển sang bước đối chiếu?">
    <input asp-for="BookingId" type="hidden" />
    <input asp-for="ReturnedAt" type="hidden" id="returned-at-value" data-return-time />
    <input asp-for="InteriorCondition" type="hidden" id="return-accessories-value" />

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger py-2" id="return-validation-summary">
            <strong>Chưa thể lưu biên bản.</strong>
            <div asp-validation-summary="All" class="mb-0 mt-1"></div>
        </div>
    }

    <h2 class="h5 mb-3">1. Thông tin trả xe</h2>
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label fw-semibold">Thời gian trả</label>
            <div class="row g-2">
                <div class="col-7">
                    <input type="date"
                           id="return-date"
                           value="@returnDate"
                           class="form-control"
                           required
                           oninvalid="this.setCustomValidity('Vui lòng chọn ngày trả xe.')"
                           oninput="this.setCustomValidity('')" />
                </div>
                <div class="col-5">
                    <input type="text"
                           id="return-time"
                           value="@returnTime"
                           class="form-control"
                           inputmode="numeric"
                           maxlength="5"
                           pattern="(?:[01][0-9]|2[0-3]):[0-5][0-9]"
                           placeholder="HH:mm"
                           title="Giờ 24h, ví dụ 18:45"
                           required
                           oninvalid="this.setCustomValidity('Vui lòng nhập giờ trả xe theo định dạng HH:mm, ví dụ 18:45.')"
                           oninput="this.setCustomValidity('')" />
                </div>
            </div>
            <div class="form-text">Giờ 24h · ví dụ 18:45.</div>
            <span asp-validation-for="ReturnedAt" class="text-danger small"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="ReturnerCitizenId" class="form-label fw-semibold"></label>
            <input asp-for="ReturnerCitizenId"
                   class="form-control"
                   inputmode="numeric"
                   maxlength="12"
                   autocomplete="off"
                   placeholder="Nhập đúng 12 số CCCD của khách đứng tên đơn"
                   required />
            <span asp-validation-for="ReturnerCitizenId" class="text-danger small"></span>
            <div class="form-text">Người trả xe phải là đúng khách đứng tên đơn và CCCD phải trùng hồ sơ đã được xác minh.</div>
        </div>
        <div class="col-12">
            <div class="form-check border rounded p-3 ps-5 bg-light">
                <input asp-for="ReturnerIdentityCheckedInPerson"
                       class="form-check-input" />

                <label asp-for="ReturnerIdentityCheckedInPerson"
                       class="form-check-label fw-semibold">
                    Tôi đã xem CCCD gốc và đối chiếu trực tiếp người đang trả xe đúng là khách đứng tên đơn
                </label>

                <span asp-validation-for="ReturnerIdentityCheckedInPerson"
                      class="text-danger small d-block"></span>

                <div class="form-text">
                    Nhân viên phải đối chiếu giấy tờ gốc với người có mặt,
                    không chỉ nhập một số CCCD biết trước.
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <label asp-for="Mileage" class="form-label fw-semibold">Km lúc trả</label>
            <input asp-for="Mileage"
                   type="number"
                   min="@(handoverMileage ?? 0)"
                   step="1"
                   class="form-control"
                   required
                   data-return-mileage
                   oninvalid="this.setCustomValidity('Vui lòng nhập số km khi trả xe và không được nhỏ hơn số km lúc giao.')"
                   oninput="this.setCustomValidity('')" />
            <span asp-validation-for="Mileage" class="text-danger small"></span>
        </div>

        @if (handoverMileage.HasValue)
        {
            <div class="col-12">
                <div class="border rounded p-3 bg-light" id="mileage-preview"
                     data-handover-mileage="@handoverMileage.Value"
                     data-handover-time="@(handoverAt?.ToString("yyyy-MM-ddTHH:mm:ss") ?? string.Empty)"
                     data-included-km="@includedKilometers"
                     data-fee-per-km="@excessKmFee">
                    <div class="d-flex flex-wrap gap-4 small">
                        <div><span class="text-muted">Đã chạy</span><div class="fw-semibold" data-driven>0 km</div></div>
                        <div><span class="text-muted">Tổng định mức chuyến</span><div class="fw-semibold" data-included-display>@includedKilometers.ToString("N0") km</div></div>
                        <div><span class="text-muted">Vượt</span><div class="fw-semibold" data-excess>0 km</div></div>
                        <div><span class="text-muted">Phụ phí dự kiến</span><div class="fw-bold text-danger" data-fee>0 đ</div></div>
                    </div>
                    <div class="small text-muted mt-2">Định mức: @RentalPolicy.IncludedKilometersPerDay.ToString("N0") km/ngày.</div>
                    <div class="small text-danger mt-2 d-none" data-mileage-warning></div>
                </div>
            </div>
        }

        <div class="col-md-6">
            <label asp-for="FuelLevel" class="form-label fw-semibold">Nhiên liệu</label>
            <div class="input-group">
                <input asp-for="FuelLevel"
                       type="number"
                       min="0"
                       max="100"
                       step="1"
                       class="form-control"
                       placeholder="0 - 100"
                       required
                       oninvalid="this.setCustomValidity('Vui lòng nhập mức nhiên liệu từ 0 đến 100%.')"
                       oninput="this.setCustomValidity('')" />
                <span class="input-group-text">%</span>
            </div>
            <span asp-validation-for="FuelLevel" class="text-danger small"></span>
        </div>

        <div class="col-md-6">
            <label class="form-label fw-semibold">Phụ kiện khi trả</label>
            <select id="return-accessories-status" class="form-select" required>
                <option value="Đủ" selected="@(!accessoryIsMissing)">Đủ như lúc giao</option>
                <option value="Thiếu" selected="@(accessoryIsMissing)">Thiếu / mất</option>
            </select>
            <div class="form-text">Đối chiếu với danh sách phụ kiện trong biên bản giao phía trên.</div>
        </div>

        <div class="col-12 @(accessoryIsMissing ? string.Empty : "d-none")" id="missing-accessories-box">
            <label class="form-label fw-semibold text-danger">Thiếu / mất phụ kiện nào? *</label>
            <input id="missing-accessories"
                   class="form-control"
                   maxlength="1000"
                   value="@missingAccessoryText"
                   placeholder="Ví dụ: thiếu 1 chìa khóa phụ, cáp sạc..." />
            <div class="form-text">Thông tin này sẽ xuất hiện trong biên bản trả để khách ký xác nhận.</div>
        </div>
    </div>

    <hr class="my-4" />

    <div class="d-flex justify-content-between align-items-end gap-2 flex-wrap mb-2">
        <div>
            <h2 class="h5 mb-1">2. Ảnh đối chiếu</h2>
            <div class="text-muted small">Chọn nhiều ảnh trong một lần · tối thiểu 7 ảnh · tối đa 25 ảnh · tối đa 5 MB/ảnh.</div>
        </div>
        <div class="form-check">
            <input asp-for="HasDamage" class="form-check-input" id="has-damage" />
            <label asp-for="HasDamage" class="form-check-label fw-semibold">Có hư hỏng mới</label>
        </div>
    </div>

    <div class="border rounded p-3 bg-light">
        <label class="form-label fw-semibold" for="return-image-picker">Chọn ảnh trả xe *</label>
        <input id="return-image-picker"
               type="file"
               multiple
               accept="@imageAccept"
               class="form-control"
               required
               oninvalid="this.setCustomValidity('Vui lòng chọn từ 7 đến 25 ảnh trả xe.')"
               onchange="this.setCustomValidity('')" />
        <div class="d-flex justify-content-end mt-2">
            <span id="return-image-count" class="badge text-bg-secondary">Chưa chọn ảnh</span>
        </div>
        <div id="return-image-preview" class="d-flex flex-wrap gap-2 mt-3"></div>
    </div>

    <div class="d-none" aria-hidden="true">
        <input asp-for="FrontImage" id="return-front-image" type="file" accept="@imageAccept" tabindex="-1" />
        <input asp-for="RearImage" id="return-rear-image" type="file" accept="@imageAccept" tabindex="-1" />
        <input asp-for="LeftImage" id="return-left-image" type="file" accept="@imageAccept" tabindex="-1" />
        <input asp-for="RightImage" id="return-right-image" type="file" accept="@imageAccept" tabindex="-1" />
        <input asp-for="InteriorImage" id="return-interior-image" type="file" accept="@imageAccept" tabindex="-1" />
        <input asp-for="OdometerImage" id="return-odometer-image" type="file" accept="@imageAccept" tabindex="-1" />
        <input asp-for="FuelImage" id="return-fuel-image" type="file" accept="@imageAccept" tabindex="-1" />
        <input asp-for="Images" id="return-other-images" type="file" multiple accept="@imageAccept" tabindex="-1" />
    </div>

    <div id="damage-evidence" class="border border-danger-subtle rounded p-3 mt-3 @(Model.HasDamage ? string.Empty : "d-none")">
        <label asp-for="DamageImages" class="form-label fw-semibold">Ảnh hư hỏng *</label>
        <input asp-for="DamageImages"
               id="damage-images"
               type="file"
               multiple
               accept="@imageAccept"
               class="form-control"
               oninvalid="this.setCustomValidity('Vui lòng chọn ít nhất một ảnh thể hiện rõ hư hỏng mới.')"
               onchange="this.setCustomValidity('')" />
        <span asp-validation-for="DamageImages" class="text-danger small"></span>
        <div id="damage-image-preview" class="d-flex flex-wrap gap-2 mt-3"></div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-warning py-2 mt-3 mb-0 small">Form có lỗi thì trình duyệt không giữ ảnh. Hãy chọn lại ảnh trước khi lưu.</div>
    }

    <div class="mt-3">
        <label asp-for="Notes" class="form-label fw-semibold">Ghi chú</label>
        <textarea asp-for="Notes" class="form-control" rows="2" maxlength="1500" placeholder="Điểm cần lưu ý khác khi nhận lại xe"></textarea>
        <span asp-validation-for="Notes" class="text-danger small"></span>
    </div>

    <div class="mt-4 d-flex gap-2 flex-wrap">
        <button class="btn btn-primary" type="submit" data-loading-text="Đang lưu...">Lưu biên bản</button>
        @if (User.IsInRole(SmartCar.Domain.Constants.RoleNames.Staff))
        {
            <a class="btn btn-outline-secondary" asp-controller="Staff" asp-action="Details" asp-route-id="@Model.BookingId">Hủy</a>
        }
        else
        {
            <a class="btn btn-outline-secondary" asp-controller="AdminBookings" asp-action="Details" asp-route-id="@Model.BookingId">Hủy</a>
        }
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const form = document.querySelector('form[data-loading-form]');
            const hiddenTime = document.getElementById('returned-at-value');
            const dateInput = document.getElementById('return-date');
            const timeInput = document.getElementById('return-time');
            const mileage = document.querySelector('[data-return-mileage]');
            const preview = document.getElementById('mileage-preview');
            const hasDamage = document.getElementById('has-damage');
            const damageBox = document.getElementById('damage-evidence');
            const damageImages = document.getElementById('damage-images');
            const damagePreview = document.getElementById('damage-image-preview');
            const accessoryStatus = document.getElementById('return-accessories-status');
            const accessoryHidden = document.getElementById('return-accessories-value');
            const missingAccessoriesBox = document.getElementById('missing-accessories-box');
            const missingAccessories = document.getElementById('missing-accessories');
            const imagePicker = document.getElementById('return-image-picker');
            const imagePreview = document.getElementById('return-image-preview');
            const imageCount = document.getElementById('return-image-count');
            const evidenceInputs = [
                document.getElementById('return-front-image'),
                document.getElementById('return-rear-image'),
                document.getElementById('return-left-image'),
                document.getElementById('return-right-image'),
                document.getElementById('return-interior-image'),
                document.getElementById('return-odometer-image'),
                document.getElementById('return-fuel-image')
            ];
            const otherImages = document.getElementById('return-other-images');
            const timePattern = /^(?:[01]\d|2[0-3]):[0-5]\d$/;
            const maximumImageBytes = 5 * 1024 * 1024;
            const maximumImages = 25;
            const minimumImages = 7;
            const allowedExtensions = ['.jpg', '.jpeg', '.png', '.webp'];
            let previewUrls = [];
            let damagePreviewUrls = [];

            function syncDateTime() {
                if (!dateInput?.value || !timePattern.test(timeInput?.value || '')) return false;
                hiddenTime.value = `${dateInput.value}T${timeInput.value}`;
                return true;
            }

            function syncAccessories() {
                const missing = accessoryStatus?.value === 'Thiếu';
                missingAccessoriesBox?.classList.toggle('d-none', !missing);
                if (missingAccessories) {
                    missingAccessories.required = missing;
                    missingAccessories.setCustomValidity('');
                }

                if (missing) {
                    const detail = missingAccessories?.value.trim() || '';
                    accessoryHidden.value = detail ? `Thiếu/mất: ${detail}` : 'Thiếu/mất:';
                    if (!detail) {
                        missingAccessories?.setCustomValidity('Vui lòng ghi rõ phụ kiện bị thiếu hoặc mất.');
                        return false;
                    }
                    return true;
                }

                accessoryHidden.value = 'Đủ';
                return true;
            }

            function toggleDamage() {
                const active = !!hasDamage?.checked;
                damageBox?.classList.toggle('d-none', !active);
                if (damageImages) {
                    damageImages.required = active;
                    if (!active) damageImages.setCustomValidity('');
                }
                validateReturnImages(false);
            }

            function assignFiles(input, files) {
                if (!input) return;
                const transfer = new DataTransfer();
                files.forEach(file => transfer.items.add(file));
                input.files = transfer.files;
            }

            function fileError(file) {
                const lowerName = file.name.toLowerCase();
                if (!allowedExtensions.some(extension => lowerName.endsWith(extension))) {
                    return `Ảnh ${file.name} không đúng định dạng. Chỉ chấp nhận JPG, PNG hoặc WEBP.`;
                }
                if (file.size > maximumImageBytes) {
                    return `Ảnh ${file.name} vượt quá 5 MB.`;
                }
                return '';
            }

            function validateReturnImages(showMessage) {
                const files = Array.from(imagePicker?.files || []);
                const damageFiles = hasDamage?.checked ? Array.from(damageImages?.files || []) : [];
                let message = '';

                if (files.length < minimumImages) {
                    message = `Vui lòng chọn ít nhất ${minimumImages} ảnh trả xe.`;
                } else if (files.length + damageFiles.length > maximumImages) {
                    message = `Tổng số ảnh trả xe và ảnh hư hỏng không được vượt quá ${maximumImages} ảnh.`;
                } else {
                    const invalid = [...files, ...damageFiles].map(fileError).find(Boolean);
                    if (invalid) message = invalid;
                }

                imagePicker?.setCustomValidity(message);
                if (showMessage && message) imagePicker?.reportValidity();
                return !message;
            }

            function releaseUrls(urls) {
                urls.forEach(url => URL.revokeObjectURL(url));
                return [];
            }

            function appendThumbnail(container, file, url, index) {
                if (!container) return;
                const wrapper = document.createElement('div');
                wrapper.className = 'border rounded bg-white p-1';
                wrapper.style.width = '116px';

                const image = document.createElement('img');
                image.src = url;
                image.alt = `Ảnh ${index + 1}`;
                image.className = 'rounded d-block w-100';
                image.style.height = '78px';
                image.style.objectFit = 'cover';
                image.style.cursor = 'zoom-in';
                image.title = 'Bấm để xem ảnh lớn';
                image.addEventListener('click', () => window.open(url, '_blank'));

                const caption = document.createElement('div');
                caption.className = 'small text-muted text-center text-truncate mt-1';
                caption.textContent = `${index + 1}. ${file.name}`;
                caption.title = file.name;

                wrapper.append(image, caption);
                container.appendChild(wrapper);
            }

            function distributeAndPreviewImages() {
                const files = Array.from(imagePicker?.files || []);
                previewUrls = releaseUrls(previewUrls);
                if (imagePreview) imagePreview.innerHTML = '';

                evidenceInputs.forEach((input, index) => assignFiles(input, files[index] ? [files[index]] : []));
                assignFiles(otherImages, files.slice(7));

                if (imageCount) {
                    imageCount.textContent = files.length > 0 ? `Đã chọn ${files.length} ảnh` : 'Chưa chọn ảnh';
                    imageCount.className = `badge ${files.length >= minimumImages ? 'text-bg-success' : 'text-bg-secondary'}`;
                }

                files.forEach((file, index) => {
                    const url = URL.createObjectURL(file);
                    previewUrls.push(url);
                    appendThumbnail(imagePreview, file, url, index);
                });

                validateReturnImages(false);
            }

            function renderDamagePreview() {
                const files = Array.from(damageImages?.files || []);
                damagePreviewUrls = releaseUrls(damagePreviewUrls);
                if (damagePreview) damagePreview.innerHTML = '';
                files.forEach((file, index) => {
                    const url = URL.createObjectURL(file);
                    damagePreviewUrls.push(url);
                    appendThumbnail(damagePreview, file, url, index);
                });
                validateReturnImages(false);
            }

            function renderMileage() {
                if (!preview || !mileage) return;
                const handoverMileageValue = Number(preview.dataset.handoverMileage || 0);
                const handoverTimeValue = new Date(preview.dataset.handoverTime || '');
                const storedIncluded = Number(preview.dataset.includedKm || 0);
                const feePerKm = Number(preview.dataset.feePerKm || 0);
                const current = Number(mileage.value || handoverMileageValue);
                const driven = Math.max(0, current - handoverMileageValue);
                const number = value => new Intl.NumberFormat('vi-VN').format(value);

                let days = 1;
                if (hiddenTime?.value && !Number.isNaN(handoverTimeValue.getTime())) {
                    const end = new Date(hiddenTime.value);
                    const hours = Math.max(0, (end - handoverTimeValue) / 3600000);
                    days = Math.max(1, Math.ceil(hours / 24));
                }

                const effectiveIncluded = Math.max(storedIncluded, days * @RentalPolicy.IncludedKilometersPerDay);
                const excess = Math.max(0, driven - effectiveIncluded);
                const fee = excess * feePerKm;

                preview.querySelector('[data-driven]').textContent = `${number(driven)} km`;
                preview.querySelector('[data-included-display]').textContent = `${number(effectiveIncluded)} km`;
                preview.querySelector('[data-excess]').textContent = `${number(excess)} km`;
                preview.querySelector('[data-fee]').textContent = `${number(fee)} đ`;

                const warning = preview.querySelector('[data-mileage-warning]');
                const maxReasonable = days * 2500;
                if (driven > maxReasonable) {
                    warning.textContent = `Số km tăng ${number(driven)} km trong ${days} ngày là bất thường. Vui lòng kiểm tra lại công-tơ-mét.`;
                    warning.classList.remove('d-none');
                } else {
                    warning.textContent = '';
                    warning.classList.add('d-none');
                }
            }

            dateInput?.addEventListener('change', () => { syncDateTime(); renderMileage(); });
            timeInput?.addEventListener('input', () => { syncDateTime(); renderMileage(); });
            mileage?.addEventListener('input', renderMileage);
            hasDamage?.addEventListener('change', toggleDamage);
            damageImages?.addEventListener('change', renderDamagePreview);
            imagePicker?.addEventListener('change', distributeAndPreviewImages);
            accessoryStatus?.addEventListener('change', syncAccessories);
            missingAccessories?.addEventListener('input', syncAccessories);

            form?.addEventListener('submit', event => {
                const timeValid = syncDateTime();
                const accessoriesValid = syncAccessories();
                const imagesValid = validateReturnImages(true);
                const damageValid = !hasDamage?.checked || (damageImages?.files?.length || 0) > 0;

                if (!timeValid || !accessoriesValid || !imagesValid || !damageValid) {
                    event.preventDefault();
                    if (!timeValid) {
                        timeInput?.setCustomValidity('Vui lòng nhập giờ trả xe theo định dạng HH:mm, ví dụ 18:45.');
                        timeInput?.reportValidity();
                    } else if (!accessoriesValid) {
                        missingAccessories?.reportValidity();
                    } else if (!damageValid) {
                        damageImages?.setCustomValidity('Vui lòng chọn ít nhất một ảnh thể hiện rõ hư hỏng mới.');
                        damageImages?.reportValidity();
                    }
                    return;
                }

                timeInput?.setCustomValidity('');
                damageImages?.setCustomValidity('');
            });

            syncDateTime();
            syncAccessories();
            toggleDamage();
            distributeAndPreviewImages();
            renderDamagePreview();
            renderMileage();
            document.getElementById('return-validation-summary')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        })();
    </script>
}
