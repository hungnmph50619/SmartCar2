@model SmartCar.Web.ViewModels.ReturnViewModel
@using SmartCar.Domain.Constants
@using SmartCar.Web.ViewModels
@{
    ViewData["Title"] = "Biên bản trả xe";
    const string imageAccept = ".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp";
    var handoverMileage = ViewBag.HandoverMileage is int mileage ? mileage : 0;
    var handoverFuelLevel = ViewBag.HandoverFuelLevel as string ?? "-";
    var handoverAt = ViewBag.HandoverAt is DateTime at ? at : (DateTime?)null;
    var handoverExterior = ViewBag.HandoverExteriorCondition as string;
    var handoverInterior = ViewBag.HandoverInteriorCondition as string;
    var handoverAccessories = ViewBag.HandoverAccessories as string;
    var kycFaceUrl = Url.Action("CustomerKyc", "IdentityFace", new { customerId = Model.CustomerId }) ?? "#";
    var accessoryMissing = Model.AccessoryStatus.StartsWith("Thiếu/mất:", StringComparison.OrdinalIgnoreCase);
}

<div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-3">
    <div>
        <div class="text-uppercase small text-primary fw-semibold">Nhận xe trả tại quầy</div>
        <h1 class="h3 mb-1">Biên bản trả xe · #@Model.BookingId</h1>
        <p class="text-muted mb-0">Đúng người trả → đối chiếu xe với lúc giao → 7 ảnh bắt buộc → ghi nhận hư hỏng/phụ kiện.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-controller="Staff" asp-action="Details" asp-route-id="@Model.BookingId">Quay lại đơn</a>
</div>

<form asp-controller="Returns" asp-action="Create" method="post" enctype="multipart/form-data"
      class="card card-body shadow-sm" data-loading-form
      data-confirm="Lưu biên bản trả xe? Thời gian trả thực tế sẽ được server ghi ngay lúc lưu.">
    <input asp-for="BookingId" type="hidden" />
    <input asp-for="ReturnedAt" type="hidden" />

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <strong>Chưa thể lưu biên bản trả xe.</strong>
            <div asp-validation-summary="All" class="mt-1 mb-0"></div>
        </div>
    }

    <section class="border rounded-4 p-3 p-lg-4 mb-4">
        <div class="text-uppercase small text-primary fw-semibold">Bước 1/4</div>
        <h2 class="h5 mb-1">Xác minh đúng người trả</h2>
        <p class="small text-muted">Chụp lại hai mặt CCCD người đang trả, nhập số đọc trực tiếp từ giấy tờ và đối chiếu ảnh lúc giao, hồ sơ KYC, người có mặt.</p>

        <div class="row g-3 mb-3">
            <div class="col-lg-8">
                <div class="row g-2">
                    <div class="col-md-6"><div class="border rounded-3 p-3 h-100"><div class="small text-muted">Khách đứng tên đơn</div><strong>@Model.VerifiedCustomerName</strong></div></div>
                    <div class="col-md-6"><div class="border rounded-3 p-3 h-100"><div class="small text-muted">CCCD đã Admin duyệt</div><strong>@Model.VerifiedCitizenId</strong></div></div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="border rounded-3 p-2 h-100 d-flex align-items-center gap-3">
                    <img src="@kycFaceUrl" alt="Ảnh mặt KYC tham chiếu" class="rounded-3 border bg-light" style="width:84px;height:84px;object-fit:cover" onerror="this.classList.add('d-none');this.nextElementSibling.textContent='Tài khoản cũ chưa có ảnh mặt KYC; Staff vẫn phải đối chiếu CCCD bản gốc và chụp người trả hiện tại.'" />
                    <div class="small text-muted">Ảnh KYC chỉ là ảnh tham chiếu; ảnh người trả hiện tại được lưu riêng cho biên bản trả.</div>
                </div>
            </div>
        </div>

        <div class="row g-2 mb-3">
            @foreach (var side in new[] { "front", "back" })
            {
                <div class="col-sm-6 col-lg-3">
                    <div class="border rounded-3 p-2 h-100">
                        <div class="small fw-semibold">CCCD @(side == "front" ? "mặt trước" : "mặt sau") đã duyệt</div>
                        <img src="@Url.Action("KycCitizen", "StaffCounterIdentityEvidence", new { bookingId = Model.BookingId, side })"
                             alt="CCCD KYC @side" class="img-fluid rounded-2 mt-1" style="max-height:125px;object-fit:contain" />
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="border rounded-3 p-2 h-100">
                        <div class="small fw-semibold">CCCD @(side == "front" ? "mặt trước" : "mặt sau") lúc giao</div>
                        <img src="@Url.Action("HandoverCitizen", "StaffCounterIdentityEvidence", new { bookingId = Model.BookingId, side })"
                             alt="CCCD lúc giao @side" class="img-fluid rounded-2 mt-1" style="max-height:125px;object-fit:contain" />
                    </div>
                </div>
            }
        </div>

        <div class="alert alert-warning small mb-3">
            Nếu người trả xuất trình CCCD khác hoặc không phải khách đứng tên đơn, dừng xác minh trả xe thông thường và báo quản lý. Ghi nhận thời điểm xe thực tế được đưa tới để xử lý riêng.
        </div>
        <partial name="_IdentityCaptureWidget" model="@(new IdentityCaptureWidgetViewModel
        {
            Purpose = IdentityCapturePurposes.Return,
            HiddenFieldName = nameof(ReturnViewModel.IdentityFaceSessionId),
            CompletedSessionId = Model.IdentityFaceSessionId,
            BookingId = Model.BookingId,
            CustomerId = Model.CustomerId,
            Title = "Ảnh mặt người đang trả xe",
            HelpText = "Chụp trực tiếp trên máy quầy hoặc QR sang điện thoại; phiên ảnh chỉ dùng một lần cho đúng đơn này.",
            AllowStaffFallback = true
        })" />
        <span asp-validation-for="IdentityFaceSessionId" class="text-danger small d-block mt-2"></span>

        <div class="border rounded-3 bg-light p-3 mt-3">
            <div class="form-check mb-2">
                <input asp-for="OriginalCitizenIdChecked" class="form-check-input" />
                <label asp-for="OriginalCitizenIdChecked" class="form-check-label fw-semibold">Tôi đã xem CCCD bản gốc và số trùng @Model.VerifiedCitizenId</label>
                <span asp-validation-for="OriginalCitizenIdChecked" class="text-danger small d-block"></span>
            </div>
            <div class="form-check">
                <input asp-for="ReturnerIdentityCheckedInPerson" class="form-check-input" />
                <label asp-for="ReturnerIdentityCheckedInPerson" class="form-check-label fw-semibold">Ảnh camera hiện tại + người đang đứng trước quầy + CCCD bản gốc là cùng khách đứng tên đơn</label>
                <span asp-validation-for="ReturnerIdentityCheckedInPerson" class="text-danger small d-block"></span>
            </div>
        </div>
    </section>

    <section class="border rounded-4 p-3 p-lg-4 mb-4">
        <div class="d-flex justify-content-between gap-3 flex-wrap">
            <div>
                <div class="text-uppercase small text-primary fw-semibold">Bước 2/4</div>
                <h2 class="h5 mb-1">Đối chiếu tình trạng xe</h2>
                <p class="small text-muted mb-0">Thời gian trả thực tế do server ghi khi bấm lưu; Staff không được sửa timestamp để thay đổi phí muộn.</p>
            </div>
            <div class="small text-end"><span class="text-muted">Giao thực tế:</span><br /><strong>@(handoverAt?.ToString("dd/MM/yyyy HH:mm") ?? "-")</strong></div>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-md-4">
                <label asp-for="Mileage" class="form-label fw-semibold">Số km khi trả</label>
                <input asp-for="Mileage" type="number" min="@handoverMileage" step="1" data-integer="true" class="form-control" required />
                <div class="form-text">Lúc giao: @handoverMileage.ToString("N0") km</div>
                <span asp-validation-for="Mileage" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="FuelLevel" class="form-label fw-semibold">Nhiên liệu khi trả (%)</label>
                <input asp-for="FuelLevel" type="number" min="0" max="100" step="1" data-integer="true" class="form-control" required />
                <div class="form-text">Lúc giao: @handoverFuelLevel</div>
                <span asp-validation-for="FuelLevel" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold">Phụ kiện</label>
                <input asp-for="AccessoryStatus" type="hidden" data-accessory-value />
                <select class="form-select" data-accessory-mode>
                    <option value="Đủ" selected="@(!accessoryMissing)">Đủ như lúc giao</option>
                    <option value="missing" selected="@accessoryMissing">Thiếu / mất</option>
                </select>
                <input type="text" class="form-control mt-2 @(accessoryMissing ? "" : "d-none")" maxlength="980" data-accessory-missing placeholder="Ghi rõ đồ thiếu/mất" value="@(accessoryMissing ? Model.AccessoryStatus["Thiếu/mất:".Length..].Trim() : string.Empty)" />
                <div class="form-text">Lúc giao: @(string.IsNullOrWhiteSpace(handoverAccessories) ? "Không ghi" : handoverAccessories)</div>
                <span asp-validation-for="AccessoryStatus" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ExteriorCondition" class="form-label fw-semibold">Ngoại thất khi trả</label>
                <textarea asp-for="ExteriorCondition" class="form-control" rows="3" maxlength="1500" placeholder="Mô tả thay đổi/xước/móp nếu có"></textarea>
                <div class="form-text">Lúc giao: @(string.IsNullOrWhiteSpace(handoverExterior) ? "Không ghi" : handoverExterior)</div>
                <span asp-validation-for="ExteriorCondition" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="InteriorCondition" class="form-label fw-semibold">Nội thất khi trả</label>
                <textarea asp-for="InteriorCondition" class="form-control" rows="3" maxlength="1500" placeholder="Ghế, taplo, màn hình, vệ sinh..."></textarea>
                <div class="form-text">Lúc giao: @(string.IsNullOrWhiteSpace(handoverInterior) ? "Không ghi" : handoverInterior)</div>
                <span asp-validation-for="InteriorCondition" class="text-danger small"></span>
            </div>
        </div>

        <div class="form-check border rounded-3 p-3 ps-5 mt-3">
            <input asp-for="HasDamage" class="form-check-input" />
            <label asp-for="HasDamage" class="form-check-label fw-semibold">Có hư hỏng mới phát sinh</label>
            <div class="small text-muted">Nếu chọn, bắt buộc tải ảnh hư hỏng riêng ở bước 3.</div>
        </div>
    </section>

    <section class="border rounded-4 p-3 p-lg-4 mb-4">
        <div class="text-uppercase small text-primary fw-semibold">Bước 3/4</div>
        <h2 class="h5 mb-1">7 ảnh trả xe bắt buộc</h2>
        <p class="small text-muted">Chụp cùng các góc với lúc giao. Ảnh preview ngay, giữ tạm nếu validation server trả lại form và server chặn nội dung ảnh bị dùng lặp.</p>
        <div class="row g-3">
            <div class="col-md-6 col-lg-4"><div class="border rounded-4 p-3 h-100" data-evidence-slot><strong>Mặt trước xe *</strong><img data-evidence-preview class="d-none w-100 rounded-3 border my-2" alt="Preview mặt trước" style="height:150px;object-fit:cover" /><input asp-for="FrontImage" type="file" class="form-control mt-2" accept="@imageAccept" required data-evidence-input data-file-draft-key="return-@Model.BookingId-front" /><div data-evidence-name class="small text-muted mt-1">Chưa chọn ảnh</div><span asp-validation-for="FrontImage" class="text-danger small"></span></div></div>
            <div class="col-md-6 col-lg-4"><div class="border rounded-4 p-3 h-100" data-evidence-slot><strong>Mặt sau xe *</strong><img data-evidence-preview class="d-none w-100 rounded-3 border my-2" alt="Preview mặt sau" style="height:150px;object-fit:cover" /><input asp-for="RearImage" type="file" class="form-control mt-2" accept="@imageAccept" required data-evidence-input data-file-draft-key="return-@Model.BookingId-rear" /><div data-evidence-name class="small text-muted mt-1">Chưa chọn ảnh</div><span asp-validation-for="RearImage" class="text-danger small"></span></div></div>
            <div class="col-md-6 col-lg-4"><div class="border rounded-4 p-3 h-100" data-evidence-slot><strong>Bên trái xe *</strong><img data-evidence-preview class="d-none w-100 rounded-3 border my-2" alt="Preview bên trái" style="height:150px;object-fit:cover" /><input asp-for="LeftImage" type="file" class="form-control mt-2" accept="@imageAccept" required data-evidence-input data-file-draft-key="return-@Model.BookingId-left" /><div data-evidence-name class="small text-muted mt-1">Chưa chọn ảnh</div><span asp-validation-for="LeftImage" class="text-danger small"></span></div></div>
            <div class="col-md-6 col-lg-4"><div class="border rounded-4 p-3 h-100" data-evidence-slot><strong>Bên phải xe *</strong><img data-evidence-preview class="d-none w-100 rounded-3 border my-2" alt="Preview bên phải" style="height:150px;object-fit:cover" /><input asp-for="RightImage" type="file" class="form-control mt-2" accept="@imageAccept" required data-evidence-input data-file-draft-key="return-@Model.BookingId-right" /><div data-evidence-name class="small text-muted mt-1">Chưa chọn ảnh</div><span asp-validation-for="RightImage" class="text-danger small"></span></div></div>
            <div class="col-md-6 col-lg-4"><div class="border rounded-4 p-3 h-100" data-evidence-slot><strong>Nội thất *</strong><img data-evidence-preview class="d-none w-100 rounded-3 border my-2" alt="Preview nội thất" style="height:150px;object-fit:cover" /><input asp-for="InteriorImage" type="file" class="form-control mt-2" accept="@imageAccept" required data-evidence-input data-file-draft-key="return-@Model.BookingId-interior" /><div data-evidence-name class="small text-muted mt-1">Chưa chọn ảnh</div><span asp-validation-for="InteriorImage" class="text-danger small"></span></div></div>
            <div class="col-md-6 col-lg-4"><div class="border rounded-4 p-3 h-100" data-evidence-slot><strong>Đồng hồ số km *</strong><img data-evidence-preview class="d-none w-100 rounded-3 border my-2" alt="Preview số km" style="height:150px;object-fit:cover" /><input asp-for="OdometerImage" type="file" class="form-control mt-2" accept="@imageAccept" required data-evidence-input data-file-draft-key="return-@Model.BookingId-odometer" /><div data-evidence-name class="small text-muted mt-1">Chưa chọn ảnh</div><span asp-validation-for="OdometerImage" class="text-danger small"></span></div></div>
            <div class="col-md-6 col-lg-4"><div class="border rounded-4 p-3 h-100" data-evidence-slot><strong>Mức nhiên liệu *</strong><img data-evidence-preview class="d-none w-100 rounded-3 border my-2" alt="Preview nhiên liệu" style="height:150px;object-fit:cover" /><input asp-for="FuelImage" type="file" class="form-control mt-2" accept="@imageAccept" required data-evidence-input data-file-draft-key="return-@Model.BookingId-fuel" /><div data-evidence-name class="small text-muted mt-1">Chưa chọn ảnh</div><span asp-validation-for="FuelImage" class="text-danger small"></span></div></div>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-md-6">
                <div class="border rounded-4 p-3" data-evidence-multiple>
                    <strong>Ảnh hư hỏng</strong>
                    <input asp-for="DamageImages" type="file" multiple class="form-control mt-2" accept="@imageAccept" data-evidence-multiple-input data-file-draft-key="return-@Model.BookingId-damage" />
                    <div class="d-flex justify-content-between mt-1"><span data-evidence-count class="small text-muted">Chưa chọn ảnh</span><span class="small text-muted">Bắt buộc khi Có hư hỏng</span></div>
                    <div data-evidence-multiple-preview class="d-flex flex-wrap gap-2 mt-2"></div>
                    <span asp-validation-for="DamageImages" class="text-danger small"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="border rounded-4 p-3" data-evidence-multiple>
                    <strong>Ảnh bổ sung khác</strong>
                    <input asp-for="Images" type="file" multiple class="form-control mt-2" accept="@imageAccept" data-evidence-multiple-input data-file-draft-key="return-@Model.BookingId-other" />
                    <div data-evidence-count class="small text-muted mt-1">Chưa chọn ảnh</div>
                    <div data-evidence-multiple-preview class="d-flex flex-wrap gap-2 mt-2"></div>
                    <span asp-validation-for="Images" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </section>

    <section class="border rounded-4 p-3 p-lg-4 mb-3">
        <div class="text-uppercase small text-primary fw-semibold">Bước 4/4</div>
        <h2 class="h5 mb-2">Ghi chú cuối</h2>
        <textarea asp-for="Notes" class="form-control" rows="3" maxlength="1500" placeholder="Ghi nhận thêm nếu cần"></textarea>
        <span asp-validation-for="Notes" class="text-danger small"></span>
    </section>

    <div class="mt-4 d-flex gap-2 flex-wrap">
        <button class="btn btn-primary btn-lg" type="submit" data-loading-text="Đang lưu...">Lưu biên bản trả xe</button>
        <a class="btn btn-outline-secondary btn-lg" asp-controller="Staff" asp-action="Details" asp-route-id="@Model.BookingId">Hủy</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/evidence-image-slots.js" asp-append-version="true"></script>
    <script>
        (() => {
            const mode = document.querySelector('[data-accessory-mode]');
            const missing = document.querySelector('[data-accessory-missing]');
            const value = document.querySelector('[data-accessory-value]');
            if (!mode || !missing || !value) return;

            const sync = () => {
                const isMissing = mode.value === 'missing';
                missing.classList.toggle('d-none', !isMissing);
                missing.required = isMissing;
                value.value = isMissing ? `Thiếu/mất: ${missing.value.trim()}` : 'Đủ';
            };

            mode.addEventListener('change', sync);
            missing.addEventListener('input', sync);
            sync();
        })();
    </script>
}
