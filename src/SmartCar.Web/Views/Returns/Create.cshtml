@model SmartCar.Web.ViewModels.ReturnViewModel
@{
    ViewData["Title"] = "Biên bản trả xe";

    var isEarlyReturn = ViewBag.IsEarlyReturn is bool early && early;
    var scheduledReturnDate = ViewBag.ScheduledReturnDate is DateTime scheduled ? scheduled : (DateTime?)null;
    var handoverAt = ViewBag.HandoverAt is DateTime handoverDate ? handoverDate : (DateTime?)null;
    var handoverMileage = ViewBag.HandoverMileage is int mileage ? mileage : 0;
    var handoverFuelLevel = ViewBag.HandoverFuelLevel as string ?? "Chưa ghi nhận";
    var vehicleFuelType = ViewBag.VehicleFuelType as string ?? string.Empty;
    var isElectric = vehicleFuelType.Equals("Điện", StringComparison.OrdinalIgnoreCase);

    var handoverVehicleImages = (ViewBag.HandoverVehicleImagePaths as string ?? string.Empty)
        .Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    var handoverDocumentImages = (ViewBag.HandoverDocumentImagePaths as string ?? string.Empty)
        .Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
}

<div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
    <div>
        <div class="text-uppercase small text-primary fw-semibold">Nhận lại xe</div>
        <h1 class="h3 mb-1">Biên bản trả xe · Đơn #@Model.BookingId</h1>
        <p class="text-muted mb-0">Đối chiếu ảnh lúc giao, kiểm tra xe thực tế và lưu hồ sơ biên bản tại thời điểm SmartCar nhận lại xe.</p>
    </div>
    <a class="btn btn-outline-secondary"
       asp-controller="AdminBookings"
       asp-action="Details"
       asp-route-id="@Model.BookingId">← Quay lại đơn</a>
</div>

@if (isEarlyReturn && scheduledReturnDate.HasValue)
{
    <div class="alert alert-primary shadow-sm">
        <strong>Khách trả xe trước lịch.</strong>
        Lịch trả ban đầu: <strong>@scheduledReturnDate.Value.ToString("dd/MM/yyyy HH:mm")</strong>.
        Tiền thuê/phí giao nhận vẫn được tính theo đơn đã thanh toán; cọc chỉ được quyết toán sau khi kiểm tra xe.
    </div>
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3">
            <div>
                <div class="text-uppercase small text-muted fw-semibold">Hồ sơ lúc giao xe</div>
                <h2 class="h5 mb-1">Căn cứ để đối chiếu khi nhận lại</h2>
            </div>
            <span class="badge bg-light text-dark border">Đã lưu trên SmartCar</span>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <div class="small text-muted">Thời gian giao</div>
                <div class="fw-semibold">@(handoverAt.HasValue ? handoverAt.Value.ToString("dd/MM/yyyy HH:mm") : "Không xác định")</div>
            </div>
            <div class="col-md-4">
                <div class="small text-muted">Số km khi giao</div>
                <div class="fw-semibold">@handoverMileage.ToString("N0") km</div>
            </div>
            <div class="col-md-4">
                <div class="small text-muted">Nhiên liệu / pin khi giao</div>
                <div class="fw-semibold">@handoverFuelLevel</div>
            </div>
        </div>

        @if (handoverDocumentImages.Length > 0)
        {
            <div class="mb-3">
                <div class="fw-semibold small mb-2">Biên bản bàn giao có chữ ký khách</div>
                <div class="row g-2">
                    @foreach (var path in handoverDocumentImages)
                    {
                        <div class="col-6 col-md-3">
                            <a href="@path" target="_blank" rel="noopener noreferrer">
                                <img src="@path" class="w-100 rounded border" style="height:170px;object-fit:contain;background:#f8f9fa" alt="Biên bản bàn giao đã ký" />
                            </a>
                        </div>
                    }
                </div>
            </div>
        }

        @if (handoverVehicleImages.Length > 0)
        {
            <div>
                <div class="fw-semibold small mb-2">Ảnh xe lúc giao</div>
                <div class="row g-2">
                    @foreach (var path in handoverVehicleImages.Take(6))
                    {
                        <div class="col-4 col-md-2">
                            <a href="@path" target="_blank" rel="noopener noreferrer">
                                <img src="@path" class="w-100 rounded border" style="height:90px;object-fit:cover" alt="Ảnh xe lúc giao" />
                            </a>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

<form asp-action="Create"
      method="post"
      enctype="multipart/form-data"
      data-loading-form
      data-confirm="Xác nhận SmartCar đã thực tế nhận lại xe và đã lưu đầy đủ ảnh hiện trạng cùng hồ sơ biên bản trả xe?">
    <input asp-for="BookingId" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <div class="text-uppercase small text-primary fw-semibold">Bước 1</div>
            <h2 class="h5 mb-3">Thông tin nhận lại xe</h2>

            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="ReturnedAt" class="form-label fw-semibold">Thời gian nhận lại xe thực tế</label>
                    <input asp-for="ReturnedAt" type="datetime-local" class="form-control" required />
                    <span asp-validation-for="ReturnedAt" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Mileage" class="form-label fw-semibold">Số km trên đồng hồ khi trả</label>
                    <div class="input-group">
                        <input asp-for="Mileage" type="number" min="@handoverMileage" class="form-control" required />
                        <span class="input-group-text">km</span>
                    </div>
                    <span asp-validation-for="Mileage" class="text-danger small"></span>
                    <div class="form-text">Khi giao: @handoverMileage.ToString("N0") km.</div>
                </div>
                <div class="col-md-4">
                    <label asp-for="FuelLevel" class="form-label fw-semibold">@(isElectric ? "Mức pin khi trả" : "Mức nhiên liệu khi trả")</label>
                    @if (isElectric)
                    {
                        <div class="input-group">
                            <input asp-for="FuelLevel" type="number" min="0" max="100" class="form-control" required />
                            <span class="input-group-text">%</span>
                        </div>
                    }
                    else
                    {
                        <select asp-for="FuelLevel" class="form-select" required>
                            <option value="">-- Chọn mức trên đồng hồ --</option>
                            <option value="8/8 (100%)">8/8 - Đầy bình</option>
                            <option value="7/8 (~87.5%)">7/8 - khoảng 87,5%</option>
                            <option value="6/8 (75%)">6/8 - 75%</option>
                            <option value="5/8 (~62.5%)">5/8 - khoảng 62,5%</option>
                            <option value="4/8 (50%)">4/8 - 50%</option>
                            <option value="3/8 (~37.5%)">3/8 - khoảng 37,5%</option>
                            <option value="2/8 (25%)">2/8 - 25%</option>
                            <option value="1/8 (~12.5%)">1/8 - khoảng 12,5%</option>
                            <option value="0/8 (Gần cạn)">0/8 - Gần cạn</option>
                        </select>
                    }
                    <span asp-validation-for="FuelLevel" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="ReturnLocation" class="form-label fw-semibold">Địa điểm thực tế nhận lại xe</label>
                    <input asp-for="ReturnLocation" class="form-control" maxlength="250" required />
                    <span asp-validation-for="ReturnLocation" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3">
                <div>
                    <div class="text-uppercase small text-primary fw-semibold">Bước 2</div>
                    <h2 class="h5 mb-1">Ảnh hiện trạng xe khi trả</h2>
                    <p class="small text-muted mb-0">Chụp lại cùng các góc như lúc giao. Nếu có hư hỏng mới, chụp thêm ảnh cận cảnh.</p>
                </div>
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">6–15 ảnh</span>
            </div>

            <div class="row g-2 small mb-3">
                <div class="col-md-4"><div class="bg-light rounded p-2">① Chính diện xe</div></div>
                <div class="col-md-4"><div class="bg-light rounded p-2">② Phía sau xe</div></div>
                <div class="col-md-4"><div class="bg-light rounded p-2">③ Bên trái thân xe</div></div>
                <div class="col-md-4"><div class="bg-light rounded p-2">④ Bên phải thân xe</div></div>
                <div class="col-md-4"><div class="bg-light rounded p-2">⑤ Số km + nhiên liệu/pin</div></div>
                <div class="col-md-4"><div class="bg-light rounded p-2">⑥ Nội thất xe</div></div>
            </div>

            <input asp-for="Images"
                   type="file"
                   multiple
                   accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                   class="form-control"
                   data-image-input
                   data-max-files="15"
                   data-preview-target="#return-image-preview"
                   data-file-info-target="#return-file-info" />
            <span asp-validation-for="Images" class="text-danger small"></span>
            <div class="form-text">Tối thiểu 6 ảnh, tối đa 15 ảnh; mỗi ảnh tối đa 5 MB.</div>
            <div id="return-file-info" class="small text-muted mt-2 d-none"></div>
            <div id="return-image-preview" class="mt-3 d-none">
                <div class="row g-2" data-preview-list></div>
                <button type="button" class="btn btn-sm btn-outline-secondary mt-2" data-clear-image>Chọn lại ảnh</button>
            </div>

            <div class="mt-3">
                <label asp-for="ExteriorCondition" class="form-label fw-semibold">Mô tả hư hỏng / bất thường mới <span class="text-muted fw-normal">(nếu có)</span></label>
                <textarea asp-for="ExteriorCondition" class="form-control" rows="3" maxlength="1000" placeholder="Ví dụ: móp mới cản trước bên phải; xước mới cửa sau bên trái..."></textarea>
                <span asp-validation-for="ExteriorCondition" class="text-danger small"></span>
                <div class="form-text">Nếu không có hư hỏng mới thì để trống. Chi phí sửa chữa được xử lý ở bước kiểm tra/phụ phí sau đó.</div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-primary mb-4">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3">
                <div>
                    <div class="text-uppercase small text-primary fw-semibold">Bước 3</div>
                    <h2 class="h5 mb-1">Xác nhận biên bản trả xe</h2>
                    <p class="small text-muted mb-0">Khách ký thì lưu ảnh biên bản đã ký. Nếu khách từ chối ký, SmartCar vẫn nhận lại xe nhưng phải lưu biên bản/hồ sơ ghi nhận từ chối ký và chuyển sang xử lý tranh chấp.</p>
                </div>
                <span class="badge bg-primary">Bằng chứng bắt buộc</span>
            </div>

            <span asp-validation-for="ReturnDocumentStatus" class="text-danger small d-block mb-2"></span>
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="border rounded-3 p-3 d-flex gap-3 h-100" for="returnDocumentSigned">
                        <input asp-for="ReturnDocumentStatus"
                               id="returnDocumentSigned"
                               class="form-check-input mt-1"
                               type="radio"
                               value="Signed" />
                        <span>
                            <strong class="d-block">Khách đã ký biên bản trả xe</strong>
                            <span class="small text-muted">Hai bên thống nhất nội dung biên bản; tải ảnh/scan có chữ ký khách.</span>
                        </span>
                    </label>
                </div>
                <div class="col-md-6">
                    <label class="border border-danger rounded-3 p-3 d-flex gap-3 h-100" for="returnDocumentRefused">
                        <input asp-for="ReturnDocumentStatus"
                               id="returnDocumentRefused"
                               class="form-check-input mt-1"
                               type="radio"
                               value="Refused" />
                        <span>
                            <strong class="d-block text-danger">Khách từ chối ký / không đồng ý hiện trạng</strong>
                            <span class="small text-muted">Không hủy chuyến. SmartCar nhận lại xe, lưu hồ sơ và khóa quyết toán cọc cho đến khi tranh chấp được xử lý.</span>
                        </span>
                    </label>
                </div>
            </div>

            <div id="signature-refusal-block" class="alert alert-danger d-none">
                <label asp-for="SignatureRefusalReason" class="form-label fw-semibold">Lý do / diễn biến khách từ chối ký</label>
                <textarea asp-for="SignatureRefusalReason"
                          id="signature-refusal-reason"
                          class="form-control"
                          rows="3"
                          maxlength="1000"
                          placeholder="Ví dụ: khách không đồng ý vết móp cản trước là hư hỏng mới và từ chối ký biên bản..."></textarea>
                <span asp-validation-for="SignatureRefusalReason" class="text-danger small"></span>
                <div class="form-text">Thông tin này được lưu cùng ảnh hiện trạng và hồ sơ biên bản để xử lý tranh chấp.</div>
            </div>

            <label asp-for="SignedDocumentImages" class="form-label fw-semibold">Ảnh biên bản / hồ sơ ghi nhận tại thời điểm trả xe</label>
            <input asp-for="SignedDocumentImages"
                   type="file"
                   multiple
                   accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                   class="form-control"
                   data-image-input
                   data-max-files="3"
                   data-preview-target="#return-document-preview"
                   data-file-info-target="#return-document-info" />
            <span asp-validation-for="SignedDocumentImages" class="text-danger small"></span>
            <div class="form-text">Bắt buộc ít nhất 1 ảnh, tối đa 3 ảnh. Nếu khách ký: ảnh phải thấy rõ chữ ký. Nếu khách từ chối ký: chụp/scan biên bản ghi nhận việc từ chối ký.</div>
            <div id="return-document-info" class="small text-muted mt-2 d-none"></div>
            <div id="return-document-preview" class="mt-3 d-none">
                <div class="row g-2" data-preview-list></div>
                <button type="button" class="btn btn-sm btn-outline-secondary mt-2" data-clear-image>Chọn lại ảnh biên bản</button>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap border-top pt-3 mb-5">
        <div class="small text-muted">Sau khi lưu, xe được SmartCar tiếp nhận và đơn chuyển sang <strong>Chờ kiểm tra</strong>. Nếu khách từ chối ký, cọc bị khóa cho tới khi Admin xử lý tranh chấp.</div>
        <button class="btn btn-primary px-4" type="submit" data-loading-text="Đang lưu biên bản trả xe...">Lưu hồ sơ & tiếp nhận xe</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const refusalBlock = document.getElementById('signature-refusal-block');
            const refusalReason = document.getElementById('signature-refusal-reason');
            const statusInputs = document.querySelectorAll('input[name="ReturnDocumentStatus"]');

            const syncSignatureState = () => {
                const selected = document.querySelector('input[name="ReturnDocumentStatus"]:checked')?.value;
                const refused = selected === 'Refused';
                refusalBlock?.classList.toggle('d-none', !refused);
                if (refusalReason) refusalReason.required = refused;
            };

            statusInputs.forEach(input => input.addEventListener('change', syncSignatureState));
            syncSignatureState();
        })();
    </script>
}
