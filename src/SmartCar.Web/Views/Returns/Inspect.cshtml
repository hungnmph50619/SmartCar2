@model SmartCar.Web.ViewModels.ReturnInspectionViewModel
@using SmartCar.Domain.Enums

@{
    ViewData["Title"] = $"Đối chiếu giao - trả #{Model.BookingId}";
    var canComplete = Model.Status == BookingStatus.PendingInspection;
    var hasUnpaidCharge = Model.AdditionalAmount > 0 && !Model.AdditionalChargePaid;
    var awaitingRefund = Model.Status == BookingStatus.AwaitingRefund || Model.RefundStatus == PaymentStatus.AwaitingRefund;
    var fuelDifference = Model.FuelDifferencePercent;
    var fuelDifferenceText = fuelDifference.HasValue
        ? $"{(fuelDifference.Value > 0 ? "+" : string.Empty)}{fuelDifference.Value}%"
        : null;
}

<div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-3">
    <div>
        <h1 class="h3 mb-1">Đối chiếu giao - trả xe</h1>
        <p class="text-muted mb-0">
            Đơn #@Model.BookingId · @Model.VehicleName · @Model.LicensePlate
        </p>
    </div>

    <a class="btn btn-outline-secondary"
       asp-controller="AdminBookings"
       asp-action="Details"
       asp-route-id="@Model.BookingId">
        Quay lại đơn
    </a>
</div>

@if (awaitingRefund)
{
    <div class="alert alert-warning">
        <strong>Đã kiểm tra xong.</strong>
        Chờ hoàn cọc <strong>@Model.RefundAmount.ToString("N0") đ</strong> trước khi hoàn tất chuyến.
    </div>
}
else
{
    <div class="alert alert-info">
        So sánh km, nhiên liệu và ảnh lúc giao với lúc trả trước khi kết thúc chuyến.
    </div>
}

<div class="card card-body shadow-sm mb-4">
    <div class="row g-3 align-items-center mb-3">
        <div class="col-md-4">
            <div class="small text-muted">Khách hàng</div>
            <strong>@Model.CustomerName</strong>
        </div>
        <div class="col-md-4">
            <div class="small text-muted">Quãng đường đã chạy</div>
            <strong class="fs-5">@Model.DrivenKilometers.ToString("N0") km</strong>
        </div>
        <div class="col-md-4">
            <div class="small text-muted">Nhiên liệu giao → trả</div>
            <strong class="fs-5 @(fuelDifference < 0 ? "text-danger" : "")">
                @Model.Handover.FuelDisplay → @Model.Return.FuelDisplay
                @if (!string.IsNullOrWhiteSpace(fuelDifferenceText))
                {
                    <span class="fs-6">(@fuelDifferenceText)</span>
                }
            </strong>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-6">
            <div class="border rounded p-3 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h5 mb-0">Biên bản giao xe</h2>
                    <span class="badge bg-primary">Lúc giao</span>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <div class="small text-muted">Thời gian</div>
                        <strong>@Model.Handover.RecordedAt.ToString("dd/MM/yyyy HH:mm")</strong>
                    </div>
                    <div class="col-3">
                        <div class="small text-muted">Số km</div>
                        <strong>@Model.Handover.Mileage.ToString("N0")</strong>
                    </div>
                    <div class="col-3">
                        <div class="small text-muted">Nhiên liệu</div>
                        <strong>@Model.Handover.FuelDisplay</strong>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Handover.Notes))
                {
                    <div class="mb-3">
                        <div class="small text-muted">Ghi chú</div>
                        <div>@Model.Handover.Notes</div>
                    </div>
                }

                <div class="small text-muted mb-2">Ảnh lúc giao (@Model.Handover.ImagePaths.Count)</div>
                <div class="row g-2">
                    @foreach (var image in Model.Handover.ImagePaths)
                    {
                        <div class="col-6 col-md-4">
                            <a href="@image" target="_blank" rel="noopener">
                                <img src="@image"
                                     alt="Ảnh xe lúc giao"
                                     class="img-fluid rounded border w-100"
                                     style="height:140px;object-fit:cover" />
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="border rounded p-3 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h5 mb-0">Biên bản trả xe</h2>
                    <span class="badge bg-success">Lúc trả</span>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <div class="small text-muted">Thời gian</div>
                        <strong>@Model.Return.RecordedAt.ToString("dd/MM/yyyy HH:mm")</strong>
                    </div>
                    <div class="col-3">
                        <div class="small text-muted">Số km</div>
                        <strong>@Model.Return.Mileage.ToString("N0")</strong>
                    </div>
                    <div class="col-3">
                        <div class="small text-muted">Nhiên liệu</div>
                        <strong>@Model.Return.FuelDisplay</strong>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="small text-muted">Hư hỏng mới</div>
                    <strong class="@(Model.Return.HasDamage == true ? "text-danger" : "text-success")">
                        @(Model.Return.HasDamage == true ? "Có" : "Không")
                    </strong>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Return.Notes))
                {
                    <div class="mb-3">
                        <div class="small text-muted">Ghi chú</div>
                        <div>@Model.Return.Notes</div>
                    </div>
                }

                <div class="small text-muted mb-2">Ảnh lúc trả (@Model.Return.ImagePaths.Count)</div>
                <div class="row g-2">
                    @foreach (var image in Model.Return.ImagePaths)
                    {
                        <div class="col-6 col-md-4">
                            <a href="@image" target="_blank" rel="noopener">
                                <img src="@image"
                                     alt="Ảnh xe lúc trả"
                                     class="img-fluid rounded border w-100"
                                     style="height:140px;object-fit:cover" />
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card card-body shadow-sm mb-4">
    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3">
        <div>
            <h2 class="h5 mb-1">Phụ phí sau khi trả</h2>
            <p class="text-muted small mb-0">Chỉ thêm khi có căn cứ sau đối chiếu.</p>
        </div>
        <a class="btn btn-sm btn-outline-primary"
           asp-controller="AdminBookings"
           asp-action="Details"
           asp-route-id="@Model.BookingId">
            Xử lý phụ phí
        </a>
    </div>

    @if (Model.AdditionalCharges.Count == 0)
    {
        <div class="text-success fw-semibold">Không có phụ phí.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-2">
                <thead>
                    <tr>
                        <th>Loại</th>
                        <th>Nội dung</th>
                        <th class="text-end">Số tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var charge in Model.AdditionalCharges)
                    {
                        <tr>
                            <td>@charge.ChargeType.ToVietnamese()</td>
                            <td>@charge.Description</td>
                            <td class="text-end fw-semibold">@charge.Amount.ToString("N0") đ</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between">
            <span>Tổng phụ phí</span>
            <strong>@Model.AdditionalAmount.ToString("N0") đ</strong>
        </div>

        <div class="mt-2">
            @if (Model.AdditionalChargePaid)
            {
                <span class="badge bg-success">Đã thanh toán</span>
            }
            else
            {
                <span class="badge bg-warning text-dark">Chưa thanh toán</span>
            }
        </div>
    }
</div>

@if (canComplete)
{
    <div class="card card-body shadow-sm border-primary">
        <h2 class="h5">Xác nhận đối chiếu</h2>

        @if (hasUnpaidCharge)
        {
            <div class="alert alert-warning mb-0">
                Còn phụ phí <strong>@Model.AdditionalAmount.ToString("N0") đ</strong> chưa thanh toán.
                Chưa thể kết thúc kiểm tra.
            </div>
        }
        else
        {
            <p class="text-muted">
                Xe sẽ được giải phóng hoặc chuyển bảo trì. Có tiền cọc thì đơn chuyển sang <strong>Chờ hoàn cọc</strong>.
            </p>

            <form asp-controller="Returns"
                  asp-action="Complete"
                  method="post"
                  data-loading-form
                  data-confirm="Xác nhận đã đối chiếu cả hai biên bản và kết thúc kiểm tra xe?">

                <input type="hidden" name="BookingId" value="@Model.BookingId" />
                <input type="hidden" name="reviewConfirmed" value="true" />

                <div class="form-check mb-2">
                    <input class="form-check-input"
                           type="checkbox"
                           name="RequiresMaintenance"
                           value="true"
                           id="inspectionRequiresMaintenance" />
                    <label class="form-check-label" for="inspectionRequiresMaintenance">
                        Xe cần bảo trì hoặc sửa chữa
                    </label>
                </div>

                <textarea name="MaintenanceNote"
                          maxlength="1000"
                          class="form-control mb-3"
                          rows="2"
                          placeholder="Nội dung bảo trì nếu có"></textarea>

                <button class="btn btn-primary" type="submit" data-loading-text="Đang xử lý...">
                    @(Model.DepositAmount > 0
                        ? "Xác nhận → Hoàn cọc"
                        : "Xác nhận → Hoàn tất")
                </button>
            </form>
        }
    </div>
}
else if (Model.Status == BookingStatus.Completed)
{
    <div class="alert alert-success">
        <strong>Chuyến đã hoàn tất.</strong> Hai biên bản được giữ lại để tra cứu.
    </div>
}
