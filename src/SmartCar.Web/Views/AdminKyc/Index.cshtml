@model SmartCar.Web.ViewModels.AdminKycQueueViewModel
@{
    ViewData["Title"] = "Hồ sơ xác minh chờ duyệt";
}

<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-start gap-3 mb-4">
    <div>
        <div class="text-uppercase small text-primary fw-semibold">HÀNG ĐỢI XÁC MINH GIẤY TỜ</div>
        <h1 class="h2 fw-bold mb-1">Hồ sơ xác minh chờ duyệt</h1>
        <p class="text-muted mb-0">Xử lý cả hồ sơ xác minh lần đầu và các yêu cầu cập nhật riêng CCCD/GPLX khi giấy tờ sắp hết hạn, hết hạn hoặc cần gửi lại.</p>
    </div>
</div>

@if (Model.Items.Count > 0)
{
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0 p-4 pb-2">
            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                <div>
                    <h2 class="h5 fw-bold mb-1">Xác minh lần đầu</h2>
                    <p class="text-muted mb-0">Khách hàng đã gửi đủ CCCD + GPLX và 4 ảnh. Quản trị viên đối chiếu toàn bộ hồ sơ trong một lần.</p>
                </div>
                <span class="badge bg-warning text-dark px-3 py-2">@Model.Items.Count hồ sơ</span>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Khách hàng</th>
                        <th>Liên hệ</th>
                        <th>Gửi lúc</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@item.CustomerName</div>
                            <small class="text-muted">@item.CustomerEmail</small>
                        </td>
                        <td>@(string.IsNullOrWhiteSpace(item.CustomerPhone) ? "Chưa cập nhật" : item.CustomerPhone)</td>
                        <td>
                            <div>@item.SubmittedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                            <small class="text-muted">Đủ CCCD + GPLX · 4 ảnh</small>
                        </td>
                        <td><span class="badge bg-warning text-dark">Chờ xác minh</span></td>
                        <td class="text-end">
                            <a class="btn btn-primary btn-sm"
                               asp-action="Review"
                               asp-route-customerId="@item.CustomerId">Xem và xác minh</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="alert alert-light border shadow-sm mb-0">
        <strong>Không có hồ sơ xác minh lần đầu đang chờ.</strong>
        <span class="text-muted"> Các yêu cầu cập nhật riêng CCCD/GPLX, nếu có, được hiển thị bên dưới.</span>
    </div>
}

@await Component.InvokeAsync("IndividualDocumentRenewalQueue")
