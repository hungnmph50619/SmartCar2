@model SmartCar.Web.ViewModels.AdminKycPackageReviewViewModel
@using SmartCar.Domain.Constants
@using SmartCar.Domain.Enums
@{
    ViewData["Title"] = "Duyệt hồ sơ xác minh";
    var citizenFront = Model.Documents.First(item => item.DocumentType == DocumentTypes.CitizenId);
    var citizenBack = Model.Documents.First(item => item.DocumentType == DocumentTypes.CitizenIdBack);
    var licenseFront = Model.Documents.First(item => item.DocumentType == DocumentTypes.DrivingLicense);
    var licenseBack = Model.Documents.First(item => item.DocumentType == DocumentTypes.DrivingLicenseBack);
    var allPending = new[] { citizenFront, citizenBack, licenseFront, licenseBack }
        .All(item => item.Status == DocumentStatus.Pending && item.HasRequiredData);

    string ImageUrl(int id) => Url.Action("ViewDocumentImage", "AdminCustomers", new { id }) ?? "#";
    var faceUrl = Url.Action("CustomerKyc", "IdentityFace", new { customerId = Model.CustomerId }) ?? "#";
}

<link rel="stylesheet" href="~/css/admin-kyc.css" asp-append-version="true" />

<div class="admin-kyc-review">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-start gap-3 mb-4">
        <div>
            <div class="text-uppercase small text-primary fw-semibold">HỒ SƠ XÁC MINH MỚI · CHỜ DUYỆT</div>
            <h1 class="h2 fw-bold mb-1">Đối chiếu CCCD + GPLX + khuôn mặt</h1>
            <p class="text-muted mb-0">@Model.CustomerName · @Model.CustomerEmail</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-outline-primary" asp-action="Index">← Hàng đợi xác minh</a>
            <a class="btn btn-outline-secondary" asp-controller="AdminCustomers" asp-action="Details" asp-route-id="@Model.CustomerId" asp-route-tab="documents">Mở trang khách hàng</a>
        </div>
    </div>

    <div class="alert alert-warning shadow-sm mb-4">
        <strong>Không duyệt theo checkbox mù.</strong> Admin phải mở đủ 4 ảnh giấy tờ, xem ảnh mặt được chụp trực tiếp bằng camera/QR và đối chiếu cùng một người trước khi duyệt. Backend cũng chặn duyệt nếu tài khoản chưa có ảnh mặt KYC.
    </div>

    <div class="row g-4 align-items-start">
        <div class="col-xl-8">
            <section class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <div class="text-uppercase small text-primary fw-semibold">1/3 · KHUÔN MẶT</div>
                    <h2 class="h4 fw-bold mb-2">Ảnh mặt chụp trực tiếp</h2>
                    <p class="text-muted">Ảnh này không phải ảnh Customer chọn từ thư viện trong luồng bình thường. Hãy đối chiếu khuôn mặt với CCCD mặt trước và thông tin hồ sơ.</p>
                    <div class="row g-3 align-items-start">
                        <div class="col-md-5">
                            <img src="@faceUrl" alt="Ảnh khuôn mặt KYC" class="img-fluid rounded-4 border bg-light" style="width:100%;max-height:420px;object-fit:cover" onerror="this.classList.add('d-none');this.nextElementSibling.classList.remove('d-none');" />
                            <div class="alert alert-danger d-none mb-0">Không tải được ảnh mặt KYC. Backend sẽ không cho duyệt hồ sơ này.</div>
                        </div>
                        <div class="col-md-7">
                            <div class="border rounded-3 p-3 mb-2"><span class="text-muted small d-block">Khách đứng tên</span><strong>@(citizenFront.FullNameOnDocument ?? Model.CustomerName)</strong></div>
                            <div class="border rounded-3 p-3 mb-2"><span class="text-muted small d-block">Số CCCD khai báo</span><strong>@citizenFront.DocumentNumber</strong></div>
                            <div class="border rounded-3 p-3"><span class="text-muted small d-block">Mục tiêu đối chiếu</span><strong>Ảnh mặt ↔ chân dung trên CCCD ↔ họ tên/ngày sinh ↔ tài khoản đang gửi hồ sơ</strong></div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <div class="text-uppercase small text-primary fw-semibold">2/3 · CĂN CƯỚC CÔNG DÂN</div>
                    <h2 class="h4 fw-bold mb-3">Đối chiếu CCCD</h2>
                    <div class="row g-2 mb-3">
                        <div class="col-md-4"><div class="border rounded-3 p-3 h-100"><span class="small text-muted d-block">Họ tên</span><strong>@(citizenFront.FullNameOnDocument ?? "Chưa cập nhật")</strong></div></div>
                        <div class="col-md-4"><div class="border rounded-3 p-3 h-100"><span class="small text-muted d-block">Số CCCD</span><strong>@citizenFront.DocumentNumber</strong></div></div>
                        <div class="col-md-4"><div class="border rounded-3 p-3 h-100"><span class="small text-muted d-block">Hết hạn</span><strong>@(citizenFront.ExpiryDate?.ToString("dd/MM/yyyy") ?? "-")</strong></div></div>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <a href="@ImageUrl(citizenFront.CustomerDocumentId)" target="_blank" rel="noopener" class="d-block border rounded-4 p-2 text-decoration-none bg-light">
                                <img src="@ImageUrl(citizenFront.CustomerDocumentId)" alt="CCCD mặt trước" class="w-100 rounded-3 bg-white" style="height:260px;object-fit:contain" />
                                <div class="fw-semibold mt-2">CCCD mặt trước · mở ảnh gốc ↗</div>
                            </a>
                        </div>
                        <div class="col-md-6">
                            <a href="@ImageUrl(citizenBack.CustomerDocumentId)" target="_blank" rel="noopener" class="d-block border rounded-4 p-2 text-decoration-none bg-light">
                                <img src="@ImageUrl(citizenBack.CustomerDocumentId)" alt="CCCD mặt sau" class="w-100 rounded-3 bg-white" style="height:260px;object-fit:contain" />
                                <div class="fw-semibold mt-2">CCCD mặt sau · mở ảnh gốc ↗</div>
                            </a>
                        </div>
                    </div>
                </div>
            </section>

            <section class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <div class="text-uppercase small text-primary fw-semibold">3/3 · GIẤY PHÉP LÁI XE</div>
                    <h2 class="h4 fw-bold mb-3">Đối chiếu GPLX</h2>
                    <div class="row g-2 mb-3">
                        <div class="col-md-4"><div class="border rounded-3 p-3 h-100"><span class="small text-muted d-block">Số GPLX</span><strong>@licenseFront.DocumentNumber</strong></div></div>
                        <div class="col-md-4"><div class="border rounded-3 p-3 h-100"><span class="small text-muted d-block">Hạng</span><strong>@(licenseFront.LicenseClass ?? "-")</strong></div></div>
                        <div class="col-md-4"><div class="border rounded-3 p-3 h-100"><span class="small text-muted d-block">Hết hạn</span><strong>@(licenseFront.ExpiryDate?.ToString("dd/MM/yyyy") ?? "-")</strong></div></div>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <a href="@ImageUrl(licenseFront.CustomerDocumentId)" target="_blank" rel="noopener" class="d-block border rounded-4 p-2 text-decoration-none bg-light">
                                <img src="@ImageUrl(licenseFront.CustomerDocumentId)" alt="GPLX mặt trước" class="w-100 rounded-3 bg-white" style="height:260px;object-fit:contain" />
                                <div class="fw-semibold mt-2">GPLX mặt trước · mở ảnh gốc ↗</div>
                            </a>
                        </div>
                        <div class="col-md-6">
                            <a href="@ImageUrl(licenseBack.CustomerDocumentId)" target="_blank" rel="noopener" class="d-block border rounded-4 p-2 text-decoration-none bg-light">
                                <img src="@ImageUrl(licenseBack.CustomerDocumentId)" alt="GPLX mặt sau" class="w-100 rounded-3 bg-white" style="height:260px;object-fit:contain" />
                                <div class="fw-semibold mt-2">GPLX mặt sau · mở ảnh gốc ↗</div>
                            </a>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <div class="col-xl-4">
            <aside class="card border-0 shadow-sm rounded-4 position-sticky" style="top:1rem">
                <div class="card-body p-4">
                    <div class="text-uppercase small text-success fw-semibold">QUYẾT ĐỊNH HỒ SƠ</div>
                    <h2 class="h4 fw-bold mb-2">Một quyết định cho cả bộ KYC</h2>
                    @if (allPending)
                    {
                        <form asp-action="VerifyAll" method="post" class="mb-4" data-loading-form data-confirm="Xác nhận đã đối chiếu ảnh mặt trực tiếp với CCCD/GPLX và duyệt toàn bộ hồ sơ?">
                            <input type="hidden" name="customerId" value="@Model.CustomerId" />
                            <div class="d-grid gap-2 mb-3">
                                <label class="form-check"><input class="form-check-input" type="checkbox" required /> <span class="form-check-label">Đã xem ảnh mặt chụp trực tiếp và chân dung trên CCCD, xác nhận cùng một người.</span></label>
                                <label class="form-check"><input class="form-check-input" type="checkbox" required /> <span class="form-check-label">CCCD: họ tên, số, ngày sinh, hạn dùng khớp ảnh.</span></label>
                                <label class="form-check"><input class="form-check-input" type="checkbox" required /> <span class="form-check-label">GPLX: cùng chủ thể với CCCD, số/hạng/hạn dùng hợp lệ.</span></label>
                                <label class="form-check"><input class="form-check-input" type="checkbox" required /> <span class="form-check-label">Đã mở đủ 4 ảnh giấy tờ và ảnh đủ rõ, không thấy dấu hiệu chỉnh sửa bất thường.</span></label>
                            </div>
                            <button class="btn btn-success w-100" type="submit" data-loading-text="Đang duyệt...">Duyệt toàn bộ KYC</button>
                        </form>

                        <hr />
                        <h3 class="h6 text-danger">Yêu cầu gửi lại</h3>
                        <p class="small text-muted">Khi yêu cầu gửi lại toàn bộ KYC, ảnh mặt ứng viên cũ cũng bị xóa khỏi hồ sơ; khách phải chụp lại bằng camera/QR.</p>
                        <form asp-action="RequestResubmission" method="post" data-loading-form data-confirm="Yêu cầu khách gửi lại toàn bộ KYC và chụp lại ảnh mặt?">
                            <input type="hidden" name="customerId" value="@Model.CustomerId" />
                            <div class="mb-2">
                                <select class="form-select" name="reason" required>
                                    <option value="">-- Chọn lý do --</option>
                                    <option>Ảnh mặt không khớp chân dung trên CCCD</option>
                                    <option>Thông tin khai báo không khớp ảnh giấy tờ</option>
                                    <option>Họ tên trên GPLX không khớp với CCCD</option>
                                    <option>Hạng GPLX không phù hợp</option>
                                    <option>Ảnh giấy tờ hoặc ảnh mặt không đủ rõ</option>
                                    <option>Giấy tờ hết hạn hoặc không đủ hiệu lực</option>
                                    <option>Khác</option>
                                </select>
                            </div>
                            <textarea class="form-control mb-2" name="additionalNote" rows="3" maxlength="500" placeholder="Ghi chú cụ thể"></textarea>
                            <button class="btn btn-outline-danger w-100" type="submit" data-loading-text="Đang gửi yêu cầu...">Yêu cầu cập nhật lại KYC</button>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-secondary mb-0">Hồ sơ này không còn ở trạng thái có thể xử lý.</div>
                    }
                </div>
            </aside>
        </div>
    </div>
</div>
