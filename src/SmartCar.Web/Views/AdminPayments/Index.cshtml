@model IReadOnlyList<SmartCar.Application.Features.Payments.AdminPaymentListItemDto>
@using SmartCar.Domain.Enums
@using SmartCar.Web.Services
@inject IUserBankAccountService BankAccountService

@{
    ViewData["Title"] = "Quản lý thanh toán";
    var section = ViewBag.Section as string ?? "collection";
    var selectedStatus = ViewBag.Status as PaymentStatus?;

    string StatusText(PaymentStatus status) => status switch
    {
        PaymentStatus.Pending => "Chưa thanh toán",
        PaymentStatus.AwaitingConfirmation => "Chờ xác nhận",
        PaymentStatus.Paid => "Đã thu",
        PaymentStatus.AwaitingRefund => "Chờ hoàn",
        PaymentStatus.Refunded => "Đã hoàn",
        PaymentStatus.Failed => "Lỗi",
        _ => status.ToString()
    };

    string StatusBadge(PaymentStatus status) => status switch
    {
        PaymentStatus.Paid or PaymentStatus.Refunded => "bg-success",
        PaymentStatus.AwaitingConfirmation or PaymentStatus.AwaitingRefund => "bg-warning text-dark",
        PaymentStatus.Failed => "bg-danger",
        _ => "bg-secondary"
    };

    string TypeText(PaymentType type) => type switch
    {
        PaymentType.Rental => "Tiền thuê / giao",
        PaymentType.Deposit => "Tiền cọc",
        PaymentType.Extension => "Gia hạn",
        PaymentType.AdditionalCharge => "Phụ phí",
        PaymentType.Refund => "Hoàn tiền",
        _ => type.ToString()
    };
}

<div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3">
    <div>
        <h1 class="h3 mb-1">Quản lý tài chính</h1>
        <p class="text-muted mb-0">Tiền vào, khoản phát sinh và tiền hoàn được tách riêng.</p>
    </div>
</div>

<div class="nav nav-pills gap-2 mb-4">
    <a class="nav-link @(section == "collection" ? "active" : "")" asp-action="Index" asp-route-section="collection">Tiền thu</a>
    <a class="nav-link @(section == "adjustment" ? "active" : "")" asp-action="Index" asp-route-section="adjustment">Phát sinh</a>
    <a class="nav-link @(section == "refund" ? "active" : "")" asp-action="Index" asp-route-section="refund">Hoàn tiền</a>
</div>

<form method="get" class="d-flex gap-2 mb-3 flex-wrap">
    <input type="hidden" name="section" value="@section" />
    <select name="status" class="form-select" style="max-width:220px">
        <option value="">Tất cả trạng thái</option>
        @foreach (var status in Enum.GetValues<PaymentStatus>())
        {
            <option value="@status" selected="@(selectedStatus == status)">@StatusText(status)</option>
        }
    </select>
    <button class="btn btn-outline-primary" type="submit">Lọc</button>
    <a class="btn btn-outline-secondary" asp-action="Index" asp-route-section="@section">Xóa lọc</a>
</form>

@if (Model.Count == 0)
{
    <div class="alert alert-light border">Không có giao dịch.</div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead class="table-light">
                <tr>
                    <th>Đơn</th>
                    <th>Khách / xe</th>
                    <th>Khoản</th>
                    <th class="text-end">Số tiền</th>
                    <th>Trạng thái</th>
                    <th>Mã GD</th>
                    <th style="min-width:230px">Xử lý</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var payment in Model)
                {
                    UserBankAccountDto? bank = null;
                    if (payment.Type == PaymentType.Refund && payment.Status == PaymentStatus.AwaitingRefund)
                    {
                        bank = await BankAccountService.GetDefaultAsync(payment.CustomerId);
                    }

                    <tr>
                        <td><a class="fw-semibold text-decoration-none" asp-controller="AdminBookings" asp-action="Details" asp-route-id="@payment.BookingId">#@payment.BookingId</a></td>
                        <td>
                            <strong>@payment.CustomerName</strong><br />
                            <small class="text-muted">@payment.VehicleName · @payment.LicensePlate</small>
                        </td>
                        <td>@TypeText(payment.Type)</td>
                        <td class="text-end fw-semibold">@payment.Amount.ToString("N0") đ</td>
                        <td><span class="badge @StatusBadge(payment.Status)">@StatusText(payment.Status)</span></td>
                        <td>@(string.IsNullOrWhiteSpace(payment.TransactionCode) ? "-" : payment.TransactionCode)</td>
                        <td>
                            @if (payment.Status == PaymentStatus.AwaitingConfirmation)
                            {
                                <div class="d-flex gap-2 flex-wrap">
                                    <form asp-action="ConfirmQr" method="post" data-confirm="Đã kiểm tra ngân hàng và nhận được tiền?">
                                        <input type="hidden" name="paymentId" value="@payment.PaymentId" />
                                        <input type="hidden" name="section" value="@section" />
                                        <button class="btn btn-sm btn-success" type="submit">Đã nhận</button>
                                    </form>
                                    <form asp-action="RejectQr" method="post" data-confirm="Chưa nhận được giao dịch này?">
                                        <input type="hidden" name="paymentId" value="@payment.PaymentId" />
                                        <input type="hidden" name="section" value="@section" />
                                        <button class="btn btn-sm btn-outline-danger" type="submit">Chưa nhận</button>
                                    </form>
                                </div>
                            }
                            else if (payment.Type == PaymentType.Refund && payment.Status == PaymentStatus.AwaitingRefund)
                            {
                                @if (bank is null)
                                {
                                    <span class="text-danger small">Khách chưa có tài khoản nhận hoàn.</span>
                                }
                                else
                                {
                                    <div class="small mb-2">
                                        <strong>@bank.BankName</strong> · <span class="user-select-all">@bank.AccountNumber</span><br />
                                        @bank.AccountHolderName
                                    </div>
                                    <form asp-action="ConfirmRefund" method="post" data-confirm="Đã thực sự chuyển khoản hoàn tiền cho khách?">
                                        <input type="hidden" name="paymentId" value="@payment.PaymentId" />
                                        <input type="hidden" name="section" value="refund" />
                                        <div class="input-group input-group-sm">
                                            <input name="transactionCode" class="form-control" maxlength="100" placeholder="Mã giao dịch" required />
                                            <button class="btn btn-success" type="submit">Đã hoàn</button>
                                        </div>
                                    </form>
                                }
                            }
                            else if (payment.Status == PaymentStatus.Pending)
                            {
                                <span class="text-muted small">Chờ khách</span>
                            }
                            else if (payment.Status == PaymentStatus.Paid)
                            {
                                <span class="text-success small">✓ Đã thu</span>
                            }
                            else if (payment.Status == PaymentStatus.Refunded)
                            {
                                <span class="text-success small">✓ Đã hoàn</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
