@model IReadOnlyList<SmartCar.Application.Features.Payments.AdminPaymentListItemDto>

@using SmartCar.Domain.Enums
@using SmartCar.Web.Services

@inject IUserBankAccountService BankAccountService

@{
    ViewData["Title"] = "Quản lý thanh toán";

    var selectedStatus =
        ViewBag.Status as PaymentStatus?;

    var selectedType =
        ViewBag.Type as PaymentType?;

    string GetStatusBadgeClass(PaymentStatus status)
    {
        return status switch
        {
            PaymentStatus.Pending =>
                "bg-secondary",

            PaymentStatus.AwaitingConfirmation =>
                "bg-warning text-dark",

            PaymentStatus.Paid =>
                "bg-success",

            PaymentStatus.AwaitingRefund =>
                "bg-info text-dark",

            PaymentStatus.Refunded =>
                "bg-success",

            PaymentStatus.Failed =>
                "bg-danger",

            _ =>
                "bg-secondary"
        };
    }

    string GetPaymentTimeText(
        PaymentStatus status,
        DateTime? paidAt)
    {
        if (paidAt.HasValue)
        {
            return paidAt.Value
                .ToLocalTime()
                .ToString("dd/MM/yyyy HH:mm");
        }

        return status switch
        {
            PaymentStatus.Pending =>
                "Chưa thanh toán",

            PaymentStatus.AwaitingConfirmation =>
                "Chờ xác nhận",

            PaymentStatus.AwaitingRefund =>
                "Chờ hoàn tiền",

            PaymentStatus.Failed =>
                "Thanh toán thất bại",

            _ =>
                "-"
        };
    }
}

<div class="d-flex justify-content-between
    align-items-center
    flex-wrap
    gap-3
    mb-3">

    <div>
        <h1 class="h3 mb-1">
            Quản lý thanh toán
        </h1>

        <p class="text-muted mb-0">
            Theo dõi thanh toán tiền thuê,
            gia hạn, phụ phí và hoàn tiền.
        </p>
    </div>

</div>


@* =========================================================
   BỘ LỌC
   ========================================================= *@

<form method="get"
      class="row g-2 mb-4">

    <div class="col-md-4">

        <label class="form-label">
            Trạng thái
        </label>

        <select name="status"
                class="form-select">

            <option value="">
                Tất cả trạng thái
            </option>

            @foreach (var status in
                Enum.GetValues<PaymentStatus>())
            {
                <option value="@status"
                        selected="@(selectedStatus == status)">
                    @status.ToVietnamese()
                </option>
            }

        </select>

    </div>

    <div class="col-md-4">

        <label class="form-label">
            Loại thanh toán
        </label>

        <select name="type"
                class="form-select">

            <option value="">
                Tất cả loại thanh toán
            </option>

            @foreach (var type in
                Enum.GetValues<PaymentType>())
            {
                <option value="@type"
                        selected="@(selectedType == type)">
                    @type.ToVietnamese()
                </option>
            }

        </select>

    </div>

    <div class="col-md-auto d-flex align-items-end">

        <button class="btn btn-outline-primary"
                type="submit">
            Lọc
        </button>

    </div>

    <div class="col-md-auto d-flex align-items-end">

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Xóa bộ lọc
        </a>

    </div>

</form>


@* =========================================================
   DANH SÁCH GIAO DỊCH
   ========================================================= *@

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Chưa có giao dịch phù hợp.
    </div>
}
else
{
    <div class="table-responsive">

        <table class="table
            table-bordered
            table-hover
            align-middle">

            <thead class="table-light">

                <tr>

                    <th>
                        Mã GD
                    </th>

                    <th>
                        Đơn
                    </th>

                    <th>
                        Khách hàng
                    </th>

                    <th>
                        Xe
                    </th>

                    <th>
                        Loại
                    </th>

                    <th>
                        Phương thức
                    </th>

                    <th class="text-end">
                        Số tiền
                    </th>

                    <th>
                        Trạng thái
                    </th>

                    <th>
                        Thời gian
                    </th>

                    <th>
                        Mã giao dịch
                    </th>

                    <th style="min-width:280px;">
                        Thao tác
                    </th>

                </tr>

            </thead>

            <tbody>

                @foreach (var payment in Model)
                {
                    // Chỉ cần đọc tài khoản ngân hàng
                    // khi đây là khoản hoàn tiền đang chờ xử lý.
                    UserBankAccountDto? refundBankAccount = null;

                    if (payment.Type == PaymentType.Refund &&
                        payment.Status == PaymentStatus.AwaitingRefund)
                    {
                        refundBankAccount =
                            await BankAccountService.GetDefaultAsync(
                                payment.CustomerId);
                    }

                    <tr>

                        @* MÃ GIAO DỊCH *@
                        <td class="fw-semibold">
                            #@payment.PaymentId
                        </td>


                        @* ĐƠN THUÊ *@
                        <td>

                            <a asp-controller="AdminBookings"
                               asp-action="Details"
                               asp-route-id="@payment.BookingId"
                               class="text-decoration-none fw-semibold">

                                #@payment.BookingId

                            </a>

                        </td>


                        @* KHÁCH HÀNG *@
                        <td>

                            <div class="fw-semibold">
                                @payment.CustomerName
                            </div>

                            <a asp-controller="AdminCustomers"
                               asp-action="Details"
                               asp-route-id="@payment.CustomerId"
                               class="small text-decoration-none">

                                Xem khách hàng

                            </a>

                        </td>


                        @* XE *@
                        <td>

                            <strong>
                                @payment.VehicleName
                            </strong>

                            <br />

                            <small class="text-muted">
                                @payment.LicensePlate
                            </small>

                        </td>


                        @* LOẠI THANH TOÁN *@
                        <td>

                            @payment.Type.ToVietnamese()

                        </td>


                        @* PHƯƠNG THỨC *@
                        <td>

                            @if (string.IsNullOrWhiteSpace(
                                payment.Method))
                            {
                                <span class="text-muted">
                                    -
                                </span>
                            }
                            else
                            {
                                @payment.Method
                            }

                        </td>


                        @* SỐ TIỀN *@
                        <td class="text-end fw-semibold">

                            @payment.Amount.ToString("N0") đ

                        </td>


                        @* TRẠNG THÁI *@
                        <td>

                            <span class="badge
                                @GetStatusBadgeClass(payment.Status)">

                                @payment.Status.ToVietnamese()

                            </span>

                        </td>


                        @* THỜI GIAN *@
                        <td class="small">

                            @GetPaymentTimeText(
                                payment.Status,
                                payment.PaidAt)

                        </td>


                        @* MÃ GIAO DỊCH NGÂN HÀNG *@
                        <td>

                            @if (string.IsNullOrWhiteSpace(
                                payment.TransactionCode))
                            {
                                <span class="text-muted">
                                    -
                                </span>
                            }
                            else
                            {
                                <code>
                                    @payment.TransactionCode
                                </code>
                            }

                        </td>


                        @* =================================================
                           THAO TÁC
                           ================================================= *@

                        <td>

                            @* =============================================
                               1. KHÁCH ĐÃ BÁO CHUYỂN QR
                               ============================================= *@

                            @if (payment.Status ==
                                 PaymentStatus.AwaitingConfirmation)
                            {
                                <div class="alert
                                    alert-warning
                                    py-2
                                    px-2
                                    small
                                    mb-2">

                                    <strong>
                                        Khách báo đã chuyển khoản QR
                                    </strong>

                                    <div class="mt-1">
                                        Kiểm tra tài khoản ngân hàng
                                        trước khi xác nhận.
                                    </div>

                                </div>


                                @* XÁC NHẬN ĐÃ NHẬN TIỀN *@

                                <form asp-action="ConfirmQr"
                                      method="post"
                                      class="mb-2"
                                      data-loading-form
                                      data-confirm="Bạn đã kiểm tra ngân hàng và chắc chắn đã nhận được tiền?">

                                    <input type="hidden"
                                           name="paymentId"
                                           value="@payment.PaymentId" />

                                    <button type="submit"
                                            class="btn
                                        btn-success
                                        btn-sm
                                        w-100"
                                            data-loading-text="Đang xác nhận...">

                                        ✓ Xác nhận đã nhận tiền

                                    </button>

                                </form>


                                @* TỪ CHỐI / CHƯA NHẬN ĐƯỢC *@

                                <form asp-action="RejectQr"
                                      method="post"
                                      data-loading-form
                                      data-confirm="Xác nhận chưa nhận được khoản chuyển này?">

                                    <input type="hidden"
                                           name="paymentId"
                                           value="@payment.PaymentId" />

                                    <button type="submit"
                                            class="btn
                                        btn-outline-danger
                                        btn-sm
                                        w-100"
                                            data-loading-text="Đang xử lý...">

                                        Chưa nhận được tiền

                                    </button>

                                </form>
                            }


                            @* =============================================
                               2. KHOẢN HOÀN TIỀN ĐANG CHỜ XỬ LÝ
                               ============================================= *@

                            else if (
                                payment.Type == PaymentType.Refund &&
                                payment.Status ==
                                    PaymentStatus.AwaitingRefund)
                            {
                                <div class="fw-semibold mb-2">
                                    Hoàn tiền cho khách
                                </div>


                                @if (refundBankAccount is null)
                                {
                                    <div class="alert
                                        alert-danger
                                        py-2
                                        px-2
                                        small
                                        mb-2">

                                        Khách chưa lưu tài khoản
                                        ngân hàng nhận hoàn tiền.

                                    </div>

                                    <a asp-controller="AdminCustomers"
                                       asp-action="Details"
                                       asp-route-id="@payment.CustomerId"
                                       class="btn
                                        btn-outline-secondary
                                        btn-sm
                                        w-100">

                                        Xem thông tin khách hàng

                                    </a>
                                }
                                else
                                {
                                    @* THÔNG TIN NGÂN HÀNG KHÁCH *@

                                    <div class="border
                                        rounded
                                        bg-light
                                        p-2
                                        mb-2
                                        small">

                                        <div class="mb-1">

                                            <span class="text-muted">
                                                Ngân hàng:
                                            </span>

                                            <strong>
                                                @refundBankAccount.BankName
                                            </strong>

                                        </div>


                                        <div class="mb-1">

                                            <span class="text-muted">
                                                Số tài khoản:
                                            </span>

                                            <strong class="user-select-all">
                                                @refundBankAccount.AccountNumber
                                            </strong>

                                        </div>


                                        <div class="mb-1">

                                            <span class="text-muted">
                                                Chủ tài khoản:
                                            </span>

                                            <strong>
                                                @refundBankAccount.AccountHolderName
                                            </strong>

                                        </div>


                                        <div>

                                            <span class="text-muted">
                                                Cần hoàn:
                                            </span>

                                            <strong class="text-danger">
                                                @payment.Amount.ToString("N0") đ
                                            </strong>

                                        </div>

                                    </div>


                                    @* FORM XÁC NHẬN HOÀN TIỀN *@

                                    <form asp-action="ConfirmRefund"
                                          method="post"
                                          data-loading-form
                                          data-confirm="Bạn đã thực sự chuyển khoản hoàn tiền cho khách?">

                                        <input type="hidden"
                                               name="paymentId"
                                               value="@payment.PaymentId" />


                                        <div class="mb-2">

                                            <label class="form-label
                                                small
                                                fw-semibold">

                                                Mã giao dịch ngân hàng

                                            </label>

                                            <input type="text"
                                                   name="transactionCode"
                                                   class="form-control
                                            form-control-sm"
                                                   maxlength="100"
                                                   placeholder="Ví dụ: FT260812123456"
                                                   required />

                                        </div>


                                        <button type="submit"
                                                class="btn
                                            btn-success
                                            btn-sm
                                            w-100"
                                                data-loading-text="Đang xác nhận...">

                                            ✓ Xác nhận đã hoàn tiền

                                        </button>

                                    </form>
                                }
                            }


                            @* =============================================
                               3. GIAO DỊCH ĐÃ XỬ LÝ
                               ============================================= *@

                            else if (
                                payment.Status == PaymentStatus.Paid)
                            {
                                <span class="text-success small fw-semibold">
                                    ✓ Đã thanh toán
                                </span>
                            }

                            else if (
                                payment.Status == PaymentStatus.Refunded)
                            {
                                <span class="text-success small fw-semibold">
                                    ✓ Đã hoàn tiền
                                </span>
                            }

                            else if (
                                payment.Status == PaymentStatus.Pending)
                            {
                                <span class="text-muted small">
                                    Chờ khách thanh toán
                                </span>
                            }

                            else if (
                                payment.Status == PaymentStatus.Failed)
                            {
                                <span class="text-danger small">
                                    Giao dịch thất bại
                                </span>
                            }

                            else
                            {
                                <span class="text-muted">
                                    -
                                </span>
                            }

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
}