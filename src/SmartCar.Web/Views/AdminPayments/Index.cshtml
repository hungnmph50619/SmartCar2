@model IReadOnlyList<SmartCar.Application.Features.Payments.AdminPaymentListItemDto>

@using SmartCar.Domain.Enums
@using SmartCar.Web.Services

@inject IUserBankAccountService BankAccountService

@{
    ViewData["Title"] = "Quản lý thanh toán";

    var selectedStatus = ViewBag.Status as PaymentStatus?;
    var selectedType = ViewBag.Type as PaymentType?;

    string GetStatusBadgeClass(PaymentStatus status) => status switch
    {
        PaymentStatus.Pending => "bg-secondary",
        PaymentStatus.AwaitingConfirmation => "bg-warning text-dark",
        PaymentStatus.Paid => "bg-success",
        PaymentStatus.AwaitingRefund => "bg-info text-dark",
        PaymentStatus.Refunded => "bg-success",
        PaymentStatus.Failed => "bg-danger",
        _ => "bg-secondary"
    };

    string GetPaymentTimeText(PaymentStatus status, DateTime? paidAt)
    {
        if (paidAt.HasValue)
        {
            return paidAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm");
        }

        return status switch
        {
            PaymentStatus.Pending => "Chưa thanh toán",
            PaymentStatus.AwaitingConfirmation => "Chờ xác nhận",
            PaymentStatus.AwaitingRefund => "Chờ hoàn tiền",
            PaymentStatus.Failed => "Thanh toán thất bại",
            _ => "-"
        };
    }

    string? GetTransferContent(PaymentType type, int bookingId) => type switch
    {
        PaymentType.Rental or PaymentType.Deposit => $"SC{bookingId}-BOOKING",
        PaymentType.Extension => $"SC{bookingId}-EXT",
        PaymentType.AdditionalCharge => $"SC{bookingId}-FEE",
        PaymentType.Refund => $"SC{bookingId}-REFUND",
        PaymentType.DepositRefund => $"SC{bookingId}-DEPOSIT-REFUND",
        _ => null
    };
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
    <div>
        <h1 class="h3 mb-1">Quản lý thanh toán</h1>
        <p class="text-muted mb-0">
            Giao dịch tiền vào được đối chiếu theo <strong>số tiền + nội dung chuyển khoản</strong>.
            Khi hoàn tiền/cọc, chỉ xác nhận sau khi đã chuyển thực tế và có <strong>mã giao dịch ngân hàng</strong>.
        </p>
    </div>
</div>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-4">
        <label class="form-label">Trạng thái</label>
        <select name="status" class="form-select">
            <option value="">Tất cả trạng thái</option>
            @foreach (var status in Enum.GetValues<PaymentStatus>())
            {
                <option value="@status" selected="@(selectedStatus == status)">@status.ToVietnamese()</option>
            }
        </select>
    </div>

    <div class="col-md-4">
        <label class="form-label">Loại thanh toán</label>
        <select name="type" class="form-select">
            <option value="">Tất cả loại thanh toán</option>
            @foreach (var type in Enum.GetValues<PaymentType>())
            {
                <option value="@type" selected="@(selectedType == type)">@type.ToVietnamese()</option>
            }
        </select>
        <div class="form-text">Chỉ lọc theo loại khi cần xem cấu phần kế toán riêng.</div>
    </div>

    <div class="col-md-auto d-flex align-items-end">
        <button class="btn btn-outline-primary" type="submit">Lọc</button>
    </div>
    <div class="col-md-auto d-flex align-items-end">
        <a asp-action="Index" class="btn btn-outline-secondary">Xóa bộ lọc</a>
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Chưa có giao dịch phù hợp.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Giao dịch</th>
                    <th>Đơn</th>
                    <th>Khách hàng</th>
                    <th>Xe</th>
                    <th>Loại</th>
                    <th>Phương thức</th>
                    <th class="text-end">Số tiền</th>
                    <th>Trạng thái</th>
                    <th>Thời gian</th>
                    <th style="min-width:190px;">Nội dung / mã GD</th>
                    <th style="min-width:350px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var payment in Model)
                {
                    UserBankAccountDto? refundBankAccount = null;
                    var isRefund = payment.Type is PaymentType.Refund or PaymentType.DepositRefund;
                    var isDepositRefund = payment.Type == PaymentType.DepositRefund;
                    var isInitialCheckoutPart = payment.Type is PaymentType.Rental or PaymentType.Deposit;

                    var pairedCheckoutPayment = isInitialCheckoutPart
                        ? Model.FirstOrDefault(item =>
                            item.BookingId == payment.BookingId &&
                            item.PaymentId != payment.PaymentId &&
                            (item.Type is PaymentType.Rental or PaymentType.Deposit) &&
                            item.Type != payment.Type &&
                            item.Status == payment.Status &&
                            string.Equals(item.TransactionCode, payment.TransactionCode, StringComparison.Ordinal))
                        : null;

                    var isGroupedCheckout = selectedType is null &&
                        isInitialCheckoutPart &&
                        pairedCheckoutPayment is not null;

                    if (isGroupedCheckout && payment.Type == PaymentType.Deposit)
                    {
                        continue;
                    }

                    var displayAmount = isGroupedCheckout
                        ? payment.Amount + pairedCheckoutPayment!.Amount
                        : payment.Amount;
                    var displayType = isGroupedCheckout ? "Tiền thuê + cọc" : payment.Type.ToVietnamese();
                    var displayPaymentId = isGroupedCheckout
                        ? $"#{Math.Min(payment.PaymentId, pairedCheckoutPayment!.PaymentId)} + #{Math.Max(payment.PaymentId, pairedCheckoutPayment.PaymentId)}"
                        : $"#{payment.PaymentId}";
                    var transferContent = GetTransferContent(payment.Type, payment.BookingId);

                    if (isRefund && payment.Status == PaymentStatus.AwaitingRefund)
                    {
                        refundBankAccount = await BankAccountService.GetDefaultAsync(payment.CustomerId);
                    }

                    <tr class="@(isGroupedCheckout ? "table-primary" : string.Empty)">
                        <td>
                            @if (isGroupedCheckout)
                            {
                                <div class="fw-semibold">Thanh toán ban đầu</div>
                                <div class="small text-muted">@displayPaymentId · 1 giao dịch</div>
                            }
                            else
                            {
                                <span class="fw-semibold">@displayPaymentId</span>
                            }
                        </td>
                        <td>
                            <a asp-controller="AdminBookings"
                               asp-action="Details"
                               asp-route-id="@payment.BookingId"
                               class="text-decoration-none fw-semibold">#@payment.BookingId</a>
                        </td>
                        <td>
                            <div class="fw-semibold">@payment.CustomerName</div>
                            <a asp-controller="AdminCustomers"
                               asp-action="Details"
                               asp-route-id="@payment.CustomerId"
                               class="small text-decoration-none">Xem khách hàng</a>
                        </td>
                        <td>
                            <strong>@payment.VehicleName</strong><br />
                            <small class="text-muted">@payment.LicensePlate</small>
                        </td>
                        <td>
                            <strong class="@(isGroupedCheckout ? "text-primary" : string.Empty)">@displayType</strong>
                            @if (isGroupedCheckout)
                            {
                                var rentalPart = payment.Type == PaymentType.Rental ? payment : pairedCheckoutPayment!;
                                var depositPart = payment.Type == PaymentType.Deposit ? payment : pairedCheckoutPayment!;
                                <div class="small text-muted mt-1">
                                    Thuê/phí: @rentalPart.Amount.ToString("N0") đ<br />
                                    Cọc: @depositPart.Amount.ToString("N0") đ
                                </div>
                            }
                            else if (isInitialCheckoutPart && selectedType is not null)
                            {
                                <div class="small text-muted">Cấu phần kế toán của thanh toán ban đầu</div>
                            }
                        </td>
                        <td>
                            @(string.IsNullOrWhiteSpace(payment.Method) ? "-" : payment.Method)
                        </td>
                        <td class="text-end">
                            <strong class="@(isGroupedCheckout ? "text-primary fs-6" : string.Empty)">@displayAmount.ToString("N0") đ</strong>
                            @if (isGroupedCheckout)
                            {
                                <div class="small text-muted">Khách chuyển 1 lần</div>
                            }
                        </td>
                        <td><span class="badge @GetStatusBadgeClass(payment.Status)">@payment.Status.ToVietnamese()</span></td>
                        <td class="small">@GetPaymentTimeText(payment.Status, payment.PaidAt)</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(transferContent))
                            {
                                <div class="small text-muted">Nội dung chuyển khoản</div>
                                <code class="user-select-all">@transferContent</code>

                                @if (!string.IsNullOrWhiteSpace(payment.TransactionCode))
                                {
                                    if (isRefund && payment.Status == PaymentStatus.Refunded)
                                    {
                                        <div class="small text-muted mt-2">Mã GD ngân hàng</div>
                                        <code class="user-select-all">@payment.TransactionCode</code>
                                    }
                                    else
                                    {
                                        <div class="small text-muted mt-2">Mã nội bộ</div>
                                        <span class="small user-select-all">@payment.TransactionCode</span>
                                    }
                                }
                            }
                            else if (!string.IsNullOrWhiteSpace(payment.TransactionCode))
                            {
                                <div class="small text-muted">Mã giao dịch</div>
                                <code class="user-select-all">@payment.TransactionCode</code>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            @if (payment.Status == PaymentStatus.AwaitingConfirmation && isGroupedCheckout)
                            {
                                <div class="alert alert-warning py-2 px-2 small mb-2">
                                    <strong>Đối chiếu trên tài khoản ngân hàng</strong>
                                    <div class="border rounded bg-white p-2 mt-2">
                                        <div class="d-flex justify-content-between gap-2">
                                            <span>Số tiền:</span>
                                            <strong class="text-danger">@displayAmount.ToString("N0") đ</strong>
                                        </div>
                                        <div class="d-flex justify-content-between gap-2 mt-1">
                                            <span>Nội dung CK:</span>
                                            <strong class="user-select-all">@transferContent</strong>
                                        </div>
                                    </div>
                                    <div class="mt-2">Chỉ xác nhận khi tiền vào khớp đúng số tiền và nội dung chuyển khoản.</div>
                                </div>

                                <form asp-action="ConfirmQr" method="post" class="mb-2" data-loading-form
                                      data-confirm="Bạn đã thấy giao dịch vào đúng @displayAmount.ToString("N0") đ với nội dung @transferContent?">
                                    <input type="hidden" name="paymentId" value="@payment.PaymentId" />
                                    <button type="submit" class="btn btn-success btn-sm w-100" data-loading-text="Đang xác nhận...">
                                        ✓ Đã thấy tiền - xác nhận @displayAmount.ToString("N0") đ
                                    </button>
                                </form>

                                <form asp-action="RejectQr" method="post" data-loading-form
                                      data-confirm="Bạn xác nhận hiện chưa tìm thấy giao dịch đúng số tiền và nội dung chuyển khoản này?">
                                    <input type="hidden" name="paymentId" value="@payment.PaymentId" />
                                    <div class="mb-2">
                                        <label class="form-label small fw-semibold">Lý do chưa tìm thấy giao dịch</label>
                                        <textarea name="rejectionReason" class="form-control form-control-sm" rows="2" maxlength="500" required
                                                  placeholder="Ví dụ: Đã kiểm tra tài khoản nhưng chưa thấy giao dịch đúng tổng tiền/nội dung."></textarea>
                                    </div>
                                    <button type="submit" class="btn btn-outline-danger btn-sm w-100" data-loading-text="Đang ghi nhận...">⚠ Chưa tìm thấy giao dịch</button>
                                </form>
                            }
                            else if (payment.Status == PaymentStatus.AwaitingConfirmation)
                            {
                                <div class="alert alert-warning py-2 px-2 small mb-2">
                                    @if (isInitialCheckoutPart)
                                    {
                                        <strong>Đang xem cấu phần kế toán</strong>
                                        <div class="mt-1">Khoản này thuộc giao dịch thanh toán ban đầu tiền thuê + cọc.</div>
                                    }
                                    else
                                    {
                                        <strong>Đối chiếu trên tài khoản ngân hàng</strong>
                                        <div class="mt-1">Số tiền: <strong>@displayAmount.ToString("N0") đ</strong></div>
                                        @if (!string.IsNullOrWhiteSpace(transferContent))
                                        {
                                            <div>Nội dung CK: <strong class="user-select-all">@transferContent</strong></div>
                                        }
                                    }
                                </div>

                                <form asp-action="ConfirmQr" method="post" class="mb-2" data-loading-form data-confirm="Bạn đã kiểm tra ngân hàng và chắc chắn đã nhận được tiền?">
                                    <input type="hidden" name="paymentId" value="@payment.PaymentId" />
                                    <button type="submit" class="btn btn-success btn-sm w-100" data-loading-text="Đang xác nhận...">✓ Đã thấy tiền - xác nhận</button>
                                </form>

                                <form asp-action="RejectQr" method="post" data-loading-form data-confirm="Bạn xác nhận hiện chưa tìm thấy giao dịch này?">
                                    <input type="hidden" name="paymentId" value="@payment.PaymentId" />
                                    <div class="mb-2">
                                        <label class="form-label small fw-semibold">Lý do chưa tìm thấy giao dịch</label>
                                        <textarea name="rejectionReason" class="form-control form-control-sm" rows="2" maxlength="500" required></textarea>
                                    </div>
                                    <button type="submit" class="btn btn-outline-danger btn-sm w-100" data-loading-text="Đang ghi nhận...">⚠ Chưa tìm thấy giao dịch</button>
                                </form>
                            }
                            else if (isRefund && payment.Status == PaymentStatus.AwaitingRefund)
                            {
                                <div class="fw-semibold mb-2">@(isDepositRefund ? "Hoàn cọc bảo đảm cho khách" : "Hoàn phần tiền chuyến cho khách")</div>

                                @if (refundBankAccount is null)
                                {
                                    <div class="alert alert-danger py-2 px-2 small mb-2">Khách chưa lưu tài khoản ngân hàng mặc định để nhận khoản hoàn.</div>
                                    <a asp-controller="AdminCustomers" asp-action="Details" asp-route-id="@payment.CustomerId"
                                       class="btn btn-outline-secondary btn-sm w-100">Xem thông tin khách hàng</a>
                                }
                                else
                                {
                                    <div class="border rounded bg-light p-2 mb-2 small">
                                        <div class="mb-1"><span class="text-muted">Ngân hàng:</span> <strong>@refundBankAccount.BankName</strong></div>
                                        <div class="mb-1"><span class="text-muted">Số tài khoản:</span> <strong class="user-select-all">@refundBankAccount.AccountNumber</strong></div>
                                        <div class="mb-1"><span class="text-muted">Chủ tài khoản:</span> <strong>@refundBankAccount.AccountHolderName</strong></div>
                                        <div class="mb-1"><span class="text-muted">Số tiền:</span> <strong class="text-danger">@payment.Amount.ToString("N0") đ</strong></div>
                                        <div><span class="text-muted">Nội dung chuyển:</span> <strong class="user-select-all">@transferContent</strong></div>
                                    </div>

                                    <div class="alert alert-info py-2 px-2 small mb-2">
                                        <strong>Trình tự xác nhận</strong>
                                        <div>1. Chuyển đúng số tiền vào đúng tài khoản ở trên.</div>
                                        <div>2. Dùng đúng nội dung <strong>@transferContent</strong>.</div>
                                        <div>3. Sau khi ngân hàng báo thành công, copy mã giao dịch ngân hàng rồi mới xác nhận.</div>
                                    </div>

                                    <form asp-action="ConfirmRefund" method="post" data-loading-form
                                          data-confirm="Bạn xác nhận đã thực sự chuyển @payment.Amount.ToString("N0") đ cho @refundBankAccount.AccountHolderName với nội dung @transferContent?">
                                        <input type="hidden" name="paymentId" value="@payment.PaymentId" />

                                        <div class="mb-2">
                                            <label class="form-label small fw-semibold">Mã giao dịch ngân hàng sau khi chuyển</label>
                                            <input type="text"
                                                   name="transactionCode"
                                                   class="form-control form-control-sm"
                                                   minlength="4"
                                                   maxlength="100"
                                                   autocomplete="off"
                                                   placeholder="Ví dụ: FT260815123456"
                                                   required />
                                            <div class="form-text">Nhập mã/reference do ngân hàng sinh sau khi giao dịch thành công, không tự đặt mã.</div>
                                        </div>

                                        <div class="form-check mb-2">
                                            <input class="form-check-input" type="checkbox" name="transferCompleted" value="true"
                                                   id="transferCompleted-@payment.PaymentId" required />
                                            <label class="form-check-label small" for="transferCompleted-@payment.PaymentId">
                                                Tôi xác nhận đã thực tế chuyển khoản cho đúng người nhận, đúng số tiền và đúng nội dung trên.
                                            </label>
                                        </div>

                                        <button type="submit" class="btn btn-success btn-sm w-100" data-loading-text="Đang xác nhận...">
                                            ✓ @(isDepositRefund ? "Ghi nhận đã hoàn cọc" : "Ghi nhận đã hoàn tiền")
                                        </button>
                                    </form>
                                }
                            }
                            else if (payment.Status == PaymentStatus.Paid)
                            {
                                <span class="text-success small fw-semibold">✓ Đã thanh toán</span>
                            }
                            else if (payment.Status == PaymentStatus.Refunded)
                            {
                                <div class="text-success small fw-semibold">✓ @(isDepositRefund ? "Đã hoàn cọc" : "Đã hoàn tiền")</div>
                                @if (isRefund)
                                {
                                    <div class="small text-muted mt-1">Khoản này đã khóa, không thể xác nhận hoàn lần hai.</div>
                                }
                            }
                            else if (payment.Status == PaymentStatus.Pending)
                            {
                                <span class="text-muted small">@(isInitialCheckoutPart ? "Chờ khách thanh toán gói tiền thuê + cọc" : "Chờ khách thanh toán")</span>
                            }
                            else if (payment.Status == PaymentStatus.Failed)
                            {
                                <span class="text-danger small">Giao dịch không còn hiệu lực</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
