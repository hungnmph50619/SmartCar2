@model SmartCar.Web.ViewModels.VehicleDocumentViewModel
@using SmartCar.Domain.Enums
@{
    ViewData["Title"] = "Thêm giấy tờ xe";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card card-body shadow-sm">
            <h1 class="h3 mb-3">Thêm giấy tờ pháp lý xe</h1>
            <form asp-action="Create" method="post" class="row g-3">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="col-md-6">
                    <label class="form-label">Xe</label>
                    <select asp-for="VehicleId" asp-items="ViewBag.Vehicles" class="form-select"></select>
                    <span asp-validation-for="VehicleId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Loại giấy tờ</label>
                    <select asp-for="DocumentType" asp-items="Html.GetEnumSelectList<VehicleDocumentType>()" class="form-select"></select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Số giấy tờ</label>
                    <input asp-for="DocumentNumber" class="form-control" />
                    <span asp-validation-for="DocumentNumber" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Ngày cấp</label>
                    <input asp-for="IssuedDate" type="date" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Ngày hết hạn</label>
                    <input asp-for="ExpiryDate" type="date" class="form-control" />
                </div>
                <div class="col-12">
                    <label class="form-label">Đường dẫn ảnh/tệp</label>
                    <input asp-for="ImagePath" class="form-control" placeholder="/uploads/documents/... hoặc URL lưu trữ" />
                </div>
                <div class="col-12">
                    <label class="form-label">Ghi chú</label>
                    <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                </div>
                <div class="col-12 d-flex gap-2">
                    <button class="btn btn-primary" type="submit">Lưu giấy tờ</button>
                    <a class="btn btn-outline-secondary" asp-action="Index" asp-route-vehicleId="@Model.VehicleId">Quay lại</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
