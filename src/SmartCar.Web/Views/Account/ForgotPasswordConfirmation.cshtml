@{
    ViewData["Title"] = "Yêu cầu đặt lại mật khẩu";
}

<div class="row justify-content-center py-3">
    <div class="col-md-7 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-lg-5 text-center">
                <h1 class="h3 mb-3">Kiểm tra email của bạn</h1>

                <p class="text-muted">
                    Nếu email bạn nhập tồn tại trong hệ thống, SmartCar đã gửi một liên kết đặt lại mật khẩu đến địa chỉ đó.
                </p>

                <div class="alert alert-info small text-start" role="alert">
                    Liên kết có hiệu lực trong 30 phút. Nếu chưa thấy email, hãy kiểm tra thư rác hoặc thử lại sau ít phút.
                </div>

                <a asp-action="ForgotPassword" class="btn btn-outline-primary w-100 py-2 fw-semibold">
                    Gửi lại liên kết
                </a>

                <p class="mt-3 mb-0">
                    <a asp-action="Login" class="text-decoration-none">Quay lại đăng nhập</a>
                </p>
            </div>
        </div>
    </div>
</div>
