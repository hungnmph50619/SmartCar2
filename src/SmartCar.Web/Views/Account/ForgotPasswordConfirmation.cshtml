@{
    ViewData["Title"] = "Yêu cầu đặt lại mật khẩu";
    var developmentResetUrl = ViewData["DevelopmentResetUrl"] as string;
}

<div class="row justify-content-center py-3">
    <div class="col-md-7 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-lg-5 text-center">
                <h1 class="h3 mb-3">Yêu cầu đã được tiếp nhận</h1>

                @if (!string.IsNullOrWhiteSpace(developmentResetUrl))
                {
                    <p class="text-muted">
                        Email đã được xác minh trong môi trường demo. Nhấn nút bên dưới để đặt lại mật khẩu.
                    </p>
                    <div class="alert alert-warning small text-start" role="alert">
                        Liên kết này chỉ được hiển thị khi ứng dụng chạy ở môi trường Development. Khi triển khai thực tế, cần gửi liên kết qua email.
                    </div>
                    <a href="@developmentResetUrl" class="btn btn-primary w-100 py-2 fw-semibold">
                        Đặt lại mật khẩu
                    </a>
                }
                else
                {
                    <p class="text-muted mb-0">
                        Nếu email hợp lệ, vui lòng liên hệ quản trị viên SmartCar để được hỗ trợ đặt lại mật khẩu.
                    </p>
                }

                <p class="mt-3 mb-0">
                    <a asp-action="Login" class="text-decoration-none">Quay lại đăng nhập</a>
                </p>
            </div>
        </div>
    </div>
</div>
