@model SmartCar.Web.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<style>
    .forgot-password-form .validation-summary-valid,
    .forgot-password-form .field-validation-valid {
        display: none;
    }

    .forgot-password-form .input-validation-error {
        border-color: #dc3545;
        box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.08);
    }
</style>

<div class="row justify-content-center py-3">
    <div class="col-md-7 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-lg-5">
                <div class="text-center mb-4">
                    <h1 class="h3 mb-2">Khôi phục mật khẩu</h1>
                    <p class="text-muted mb-0">
                        Nhập email đã đăng ký. SmartCar sẽ gửi liên kết đặt lại mật khẩu đến email của bạn.
                    </p>
                </div>

                <div class="alert alert-info small" role="alert">
                    Liên kết đặt lại mật khẩu có hiệu lực trong 30 phút và chỉ nên được sử dụng bởi chính bạn.
                </div>

                <form asp-action="ForgotPassword" method="post" class="forgot-password-form" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3" role="alert"></div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label fw-semibold">
                            Email <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Email"
                               class="form-control"
                               placeholder="Nhập địa chỉ email"
                               autocomplete="email"
                               autofocus />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                        Gửi liên kết khôi phục
                    </button>
                </form>

                <p class="text-center mt-3 mb-0">
                    <a asp-action="Login" class="text-decoration-none">Quay lại đăng nhập</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
