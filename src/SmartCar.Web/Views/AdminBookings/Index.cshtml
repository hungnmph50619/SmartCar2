@model IReadOnlyList<SmartCar.Application.Features.Bookings.BookingListItemDto>
@using SmartCar.Domain.Enums
@{
    ViewData["Title"] = "Quản lý đơn thuê";
    var selectedStatus = ViewBag.Status as BookingStatus?;
    var selectedQuery = ViewBag.Query as string ?? string.Empty;
    var pendingConfirmationCount = Model.Count(item => item.Status == BookingStatus.PendingConfirmation);

    static string StatusBadgeClass(BookingStatus status) => status switch
    {
        BookingStatus.PendingConfirmation => "bg-warning text-dark",
        BookingStatus.Rejected => "bg-danger",
        BookingStatus.PendingPayment => "bg-info text-dark",
        BookingStatus.Paid => "bg-primary",
        BookingStatus.ReadyForPickup => "bg-info text-dark",
        BookingStatus.Rented => "bg-primary",
        BookingStatus.PendingInspection => "bg-warning text-dark",
        BookingStatus.Completed => "bg-success",
        BookingStatus.Cancelled => "bg-danger",
        BookingStatus.NoShow => "bg-dark",
        _ => "bg-secondary"
    };

    static bool IsFinished(BookingStatus status) =>
        status is BookingStatus.Rejected or BookingStatus.Completed or BookingStatus.Cancelled or BookingStatus.NoShow;
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h1 class="h3 mb-1">Quản lý đơn thuê</h1>
        <p class="text-muted mb-0">Xác nhận đơn mới và theo dõi trạng thái thuê xe.</p>
    </div>

    @if (pendingConfirmationCount > 0)
    {
        <span class="badge bg-warning text-dark fs-6">
            @pendingConfirmationCount đơn mới
        </span>
    }
</div>

<form method="get" class="row g-2 align-items-center mb-3">
    <div class="col-lg-4 col-md-5">
        <select name="status" class="form-select" aria-label="Lọc theo trạng thái đơn">
            <option value="">Tất cả trạng thái</option>
            @foreach (var status in Enum.GetValues<BookingStatus>())
            {
                <option value="@status" selected="@(selectedStatus == status)">@status.ToVietnamese()</option>
            }
        </select>
    </div>
    <div class="col-lg-5 col-md-7">
        <input type="search"
               name="query"
               value="@selectedQuery"
               class="form-control"
               placeholder="Mã đơn, khách, SĐT hoặc biển số"
               aria-label="Tìm đơn thuê" />
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-primary" type="submit">Lọc</button>
    </div>
    @if (selectedStatus.HasValue || !string.IsNullOrWhiteSpace(selectedQuery))
    {
        <div class="col-auto">
            <a class="btn btn-link text-decoration-none" asp-action="Index">Xóa lọc</a>
        </div>
    }
</form>

<div class="table-responsive">
    <table class="table table-bordered table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Mã</th>
                <th>Khách hàng</th>
                <th>Xe</th>
                <th>Thời gian</th>
                <th class="text-end">Tổng</th>
                <th>Trạng thái</th>
                <th class="text-center">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">
                        Không có đơn phù hợp.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var booking in Model)
                {
                    var isFinished = IsFinished(booking.Status);
                    var isPendingConfirmation = booking.Status == BookingStatus.PendingConfirmation;

                    <tr class="@(isPendingConfirmation ? "table-warning" : string.Empty)">
                        <td class="fw-semibold">#@booking.BookingId</td>
                        <td>
                            <strong>@booking.CustomerName</strong>
                            @if (!string.IsNullOrWhiteSpace(booking.CustomerPhone))
                            {
                                <div class="mt-1">
                                    <a href="tel:@booking.CustomerPhone" class="text-decoration-none small">☎ @booking.CustomerPhone</a>
                                </div>
                            }
                        </td>
                        <td>
                            @booking.VehicleName<br />
                            <small class="text-muted">@booking.LicensePlate</small>
                        </td>
                        <td>
                            @booking.PickupDate.ToString("dd/MM HH:mm")
                            <span class="text-muted">→ @booking.ReturnDate.ToString("dd/MM HH:mm")</span>
                            <div class="small mt-1 @(booking.PickupMethod == VehiclePickupMethod.Delivery ? "text-primary fw-semibold" : "text-muted")">
                                @(booking.PickupMethod == VehiclePickupMethod.Delivery ? "Giao tận nơi" : "Nhận tại cửa hàng")
                            </div>
                        </td>
                        <td class="text-end fw-semibold text-nowrap">@booking.GrandTotalAmount.ToString("N0") đ</td>
                        <td>
                            <span class="badge @StatusBadgeClass(booking.Status)">@booking.Status.ToVietnamese()</span>
                        </td>
                        <td class="text-center text-nowrap">
                            @if (isPendingConfirmation)
                            {
                                <a class="btn btn-sm btn-success"
                                   asp-controller="AdminBookingReview"
                                   asp-action="Index"
                                   asp-route-id="@booking.BookingId">
                                    Xác nhận
                                </a>
                            }
                            else
                            {
                                <a class="btn btn-sm @(isFinished ? "btn-outline-primary" : "btn-primary")"
                                   asp-action="Details"
                                   asp-route-id="@booking.BookingId">
                                    @(isFinished ? "Xem" : "Xử lý")
                                </a>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
