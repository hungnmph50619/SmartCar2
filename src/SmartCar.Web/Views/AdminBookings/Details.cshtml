@model SmartCar.Application.Features.Bookings.BookingDetailsDto
@using SmartCar.Domain.Constants
@using SmartCar.Domain.Enums
@{
    ViewData["Title"] = $"Xử lý đơn #{Model.BookingId}";
    var canAdminCancel = Model.Status is BookingStatus.PendingConfirmation or BookingStatus.PendingPayment or BookingStatus.Paid or BookingStatus.ReadyForPickup;
    var canMarkNoShow = (Model.Status is BookingStatus.Paid or BookingStatus.ReadyForPickup) &&
        DateTime.Now >= Model.PickupDate.AddMinutes(30);
    var canEditLocations = Model.Status is BookingStatus.PendingConfirmation or BookingStatus.PendingPayment;

    var customerCreatedAt = ViewBag.CustomerCreatedAt is DateTime createdAtValue
        ? createdAtValue
        : (DateTime?)null;
    var customerTotalBookingCount = ViewBag.CustomerTotalBookingCount is int totalValue ? totalValue : 0;
    var customerCompletedBookingCount = ViewBag.CustomerCompletedBookingCount is int completedValue ? completedValue : 0;
    var customerCancelledBookingCount = ViewBag.CustomerCancelledBookingCount is int cancelledValue ? cancelledValue : 0;
    var customerNoShowCount = ViewBag.CustomerNoShowCount is int noShowValue ? noShowValue : 0;
    var citizenIdentityVerified = ViewBag.CitizenIdentityVerified is bool citizenValue && citizenValue;
    var drivingLicenseVerified = ViewBag.DrivingLicenseVerified is bool licenseValue && licenseValue;
    var customerKycVerified = ViewBag.CustomerKycVerified is bool kycValue && kycValue;

    var pickupLocationText = string.IsNullOrWhiteSpace(Model.PickupLocation)
        ? "Chưa cập nhật địa điểm nhận xe"
        : Model.PickupLocation;
    var returnLocationText = string.IsNullOrWhiteSpace(Model.ReturnLocation)
        ? "Chưa cập nhật địa điểm trả xe"
        : Model.ReturnLocation;
    var isHomeDelivery = Model.PickupMethod == DeliveryConstants.HomeDelivery;
    var pickupMethodLabel = isHomeDelivery ? "SmartCar giao xe tận nơi" : "Khách tự đến SmartCar";
    var pickupLegFee = Math.Round(Model.PickupDeliveryDistanceKm * Model.DeliveryRatePerKm, 0);
    var returnLegFee = Math.Round(Model.ReturnCollectionDistanceKm * Model.DeliveryRatePerKm, 0);
    var pickupMapUrl = $"https://www.google.com/maps?q={Uri.EscapeDataString(pickupLocationText)}&output=embed";
    var returnMapUrl = $"https://www.google.com/maps?q={Uri.EscapeDataString(returnLocationText)}&output=embed";
    var pickupDirectionsUrl = isHomeDelivery
        ? $"https://www.google.com/maps/dir/?api=1&origin={Uri.EscapeDataString(DeliveryConstants.SmartCarMapQuery)}&destination={Uri.EscapeDataString(pickupLocationText)}"
        : $"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(pickupLocationText)}";
    var returnDirectionsUrl = Model.ReturnCollectionDistanceKm > 0
        ? $"https://www.google.com/maps/dir/?api=1&origin={Uri.EscapeDataString(DeliveryConstants.SmartCarMapQuery)}&destination={Uri.EscapeDataString(returnLocationText)}"
        : $"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(returnLocationText)}";

    var nextAction = Model.Status switch
    {
        BookingStatus.PendingConfirmation => (
            "Kiểm tra và quyết định đơn",
            "Đối chiếu hồ sơ, lịch xe, địa chỉ giao nhận và chi phí. Sau đó xác nhận hoặc nhập lý do từ chối.",
            "warning"),
        BookingStatus.PendingPayment => (
            "Chờ khách hàng thanh toán",
            "Đơn đã được xác nhận. Tiền thuê và phí giao nhận đã được chốt; chưa chuẩn bị giao xe cho đến khi thanh toán được ghi nhận.",
            "primary"),
        BookingStatus.Paid => (
            "Kiểm tra và chuẩn bị xe",
            "Khách hàng đã thanh toán. Kiểm tra xe, giấy tờ xe và đánh dấu sẵn sàng bàn giao.",
            "success"),
        BookingStatus.ReadyForPickup => (
            "Lập biên bản bàn giao",
            "Xe đã sẵn sàng. Kiểm tra người nhận, số km, nhiên liệu, tình trạng xe và phụ kiện trước khi giao.",
            "success"),
        BookingStatus.Rented => (
            "Theo dõi chuyến thuê",
            "Xử lý yêu cầu gia hạn nếu có. Khi khách trả xe, có thể tiếp nhận đúng hạn hoặc tiếp nhận trả sớm và lập biên bản trả xe.",
            "primary"),
        BookingStatus.PendingInspection => (
            "Kiểm tra xe sau khi trả",
            "Đối chiếu biên bản giao–trả, thêm phụ phí có căn cứ và chỉ hoàn tất khi các khoản cần thanh toán đã xử lý.",
            "warning"),
        BookingStatus.Completed => (
            "Đơn đã hoàn tất",
            "Không còn hành động vận hành bắt buộc. Dữ liệu được giữ để báo cáo và truy vết.",
            "success"),
        BookingStatus.Cancelled or BookingStatus.Rejected or BookingStatus.NoShow => (
            "Đơn đã kết thúc",
            "Kiểm tra lý do, người thực hiện và khoản hoàn tiền trong phần thông tin bên dưới.",
            "danger"),
        _ => (
            "Theo dõi trạng thái đơn",
            "Kiểm tra thông tin đơn và chỉ thực hiện hành động phù hợp với trạng thái hiện tại.",
            "secondary")
    };
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-3">
    <div>
        <h1 class="h3 mb-1">Xử lý đơn #@Model.BookingId</h1>
        <span class="badge bg-@nextAction.Item3">@Model.Status.ToVietnamese()</span>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">Danh sách đơn</a>
</div>

<div class="alert alert-@nextAction.Item3 shadow-sm mb-4" role="status">
    <div class="text-uppercase small fw-semibold mb-1">Hành động tiếp theo</div>
    <h2 class="h5 mb-2">@nextAction.Item1</h2>
    <p class="mb-0">@nextAction.Item2</p>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card card-body shadow-sm mb-4">
            <h2 class="h5">Thông tin thuê xe</h2>
            <div class="row">
                <div class="col-md-6"><strong>Khách hàng:</strong> @Model.CustomerName<br /><strong>SĐT:</strong> @Model.CustomerPhone</div>
                <div class="col-md-6"><strong>Xe:</strong> @Model.VehicleName<br /><strong>Biển số:</strong> @Model.LicensePlate</div>
            </div>
            <hr />
            <div><strong>Nhận xe:</strong> @Model.PickupDate.ToString("dd/MM/yyyy HH:mm")</div>
            <div><strong>Hình thức nhận:</strong> @pickupMethodLabel</div>
            <div><strong>Địa điểm nhận:</strong> @pickupLocationText</div>
            <div class="mt-1"><strong>Trả xe:</strong> @Model.ReturnDate.ToString("dd/MM/yyyy HH:mm")</div>
            <div><strong>Địa điểm trả:</strong> @returnLocationText</div>
            @if (Model.HasReturn && !string.IsNullOrWhiteSpace(Model.ActualReturnLocation))
            {
                <div class="mt-1 text-success"><strong>Địa điểm trả thực tế:</strong> @Model.ActualReturnLocation</div>
            }
            <div class="mt-1"><strong>Số ngày:</strong> @Model.NumberOfDays</div>

            <div class="bg-light rounded-3 p-3 mt-3">
                <div class="fw-semibold mb-2">Chi phí giao nhận đã tính</div>
                @if (Model.PickupDeliveryDistanceKm > 0)
                {
                    <div class="d-flex justify-content-between small"><span>Quãng đường giao xe</span><strong>@Model.PickupDeliveryDistanceKm.ToString("N1") km</strong></div>
                }
                @if (Model.ReturnCollectionDistanceKm > 0)
                {
                    <div class="d-flex justify-content-between small"><span>Quãng đường đến nhận lại xe</span><strong>@Model.ReturnCollectionDistanceKm.ToString("N1") km</strong></div>
                }
                <div class="d-flex justify-content-between small"><span>Đơn giá giao nhận</span><strong>@Model.DeliveryRatePerKm.ToString("N0") đ/km/lượt</strong></div>
                <div class="d-flex justify-content-between mt-2"><span>Phí giao nhận</span><strong class="@(Model.DeliveryFee > 0 ? "text-primary" : "text-success")">@(Model.DeliveryFee > 0 ? $"{Model.DeliveryFee:N0} đ" : "Miễn phí")</strong></div>
            </div>

            @if (canEditLocations)
            {
                <form asp-action="UpdateLocations"
                      method="post"
                      class="row g-2 mt-3 pt-3 border-top"
                      data-loading-form
                      data-confirm="Cập nhật địa điểm giao nhận? Hệ thống sẽ tính lại quãng đường, phí giao nhận và số tiền khách cần thanh toán.">
                    <input type="hidden" name="bookingId" value="@Model.BookingId" />
                    <div class="col-md-5">
                        <label class="form-label">Địa điểm nhận xe</label>
                        <input name="pickupLocation"
                               class="form-control"
                               maxlength="250"
                               required
                               value="@Model.PickupLocation"
                               readonly="@(Model.PickupMethod == DeliveryConstants.SelfPickup ? "readonly" : null)"
                               placeholder="Nhập địa điểm nhận xe" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">Địa điểm trả xe</label>
                        <input name="returnLocation"
                               class="form-control"
                               maxlength="250"
                               required
                               value="@Model.ReturnLocation"
                               placeholder="Nhập địa điểm trả xe" />
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button class="btn btn-outline-primary w-100"
                                type="submit"
                                data-loading-text="Đang tính lại...">Cập nhật</button>
                    </div>
                    <div class="col-12"><div class="form-text">Chỉ thay đổi trước khi khách thanh toán; hệ thống sẽ tính lại phí giao nhận theo tuyến đường.</div></div>
                </form>
            }

            @if (!string.IsNullOrWhiteSpace(Model.CancelReason))
            {
                <div class="alert alert-danger mt-3 mb-0">
                    <strong>Lý do:</strong> @Model.CancelReason<br />
                    <strong>Người hủy:</strong> @Model.CancelledBy.ToVietnameseActor()<br />
                    <strong>Tiền hoàn:</strong> @Model.RefundAmount.ToString("N0") đ<br />
                    @Model.RefundReason
                </div>
            }
        </div>

        <div class="card shadow-sm mb-4 border-0 overflow-hidden">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3">
                    <div>
                        <div class="text-uppercase small text-muted fw-semibold">Vận hành giao nhận</div>
                        <h2 class="h4 mb-1">Kế hoạch giao xe & nhận lại xe</h2>
                        <p class="text-muted small mb-0">Admin dùng khối này để biết phải đi đâu, khi nào cần liên hệ khách và bước tiếp theo tại điểm giao nhận.</p>
                    </div>
                    <span class="badge @(Model.RentalPaid ? "bg-success" : "bg-secondary") px-3 py-2">
                        @(Model.RentalPaid ? "Đã thanh toán" : "Chưa thanh toán")
                    </span>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="border rounded-3 h-100 overflow-hidden">
                            <div class="p-3">
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                    <div>
                                        <div class="small text-muted text-uppercase fw-semibold">1. Giao xe</div>
                                        <h3 class="h6 mb-0">@pickupMethodLabel</h3>
                                    </div>
                                    <span class="badge @(isHomeDelivery ? "bg-primary" : "bg-success")">@(isHomeDelivery ? "Admin đi giao" : "Khách tự đến")</span>
                                </div>

                                <div class="small text-muted">Thời gian</div>
                                <div class="fw-semibold mb-2">@Model.PickupDate.ToString("HH:mm - dd/MM/yyyy")</div>

                                <div class="small text-muted">Địa điểm</div>
                                <div class="fw-semibold mb-2">@pickupLocationText</div>

                                @if (isHomeDelivery)
                                {
                                    <div class="bg-light rounded-3 p-2 small mb-2">
                                        <div class="d-flex justify-content-between"><span>Quãng đường</span><strong>@Model.PickupDeliveryDistanceKm.ToString("N1") km</strong></div>
                                        <div class="d-flex justify-content-between"><span>Phí lượt giao</span><strong>@pickupLegFee.ToString("N0") đ</strong></div>
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-success py-2 small mb-2">Khách tự đến điểm SmartCar; Admin không phải di chuyển để giao xe.</div>
                                }

                                <div class="d-flex gap-2 flex-wrap">
                                    @if (!string.IsNullOrWhiteSpace(Model.CustomerPhone))
                                    {
                                        <a class="btn btn-sm btn-outline-success" href="tel:@Model.CustomerPhone">Gọi khách</a>
                                    }
                                    <a class="btn btn-sm btn-outline-primary" href="@pickupDirectionsUrl" target="_blank" rel="noopener noreferrer">@(isHomeDelivery ? "Mở chỉ đường" : "Xem điểm nhận")</a>
                                    @if (Model.Status == BookingStatus.ReadyForPickup)
                                    {
                                        <a class="btn btn-sm btn-primary" asp-controller="Handovers" asp-action="Create" asp-route-bookingId="@Model.BookingId">Lập biên bản giao xe</a>
                                    }
                                </div>
                            </div>

                            <div class="ratio ratio-16x9 border-top">
                                <iframe title="Bản đồ điểm giao xe" src="@pickupMapUrl" loading="lazy" referrerpolicy="no-referrer-when-downgrade" style="border:0" allowfullscreen></iframe>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="border rounded-3 h-100 overflow-hidden">
                            <div class="p-3">
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                    <div>
                                        <div class="small text-muted text-uppercase fw-semibold">2. Nhận lại xe</div>
                                        <h3 class="h6 mb-0">Điểm trả đã thỏa thuận</h3>
                                    </div>
                                    <span class="badge @(Model.ReturnCollectionDistanceKm > 0 ? "bg-primary" : "bg-success")">@(Model.ReturnCollectionDistanceKm > 0 ? "Admin đi nhận" : "Khách trả tại SmartCar")</span>
                                </div>

                                <div class="small text-muted">Thời gian dự kiến</div>
                                <div class="fw-semibold mb-2">@Model.ReturnDate.ToString("HH:mm - dd/MM/yyyy")</div>

                                <div class="small text-muted">Địa điểm</div>
                                <div class="fw-semibold mb-2">@returnLocationText</div>

                                @if (Model.ReturnCollectionDistanceKm > 0)
                                {
                                    <div class="bg-light rounded-3 p-2 small mb-2">
                                        <div class="d-flex justify-content-between"><span>Quãng đường</span><strong>@Model.ReturnCollectionDistanceKm.ToString("N1") km</strong></div>
                                        <div class="d-flex justify-content-between"><span>Phí lượt nhận lại</span><strong>@returnLegFee.ToString("N0") đ</strong></div>
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-success py-2 small mb-2">Khách mang xe về SmartCar; không phát sinh chuyến đi nhận lại xe.</div>
                                }

                                <div class="d-flex gap-2 flex-wrap">
                                    @if (!string.IsNullOrWhiteSpace(Model.CustomerPhone))
                                    {
                                        <a class="btn btn-sm btn-outline-success" href="tel:@Model.CustomerPhone">Gọi khách</a>
                                    }
                                    <a class="btn btn-sm btn-outline-primary" href="@returnDirectionsUrl" target="_blank" rel="noopener noreferrer">@(Model.ReturnCollectionDistanceKm > 0 ? "Mở chỉ đường" : "Xem điểm trả")</a>
                                    @if (Model.Status == BookingStatus.Rented)
                                    {
                                        <a class="btn btn-sm btn-primary" asp-controller="Returns" asp-action="Create" asp-route-bookingId="@Model.BookingId">@(DateTime.Now < Model.ReturnDate ? "Tiếp nhận trả sớm" : "Lập biên bản trả xe")</a>
                                    }
                                </div>
                            </div>

                            <div class="ratio ratio-16x9 border-top">
                                <iframe title="Bản đồ điểm nhận lại xe" src="@returnMapUrl" loading="lazy" referrerpolicy="no-referrer-when-downgrade" style="border:0" allowfullscreen></iframe>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="border rounded-3 p-3 mt-3 bg-light">
                    <div class="fw-semibold mb-2">Quy trình Admin tại thời điểm giao xe</div>
                    <div class="row g-2 small">
                        <div class="col-md-6"><strong>Trước khi đi:</strong> kiểm tra đơn đã thanh toán, gọi/nhắn khách để nhắc lại giờ và địa điểm.</div>
                        <div class="col-md-6"><strong>Tại điểm giao:</strong> gặp đúng người thuê, đối chiếu giấy tờ và lập biên bản trước khi giao chìa khóa.</div>
                        <div class="col-md-6"><strong>Nếu khách đến muộn:</strong> liên hệ và ghi nhận tình huống; không tự động kết thúc đơn khi khách có phản hồi và hai bên thống nhất chờ.</div>
                        <div class="col-md-6"><strong>NoShow (Khách không đến nhận):</strong> với giao tận nơi, chỉ ghi nhận sau khi Admin đã đến đúng điểm giao, đúng thời gian và không liên hệ được khách theo quy định.</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card card-body shadow-sm mb-4 border-0">
            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3">
                <div>
                    <div class="text-uppercase small text-muted fw-semibold">Kiểm soát khách thuê</div>
                    <h2 class="h5 mb-1">Hồ sơ xác minh giấy tờ & độ tin cậy khách hàng</h2>
                    <p class="text-muted small mb-0">Xác minh giấy tờ gồm 2 bước: đối chiếu CCCD và kiểm tra giấy phép lái xe.</p>
                </div>
                <span class="badge @(customerKycVerified ? "bg-success" : "bg-danger") px-3 py-2">
                    @(customerKycVerified ? "Hồ sơ đã xác minh" : "Hồ sơ chưa đủ")
                </span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <div class="border rounded p-3 h-100">
                        <div class="small text-muted">Danh tính CCCD</div>
                        <strong class="@(citizenIdentityVerified ? "text-success" : "text-danger")">
                            @(citizenIdentityVerified ? "✓ Đã xác minh thông tin + 2 ảnh" : "✕ Chưa hợp lệ")
                        </strong>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="border rounded p-3 h-100">
                        <div class="small text-muted">GPLX đến ngày trả</div>
                        <strong class="@(drivingLicenseVerified ? "text-success" : "text-danger")">
                            @(drivingLicenseVerified ? "✓ Đã xác minh và còn hiệu lực" : "✕ Chưa hợp lệ")
                        </strong>
                    </div>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-6 col-md-3"><div class="bg-light rounded p-3 h-100"><div class="small text-muted">Tổng đơn</div><div class="fs-4 fw-bold">@customerTotalBookingCount</div></div></div>
                <div class="col-6 col-md-3"><div class="bg-light rounded p-3 h-100"><div class="small text-muted">Hoàn thành</div><div class="fs-4 fw-bold text-success">@customerCompletedBookingCount</div></div></div>
                <div class="col-6 col-md-3"><div class="bg-light rounded p-3 h-100"><div class="small text-muted">Hủy / bị từ chối</div><div class="fs-4 fw-bold">@customerCancelledBookingCount</div></div></div>
                <div class="col-6 col-md-3"><div class="bg-light rounded p-3 h-100"><div class="small text-muted">Không đến nhận xe</div><div class="fs-4 fw-bold @(customerNoShowCount > 0 ? "text-danger" : string.Empty)">@customerNoShowCount</div></div></div>
            </div>

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3 pt-3 border-top">
                <div class="small text-muted">Thành viên từ: <strong>@(customerCreatedAt.HasValue ? customerCreatedAt.Value.ToLocalTime().ToString("dd/MM/yyyy") : "Không xác định")</strong></div>
                <a class="btn btn-sm btn-outline-primary" asp-controller="AdminCustomers" asp-action="Details" asp-route-id="@Model.CustomerId" asp-route-tab="documents">Xem và đối chiếu giấy tờ</a>
            </div>
        </div>

        @if (Model.Status == BookingStatus.PendingConfirmation)
        {
            <div class="card card-body shadow-sm mb-4">
                <h2 class="h5">Xác nhận yêu cầu</h2>
                <p class="text-muted">Chỉ xác nhận sau khi danh tính CCCD, GPLX, lịch xe, địa điểm và phí giao nhận đều hợp lệ.</p>
                <form asp-action="Confirm" method="post" class="mb-3" data-loading-form data-confirm="Xác nhận đơn thuê này và chuyển khách hàng sang bước thanh toán?">
                    <input type="hidden" name="id" value="@Model.BookingId" />
                    <button class="btn btn-success" type="submit" data-loading-text="Đang xác nhận...">Xác nhận đơn</button>
                </form>
                <form asp-action="Reject" method="post" data-loading-form data-confirm="Từ chối đơn và gửi lý do cho khách hàng?">
                    <input type="hidden" name="BookingId" value="@Model.BookingId" />
                    <label class="form-label">Lý do không duyệt</label>
                    <textarea name="Reason" maxlength="500" class="form-control mb-2" required placeholder="Nêu rõ lý do để khách hàng biết cách xử lý tiếp theo."></textarea>
                    <button class="btn btn-outline-danger" type="submit" data-loading-text="Đang từ chối...">Không duyệt đơn</button>
                </form>
            </div>
        }

        @if (Model.Status == BookingStatus.Paid)
        {
            <div class="card card-body shadow-sm mb-4">
                <h2 class="h5">Chuẩn bị giao xe</h2>
                <p>Khách hàng đã thanh toán. Kiểm tra xe, gọi/nhắn khách để nhắc lại giờ và địa điểm, sau đó đánh dấu xe sẵn sàng bàn giao.</p>
                <form asp-action="MarkReady" method="post" data-loading-form data-confirm="Xác nhận xe đã được kiểm tra và sẵn sàng bàn giao?">
                    <input type="hidden" name="id" value="@Model.BookingId" />
                    <button class="btn btn-primary" type="submit" data-loading-text="Đang cập nhật...">Xe đã sẵn sàng</button>
                </form>
            </div>
        }

        @if (Model.Status == BookingStatus.ReadyForPickup)
        {
            <div class="card card-body shadow-sm mb-4">
                <h2 class="h5">Bàn giao xe</h2>
                <p class="text-muted">Biên bản cần ghi số km, nhiên liệu, tình trạng xe, phụ kiện và ảnh thực tế. Chỉ chuyển sang Đang thuê sau khi giao xe thực tế và khách xác nhận.</p>
                <div class="mb-2"><strong>Điểm giao đã hẹn:</strong> @pickupLocationText</div>
                <a class="btn btn-primary" asp-controller="Handovers" asp-action="Create" asp-route-bookingId="@Model.BookingId">Lập biên bản giao xe</a>
            </div>
        }

        @if (canMarkNoShow)
        {
            <div class="card card-body border-warning shadow-sm mb-4">
                <h2 class="h5">Khách không đến nhận xe</h2>
                @if (isHomeDelivery)
                {
                    <p>Đã quá giờ nhận xe 30 phút. Với đơn giao tận nơi, chỉ ghi nhận NoShow (Khách không đến nhận) khi Admin đã thực sự đến đúng địa điểm giao, đã gọi/nhắn khách và không thể tiếp tục bàn giao.</p>
                }
                else
                {
                    <p>Đã quá giờ nhận xe 30 phút. Hãy gọi/nhắn khách trước khi ghi nhận NoShow (Khách không đến nhận).</p>
                }
                <form asp-controller="AdminBookingOperations" asp-action="MarkNoShow" method="post" data-loading-form data-confirm="Bạn xác nhận đã kiểm tra tình huống thực tế và muốn ghi nhận khách không đến nhận xe? Đơn sẽ kết thúc và không hoàn tiền.">
                    <input type="hidden" name="bookingId" value="@Model.BookingId" />
                    <button class="btn btn-warning" type="submit" data-loading-text="Đang ghi nhận...">Ghi nhận khách không đến</button>
                </form>
            </div>
        }

        @if (Model.Status == BookingStatus.Rented)
        {
            <div class="card card-body shadow-sm mb-4">
                <h2 class="h5">Đơn đang thuê</h2>
                <div class="mb-2"><strong>Điểm trả đã hẹn:</strong> @returnLocationText</div>
                @if (DateTime.Now < Model.ReturnDate)
                {
                    <div class="alert alert-info py-2">Chưa đến giờ trả dự kiến <strong>@Model.ReturnDate.ToString("dd/MM/yyyy HH:mm")</strong>. Nếu khách đã thực tế mang xe tới và hai bên đồng ý kết thúc sử dụng sớm, có thể tiếp nhận xe ngay.</div>
                }
                <div class="d-flex gap-2 flex-wrap">
                    <a class="btn btn-primary" asp-controller="Returns" asp-action="Create" asp-route-bookingId="@Model.BookingId">@(DateTime.Now < Model.ReturnDate ? "Tiếp nhận xe trả sớm" : "Lập biên bản trả xe")</a>
                    <a class="btn btn-outline-primary" asp-controller="AdminExtensions" asp-action="Index">Xử lý gia hạn</a>
                </div>
                @if (Model.Extensions.Count > 0)
                {
                    <div class="table-responsive"><table class="table mt-3 mb-0">
                    @foreach (var extension in Model.Extensions)
                    {
                        <tr><td>Đến @extension.RequestedReturnDate.ToString("dd/MM/yyyy HH:mm")</td><td>@extension.AdditionalAmount.ToString("N0") đ</td><td><span class="badge bg-secondary">@extension.Status.ToVietnamese()</span></td></tr>
                    }
                    </table></div>
                }
            </div>
        }

        @if (Model.Status == BookingStatus.PendingInspection)
        {
            <div class="card card-body shadow-sm mb-4">
                <h2 class="h5">Phụ phí sau khi trả xe</h2>
                <form asp-controller="Returns" asp-action="AddCharge" method="post" class="row g-2 mb-3" data-loading-form>
                    <input type="hidden" name="BookingId" value="@Model.BookingId" />
                    <div class="col-md-3"><select name="ChargeType" class="form-select" aria-label="Loại phụ phí">@foreach (var type in Enum.GetValues<AdditionalChargeType>()) { <option value="@type">@type.ToVietnamese()</option> }</select></div>
                    <div class="col-md-5"><input name="Description" maxlength="250" class="form-control" placeholder="Mô tả và căn cứ phụ phí" required /></div>
                    <div class="col-md-2"><input name="Amount" type="number" min="1" class="form-control" placeholder="Số tiền" required /></div>
                    <div class="col-md-2"><button class="btn btn-warning w-100" type="submit" data-loading-text="Đang thêm...">Thêm</button></div>
                </form>

                @if (Model.AdditionalCharges.Count > 0)
                {
                    <div class="table-responsive"><table class="table">
                    @foreach (var charge in Model.AdditionalCharges)
                    {
                        <tr><td>@charge.ChargeType.ToVietnamese()</td><td>@charge.Description</td><td class="text-end">@charge.Amount.ToString("N0") đ</td><td class="text-end"><form asp-controller="Returns" asp-action="RemoveCharge" method="post" data-loading-form data-confirm="Xóa khoản phụ phí này khỏi đơn?"><input type="hidden" name="bookingId" value="@Model.BookingId" /><input type="hidden" name="additionalChargeId" value="@charge.AdditionalChargeId" /><button class="btn btn-sm btn-outline-danger" type="submit" data-loading-text="Đang xóa...">Xóa</button></form></td></tr>
                    }
                    </table></div>
                }

                @if (Model.AdditionalAmount > 0 && !Model.AdditionalChargePaid)
                {
                    <div class="alert alert-warning">Đang chờ khách hàng thanh toán phụ phí @Model.AdditionalAmount.ToString("N0") đ.</div>
                }
                else if (Model.AdditionalAmount > 0)
                {
                    <div class="alert alert-success">Khách hàng đã thanh toán toàn bộ phụ phí.</div>
                }

                <hr />
                <h3 class="h6">Hoàn tất kiểm tra</h3>
                <form asp-controller="Returns" asp-action="Complete" method="post" data-loading-form data-confirm="Hoàn tất đơn và cập nhật trạng thái xe? Hãy chắc chắn mọi phụ phí đã được xử lý.">
                    <input type="hidden" name="BookingId" value="@Model.BookingId" />
                    <div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="RequiresMaintenance" value="true" id="requiresMaintenance" /><label class="form-check-label" for="requiresMaintenance">Xe cần bảo trì hoặc sửa chữa sau lượt thuê</label></div>
                    <textarea name="MaintenanceNote" maxlength="1000" class="form-control mb-2" placeholder="Nội dung bảo trì nếu có"></textarea>
                    <button class="btn btn-success" type="submit" data-loading-text="Đang hoàn tất...">Hoàn tất đơn và cập nhật xe</button>
                </form>
            </div>
        }

        @if (canAdminCancel)
        {
            <div class="card card-body border-danger shadow-sm">
                <h2 class="h5 text-danger">Quản trị viên hủy đơn</h2>
                <p class="text-muted">Quản trị viên hủy trước khi giao xe sẽ hoàn 100% số tiền khách hàng đã thanh toán.</p>
                <form asp-controller="AdminBookingOperations" asp-action="Cancel" method="post" class="row g-2" data-loading-form data-confirm="Hủy đơn và hoàn 100% số tiền khách đã thanh toán?">
                    <input type="hidden" name="BookingId" value="@Model.BookingId" />
                    <div class="col-md-9"><input name="Reason" maxlength="500" class="form-control" required placeholder="Lý do Quản trị viên hủy" /></div>
                    <div class="col-md-3"><button class="btn btn-outline-danger w-100" type="submit" data-loading-text="Đang hủy...">Hủy và hoàn tiền</button></div>
                </form>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card card-body shadow-sm sticky-top" style="top:1rem">
            <div class="text-uppercase small text-muted fw-semibold">Chi tiết chi phí</div>
            <h2 class="h5">Tổng tiền</h2>
            <div class="d-flex justify-content-between"><span>Tiền thuê và gia hạn</span><strong>@Model.RentalAmount.ToString("N0") đ</strong></div>
            <div class="d-flex justify-content-between"><span>Phí giao nhận</span><strong class="@(Model.DeliveryFee > 0 ? "text-primary" : "text-success")">@(Model.DeliveryFee > 0 ? $"{Model.DeliveryFee:N0} đ" : "Miễn phí")</strong></div>
            <div class="d-flex justify-content-between"><span>Phụ phí sau trả xe</span><strong>@Model.AdditionalAmount.ToString("N0") đ</strong></div>
            <hr />
            <div class="d-flex justify-content-between fs-5"><span>Tổng cộng</span><strong>@Model.TotalAmount.ToString("N0") đ</strong></div>
            <div class="mt-3">
                <div>Tiền thuê + giao nhận: <strong>@(Model.RentalPaid ? "Đã thanh toán" : "Chưa thanh toán")</strong></div>
                <div>Gia hạn: <strong>@(Model.ExtensionPaid ? "Đã thanh toán hoặc không có" : "Chưa thanh toán")</strong></div>
                <div>Phụ phí: <strong>@(Model.AdditionalChargePaid ? "Đã thanh toán hoặc không có" : "Chưa thanh toán")</strong></div>
            </div>
        </div>
    </div>
</div>
