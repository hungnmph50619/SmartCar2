@model SmartCar.Application.Features.Bookings.BookingDetailsDto
@using SmartCar.Domain.Enums
@{
    ViewData["Title"] = $"Chi tiết đơn #{Model.BookingId}";

    static string StatusBadgeClass(BookingStatus status) => status switch
    {
        BookingStatus.PendingConfirmation => "bg-warning text-dark",
        BookingStatus.Rejected => "bg-danger",
        BookingStatus.PendingPayment => "bg-info text-dark",
        BookingStatus.Paid => "bg-primary",
        BookingStatus.ReadyForPickup => "bg-info text-dark",
        BookingStatus.Rented => "bg-primary",
        BookingStatus.PendingInspection => "bg-warning text-dark",
        BookingStatus.AwaitingRefund => "bg-warning text-dark",
        BookingStatus.Completed => "bg-success",
        BookingStatus.Cancelled => "bg-danger",
        BookingStatus.NoShow => "bg-dark",
        _ => "bg-secondary"
    };

    var isOperational = Model.Status is BookingStatus.PendingPayment
        or BookingStatus.Paid
        or BookingStatus.ReadyForPickup
        or BookingStatus.Rented
        or BookingStatus.PendingInspection
        or BookingStatus.AwaitingRefund;
}

<div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3">
    <div>
        <h1 class="h3 mb-1">Chi tiết đơn #@Model.BookingId</h1>
        <p class="text-muted mb-0">Admin theo dõi và duyệt; không thực hiện nghiệp vụ giao/nhận/trả xe tại màn này.</p>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <span class="badge @StatusBadgeClass(Model.Status) fs-6">@Model.Status.ToVietnamese()</span>
        <a class="btn btn-outline-secondary" asp-action="Index">Danh sách đơn</a>
    </div>
</div>

@if (Model.Status == BookingStatus.PendingConfirmation)
{
    <div class="alert alert-warning d-flex justify-content-between align-items-center gap-3 flex-wrap">
        <div><strong>Đơn đang chờ Admin duyệt.</strong> Hãy kiểm tra hồ sơ/điều kiện thuê trước khi xác nhận hoặc từ chối.</div>
        <a class="btn btn-success" asp-controller="AdminBookingReview" asp-action="Index" asp-route-id="@Model.BookingId">Mở màn duyệt đơn</a>
    </div>
}
else if (isOperational)
{
    <div class="alert alert-info">
        <strong>Đơn đã qua bước duyệt của Admin.</strong> Chuẩn bị xe, đánh dấu sẵn sàng, bàn giao, no-show, nhận trả, kiểm tra xe và thực hiện hoàn tiền sau khi được duyệt thuộc trách nhiệm của <strong>Staff</strong>. Admin chỉ theo dõi và xử lý các yêu cầu cần phê duyệt.
    </div>
}

<div class="row g-3 mb-3">
    <div class="col-lg-7">
        <div class="card card-body shadow-sm h-100">
            <h2 class="h5">Thông tin đơn thuê</h2>
            <dl class="row mb-0">
                <dt class="col-sm-4">Khách hàng</dt>
                <dd class="col-sm-8">@Model.CustomerName @if (!string.IsNullOrWhiteSpace(Model.CustomerPhone)){<span>· @Model.CustomerPhone</span>}</dd>

                <dt class="col-sm-4">Xe</dt>
                <dd class="col-sm-8">@Model.VehicleName · @Model.LicensePlate</dd>

                <dt class="col-sm-4">Nhận xe</dt>
                <dd class="col-sm-8">@Model.PickupDate.ToString("dd/MM/yyyy HH:mm")</dd>

                <dt class="col-sm-4">Trả dự kiến</dt>
                <dd class="col-sm-8">@Model.ReturnDate.ToString("dd/MM/yyyy HH:mm")</dd>

                <dt class="col-sm-4">Hình thức nhận</dt>
                <dd class="col-sm-8">
                    @(Model.PickupMethod == VehiclePickupMethod.Delivery ? "Giao tận nơi" : "Nhận tại cửa hàng")
                    @if (Model.PickupMethod == VehiclePickupMethod.Delivery && !string.IsNullOrWhiteSpace(Model.DeliveryAddress))
                    {
                        <div class="small text-muted">@Model.DeliveryAddress</div>
                    }
                </dd>

                <dt class="col-sm-4">Tạo lúc</dt>
                <dd class="col-sm-8">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
            </dl>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card card-body shadow-sm h-100">
            <h2 class="h5">Tài chính</h2>
            <dl class="row mb-0">
                <dt class="col-7">Tiền thuê</dt>
                <dd class="col-5 text-end">@Model.RentalAmount.ToString("N0") đ</dd>

                <dt class="col-7">Phí giao</dt>
                <dd class="col-5 text-end">@Model.DeliveryFee.ToString("N0") đ</dd>

                <dt class="col-7">Phụ phí</dt>
                <dd class="col-5 text-end">@Model.AdditionalAmount.ToString("N0") đ</dd>

                <dt class="col-7">Tiền cọc</dt>
                <dd class="col-5 text-end">@Model.DepositAmount.ToString("N0") đ</dd>

                <dt class="col-7 border-top pt-2">Tổng gồm cọc</dt>
                <dd class="col-5 text-end border-top pt-2 fw-bold">@Model.GrandTotalAmount.ToString("N0") đ</dd>

                @if (Model.RefundAmount > 0)
                {
                    <dt class="col-7 text-warning">Tổng hoàn dự kiến</dt>
                    <dd class="col-5 text-end text-warning fw-semibold">@Model.RefundAmount.ToString("N0") đ</dd>
                }
            </dl>
        </div>
    </div>
</div>

@if (Model.Status is BookingStatus.Cancelled or BookingStatus.NoShow or BookingStatus.Rejected)
{
    <div class="card card-body shadow-sm mb-3">
        <h2 class="h5">Kết quả xử lý</h2>
        @if (!string.IsNullOrWhiteSpace(Model.CancelReason))
        {
            <div class="mb-2"><strong>Lý do:</strong> @Model.CancelReason</div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.CancelledBy))
        {
            <div class="mb-2"><strong>Người/role xử lý:</strong> @Model.CancelledBy</div>
        }
        @if (Model.CancelledAt.HasValue)
        {
            <div class="mb-2"><strong>Thời điểm:</strong> @Model.CancelledAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.RefundReason))
        {
            <div><strong>Thông tin hoàn tiền:</strong> @Model.RefundReason</div>
        }
    </div>
}

@if (Model.Payments.Count > 0)
{
    <div class="card shadow-sm mb-3">
        <div class="card-body pb-0"><h2 class="h5">Các khoản thanh toán / hoàn tiền</h2></div>
        <div class="table-responsive">
            <table class="table table-striped align-middle mb-0">
                <thead><tr><th>Mã</th><th>Loại</th><th>Phương thức</th><th>Trạng thái</th><th class="text-end">Số tiền</th></tr></thead>
                <tbody>
                @foreach (var payment in Model.Payments)
                {
                    <tr>
                        <td>#@payment.PaymentId</td>
                        <td>@payment.Type</td>
                        <td>@payment.Method</td>
                        <td>@payment.Status</td>
                        <td class="text-end fw-semibold">@payment.Amount.ToString("N0") đ</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

@if (Model.Extensions.Count > 0)
{
    <div class="card shadow-sm">
        <div class="card-body pb-0"><h2 class="h5">Yêu cầu gia hạn liên quan</h2></div>
        <div class="table-responsive">
            <table class="table table-striped align-middle mb-0">
                <thead><tr><th>Mã</th><th>Trả cũ</th><th>Trả mới</th><th>Trạng thái</th><th class="text-end">Phát sinh</th></tr></thead>
                <tbody>
                @foreach (var extension in Model.Extensions)
                {
                    <tr>
                        <td>#@extension.BookingExtensionId</td>
                        <td>@extension.OriginalReturnDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@extension.RequestedReturnDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@extension.Status</td>
                        <td class="text-end">@extension.AdditionalAmount.ToString("N0") đ</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
