@model SmartCar.Application.Features.Bookings.BookingDetailsDto
@using SmartCar.Domain.Enums
@using SmartCar.Web.Services

@{
    ViewData["Title"] = $"Xử lý đơn #{Model.BookingId}";
    var earlyReturn = ViewBag.EarlyReturn as EarlyReturnSnapshot;
    var isBeforeScheduledReturn = DateTime.Now < Model.ReturnDate;
}

@if (Model.Status == BookingStatus.Rented && earlyReturn?.Status == "Pending")
{
    <div class="card card-body shadow-sm mb-4 border-warning">
        <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3">
            <div>
                <div class="text-uppercase small text-warning fw-semibold">Yêu cầu cần xử lý</div>
                <h2 class="h5 mb-1">Khách muốn trả xe sớm</h2>
                <div class="text-muted small">Đơn vẫn ở trạng thái <strong>Đang thuê</strong> cho đến khi SmartCar thực tế nhận lại xe và lập biên bản trả.</div>
            </div>
            <span class="badge bg-warning text-dark">Chờ xác nhận</span>
        </div>

        <div class="row g-2 small mb-3">
            <div class="col-md-4"><span class="text-muted">Thời gian muốn trả</span><div class="fw-semibold">@earlyReturn.RequestedReturnAt.ToString("dd/MM/yyyy HH:mm")</div></div>
            <div class="col-md-4"><span class="text-muted">Địa điểm</span><div class="fw-semibold">@earlyReturn.ReturnLocation</div></div>
            <div class="col-md-4"><span class="text-muted">Lý do</span><div class="fw-semibold">@earlyReturn.Reason</div></div>
        </div>

        <div class="row g-2">
            <div class="col-md-6">
                <form asp-controller="AdminBookingOperations"
                      asp-action="ApproveEarlyReturn"
                      method="post"
                      data-loading-form
                      data-confirm="Chấp thuận lịch trả sớm này? Đơn vẫn giữ trạng thái Đang thuê cho đến khi xe thực tế được nhận lại.">
                    <input type="hidden" name="bookingId" value="@Model.BookingId" />
                    <input name="decisionNote"
                           maxlength="500"
                           class="form-control form-control-sm mb-2"
                           placeholder="Ghi chú cho khách (không bắt buộc)" />
                    <button class="btn btn-success btn-sm w-100"
                            type="submit"
                            data-loading-text="Đang duyệt...">✓ Chấp thuận trả sớm</button>
                </form>
            </div>
            <div class="col-md-6">
                <form asp-controller="AdminBookingOperations"
                      asp-action="RejectEarlyReturn"
                      method="post"
                      data-loading-form
                      data-confirm="Từ chối yêu cầu trả sớm và giữ lịch trả hiện tại?">
                    <input type="hidden" name="bookingId" value="@Model.BookingId" />
                    <input name="decisionNote"
                           minlength="5"
                           maxlength="500"
                           class="form-control form-control-sm mb-2"
                           required
                           placeholder="Lý do chưa thể tiếp nhận" />
                    <button class="btn btn-outline-secondary btn-sm w-100"
                            type="submit"
                            data-loading-text="Đang xử lý...">Từ chối yêu cầu</button>
                </form>
            </div>
        </div>
    </div>
}
else if (Model.Status == BookingStatus.Rented && earlyReturn?.Status == "Approved")
{
    <div class="alert alert-success shadow-sm mb-4 d-flex justify-content-between align-items-center gap-3 flex-wrap">
        <div>
            <div class="fw-bold">✓ Đã thống nhất trả xe sớm</div>
            <div class="small">Tiếp nhận <strong>@earlyReturn.RequestedReturnAt.ToString("dd/MM/yyyy HH:mm")</strong> tại <strong>@earlyReturn.ReturnLocation</strong>.</div>
            @if (!string.IsNullOrWhiteSpace(earlyReturn.DecisionNote))
            {
                <div class="small text-muted">Ghi chú: @earlyReturn.DecisionNote</div>
            }
        </div>
        <a class="btn btn-success btn-sm"
           asp-controller="Returns"
           asp-action="Create"
           asp-route-bookingId="@Model.BookingId">Tiếp nhận xe & lập biên bản</a>
    </div>
}

<partial name="Details" model="Model" />

<script>
(() => {
    // Khối bản đồ giao/nhận bị trùng thông tin với phần chi tiết đơn và làm màn hình quá nặng.
    // Giữ các thao tác chính ở đúng bước nghiệp vụ thay vì lặp lại trong một dashboard lớn.
    const cards = Array.from(document.querySelectorAll('.card'));
    const logisticsCard = cards.find(card =>
        card.textContent?.includes('Vận hành giao nhận') &&
        card.textContent?.includes('Kế hoạch giao xe & nhận lại xe'));
    if (logisticsCard) {
        logisticsCard.remove();
    }

    const isRented = '@Model.Status' === '@BookingStatus.Rented';
    if (!isRented) {
        return;
    }

    const rentedCard = Array.from(document.querySelectorAll('.card')).find(card =>
        card.querySelector('h2')?.textContent?.trim() === 'Đơn đang thuê');
    if (!rentedCard) {
        return;
    }

    // Trước giờ trả, chỉ cho tiếp nhận sớm khi khách đã gửi yêu cầu và Admin đã chấp thuận.
    const earlyReturnLink = Array.from(rentedCard.querySelectorAll('a')).find(link =>
        link.textContent?.includes('Tiếp nhận xe trả sớm'));

    const isBeforeScheduledReturn = @isBeforeScheduledReturn.ToString().ToLowerInvariant();
    const earlyReturnApproved = '@(earlyReturn?.Status ?? string.Empty)' === 'Approved';

    if (isBeforeScheduledReturn && earlyReturnLink) {
        // Nếu đã duyệt, nút tiếp nhận đã có ở banner xanh phía trên; nếu chưa duyệt thì không cho đi tắt.
        earlyReturnLink.remove();
    }
})();
</script>
