@{
    ViewData["Title"] = "Thuê xe tự lái";
    ViewData["FullWidth"] = true;

    var cars = new[]
    {
        new { Name = "Toyota Vios 2024", Seats = "5 chỗ", Transmission = "Tự động", Fuel = "Xăng", Price = "700.000đ", Rating = "4,9", Trips = "35 lượt thuê", ClassName = "car-visual--vios", Label = "Vios" },
        new { Name = "Honda City 2024", Seats = "5 chỗ", Transmission = "Tự động", Fuel = "Xăng", Price = "750.000đ", Rating = "4,8", Trips = "28 lượt thuê", ClassName = "car-visual--city", Label = "City" },
        new { Name = "Mazda CX-5 2024", Seats = "5 chỗ", Transmission = "Tự động", Fuel = "Xăng", Price = "900.000đ", Rating = "4,9", Trips = "22 lượt thuê", ClassName = "car-visual--cx5", Label = "CX-5" },
        new { Name = "Toyota Innova 2023", Seats = "7 chỗ", Transmission = "Tự động", Fuel = "Xăng", Price = "900.000đ", Rating = "4,8", Trips = "30 lượt thuê", ClassName = "car-visual--innova", Label = "Innova" }
    };
}

<section class="home-hero">
    <div class="container-xl">
        <div class="home-hero__panel">
            <div class="home-hero__content">
                <span class="home-hero__eyebrow">ĐỘI XE DO SMARTCAR TRỰC TIẾP QUẢN LÝ</span>
                <h1>Thuê xe tự lái dễ dàng cùng <span>SmartCar</span></h1>
                <p>Xe chất lượng, giá minh bạch, quy trình đặt xe nhanh chóng và hỗ trợ giao nhận rõ ràng.</p>
            </div>

            <div class="hero-car" aria-hidden="true">
                <div class="hero-car__shine"></div>
                <div class="hero-car__body">
                    <div class="hero-car__window hero-car__window--front"></div>
                    <div class="hero-car__window hero-car__window--rear"></div>
                    <div class="hero-car__grille"></div>
                    <div class="hero-car__light"></div>
                    <span class="hero-car__plate">SMARTCAR</span>
                </div>
                <div class="hero-car__wheel hero-car__wheel--front"></div>
                <div class="hero-car__wheel hero-car__wheel--rear"></div>
            </div>

            <form class="car-search" method="get" asp-controller="Home" asp-action="Index" aria-label="Tìm xe còn trống">
                <div class="car-search__field car-search__field--location">
                    <label for="pickupLocation">Địa điểm nhận xe</label>
                    <select id="pickupLocation" name="pickupLocation" class="form-select">
                        <option>SmartCar Cầu Giấy</option>
                        <option>Giao xe tận nơi</option>
                    </select>
                </div>
                <div class="car-search__field">
                    <label for="pickupDate">Ngày nhận</label>
                    <input id="pickupDate" name="pickupDate" type="date" class="form-control" />
                </div>
                <div class="car-search__field">
                    <label for="pickupTime">Giờ nhận</label>
                    <input id="pickupTime" name="pickupTime" type="time" class="form-control" value="08:00" />
                </div>
                <div class="car-search__field">
                    <label for="returnDate">Ngày trả</label>
                    <input id="returnDate" name="returnDate" type="date" class="form-control" />
                </div>
                <div class="car-search__field">
                    <label for="returnTime">Giờ trả</label>
                    <input id="returnTime" name="returnTime" type="time" class="form-control" value="18:00" />
                </div>
                <button type="submit" class="btn btn-primary car-search__submit">
                    <span class="car-search__icon" aria-hidden="true">⌕</span>
                    Tìm xe
                </button>
            </form>
        </div>

        <div class="trust-strip" aria-label="Cam kết dịch vụ">
            <div><span>✓</span> Xe được kiểm tra định kỳ</div>
            <div><span>◇</span> Giá thuê minh bạch</div>
            <div><span>▣</span> Hỗ trợ giao nhận tận nơi</div>
            <div><span>◉</span> Hỗ trợ khách hàng 24/7</div>
        </div>
    </div>
</section>

<section class="home-section home-section--compact">
    <div class="container-xl">
        <div class="section-heading">
            <div>
                <span class="section-heading__eyebrow">LỰA CHỌN NHANH</span>
                <h2>Danh mục xe</h2>
            </div>
            <a href="#featuredCars" class="section-link">Xem tất cả <span>→</span></a>
        </div>

        <div class="category-grid">
            <a class="category-card" href="#featuredCars">
                <div class="category-car category-car--sedan"><span></span></div>
                <strong>Xe 4–5 chỗ</strong>
            </a>
            <a class="category-card" href="#featuredCars">
                <div class="category-car category-car--suv"><span></span></div>
                <strong>Xe 7 chỗ</strong>
            </a>
            <a class="category-card" href="#featuredCars">
                <div class="category-car category-car--dark"><span></span></div>
                <strong>Xe số tự động</strong>
            </a>
            <a class="category-card" href="#featuredCars">
                <div class="category-car category-car--eco"><span></span></div>
                <strong>Xe tiết kiệm</strong>
            </a>
            <a class="category-card" href="#featuredCars">
                <div class="category-car category-car--premium"><span></span></div>
                <strong>Xe cao cấp</strong>
            </a>
        </div>
    </div>
</section>

<section class="home-section home-section--muted" id="featuredCars">
    <div class="container-xl">
        <div class="section-heading">
            <div>
                <span class="section-heading__eyebrow">ĐƯỢC KHÁCH HÀNG LỰA CHỌN</span>
                <h2>Xe nổi bật</h2>
            </div>
            <a href="#" class="section-link">Xem tất cả xe <span>→</span></a>
        </div>

        <div class="featured-car-grid">
            @foreach (var car in cars)
            {
                <article class="vehicle-card">
                    <div class="vehicle-card__visual @car.ClassName">
                        <span class="availability-badge">Còn trống</span>
                        <div class="car-illustration" aria-hidden="true">
                            <div class="car-illustration__roof"></div>
                            <div class="car-illustration__body"></div>
                            <div class="car-illustration__window car-illustration__window--front"></div>
                            <div class="car-illustration__window car-illustration__window--rear"></div>
                            <div class="car-illustration__wheel car-illustration__wheel--front"></div>
                            <div class="car-illustration__wheel car-illustration__wheel--rear"></div>
                            <span class="car-illustration__label">@car.Label</span>
                        </div>
                    </div>
                    <div class="vehicle-card__body">
                        <h3>@car.Name</h3>
                        <p class="vehicle-card__specs">@car.Seats <span>•</span> @car.Transmission <span>•</span> @car.Fuel</p>
                        <ul class="vehicle-card__features">
                            <li><span>⌖</span> Nhận xe tại SmartCar Cầu Giấy</li>
                            <li><span>▣</span> Có hỗ trợ giao xe tận nơi</li>
                        </ul>
                        <div class="vehicle-card__rating"><span>★</span> @car.Rating <small>(@car.Trips)</small></div>
                        <div class="vehicle-card__footer">
                            <div class="vehicle-card__price"><strong>@car.Price</strong><span>/ngày</span></div>
                            <a href="#" class="btn btn-outline-primary">Xem chi tiết</a>
                        </div>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<section class="home-section" id="rentalProcess">
    <div class="container-xl">
        <div class="section-heading section-heading--center">
            <span class="section-heading__eyebrow">ĐƠN GIẢN VÀ RÕ RÀNG</span>
            <h2>Quy trình thuê xe</h2>
            <p>SmartCar trực tiếp kiểm tra xe, xác nhận đơn và hỗ trợ khách hàng trong toàn bộ quá trình thuê.</p>
        </div>

        <div class="process-grid">
            <div class="process-item">
                <div class="process-item__number">1</div>
                <div class="process-item__icon">▦</div>
                <h3>Chọn thời gian và địa điểm</h3>
                <p>Chọn ngày, giờ và nơi nhận xe phù hợp.</p>
            </div>
            <div class="process-item">
                <div class="process-item__number">2</div>
                <div class="process-item__icon">▰</div>
                <h3>Chọn xe còn trống</h3>
                <p>Xem thông tin, giá và chọn chiếc xe bạn thích.</p>
            </div>
            <div class="process-item">
                <div class="process-item__number">3</div>
                <div class="process-item__icon">▤</div>
                <h3>Gửi yêu cầu thuê</h3>
                <p>Điền thông tin cần thiết và gửi yêu cầu đặt xe.</p>
            </div>
            <div class="process-item">
                <div class="process-item__number">4</div>
                <div class="process-item__icon">◆</div>
                <h3>SmartCar xác nhận</h3>
                <p>Admin kiểm tra lịch xe và xác nhận đơn của bạn.</p>
            </div>
            <div class="process-item">
                <div class="process-item__number">5</div>
                <div class="process-item__icon">▣</div>
                <h3>Thanh toán và nhận xe</h3>
                <p>Thanh toán tiền cọc và nhận xe tại cửa hàng hoặc tận nơi.</p>
            </div>
        </div>
    </div>
</section>

<section class="home-section home-section--blue-soft">
    <div class="container-xl">
        <div class="section-heading section-heading--center">
            <span class="section-heading__eyebrow">DỊCH VỤ TRỰC TIẾP</span>
            <h2>Vì sao chọn SmartCar?</h2>
        </div>

        <div class="benefit-grid">
            <article class="benefit-card">
                <div class="benefit-card__icon">✓</div>
                <h3>Xe được kiểm tra định kỳ</h3>
                <p>Mỗi xe được kiểm tra kỹ trước khi giao để đảm bảo an toàn.</p>
            </article>
            <article class="benefit-card">
                <div class="benefit-card__icon">◇</div>
                <h3>Giá thuê minh bạch</h3>
                <p>Giá và phụ phí hiển thị rõ ràng, không phát sinh chi phí ẩn.</p>
            </article>
            <article class="benefit-card">
                <div class="benefit-card__icon">ϟ</div>
                <h3>Đặt xe nhanh chóng</h3>
                <p>Quy trình đơn giản, theo dõi trạng thái đơn ngay trên website.</p>
            </article>
            <article class="benefit-card">
                <div class="benefit-card__icon">▣</div>
                <h3>Giao nhận linh hoạt</h3>
                <p>Nhận xe tại SmartCar hoặc yêu cầu giao xe tận nơi.</p>
            </article>
            <article class="benefit-card">
                <div class="benefit-card__icon">◉</div>
                <h3>Hỗ trợ xuyên suốt</h3>
                <p>SmartCar sẵn sàng hỗ trợ trong suốt thời gian khách thuê xe.</p>
            </article>
        </div>
    </div>
</section>

<section class="home-section" id="rentalInfo">
    <div class="container-xl">
        <div class="section-heading section-heading--center">
            <span class="section-heading__eyebrow">MINH BẠCH TRƯỚC KHI ĐẶT</span>
            <h2>Thông tin thuê xe cần biết</h2>
        </div>

        <div class="policy-grid">
            <a class="policy-card" href="#faq"><span>▤</span><div><strong>Giấy tờ cần chuẩn bị</strong><small>Xem chi tiết →</small></div></a>
            <a class="policy-card" href="#faq"><span>◌</span><div><strong>Tiền cọc và thanh toán</strong><small>Xem chi tiết →</small></div></a>
            <a class="policy-card" href="#faq"><span>◷</span><div><strong>Giới hạn kilomet</strong><small>Xem chi tiết →</small></div></a>
            <a class="policy-card" href="#faq"><span>♙</span><div><strong>Chính sách nhiên liệu</strong><small>Xem chi tiết →</small></div></a>
            <a class="policy-card" href="#faq"><span>⊗</span><div><strong>Chính sách hủy đơn</strong><small>Xem chi tiết →</small></div></a>
            <a class="policy-card" href="#faq"><span>▰</span><div><strong>Giao nhận xe</strong><small>Xem chi tiết →</small></div></a>
        </div>

        <div class="faq-wrap" id="faq">
            <div class="section-heading section-heading--center section-heading--small">
                <h2>Câu hỏi thường gặp</h2>
            </div>
            <div class="accordion faq-accordion" id="smartcarFaq">
                <div class="accordion-item">
                    <h3 class="accordion-header" id="faqHeadingOne">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqOne" aria-expanded="false" aria-controls="faqOne">Tôi cần chuẩn bị giấy tờ gì để thuê xe?</button>
                    </h3>
                    <div id="faqOne" class="accordion-collapse collapse" aria-labelledby="faqHeadingOne" data-bs-parent="#smartcarFaq">
                        <div class="accordion-body">Khách hàng cần CCCD hoặc hộ chiếu còn hiệu lực, giấy phép lái xe phù hợp và các thông tin xác minh theo quy định của SmartCar.</div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h3 class="accordion-header" id="faqHeadingTwo">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqTwo" aria-expanded="false" aria-controls="faqTwo">SmartCar xác nhận đơn trong bao lâu?</button>
                    </h3>
                    <div id="faqTwo" class="accordion-collapse collapse" aria-labelledby="faqHeadingTwo" data-bs-parent="#smartcarFaq">
                        <div class="accordion-body">Admin kiểm tra lịch xe và phản hồi yêu cầu thuê trong thời gian quy định. Trạng thái mới sẽ được hiển thị tại mục Đơn thuê của tôi.</div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h3 class="accordion-header" id="faqHeadingThree">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqThree" aria-expanded="false" aria-controls="faqThree">Khi nào tôi cần thanh toán tiền cọc?</button>
                    </h3>
                    <div id="faqThree" class="accordion-collapse collapse" aria-labelledby="faqHeadingThree" data-bs-parent="#smartcarFaq">
                        <div class="accordion-body">Khách hàng chỉ thanh toán tiền cọc sau khi SmartCar xác nhận đơn và thông báo xe đã sẵn sàng giữ lịch.</div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h3 class="accordion-header" id="faqHeadingFour">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqFour" aria-expanded="false" aria-controls="faqFour">Tôi có thể nhận xe ở đâu?</button>
                    </h3>
                    <div id="faqFour" class="accordion-collapse collapse" aria-labelledby="faqHeadingFour" data-bs-parent="#smartcarFaq">
                        <div class="accordion-body">Bạn có thể nhận xe tại cửa hàng SmartCar hoặc đăng ký dịch vụ giao xe tận nơi nếu địa chỉ nằm trong khu vực hỗ trợ.</div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h3 class="accordion-header" id="faqHeadingFive">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqFive" aria-expanded="false" aria-controls="faqFive">Hủy đơn có được hoàn tiền không?</button>
                    </h3>
                    <div id="faqFive" class="accordion-collapse collapse" aria-labelledby="faqHeadingFive" data-bs-parent="#smartcarFaq">
                        <div class="accordion-body">Việc hoàn tiền phụ thuộc vào thời điểm hủy và trạng thái thanh toán. Chính sách cụ thể được hiển thị trước khi khách xác nhận đặt xe.</div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h3 class="accordion-header" id="faqHeadingSix">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqSix" aria-expanded="false" aria-controls="faqSix">SmartCar có hỗ trợ giao xe tận nơi không?</button>
                    </h3>
                    <div id="faqSix" class="accordion-collapse collapse" aria-labelledby="faqHeadingSix" data-bs-parent="#smartcarFaq">
                        <div class="accordion-body">Có. Phí giao xe và phạm vi hỗ trợ được tính rõ ràng theo địa chỉ nhận xe của khách hàng.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        window.addEventListener("DOMContentLoaded", () => {
            const today = new Date();
            const tomorrow = new Date(today);
            tomorrow.setDate(today.getDate() + 1);
            const format = date => date.toISOString().split("T")[0];
            const pickupDate = document.getElementById("pickupDate");
            const returnDate = document.getElementById("returnDate");
            pickupDate.min = format(today);
            pickupDate.value = format(today);
            returnDate.min = format(tomorrow);
            returnDate.value = format(tomorrow);
            pickupDate.addEventListener("change", () => {
                const nextDate = new Date(pickupDate.value);
                nextDate.setDate(nextDate.getDate() + 1);
                returnDate.min = format(nextDate);
                if (!returnDate.value || returnDate.value <= pickupDate.value) {
                    returnDate.value = format(nextDate);
                }
            });
        });
    </script>
}
