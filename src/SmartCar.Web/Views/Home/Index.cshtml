@section Scripts {
    <script>
        window.addEventListener("DOMContentLoaded", () => {
            const today = new Date();
            const tomorrow = new Date(today);
            tomorrow.setDate(today.getDate() + 1);
            const format = date => date.toISOString().split("T")[0];
            const pickupDate = document.getElementById("pickupDate");
            const returnDate = document.getElementById("returnDate");

            if (!pickupDate || !returnDate) {
                return;
            }

            pickupDate.min = format(today);
            pickupDate.value = format(today);
            returnDate.min = format(tomorrow);
            returnDate.value = format(tomorrow);

            pickupDate.addEventListener("change", () => {
                const nextDate = new Date(pickupDate.value);
                nextDate.setDate(nextDate.getDate() + 1);
                returnDate.min = format(nextDate);

                if (!returnDate.value || returnDate.value <= pickupDate.value) {
                    returnDate.value = format(nextDate);
                }
            });
        });
    </script>
}
