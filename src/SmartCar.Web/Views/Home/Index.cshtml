@model IReadOnlyList<SmartCar.Application.Features.Vehicles.VehicleDto>
@using SmartCar.Domain.Constants
@{
    ViewData["Title"] = "Trang chủ";
    var pickupDate = DateTime.Today.AddDays(1).AddHours(9);
    var returnDate = pickupDate.AddDays(1);
    var heroVehicle = Model.FirstOrDefault();
    var greetingName = ViewBag.GreetingName as string;
    var isCustomer = User.Identity?.IsAuthenticated == true && User.IsInRole(RoleNames.Customer);
    var isAdmin = User.Identity?.IsAuthenticated == true && User.IsInRole(RoleNames.Admin);
    var quickSearchHeading = isCustomer && !string.IsNullOrWhiteSpace(greetingName)
        ? $"Chào {greetingName}, bạn muốn nhận xe khi nào?"
        : "Bạn muốn nhận xe khi nào?";
    var heroDescription = isCustomer
        ? "Chọn thời gian, tìm xe còn trống và theo dõi toàn bộ chuyến thuê trên một hệ thống duy nhất."
        : "Tìm xe phù hợp, gửi yêu cầu thuê, thanh toán và theo dõi toàn bộ hành trình trên một hệ thống duy nhất.";
}

<section class="home-hero">
    <div class="row align-items-center g-5">
        <div class="col-lg-6">
            <div class="hero-kicker mb-3">
                <span class="hero-kicker-dot"></span>
                Nền tảng thuê xe tự lái minh bạch
            </div>
            <h1 class="hero-title mb-3">
                Thuê xe dễ dàng,
                <span>chủ động mọi hành trình</span>
            </h1>
            <p class="hero-description mb-4">@heroDescription</p>

            <div class="d-flex flex-wrap gap-3 mb-4">
                <a href="#quick-search" class="btn btn-primary btn-lg px-4">
                    Tìm xe theo thời gian
                    <span aria-hidden="true">↓</span>
                </a>
                @if (isAdmin)
                {
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-light btn-lg px-4 hero-secondary-button">
                        Mở trang tổng quan
                    </a>
                }
                else if (isCustomer)
                {
                    <a asp-controller="Bookings" asp-action="MyBookings" class="btn btn-light btn-lg px-4 hero-secondary-button">
                        Xem đơn của tôi
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Register" class="btn btn-light btn-lg px-4 hero-secondary-button">
                        Tạo tài khoản
                    </a>
                }
            </div>

            <div class="hero-trust d-flex flex-wrap gap-4">
                <div>
                    <strong>100%</strong>
                    <span>Xe có giấy tờ rõ ràng</span>
                </div>
                <div>
                    <strong>24/7</strong>
                    <span>Theo dõi đơn trực tuyến</span>
                </div>
                <div>
                    <strong>4 bước</strong>
                    <span>Hoàn tất thuê xe</span>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="hero-visual">
                <div class="hero-visual-glow"></div>
                @if (heroVehicle is not null && !string.IsNullOrWhiteSpace(heroVehicle.PrimaryImagePath))
                {
                    <img src="@heroVehicle.PrimaryImagePath"
                         alt="@heroVehicle.VehicleName"
                         class="hero-car-image" />
                    <div class="hero-car-card">
                        <div>
                            <small>Xe nổi bật</small>
                            <strong>@heroVehicle.VehicleName</strong>
                            <span>@heroVehicle.Seats chỗ · @heroVehicle.Transmission</span>
                        </div>
                        <div class="text-end">
                            <small>Từ</small>
                            <strong>@heroVehicle.DailyPrice.ToString("N0") đ</strong>
                            <span>/ ngày</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="hero-car-placeholder" aria-label="Minh họa ô tô">
                        <svg viewBox="0 0 640 300" role="img" aria-hidden="true">
                            <path d="M145 185c18-60 57-100 119-112h113c50 6 86 40 111 101l53 14c25 7 41 30 41 56v14H63v-15c0-30 20-55 49-62l33-8z" fill="currentColor" opacity=".95" />
                            <path d="M228 94h142c29 4 55 24 76 63H179c14-34 30-55 49-63z" fill="#e3f1ff" />
                            <circle cx="180" cy="242" r="42" fill="#182a3a" />
                            <circle cx="180" cy="242" r="18" fill="#cbd5e1" />
                            <circle cx="477" cy="242" r="42" fill="#182a3a" />
                            <circle cx="477" cy="242" r="18" fill="#cbd5e1" />
                        </svg>
                    </div>
                }
                <div class="hero-floating-badge hero-badge-top">
                    <span class="floating-icon">✓</span>
                    <div><strong>Đặt xe minh bạch</strong><small>Chi phí hiển thị rõ ràng</small></div>
                </div>
                <div class="hero-floating-badge hero-badge-bottom">
                    <span class="floating-icon">★</span>
                    <div><strong>Xe được quản lý</strong><small>Kiểm tra trước khi giao</small></div>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="quick-search" class="home-search-card" aria-labelledby="quick-search-title">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-2 mb-4">
        <div>
            <span class="section-eyebrow">TÌM XE NHANH</span>
            <h2 id="quick-search-title" class="h3 mb-1">@quickSearchHeading</h2>
        </div>
        <span class="text-muted">Định dạng ngày/tháng/năm, sử dụng giờ 24 giờ</span>
    </div>

    <form asp-controller="Vehicles"
          asp-action="Index"
          method="get"
          class="row g-3 align-items-start"
          data-vehicle-search-form
          novalidate>
        <div class="col-lg-5 col-md-6">
            <label for="homePickupDisplay" class="form-label fw-semibold">Ngày giờ nhận xe</label>
            <div class="vn-datetime-control">
                <input id="homePickupDisplay"
                       type="text"
                       value="@pickupDate.ToString("dd/MM/yyyy HH:mm")"
                       placeholder="dd/MM/yyyy HH:mm"
                       inputmode="numeric"
                       autocomplete="off"
                       class="form-control form-control-lg vn-datetime-input"
                       aria-describedby="homePickupHint homePickupError"
                       data-vn-datetime="pickup" />
                <svg class="vn-datetime-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <rect x="3" y="5" width="18" height="16" rx="2"></rect>
                    <path d="M16 3v4M8 3v4M3 10h18"></path>
                </svg>
            </div>
            <small id="homePickupHint" class="vn-datetime-hint">Ví dụ: 09/08/2026 09:00</small>
            <span id="homePickupError" class="search-field-error" data-vn-datetime-error="pickup" role="alert"></span>
            <input type="hidden"
                   name="PickupDate"
                   value="@pickupDate.ToString("yyyy-MM-ddTHH:mm")"
                   data-vn-datetime-hidden="pickup" />
        </div>
        <div class="col-lg-5 col-md-6">
            <label for="homeReturnDisplay" class="form-label fw-semibold">Ngày giờ trả xe</label>
            <div class="vn-datetime-control">
                <input id="homeReturnDisplay"
                       type="text"
                       value="@returnDate.ToString("dd/MM/yyyy HH:mm")"
                       placeholder="dd/MM/yyyy HH:mm"
                       inputmode="numeric"
                       autocomplete="off"
                       class="form-control form-control-lg vn-datetime-input"
                       aria-describedby="homeReturnHint homeReturnError"
                       data-vn-datetime="return" />
                <svg class="vn-datetime-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <rect x="3" y="5" width="18" height="16" rx="2"></rect>
                    <path d="M16 3v4M8 3v4M3 10h18"></path>
                </svg>
            </div>
            <small id="homeReturnHint" class="vn-datetime-hint">Ngày trả xe phải sau ngày nhận xe</small>
            <span id="homeReturnError" class="search-field-error" data-vn-datetime-error="return" role="alert"></span>
            <input type="hidden"
                   name="ReturnDate"
                   value="@returnDate.ToString("yyyy-MM-ddTHH:mm")"
                   data-vn-datetime-hidden="return" />
        </div>
        <div class="col-lg-2 col-md-6 search-submit-column">
            <button type="submit"
                    class="btn btn-primary btn-lg w-100 home-search-button"
                    data-search-submit>
                <span data-search-submit-label>Tìm xe</span>
                <span class="d-none search-button-loading" data-search-submit-loading>
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                    Đang tìm...
                </span>
            </button>
        </div>

        <div class="col-12 d-flex justify-content-between align-items-center flex-wrap gap-2 mt-1">
            <button class="btn btn-sm btn-outline-primary"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#homeAdvancedFilters"
                    aria-expanded="false"
                    aria-controls="homeAdvancedFilters">
                ⚙ Bộ lọc nâng cao
            </button>
            <span class="small text-muted">Lọc thêm theo số chỗ, hãng, hộp số, nhiên liệu, giá và đời xe.</span>
        </div>

        <div class="col-12">
            <div class="collapse" id="homeAdvancedFilters">
                <div class="border rounded-4 bg-light p-3 p-md-4 mt-1">
                    <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
                        <strong>Bộ lọc nâng cao</strong>
                        <span class="small text-muted">Có thể bỏ trống các tiêu chí không cần thiết</span>
                    </div>
                    <div class="row g-3">
                        <div class="col-lg-3 col-md-6">
                            <label for="homeBrand" class="form-label fw-semibold">Hãng xe</label>
                            <select id="homeBrand" name="BrandId" asp-items="ViewBag.Brands" class="form-select">
                                <option value="">Tất cả hãng</option>
                            </select>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <label for="homeTransmission" class="form-label fw-semibold">Hộp số</label>
                            <select id="homeTransmission" name="Transmission" class="form-select">
                                <option value="">Tất cả</option>
                                <option value="Tự động">Tự động</option>
                                <option value="Số sàn">Số sàn</option>
                            </select>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <label for="homeFuelType" class="form-label fw-semibold">Nhiên liệu</label>
                            <select id="homeFuelType" name="FuelType" class="form-select">
                                <option value="">Tất cả</option>
                                <option value="Xăng">Xăng</option>
                                <option value="Dầu">Dầu</option>
                                <option value="Điện">Điện</option>
                                <option value="Hybrid">Hybrid</option>
                            </select>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <label for="homeSeats" class="form-label fw-semibold">Số chỗ tối thiểu</label>
                            <select id="homeSeats" name="Seats" class="form-select">
                                <option value="">Tất cả</option>
                                <option value="4">4+ chỗ</option>
                                <option value="5">5+ chỗ</option>
                                <option value="7">7+ chỗ</option>
                            </select>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <label for="homeMinPrice" class="form-label fw-semibold">Giá từ</label>
                            <div class="input-group">
                                <input id="homeMinPrice" name="MinDailyPrice" type="number" min="1" step="50000" class="form-control" placeholder="300000" />
                                <span class="input-group-text">đ/ngày</span>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <label for="homeMaxPrice" class="form-label fw-semibold">Giá đến</label>
                            <div class="input-group">
                                <input id="homeMaxPrice" name="MaxDailyPrice" type="number" min="1" step="50000" class="form-control" placeholder="1500000" />
                                <span class="input-group-text">đ/ngày</span>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <label for="homeMinYear" class="form-label fw-semibold">Đời xe từ năm</label>
                            <select id="homeMinYear" name="MinManufactureYear" class="form-select">
                                <option value="">Tất cả</option>
                                <option value="2024">2024 trở lên</option>
                                <option value="2022">2022 trở lên</option>
                                <option value="2020">2020 trở lên</option>
                                <option value="2018">2018 trở lên</option>
                            </select>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <label for="homeSort" class="form-label fw-semibold">Sắp xếp</label>
                            <select id="homeSort" name="SortBy" class="form-select">
                                <option value="price_asc">Giá thấp → cao</option>
                                <option value="price_desc">Giá cao → thấp</option>
                                <option value="year_desc">Xe đời mới nhất</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="home-search-error" data-search-error role="alert" aria-live="polite"></div>
        </div>
    </form>
</section>

<section class="home-featured-section" aria-labelledby="featured-title">
    <div class="section-heading d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
        <div>
            <span class="section-eyebrow">LỰA CHỌN NỔI BẬT</span>
            <h2 id="featured-title" class="display-6 fw-bold mb-0">Xe sẵn sàng cho bạn</h2>
        </div>
        <a asp-controller="Vehicles" asp-action="Index" class="section-link">
            Xem tất cả xe <span aria-hidden="true">→</span>
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-featured-state">
            <div class="empty-featured-icon">🚗</div>
            <h3 class="h5">Hiện chưa có xe sẵn sàng</h3>
            <p class="text-muted">Bạn có thể thay đổi thời gian tìm kiếm hoặc xem lại danh sách xe sau.</p>
            <div class="empty-featured-actions">
                <a href="#quick-search" class="btn btn-primary">Thay đổi thời gian</a>
                <a asp-controller="Vehicles" asp-action="Index" class="btn btn-outline-primary">Xem tất cả xe</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var vehicle in Model)
            {
                <div class="col-lg-4 col-md-6">
                    <a asp-controller="Vehicles"
                       asp-action="Details"
                       asp-route-id="@vehicle.VehicleId"
                       asp-route-pickupDate="@pickupDate.ToString("O")"
                       asp-route-returnDate="@returnDate.ToString("O")"
                       class="featured-card-link h-100"
                       aria-label="Xem chi tiết @vehicle.VehicleName">
                        <article class="featured-car-card h-100">
                            <div class="featured-car-image-wrap">
                                @if (!string.IsNullOrWhiteSpace(vehicle.PrimaryImagePath))
                                {
                                    <img src="@vehicle.PrimaryImagePath"
                                         alt="@vehicle.VehicleName"
                                         class="featured-car-image" />
                                }
                                else
                                {
                                    <div class="featured-car-placeholder">Chưa có ảnh</div>
                                }
                                <span class="availability-badge">Sẵn sàng</span>
                            </div>
                            <div class="featured-car-body">
                                <div class="d-flex justify-content-between gap-3 mb-2">
                                    <div>
                                        <div class="featured-brand">@vehicle.BrandName</div>
                                        <h3 class="h5 fw-bold mb-0">@vehicle.VehicleName</h3>
                                    </div>
                                    <div class="featured-price text-end">
                                        <strong>@vehicle.DailyPrice.ToString("N0") đ</strong>
                                        <span>/ ngày</span>
                                    </div>
                                </div>
                                <div class="featured-specs">
                                    <span>👥 @vehicle.Seats chỗ</span>
                                    <span>⚙ @vehicle.Transmission</span>
                                    <span>⛽ @vehicle.FuelType</span>
                                </div>
                                <span class="btn btn-outline-primary w-100 mt-4">Xem chi tiết xe</span>
                            </div>
                        </article>
                    </a>
                </div>
            }
        </div>
    }
</section>

<section class="home-benefits" aria-labelledby="benefits-title">
    <div class="text-center">
        <span class="section-eyebrow">VÌ SAO CHỌN SMARTCAR?</span>
        <h2 id="benefits-title" class="display-6 fw-bold">An tâm từ lúc đặt đến lúc trả xe</h2>
        <p class="text-muted mx-auto section-subtitle">
            Mọi thông tin quan trọng trong hành trình thuê xe đều được quản lý tập trung và minh bạch.
        </p>
    </div>

    <div class="row g-4">
        <div class="col-lg-3 col-md-6">
            <div class="benefit-card h-100">
                <div class="benefit-icon">✓</div>
                <h3 class="h5">Xe được kiểm tra</h3>
                <p>Thông tin xe, giấy tờ và tình trạng vận hành được quản lý trước khi giao.</p>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="benefit-card h-100">
                <div class="benefit-icon">⚡</div>
                <h3 class="h5">Đặt xe nhanh chóng</h3>
                <p>Tìm xe còn trống và gửi yêu cầu thuê chỉ trong vài thao tác đơn giản.</p>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="benefit-card h-100">
                <div class="benefit-icon">₫</div>
                <h3 class="h5">Chi phí minh bạch</h3>
                <p>Giá thuê, phụ phí và hoàn tiền được hiển thị rõ trên đơn.</p>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="benefit-card h-100">
                <div class="benefit-icon">↻</div>
                <h3 class="h5">Theo dõi xuyên suốt</h3>
                <p>Kiểm tra trạng thái xác nhận, thanh toán, giao xe, gia hạn và trả xe.</p>
            </div>
        </div>
    </div>
</section>

<section class="rental-process" aria-labelledby="process-title">
    <div class="row align-items-center g-5">
        <div class="col-lg-4">
            <span class="section-eyebrow section-eyebrow-light">QUY TRÌNH THUÊ XE</span>
            <h2 id="process-title" class="display-6 fw-bold text-white">Bốn bước để bắt đầu hành trình</h2>
            <p class="process-intro mb-0">
                SmartCar giúp bạn hoàn tất các bước thuê xe theo một quy trình rõ ràng và dễ theo dõi.
            </p>
        </div>
        <div class="col-lg-8">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="process-step h-100">
                        <span class="process-number">01</span>
                        <h3 class="h5">Tìm và chọn xe</h3>
                        <p>Chọn thời gian thuê, số chỗ và chiếc xe phù hợp với nhu cầu.</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="process-step h-100">
                        <span class="process-number">02</span>
                        <h3 class="h5">Gửi yêu cầu thuê</h3>
                        <p>Xác minh CCCD, GPLX và gửi yêu cầu để quản trị viên kiểm tra.</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="process-step h-100">
                        <span class="process-number">03</span>
                        <h3 class="h5">Thanh toán và nhận xe</h3>
                        <p>Thanh toán sau khi đơn được xác nhận và lập biên bản giao xe.</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="process-step h-100">
                        <span class="process-number">04</span>
                        <h3 class="h5">Trả xe và đánh giá</h3>
                        <p>Hoàn tất trả xe, xử lý phụ phí nếu có và chia sẻ trải nghiệm.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
