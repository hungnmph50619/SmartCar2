@model SmartCar.Application.Features.Reports.FleetReportDto
@{
    ViewData["Title"] = "Hiệu suất và tài chính đội xe";
    var hasUnusualAdditionalCharges = Model.TotalAdditionalChargeRevenue > 10_000_000m &&
        Model.TotalAdditionalChargeRevenue > Math.Max(1m, Model.TotalRentalRevenue) * 10m;
    var totalOutstanding = Model.OutstandingReceivables + Model.OutstandingDeposits;

    var today = DateTime.Today;
    var sevenDaysStart = today.AddDays(-6);
    var thirtyDaysStart = today.AddDays(-29);
    var monthStart = new DateTime(today.Year, today.Month, 1);

    var vehicleRows = Model.Vehicles
        .Select(item => new
        {
            Item = item,
            IsUnusual = item.AdditionalChargeRevenue > 10_000_000m &&
                item.AdditionalChargeRevenue > Math.Max(1m, item.RentalRevenue) * 10m
        })
        .OrderByDescending(row => row.IsUnusual)
        .ThenBy(row => row.Item.VehicleName)
        .ToList();
}

<div class="d-flex justify-content-between align-items-center mb-2">
    <div>
        <h1 class="h3 mb-1">Hiệu suất và tài chính đội xe</h1>
        <p class="text-muted mb-0">Doanh thu, tiền cần xử lý và hiệu quả từng xe.</p>
        <div class="small text-muted mt-1">Tiền cọc được quản lý riêng, không tính vào doanh thu.</div>
    </div>
</div>

@if (hasUnusualAdditionalCharges)
{
    <div class="alert alert-warning py-2 mb-3 mt-3">
        <strong>Cần kiểm tra phụ phí:</strong> tổng phụ phí đang cao bất thường. Mở “Xem dòng tiền” ở bảng dưới để tìm đơn gây chênh lệch.
    </div>
}

<form method="get" class="card card-body shadow-sm mb-4 mt-3">
    <div class="d-flex gap-2 flex-wrap mb-3">
        <a class="btn btn-sm btn-outline-primary"
           asp-action="Index"
           asp-route-fromDate="@sevenDaysStart.ToString("yyyy-MM-dd")"
           asp-route-toDate="@today.ToString("yyyy-MM-dd")">7 ngày</a>
        <a class="btn btn-sm btn-outline-primary"
           asp-action="Index"
           asp-route-fromDate="@thirtyDaysStart.ToString("yyyy-MM-dd")"
           asp-route-toDate="@today.ToString("yyyy-MM-dd")">30 ngày</a>
        <a class="btn btn-sm btn-outline-primary"
           asp-action="Index"
           asp-route-fromDate="@monthStart.ToString("yyyy-MM-dd")"
           asp-route-toDate="@today.ToString("yyyy-MM-dd")">Tháng này</a>
    </div>
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label">Từ ngày</label>
            <input name="fromDate" type="date" value="@Model.FromDate.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Đến ngày</label>
            <input name="toDate" type="date" value="@Model.ToDate.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-md-4">
            <button class="btn btn-primary w-100" type="submit">Cập nhật</button>
        </div>
    </div>
</form>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card card-body shadow-sm h-100">
            <span class="text-muted">Doanh thu</span>
            <strong class="fs-4">@Model.TotalRevenue.ToString("N0") đ</strong>
            <small class="text-muted">Không gồm cọc.</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-body shadow-sm h-100">
            <span class="text-muted">Hoàn tiền thuê</span>
            <strong class="fs-4 text-warning">@Model.TotalRevenueRefunds.ToString("N0") đ</strong>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-body shadow-sm h-100">
            <span class="text-muted">Chi phí vận hành</span>
            <strong class="fs-4 text-danger">@Model.TotalOperatingCost.ToString("N0") đ</strong>
            <small class="text-muted">Bảo trì, sự cố và hỗ trợ.</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-body shadow-sm h-100">
            <span class="text-muted">Lợi nhuận ước tính</span>
            <strong class="fs-4 @(Model.TotalNetOperatingProfit >= 0 ? "text-success" : "text-danger")">
                @Model.TotalNetOperatingProfit.ToString("N0") đ
            </strong>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-white">
        <strong>Tiền cần theo dõi</strong>
        <div class="small text-muted">Trạng thái hiện tại, không phụ thuộc khoảng ngày.</div>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="border rounded p-3 h-100">
                    <div class="text-muted">Cần thu / chờ đối soát</div>
                    <div class="fs-4 fw-bold text-warning">@totalOutstanding.ToString("N0") đ</div>
                    <div class="small mt-2">Thuê & phát sinh: <strong>@Model.OutstandingReceivables.ToString("N0") đ</strong></div>
                    <div class="small">Cọc: <strong>@Model.OutstandingDeposits.ToString("N0") đ</strong></div>
                    <small class="text-muted d-block mt-1">Cọc chỉ theo dõi dòng tiền, không tính vào doanh thu.</small>
                </div>
            </div>
            <div class="col-md-4">
                <div class="border rounded p-3 h-100">
                    <div class="text-muted">Cọc đang giữ</div>
                    <div class="fs-4 fw-bold text-primary">@Model.DepositsHeld.ToString("N0") đ</div>
                    <small class="text-muted">Cọc đã nhận nhưng chưa hoàn xong.</small>
                </div>
            </div>
            <div class="col-md-4">
                <div class="border rounded p-3 h-100">
                    <div class="text-muted">Chờ hoàn tiền</div>
                    <div class="fs-4 fw-bold text-warning">@Model.PendingRefunds.ToString("N0") đ</div>
                    <small class="text-muted">Admin chưa xác nhận chuyển hoàn.</small>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-white"><strong>Cơ cấu trong kỳ</strong></div>
    <div class="card-body">
        <div class="row g-3 text-center text-md-start">
            <div class="col-6 col-md-3"><div class="small text-muted">Thuê / giao</div><strong>@Model.TotalRentalRevenue.ToString("N0") đ</strong></div>
            <div class="col-6 col-md-3"><div class="small text-muted">Gia hạn</div><strong>@Model.TotalExtensionRevenue.ToString("N0") đ</strong></div>
            <div class="col-6 col-md-3"><div class="small text-muted">Phụ phí</div><strong>@Model.TotalAdditionalChargeRevenue.ToString("N0") đ</strong></div>
            <div class="col-6 col-md-3"><div class="small text-muted">Hoàn cọc</div><strong class="text-primary">@Model.TotalDepositRefunds.ToString("N0") đ</strong></div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card card-body shadow-sm h-100">
            <div class="d-flex justify-content-between mb-2">
                <div><strong>Tỷ lệ xe được thuê</strong><div class="small text-muted">Số ngày thuê / toàn bộ số ngày trong kỳ.</div></div>
                <span>@Model.AverageFleetUtilizationRate.ToString("0.##")%</span>
            </div>
            <div class="progress" style="height:18px"><div class="progress-bar" role="progressbar" style="width:@($"{Math.Min(100m, Model.AverageFleetUtilizationRate):0.##}%")"></div></div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card card-body shadow-sm h-100">
            <div class="d-flex justify-content-between mb-2">
                <div><strong>Tỷ lệ thuê khi xe sẵn sàng</strong><div class="small text-muted">Số ngày thuê / số ngày xe có thể cho thuê; không tính ngày bảo trì.</div></div>
                <span>@Model.AverageAvailableUtilizationRate.ToString("0.##")%</span>
            </div>
            <div class="progress" style="height:18px"><div class="progress-bar" role="progressbar" style="width:@($"{Math.Min(100m, Model.AverageAvailableUtilizationRate):0.##}%")"></div></div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white">
        <div class="d-flex justify-content-between align-items-end gap-3 flex-wrap">
            <div>
                <strong>Hiệu quả theo xe</strong>
                <div class="small text-muted">Tìm nhanh xe và mở dòng tiền khi cần đối chiếu.</div>
            </div>
            <div class="d-flex gap-2 flex-wrap align-items-center">
                <input id="fleet-search" type="search" class="form-control form-control-sm" style="min-width:230px" placeholder="Tìm xe / biển số" aria-label="Tìm xe hoặc biển số" />
                <div class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" id="fleet-unusual-only" />
                    <label class="form-check-label small" for="fleet-unusual-only">Chỉ xe bất thường</label>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Xe</th>
                    <th style="min-width:170px">Doanh thu</th>
                    <th style="min-width:145px">Hoàn tiền</th>
                    <th style="min-width:155px">Chi phí</th>
                    <th style="min-width:155px">Lợi nhuận</th>
                    <th style="min-width:210px">Khai thác</th>
                    <th style="min-width:160px">Chi tiết</th>
                </tr>
            </thead>
            <tbody id="fleet-report-body">
            @if (vehicleRows.Count == 0)
            {
                <tr><td colspan="7" class="text-center text-muted py-4">Chưa có dữ liệu.</td></tr>
            }
            else
            {
                @foreach (var row in vehicleRows)
                {
                    var item = row.Item;
                    <tr class="fleet-vehicle-row @(row.IsUnusual ? "table-warning" : string.Empty)"
                        data-search="@($"{item.VehicleName} {item.LicensePlate}")"
                        data-unusual="@(row.IsUnusual ? "true" : "false")">
                        <td>
                            <strong>@item.VehicleName</strong>
                            <div class="small text-muted">@item.LicensePlate</div>
                            <div class="small text-muted mt-1">@item.CompletedBookings đơn hoàn tất</div>
                            @if (row.IsUnusual)
                            {
                                <span class="badge bg-warning text-dark mt-1">Phụ phí bất thường</span>
                            }
                        </td>
                        <td>
                            <div class="fw-semibold">@item.Revenue.ToString("N0") đ</div>
                            <div class="small text-muted">Thuê: @item.RentalRevenue.ToString("N0")</div>
                            <div class="small text-muted">Gia hạn: @item.ExtensionRevenue.ToString("N0")</div>
                            <div class="small @(row.IsUnusual ? "text-danger fw-semibold" : "text-muted")">Phụ phí: @item.AdditionalChargeRevenue.ToString("N0")</div>
                        </td>
                        <td>
                            <div class="text-warning">Hoàn thuê: @item.RevenueRefunds.ToString("N0") đ</div>
                            <div class="small text-primary">Hoàn cọc: @item.DepositRefunds.ToString("N0") đ</div>
                        </td>
                        <td>
                            <div>Bảo trì: @item.MaintenanceCost.ToString("N0") đ</div>
                            <div>Sự cố/phạt: @item.IncidentCost.ToString("N0") đ</div>
                            @if (item.CompensationCost > 0)
                            {
                                <div>Hỗ trợ: @item.CompensationCost.ToString("N0") đ</div>
                            }
                        </td>
                        <td class="fw-bold @(item.NetOperatingProfit >= 0 ? "text-success" : "text-danger")">@item.NetOperatingProfit.ToString("N0") đ</td>
                        <td>
                            <div class="small mb-1"><strong>Được thuê: @item.FleetUtilizationRate.ToString("0.##")%</strong> · @item.RentalDays ngày</div>
                            <div class="progress mb-1" style="height:9px"><div class="progress-bar" style="width:@($"{Math.Min(100m, item.FleetUtilizationRate):0.##}%")"></div></div>
                            <div class="small text-muted">Khi sẵn sàng: @item.AvailableUtilizationRate.ToString("0.##")%</div>
                        </td>
                        <td>
                            <details>
                                <summary class="text-primary" style="cursor:pointer">
                                    Xem dòng tiền <span class="badge bg-light text-dark">@item.Transactions.Count</span>
                                </summary>
                                <div class="mt-2" style="min-width:390px; max-height:330px; overflow:auto">
                                    @if (item.Transactions.Count == 0)
                                    {
                                        <div class="small text-muted">Không có giao dịch trong kỳ.</div>
                                    }
                                    else
                                    {
                                        <table class="table table-sm mb-0"><tbody>
                                        @foreach (var transaction in item.Transactions)
                                        {
                                            <tr>
                                                <td class="small text-nowrap">@transaction.OccurredAt.ToString("dd/MM/yyyy")</td>
                                                <td class="small">
                                                    <div class="fw-semibold">@transaction.Category</div>
                                                    @if (transaction.BookingId.HasValue)
                                                    {
                                                        <a asp-controller="AdminBookings" asp-action="Details" asp-route-id="@transaction.BookingId.Value" class="text-decoration-none">Đơn #@transaction.BookingId.Value</a>
                                                    }
                                                </td>
                                                <td class="small text-end text-nowrap @(transaction.IsOutflow ? "text-danger" : "text-success")">@(transaction.IsOutflow ? "-" : "+")@transaction.Amount.ToString("N0") đ</td>
                                            </tr>
                                        }
                                        </tbody></table>
                                    }
                                </div>
                            </details>
                        </td>
                    </tr>
                }
                <tr id="fleet-filter-empty" class="d-none">
                    <td colspan="7" class="text-center text-muted py-4">Không có xe phù hợp bộ lọc.</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="small text-muted mt-3">Lợi nhuận ước tính chưa gồm khấu hao, bảo hiểm, thuế và chi phí chung.</div>

@section Scripts {
    <script>
        (() => {
            const searchInput = document.getElementById('fleet-search');
            const unusualOnly = document.getElementById('fleet-unusual-only');
            const rows = Array.from(document.querySelectorAll('.fleet-vehicle-row'));
            const emptyRow = document.getElementById('fleet-filter-empty');

            if (!searchInput || !unusualOnly || rows.length === 0) return;

            const applyFilter = () => {
                const query = searchInput.value.trim().toLocaleLowerCase('vi-VN');
                let visibleCount = 0;

                rows.forEach(row => {
                    const haystack = (row.dataset.search || '').toLocaleLowerCase('vi-VN');
                    const matchesText = !query || haystack.includes(query);
                    const matchesUnusual = !unusualOnly.checked || row.dataset.unusual === 'true';
                    const visible = matchesText && matchesUnusual;
                    row.classList.toggle('d-none', !visible);
                    if (visible) visibleCount++;
                });

                emptyRow?.classList.toggle('d-none', visibleCount !== 0);
            };

            searchInput.addEventListener('input', applyFilter);
            unusualOnly.addEventListener('change', applyFilter);
        })();
    </script>
}
