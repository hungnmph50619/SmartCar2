@model SmartCar.Application.Features.Reports.FleetReportDto
@{
    ViewData["Title"] = "Hiệu suất và tài chính đội xe";
    var hasUnusualAdditionalCharges = Model.TotalAdditionalChargeRevenue > 10_000_000m &&
        Model.TotalAdditionalChargeRevenue > Math.Max(1m, Model.TotalRentalRevenue) * 10m;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Hiệu suất và tài chính đội xe</h1>
        <p class="text-muted mb-0">Doanh thu, tiền cần xử lý và hiệu quả từng xe.</p>
    </div>
</div>

<div class="alert alert-info py-2 mb-4">
    <strong>Cọc được quản lý riêng</strong> và không tính vào doanh thu.
</div>

@if (hasUnusualAdditionalCharges)
{
    <div class="alert alert-warning py-2 mb-4">
        <strong>Cần kiểm tra phụ phí:</strong> tổng phụ phí đang cao bất thường. Mở “Dòng tiền” ở bảng dưới để xem đơn gây chênh lệch.
    </div>
}

<form method="get" class="card card-body shadow-sm mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label">Từ ngày</label>
            <input name="fromDate" type="date" value="@Model.FromDate.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Đến ngày</label>
            <input name="toDate" type="date" value="@Model.ToDate.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-md-4">
            <button class="btn btn-primary w-100" type="submit">Cập nhật</button>
        </div>
    </div>
</form>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card card-body shadow-sm h-100">
            <span class="text-muted">Doanh thu</span>
            <strong class="fs-4">@Model.TotalRevenue.ToString("N0") đ</strong>
            <small class="text-muted">Không gồm cọc.</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-body shadow-sm h-100">
            <span class="text-muted">Hoàn tiền thuê</span>
            <strong class="fs-4 text-warning">@Model.TotalRevenueRefunds.ToString("N0") đ</strong>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-body shadow-sm h-100">
            <span class="text-muted">Chi phí vận hành</span>
            <strong class="fs-4 text-danger">@Model.TotalOperatingCost.ToString("N0") đ</strong>
            <small class="text-muted">Bảo trì, sự cố và hỗ trợ.</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-body shadow-sm h-100">
            <span class="text-muted">Lợi nhuận ước tính</span>
            <strong class="fs-4 @(Model.TotalNetOperatingProfit >= 0 ? "text-success" : "text-danger")">
                @Model.TotalNetOperatingProfit.ToString("N0") đ
            </strong>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-white"><strong>Cơ cấu trong kỳ</strong></div>
    <div class="card-body">
        <div class="row g-3 text-center text-md-start">
            <div class="col-6 col-md-3"><div class="small text-muted">Thuê / giao</div><strong>@Model.TotalRentalRevenue.ToString("N0") đ</strong></div>
            <div class="col-6 col-md-3"><div class="small text-muted">Gia hạn</div><strong>@Model.TotalExtensionRevenue.ToString("N0") đ</strong></div>
            <div class="col-6 col-md-3"><div class="small text-muted">Phụ phí đã thu</div><strong>@Model.TotalAdditionalChargeRevenue.ToString("N0") đ</strong></div>
            <div class="col-6 col-md-3"><div class="small text-muted">Hoàn cọc</div><strong class="text-primary">@Model.TotalDepositRefunds.ToString("N0") đ</strong></div>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-white">
        <strong>Tiền cần theo dõi</strong>
        <div class="small text-muted">Trạng thái hiện tại, không phụ thuộc khoảng ngày.</div>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="border rounded p-3 h-100">
                    <div class="text-muted">Cần thu / chờ đối soát</div>
                    <div class="fs-4 fw-bold text-warning">@Model.OutstandingReceivables.ToString("N0") đ</div>
                    <small class="text-muted">Chưa thanh toán hoặc đã báo chuyển nhưng chưa xác nhận.</small>
                </div>
            </div>
            <div class="col-md-4">
                <div class="border rounded p-3 h-100">
                    <div class="text-muted">Cọc đang giữ</div>
                    <div class="fs-4 fw-bold text-primary">@Model.DepositsHeld.ToString("N0") đ</div>
                    <small class="text-muted">Cọc đã nhận nhưng chưa hoàn xong.</small>
                </div>
            </div>
            <div class="col-md-4">
                <div class="border rounded p-3 h-100">
                    <div class="text-muted">Chờ hoàn tiền</div>
                    <div class="fs-4 fw-bold text-warning">@Model.PendingRefunds.ToString("N0") đ</div>
                    <small class="text-muted">Admin chưa xác nhận chuyển hoàn.</small>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card card-body shadow-sm h-100">
            <div class="d-flex justify-content-between mb-2">
                <div><strong>Khai thác toàn kỳ</strong><div class="small text-muted">Ngày thuê / tổng ngày.</div></div>
                <span>@Model.AverageFleetUtilizationRate.ToString("0.##")%</span>
            </div>
            <div class="progress" style="height:18px"><div class="progress-bar" role="progressbar" style="width:@($"{Math.Min(100m, Model.AverageFleetUtilizationRate):0.##}%")"></div></div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card card-body shadow-sm h-100">
            <div class="d-flex justify-content-between mb-2">
                <div><strong>Khai thác khi xe khả dụng</strong><div class="small text-muted">Không tính ngày bảo trì.</div></div>
                <span>@Model.AverageAvailableUtilizationRate.ToString("0.##")%</span>
            </div>
            <div class="progress" style="height:18px"><div class="progress-bar" role="progressbar" style="width:@($"{Math.Min(100m, Model.AverageAvailableUtilizationRate):0.##}%")"></div></div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white">
        <strong>Hiệu quả theo xe</strong>
        <div class="small text-muted">Mở “Dòng tiền” để kiểm tra số liệu.</div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Xe</th>
                    <th style="min-width:170px">Doanh thu</th>
                    <th style="min-width:145px">Hoàn tiền</th>
                    <th style="min-width:155px">Chi phí</th>
                    <th style="min-width:155px">Lợi nhuận</th>
                    <th style="min-width:210px">Khai thác</th>
                    <th>Đơn xong</th>
                    <th style="min-width:180px">Đối soát</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Vehicles.Count == 0)
            {
                <tr><td colspan="8" class="text-center text-muted py-4">Chưa có dữ liệu.</td></tr>
            }
            else
            {
                @foreach (var item in Model.Vehicles)
                {
                    var unusualVehicleCharge = item.AdditionalChargeRevenue > 10_000_000m &&
                        item.AdditionalChargeRevenue > Math.Max(1m, item.RentalRevenue) * 10m;
                    <tr class="@(unusualVehicleCharge ? "table-warning" : string.Empty)">
                        <td>
                            <strong>@item.VehicleName</strong>
                            <div class="small text-muted">@item.LicensePlate</div>
                            @if (unusualVehicleCharge)
                            {
                                <span class="badge bg-warning text-dark mt-1">Kiểm tra phụ phí</span>
                            }
                        </td>
                        <td>
                            <div class="fw-semibold">@item.Revenue.ToString("N0") đ</div>
                            <div class="small text-muted">Thuê: @item.RentalRevenue.ToString("N0")</div>
                            <div class="small text-muted">Gia hạn: @item.ExtensionRevenue.ToString("N0")</div>
                            <div class="small text-muted">Phụ phí: @item.AdditionalChargeRevenue.ToString("N0")</div>
                        </td>
                        <td>
                            <div class="text-warning">Hoàn tiền thuê: @item.RevenueRefunds.ToString("N0") đ</div>
                            <div class="small text-primary">Hoàn cọc: @item.DepositRefunds.ToString("N0") đ</div>
                        </td>
                        <td>
                            <div>Bảo trì: @item.MaintenanceCost.ToString("N0") đ</div>
                            <div>Sự cố/phạt: @item.IncidentCost.ToString("N0") đ</div>
                            @if (item.CompensationCost > 0)
                            {
                                <div>Hỗ trợ: @item.CompensationCost.ToString("N0") đ</div>
                            }
                        </td>
                        <td class="fw-bold @(item.NetOperatingProfit >= 0 ? "text-success" : "text-danger")">@item.NetOperatingProfit.ToString("N0") đ</td>
                        <td>
                            <div class="d-flex justify-content-between small"><span>@item.RentalDays / @item.AvailableDays ngày</span><span>@item.FleetUtilizationRate.ToString("0.##")%</span></div>
                            <div class="progress mb-1" style="height:9px"><div class="progress-bar" style="width:@($"{Math.Min(100m, item.FleetUtilizationRate):0.##}%")"></div></div>
                            <div class="small text-muted">Khả dụng: @item.AvailableUtilizationRate.ToString("0.##")%</div>
                        </td>
                        <td>@item.CompletedBookings</td>
                        <td>
                            <details>
                                <summary class="text-primary" style="cursor:pointer">Dòng tiền (@item.Transactions.Count)</summary>
                                <div class="mt-2" style="min-width:390px; max-height:330px; overflow:auto">
                                    @if (item.Transactions.Count == 0)
                                    {
                                        <div class="small text-muted">Không có giao dịch trong kỳ.</div>
                                    }
                                    else
                                    {
                                        <table class="table table-sm mb-0"><tbody>
                                        @foreach (var transaction in item.Transactions)
                                        {
                                            <tr>
                                                <td class="small text-nowrap">@transaction.OccurredAt.ToString("dd/MM/yyyy")</td>
                                                <td class="small">
                                                    <div class="fw-semibold">@transaction.Category</div>
                                                    @if (transaction.BookingId.HasValue)
                                                    {
                                                        <a asp-controller="AdminBookings" asp-action="Details" asp-route-id="@transaction.BookingId.Value" class="text-decoration-none">Đơn #@transaction.BookingId.Value</a>
                                                    }
                                                </td>
                                                <td class="small text-end text-nowrap @(transaction.IsOutflow ? "text-danger" : "text-success")">@(transaction.IsOutflow ? "-" : "+")@transaction.Amount.ToString("N0") đ</td>
                                            </tr>
                                        }
                                        </tbody></table>
                                    }
                                </div>
                            </details>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

<div class="small text-muted mt-3">Lợi nhuận ước tính chưa gồm khấu hao, bảo hiểm, thuế và chi phí chung.</div>
