@model SmartCar.Application.Features.Reports.FleetReportDto
@{
    ViewData["Title"] = "Hiệu suất và lợi nhuận";
    var today = DateTime.Today;
    var sevenDaysStart = today.AddDays(-6);
    var thirtyDaysStart = today.AddDays(-29);
    var monthStart = new DateTime(today.Year, today.Month, 1);
    var periodDays = Math.Max(1, (Model.ToDate.Date - Model.FromDate.Date).Days + 1);
    var totalOutstanding = Model.OutstandingReceivables + Model.OutstandingDeposits;
    var totalExpense = Model.TotalOperatingCost + Model.TotalRevenueRefunds;
    var vehicleRows = Model.Vehicles
        .OrderByDescending(x => x.NetOperatingProfit)
        .ThenBy(x => x.VehicleName)
        .ToList();
}

<style>
    .profit-page { --line:#e7ebf0; --muted:#6b7280; }
    .profit-page .panel { background:#fff; border:1px solid var(--line); border-radius:14px; box-shadow:0 3px 12px rgba(15,35,60,.045); }
    .profit-page .kpi-label { color:var(--muted); font-size:.82rem; font-weight:600; }
    .profit-page .kpi-number { font-size:1.65rem; font-weight:750; line-height:1.15; margin-top:.35rem; }
    .profit-page .section-title { font-size:1.05rem; font-weight:750; margin:0; }
    .profit-page .muted { color:var(--muted); }
    .profit-page .finance-line { display:flex; justify-content:space-between; align-items:center; gap:16px; padding:.75rem 0; border-bottom:1px solid var(--line); }
    .profit-page .finance-line:last-child { border-bottom:0; }
    .profit-page .vehicle-card { border:1px solid var(--line); border-radius:12px; background:#fff; height:100%; }
    .profit-page .vehicle-card summary { list-style:none; }
    .profit-page .vehicle-card summary::-webkit-details-marker { display:none; }
    .profit-page .vehicle-card[open] { border-color:#b9d2ff; box-shadow:0 3px 14px rgba(13,110,253,.08); }
    .profit-page .vehicle-top { padding:1rem; cursor:pointer; }
    .profit-page .vehicle-details { border-top:1px solid var(--line); padding:1rem; background:#fafbfc; border-radius:0 0 12px 12px; }
    .profit-page .vehicle-name { font-size:1.05rem; font-weight:750; }
    .profit-page .tiny { font-size:.82rem; }
    .profit-page .money-good { color:#198754; }
    .profit-page .money-bad { color:#dc3545; }
    .profit-page .transaction-table td, .profit-page .transaction-table th { padding:.45rem .5rem; font-size:.84rem; }
</style>

<div class="profit-page">
    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3">
        <div>
            <h1 class="h3 mb-1">Hiệu suất và lợi nhuận</h1>
            <div class="text-muted">Xem xe nào đang tạo doanh thu, xe nào có chi phí và tiền nào đang chờ xử lý.</div>
        </div>
        <div class="text-end small text-muted">
            <div><strong>@Model.FromDate.ToString("dd/MM/yyyy") – @Model.ToDate.ToString("dd/MM/yyyy")</strong></div>
            <div>@periodDays ngày</div>
        </div>
    </div>

    <form method="get" class="panel p-3 mb-3">
        <div class="row g-2 align-items-end">
            <div class="col-lg-auto">
                <div class="d-flex gap-2 flex-wrap">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Index" asp-route-fromDate="@sevenDaysStart.ToString("yyyy-MM-dd")" asp-route-toDate="@today.ToString("yyyy-MM-dd")">7 ngày</a>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Index" asp-route-fromDate="@thirtyDaysStart.ToString("yyyy-MM-dd")" asp-route-toDate="@today.ToString("yyyy-MM-dd")">30 ngày</a>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Index" asp-route-fromDate="@monthStart.ToString("yyyy-MM-dd")" asp-route-toDate="@today.ToString("yyyy-MM-dd")">Tháng này</a>
                </div>
            </div>
            <div class="col-sm-4 col-lg"><label class="form-label small mb-1">Từ ngày</label><input name="fromDate" type="date" value="@Model.FromDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm" /></div>
            <div class="col-sm-4 col-lg"><label class="form-label small mb-1">Đến ngày</label><input name="toDate" type="date" value="@Model.ToDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm" /></div>
            <div class="col-sm-4 col-lg-auto"><button class="btn btn-primary btn-sm px-4 w-100" type="submit">Xem báo cáo</button></div>
        </div>
    </form>

    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <div class="panel p-3 h-100">
                <div class="kpi-label">TỔNG DOANH THU</div>
                <div class="kpi-number">@Model.TotalRevenue.ToString("N0") đ</div>
                <div class="small text-muted mt-2">Tiền thuê, gia hạn, phụ phí và phần cọc đã được quyết toán.</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="panel p-3 h-100">
                <div class="kpi-label">CHI PHÍ & HOÀN DOANH THU</div>
                <div class="kpi-number text-danger">@totalExpense.ToString("N0") đ</div>
                <div class="small text-muted mt-2">Chi phí vận hành @Model.TotalOperatingCost.ToString("N0") đ · Hoàn doanh thu @Model.TotalRevenueRefunds.ToString("N0") đ.</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="panel p-3 h-100">
                <div class="kpi-label">LỢI NHUẬN ƯỚC TÍNH</div>
                <div class="kpi-number @(Model.TotalNetOperatingProfit >= 0 ? "text-success" : "text-danger")">@Model.TotalNetOperatingProfit.ToString("N0") đ</div>
                <div class="small text-muted mt-2">Doanh thu trừ hoàn doanh thu và chi phí vận hành.</div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-lg-6">
            <div class="panel p-3 h-100">
                <h2 class="section-title mb-2">Doanh thu đến từ đâu?</h2>
                <div class="finance-line"><span>Tiền thuê / giao xe</span><strong>@Model.TotalRentalRevenue.ToString("N0") đ</strong></div>
                <div class="finance-line"><span>Tiền gia hạn</span><strong>@Model.TotalExtensionRevenue.ToString("N0") đ</strong></div>
                <div class="finance-line"><span>Phụ phí</span><strong>@Model.TotalAdditionalChargeRevenue.ToString("N0") đ</strong></div>
                <div class="finance-line"><span>Khấu trừ từ cọc đã quyết toán</span><strong>@Model.TotalDepositDeductionRecovery.ToString("N0") đ</strong></div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="panel p-3 h-100">
                <div class="d-flex justify-content-between align-items-center gap-2 mb-2"><h2 class="section-title">Tiền đang chờ xử lý</h2><a class="btn btn-sm btn-outline-primary" asp-controller="AdminPayments" asp-action="Index">Mở thanh toán</a></div>
                <div class="finance-line"><span>Cần thu / chờ xác nhận</span><strong class="text-warning">@totalOutstanding.ToString("N0") đ</strong></div>
                <div class="finance-line"><span>Cọc đang giữ</span><strong>@Model.DepositsHeld.ToString("N0") đ</strong></div>
                <div class="finance-line"><span>Chờ hoàn khách</span><strong class="text-warning">@Model.PendingRefunds.ToString("N0") đ</strong></div>
                <div class="small text-muted mt-2">Các khoản này là trạng thái hiện tại của hệ thống, không phụ thuộc khoảng ngày đang xem.</div>
            </div>
        </div>
    </div>

    <div class="panel p-3">
        <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-3">
            <div>
                <h2 class="section-title">Từng xe</h2>
                <div class="small text-muted">Chỉ hiển thị thông tin quan trọng. Bấm vào xe để xem chi tiết tiền và từng giao dịch.</div>
            </div>
            <input id="vehicle-search" type="search" class="form-control form-control-sm" style="max-width:280px" placeholder="Tìm tên xe hoặc biển số" />
        </div>

        @if (vehicleRows.Count == 0)
        {
            <div class="text-center text-muted py-5">Chưa có dữ liệu trong khoảng thời gian này.</div>
        }
        else
        {
            <div class="row g-3" id="vehicle-grid">
                @foreach (var item in vehicleRows)
                {
                    <div class="col-xl-6 vehicle-wrapper" data-search="@($"{item.VehicleName} {item.LicensePlate}")">
                        <details class="vehicle-card">
                            <summary class="vehicle-top">
                                <div class="d-flex justify-content-between align-items-start gap-3">
                                    <div>
                                        <div class="vehicle-name">@item.VehicleName</div>
                                        <div class="tiny text-muted">@item.LicensePlate · @item.CompletedBookings chuyến hoàn tất</div>
                                    </div>
                                    <div class="text-end">
                                        <div class="tiny text-muted">Lợi nhuận</div>
                                        <div class="fw-bold @(item.NetOperatingProfit >= 0 ? "money-good" : "money-bad")">@item.NetOperatingProfit.ToString("N0") đ</div>
                                    </div>
                                </div>
                                <div class="row g-2 mt-2">
                                    <div class="col-6"><div class="tiny text-muted">Doanh thu</div><strong>@item.Revenue.ToString("N0") đ</strong></div>
                                    <div class="col-6"><div class="tiny text-muted">Ngày có khách thuê</div><strong>@item.RentalDays / @periodDays ngày</strong></div>
                                </div>
                                <div class="small text-primary mt-3">Xem chi tiết ↓</div>
                            </summary>

                            <div class="vehicle-details">
                                <div class="row g-3 mb-3">
                                    <div class="col-sm-6">
                                        <div class="fw-semibold mb-2">Tiền vào</div>
                                        <div class="finance-line py-2"><span>Tiền thuê</span><strong>@item.RentalRevenue.ToString("N0") đ</strong></div>
                                        <div class="finance-line py-2"><span>Gia hạn</span><strong>@item.ExtensionRevenue.ToString("N0") đ</strong></div>
                                        <div class="finance-line py-2"><span>Phụ phí</span><strong>@item.AdditionalChargeRevenue.ToString("N0") đ</strong></div>
                                        @if (item.DepositDeductionRecovery > 0)
                                        {
                                            <div class="finance-line py-2"><span>Khấu trừ cọc</span><strong>@item.DepositDeductionRecovery.ToString("N0") đ</strong></div>
                                        }
                                    </div>
                                    <div class="col-sm-6">
                                        <div class="fw-semibold mb-2">Tiền ra / chi phí</div>
                                        <div class="finance-line py-2"><span>Hoàn doanh thu</span><strong>@item.RevenueRefunds.ToString("N0") đ</strong></div>
                                        <div class="finance-line py-2"><span>Bảo trì</span><strong>@item.MaintenanceCost.ToString("N0") đ</strong></div>
                                        <div class="finance-line py-2"><span>Sự cố / phạt</span><strong>@item.IncidentCost.ToString("N0") đ</strong></div>
                                        @if (item.CompensationCost > 0)
                                        {
                                            <div class="finance-line py-2"><span>Hỗ trợ / bồi thường</span><strong>@item.CompensationCost.ToString("N0") đ</strong></div>
                                        }
                                        <div class="finance-line py-2"><span>Hoàn cọc <span class="text-muted" title="Hoàn cọc là tiền giữ trước đó nên không trừ thêm vào lợi nhuận.">ⓘ</span></span><strong>@item.DepositRefunds.ToString("N0") đ</strong></div>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mb-2"><strong class="small">Lịch sử dòng tiền</strong><span class="small text-muted">@item.Transactions.Count giao dịch</span></div>
                                @if (item.Transactions.Count == 0)
                                {
                                    <div class="small text-muted">Không có giao dịch trong kỳ.</div>
                                }
                                else
                                {
                                    <div class="table-responsive">
                                        <table class="table table-sm transaction-table mb-0">
                                            <thead><tr><th>Ngày</th><th>Nội dung</th><th>Đơn</th><th class="text-end">Số tiền</th></tr></thead>
                                            <tbody>
                                            @foreach (var transaction in item.Transactions)
                                            {
                                                <tr>
                                                    <td class="text-nowrap">@transaction.OccurredAt.ToString("dd/MM/yyyy")</td>
                                                    <td>@transaction.Category</td>
                                                    <td>@if(transaction.BookingId.HasValue){<a asp-controller="AdminBookings" asp-action="Details" asp-route-id="@transaction.BookingId.Value" class="text-decoration-none">#@transaction.BookingId.Value</a>}else{<span class="text-muted">—</span>}</td>
                                                    <td class="text-end text-nowrap fw-semibold @(transaction.IsOutflow ? "text-danger" : "text-success")">@(transaction.IsOutflow ? "−" : "+")@transaction.Amount.ToString("N0") đ</td>
                                                </tr>
                                            }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        </details>
                    </div>
                }
                <div id="vehicle-empty" class="col-12 text-center text-muted py-4 d-none">Không tìm thấy xe phù hợp.</div>
            </div>
        }
    </div>

    <div class="small text-muted mt-3">Lợi nhuận ở đây là ước tính vận hành, chưa tính khấu hao xe, bảo hiểm, thuế và chi phí chung của doanh nghiệp.</div>
</div>

@section Scripts {
<script>
(() => {
    const input = document.getElementById('vehicle-search');
    const cards = Array.from(document.querySelectorAll('.vehicle-wrapper'));
    const empty = document.getElementById('vehicle-empty');
    if (!input || cards.length === 0) return;

    input.addEventListener('input', () => {
        const q = input.value.trim().toLocaleLowerCase('vi-VN');
        let visible = 0;
        cards.forEach(card => {
            const match = !q || (card.dataset.search || '').toLocaleLowerCase('vi-VN').includes(q);
            card.classList.toggle('d-none', !match);
            if (match) visible++;
        });
        empty?.classList.toggle('d-none', visible !== 0);
    });
})();
</script>
}