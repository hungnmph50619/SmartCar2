@model SmartCar.Application.Features.Vehicles.VehicleDto
@using SmartCar.Application.Features.Reviews
@{
    ViewData["Title"] = Model.VehicleName;
    var pickupDate = (DateTime)ViewBag.PickupDate;
    var returnDate = (DateTime)ViewBag.ReturnDate;
    var numberOfDays = Math.Max(1, (int)Math.Ceiling((returnDate - pickupDate).TotalHours / 24d));
    var estimatedAmount = numberOfDays * Model.DailyPrice;
    var reviews = ViewBag.Reviews as IReadOnlyList<ReviewDto> ?? Array.Empty<ReviewDto>();
    var averageRating = (double)(ViewBag.AverageRating ?? 0d);
}

<div class="row g-4">
    <div class="col-lg-7">
        @if (Model.Images.Count > 0)
        {
            <div class="row g-2">
            @foreach (var image in Model.Images)
            {
                <div class="col-6">
                    <img src="@image.ImagePath" class="img-fluid rounded w-100" style="height:240px;object-fit:cover" alt="@Model.VehicleName" />
                </div>
            }
            </div>
        }
        else
        {
            <div class="bg-light rounded d-flex align-items-center justify-content-center" style="height:360px">Xe chưa có ảnh</div>
        }
    </div>
    <div class="col-lg-5">
        <div class="card card-body shadow-sm sticky-top" style="top:1rem">
            <h1 class="h3">@Model.VehicleName</h1>
            <p class="text-muted">@Model.BrandName · @Model.Model · @Model.LicensePlate</p>
            <div class="mb-3">
                <span class="text-warning fs-5">★</span>
                <strong>@(reviews.Count == 0 ? "Chưa có đánh giá" : $"{averageRating:F1}/5")</strong>
                @if (reviews.Count > 0)
                {
                    <span class="text-muted">(@reviews.Count lượt)</span>
                }
            </div>
            <dl class="row mb-3">
                <dt class="col-5">Số chỗ</dt><dd class="col-7">@Model.Seats</dd>
                <dt class="col-5">Hộp số</dt><dd class="col-7">@Model.Transmission</dd>
                <dt class="col-5">Nhiên liệu</dt><dd class="col-7">@Model.FuelType</dd>
                <dt class="col-5">Năm sản xuất</dt><dd class="col-7">@Model.ManufactureYear</dd>
            </dl>
            <p>@Model.Description</p>
            <hr />
            <div class="mb-2"><strong>Nhận xe:</strong> @pickupDate.ToString("dd/MM/yyyy HH:mm")</div>
            <div class="mb-2"><strong>Trả xe:</strong> @returnDate.ToString("dd/MM/yyyy HH:mm")</div>
            <div class="mb-2"><strong>Số ngày tính phí:</strong> @numberOfDays</div>
            <div class="fs-4 fw-bold text-primary mb-3">Dự kiến: @estimatedAmount.ToString("N0") đ</div>

            @if (User.Identity?.IsAuthenticated == true && User.IsInRole(RoleNames.Customer))
            {
                <form asp-controller="Bookings" asp-action="Create" method="post">
                    <input type="hidden" name="VehicleId" value="@Model.VehicleId" />
                    <input type="hidden" name="PickupDate" value="@pickupDate.ToString("O")" />
                    <input type="hidden" name="ReturnDate" value="@returnDate.ToString("O")" />
                    <button class="btn btn-primary btn-lg w-100" type="submit">Gửi yêu cầu thuê xe</button>
                </form>
                <a class="btn btn-link mt-2" asp-controller="Documents" asp-action="Index">Kiểm tra trạng thái CCCD/GPLX</a>
            }
            else if (User.Identity?.IsAuthenticated != true)
            {
                <a class="btn btn-primary btn-lg w-100" asp-controller="Account" asp-action="Login">Đăng nhập để thuê xe</a>
            }
        </div>
    </div>
</div>

<div class="card card-body shadow-sm mt-4">
    <h2 class="h4">Đánh giá từ khách hàng</h2>
    @if (reviews.Count == 0)
    {
        <p class="text-muted mb-0">Xe chưa có đánh giá sau chuyến thuê.</p>
    }
    else
    {
        <div class="row g-3">
        @foreach (var review in reviews)
        {
            <div class="col-md-6">
                <div class="border rounded p-3 h-100">
                    <div class="d-flex justify-content-between">
                        <strong>@review.CustomerName</strong>
                        <span class="text-warning">@string.Concat(Enumerable.Repeat("★", review.Rating))</span>
                    </div>
                    <p class="mb-1 mt-2">@(string.IsNullOrWhiteSpace(review.Comment) ? "Khách hàng không để lại nhận xét." : review.Comment)</p>
                    <small class="text-muted">@review.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</small>
                </div>
            </div>
        }
        </div>
    }
</div>
