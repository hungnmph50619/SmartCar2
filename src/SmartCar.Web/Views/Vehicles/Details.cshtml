@model SmartCar.Application.Features.Vehicles.VehicleDto
@using SmartCar.Application.Features.Reviews
@using SmartCar.Domain.Constants
@{
    ViewData["Title"] = Model.VehicleName;
    var pickupDate = (DateTime)ViewBag.PickupDate;
    var returnDate = (DateTime)ViewBag.ReturnDate;
    var numberOfDays = Math.Max(1, (int)Math.Ceiling((returnDate - pickupDate).TotalHours / 24d));
    var estimatedAmount = numberOfDays * Model.DailyPrice;
    var reviews = ViewBag.Reviews as IReadOnlyList<ReviewDto> ?? Array.Empty<ReviewDto>();
    var averageRating = (double)(ViewBag.AverageRating ?? 0d);
    var kycVerified = ViewBag.KycVerified is bool verified && verified;
    var kycVerifiedCount = ViewBag.KycVerifiedCount is int count ? count : 0;
    var kycTotal = ViewBag.KycTotal is int total ? total : 2;
    var hasBankAccount = ViewBag.HasBankAccount is bool hasBank && hasBank;
}

<div class="row g-4">
    <div class="col-lg-7">
        @if (Model.Images.Count > 0)
        {
            <div class="row g-2">
            @foreach (var image in Model.Images)
            {
                <div class="col-6">
                    <img src="@image.ImagePath" class="img-fluid rounded w-100" style="height:240px;object-fit:cover" alt="@Model.VehicleName" />
                </div>
            }
            </div>
        }
        else
        {
            <div class="bg-light rounded d-flex align-items-center justify-content-center" style="height:360px">Xe chưa có ảnh</div>
        }
    </div>

    <div class="col-lg-5">
        <div class="card card-body shadow-sm sticky-top" style="top:1rem">
            <h1 class="h3">@Model.VehicleName</h1>
            <p class="text-muted">@Model.BrandName · @Model.Model · @Model.LicensePlate</p>

            <div class="mb-3">
                <span class="text-warning fs-5">★</span>
                <strong>@(reviews.Count == 0 ? "Chưa có đánh giá" : $"{averageRating:F1}/5")</strong>
                @if (reviews.Count > 0)
                {
                    <span class="text-muted">(@reviews.Count lượt)</span>
                }
            </div>

            <dl class="row mb-3">
                <dt class="col-5">Số chỗ</dt><dd class="col-7">@Model.Seats</dd>
                <dt class="col-5">Hộp số</dt><dd class="col-7">@Model.Transmission</dd>
                <dt class="col-5">Nhiên liệu</dt><dd class="col-7">@Model.FuelType</dd>
                <dt class="col-5">Năm sản xuất</dt><dd class="col-7">@Model.ManufactureYear</dd>
            </dl>

            <p>@Model.Description</p>
            <hr />

            <div class="d-flex justify-content-between align-items-center mb-2">
                <span><strong>Nhận xe</strong></span>
                <span>@pickupDate.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span><strong>Trả xe</strong></span>
                <span>@returnDate.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span><strong>Số ngày tính phí</strong></span>
                <span>@numberOfDays</span>
            </div>
            <div class="fs-4 fw-bold text-primary mb-3">Dự kiến: @estimatedAmount.ToString("N0") đ</div>

            @if (User.Identity?.IsAuthenticated == true && User.IsInRole(RoleNames.Customer))
            {
                @if (kycVerified)
                {
                    @if (hasBankAccount)
                    {
                        <form asp-controller="Bookings" asp-action="Create" method="post" data-loading-form id="booking-location-form">
                            <input type="hidden" name="VehicleId" value="@Model.VehicleId" />
                            <input type="hidden" name="PickupDate" value="@pickupDate.ToString("O")" />
                            <input type="hidden" name="ReturnDate" value="@returnDate.ToString("O")" />

                            <div class="border rounded-3 p-3 mb-3 bg-light">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div>
                                        <div class="text-uppercase small text-muted fw-semibold">Nhận xe</div>
                                        <div class="fw-bold">Chọn cách nhận xe</div>
                                    </div>
                                    <span class="badge bg-primary-subtle text-primary">@pickupDate.ToString("HH:mm dd/MM")</span>
                                </div>

                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="PickupMethodOption" id="pickupAtSmartCar" value="smartcar" checked />
                                    <label class="form-check-label" for="pickupAtSmartCar">
                                        <strong>Nhận tại SmartCar</strong>
                                        <span class="d-block small text-muted">Đến điểm giao nhận của SmartCar để nhận xe.</span>
                                    </label>
                                </div>

                                <div class="form-check mb-3">
                                    <input class="form-check-input" type="radio" name="PickupMethodOption" id="pickupDelivery" value="delivery" />
                                    <label class="form-check-label" for="pickupDelivery">
                                        <strong>Giao xe tận nơi</strong>
                                        <span class="d-block small text-muted">Nhập địa chỉ để quản trị viên kiểm tra khả năng giao xe trước khi duyệt đơn.</span>
                                    </label>
                                </div>

                                <label class="form-label fw-semibold" for="pickupLocation">Địa điểm nhận xe</label>
                                <input id="pickupLocation"
                                       name="PickupLocation"
                                       class="form-control"
                                       maxlength="250"
                                       required
                                       readonly
                                       value="SmartCar - Điểm giao nhận của chủ xe" />
                                <div class="form-text" id="pickupLocationHelp">Đây là địa điểm nhận xe mặc định.</div>
                            </div>

                            <div class="border rounded-3 p-3 mb-3">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div>
                                        <div class="text-uppercase small text-muted fw-semibold">Trả xe</div>
                                        <div class="fw-bold">Xác định nơi trả xe</div>
                                    </div>
                                    <span class="badge bg-secondary-subtle text-secondary">@returnDate.ToString("HH:mm dd/MM")</span>
                                </div>

                                <div class="form-check form-switch mb-3">
                                    <input class="form-check-input" type="checkbox" role="switch" id="sameReturnLocation" checked />
                                    <label class="form-check-label" for="sameReturnLocation">
                                        <strong>Trả xe tại cùng địa điểm nhận</strong>
                                        <span class="d-block small text-muted">Đây là lựa chọn mặc định và thuận tiện nhất.</span>
                                    </label>
                                </div>

                                <label class="form-label fw-semibold" for="returnLocation">Địa điểm trả xe</label>
                                <input id="returnLocation"
                                       name="ReturnLocation"
                                       class="form-control"
                                       maxlength="250"
                                       required
                                       readonly
                                       value="SmartCar - Điểm giao nhận của chủ xe" />
                                <div class="form-text" id="returnLocationHelp">Nếu muốn trả ở nơi khác, tắt lựa chọn “cùng địa điểm nhận” và nhập địa chỉ mới.</div>
                            </div>

                            <div class="alert alert-success py-2 mb-3">
                                <strong>✓ Hồ sơ đã đủ điều kiện.</strong>
                                Giấy tờ và tài khoản nhận hoàn tiền đã sẵn sàng.
                            </div>

                            <div class="alert alert-light border small py-2 mb-3">
                                Địa điểm nhận/trả sẽ được gửi cùng yêu cầu thuê. Quản trị viên kiểm tra tính khả thi trước khi xác nhận đơn; sau khi đã xác nhận, mọi thay đổi cần được hai bên thống nhất lại.
                            </div>

                            <button class="btn btn-primary btn-lg w-100" type="submit" data-loading-text="Đang gửi yêu cầu...">
                                Gửi yêu cầu thuê xe
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="border rounded-3 p-3 mb-3 bg-light">
                            <div class="fw-bold">🏦 Cần thêm tài khoản ngân hàng</div>
                            <div class="small text-muted mt-1">
                                Trước khi đặt xe, bạn cần lưu tài khoản ngân hàng để SmartCar có thể hoàn tiền, hoàn cọc hoặc chuyển trả các khoản phát sinh khi cần.
                            </div>
                        </div>
                        <a class="btn btn-primary btn-lg w-100"
                           asp-controller="Profile"
                           asp-action="Index"
                           asp-route-tab="banking"
                           asp-route-returnVehicleId="@Model.VehicleId"
                           asp-route-pickupDate="@pickupDate.ToString("O")"
                           asp-route-returnDate="@returnDate.ToString("O")">
                            Thêm tài khoản ngân hàng
                        </a>
                    }
                }
                else
                {
                    <div class="border rounded-3 p-3 mb-3 bg-light">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
                            <div>
                                <div class="fw-bold">🔒 Cần xác minh để thuê xe</div>
                                <div class="small text-muted mt-1">Hoàn tất xác minh danh tính bằng CCCD và xác minh GPLX trước khi gửi yêu cầu.</div>
                            </div>
                            <span class="badge bg-warning text-dark">@kycVerifiedCount/@kycTotal</span>
                        </div>
                        <div class="small text-muted">① CCCD: thông tin + 2 ảnh &nbsp;·&nbsp; ② GPLX: thông tin + 2 ảnh</div>
                    </div>
                    <a class="btn btn-primary btn-lg w-100"
                       asp-controller="Profile"
                       asp-action="Index"
                       asp-route-tab="documents"
                       asp-route-returnVehicleId="@Model.VehicleId"
                       asp-route-pickupDate="@pickupDate.ToString("O")"
                       asp-route-returnDate="@returnDate.ToString("O")">
                        Xác minh để thuê xe
                    </a>
                }
            }
            else if (User.Identity?.IsAuthenticated != true)
            {
                <a class="btn btn-primary btn-lg w-100" asp-controller="Account" asp-action="Login">Đăng nhập để thuê xe</a>
            }
        </div>
    </div>
</div>

<div class="card card-body shadow-sm mt-4">
    <h2 class="h4">Đánh giá từ khách hàng</h2>
    @if (reviews.Count == 0)
    {
        <p class="text-muted mb-0">Xe chưa có đánh giá sau chuyến thuê.</p>
    }
    else
    {
        <div class="row g-3">
        @foreach (var review in reviews)
        {
            <div class="col-md-6">
                <div class="border rounded p-3 h-100">
                    <div class="d-flex justify-content-between">
                        <strong>@review.CustomerName</strong>
                        <span class="text-warning">@string.Concat(Enumerable.Repeat("★", review.Rating))</span>
                    </div>
                    <p class="mb-1 mt-2">@(string.IsNullOrWhiteSpace(review.Comment) ? "Khách hàng không để lại nhận xét." : review.Comment)</p>
                    <small class="text-muted">@review.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</small>
                </div>
            </div>
        }
        </div>
    }
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const form = document.getElementById("booking-location-form");
        if (!form) return;

        const pickupAtSmartCar = document.getElementById("pickupAtSmartCar");
        const pickupDelivery = document.getElementById("pickupDelivery");
        const pickupLocation = document.getElementById("pickupLocation");
        const pickupHelp = document.getElementById("pickupLocationHelp");
        const sameReturnLocation = document.getElementById("sameReturnLocation");
        const returnLocation = document.getElementById("returnLocation");
        const returnHelp = document.getElementById("returnLocationHelp");
        const smartCarLocation = "SmartCar - Điểm giao nhận của chủ xe";

        function syncReturnLocation() {
            if (sameReturnLocation.checked) {
                returnLocation.value = pickupLocation.value;
                returnLocation.readOnly = true;
                returnHelp.textContent = "Địa điểm trả đang được đồng bộ theo địa điểm nhận xe.";
            } else {
                returnLocation.readOnly = false;
                if (returnLocation.value === pickupLocation.value || returnLocation.value === smartCarLocation) {
                    returnLocation.value = "";
                }
                returnLocation.placeholder = "Nhập địa điểm trả xe khác";
                returnHelp.textContent = "Địa điểm khác sẽ được quản trị viên kiểm tra trước khi xác nhận đơn.";
            }
        }

        function setPickupMode() {
            if (pickupAtSmartCar.checked) {
                pickupLocation.value = smartCarLocation;
                pickupLocation.readOnly = true;
                pickupLocation.placeholder = "";
                pickupHelp.textContent = "Đây là địa điểm nhận xe mặc định.";
            } else if (pickupDelivery.checked) {
                pickupLocation.value = "";
                pickupLocation.readOnly = false;
                pickupLocation.placeholder = "Nhập địa chỉ giao xe tận nơi";
                pickupHelp.textContent = "Quản trị viên sẽ kiểm tra địa chỉ và xác nhận khả năng giao xe.";
                pickupLocation.focus();
            }
            syncReturnLocation();
        }

        pickupAtSmartCar.addEventListener("change", setPickupMode);
        pickupDelivery.addEventListener("change", setPickupMode);
        pickupLocation.addEventListener("input", syncReturnLocation);
        sameReturnLocation.addEventListener("change", syncReturnLocation);

        setPickupMode();
    });
</script>
