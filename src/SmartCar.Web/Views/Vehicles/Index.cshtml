@model IReadOnlyList<SmartCar.Application.Features.Vehicles.VehicleDto>
@using Microsoft.AspNetCore.Mvc.Rendering
@using SmartCar.Web.ViewModels
@{
    ViewData["Title"] = "Tìm xe";
    var search = ViewBag.Search as VehicleSearchViewModel ?? new VehicleSearchViewModel();
    var hasSearch = Context.Request.Query.ContainsKey("PickupDate") && Context.Request.Query.ContainsKey("ReturnDate");
    var searchAction = $"{Url.Action("Index", "Vehicles")}#vehicle-results";
    var brandOptions = ViewBag.Brands as SelectList;
    var selectedBrandName = brandOptions?.FirstOrDefault(item => item.Selected)?.Text;
    var activeFilterCount = 0;
    if (search.BrandId.HasValue) activeFilterCount++;
    if (search.Seats.HasValue) activeFilterCount++;
    if (!string.IsNullOrWhiteSpace(search.Transmission)) activeFilterCount++;
    if (!string.IsNullOrWhiteSpace(search.FuelType)) activeFilterCount++;
    if (search.MinDailyPrice.HasValue) activeFilterCount++;
    if (search.MaxDailyPrice.HasValue) activeFilterCount++;
    if (search.MinManufactureYear.HasValue) activeFilterCount++;
    var hasAdvancedFilters = activeFilterCount > 0;
    var resetFiltersUrl = Url.Action("Index", "Vehicles", new
    {
        PickupDate = search.PickupDate,
        ReturnDate = search.ReturnDate,
        SortBy = "price_asc"
    });
}

<style>
    .vehicle-filter-card {
        border: 1px solid var(--smartcar-border);
        border-radius: 18px;
        background: #fff;
        box-shadow: var(--smartcar-shadow-sm);
    }

    .vehicle-filter-card .form-label {
        margin-bottom: .35rem;
        font-size: .9rem;
    }

    .vehicle-filter-chip {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .42rem .7rem;
        border: 1px solid #cfe0f5;
        border-radius: 999px;
        color: var(--smartcar-blue-dark);
        background: #f5f9ff;
        font-size: .82rem;
        font-weight: 700;
        text-decoration: none;
    }

    .vehicle-filter-chip:hover {
        border-color: var(--smartcar-blue);
        color: var(--smartcar-blue);
        background: #fff;
    }

    .vehicle-filter-chip .chip-close {
        font-size: 1rem;
        line-height: 1;
    }

    .vehicle-result-meta {
        display: flex;
        flex-wrap: wrap;
        gap: .45rem .8rem;
        color: var(--smartcar-muted);
        font-size: .85rem;
    }

    .vehicle-result-card {
        position: relative;
        cursor: pointer;
        transition: transform .18s ease, box-shadow .18s ease;
    }

    .vehicle-result-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 28px rgba(15, 23, 42, .1) !important;
    }

    .vehicle-result-card:focus-within {
        outline: 3px solid rgba(13, 110, 253, .18);
        outline-offset: 2px;
    }

    .vehicle-result-status {
        font-size: .72rem;
    }

    @@media (min-width: 992px) {
        .vehicle-filter-sticky {
            position: sticky;
            top: 92px;
            max-height: calc(100vh - 112px);
            overflow-y: auto;
            overscroll-behavior: contain;
            scrollbar-width: thin;
        }
    }
</style>

<section class="vehicle-search-page" aria-labelledby="vehicle-search-title">
    <div class="vehicle-search-card mb-4">
        <div class="vehicle-search-heading">
            <div>
                <span class="section-eyebrow">TÌM XE CÒN TRỐNG</span>
                <h1 id="vehicle-search-title" class="h3 mb-1">Chọn thời gian thuê xe</h1>
                <p class="text-muted mb-0">Hệ thống chỉ hiển thị xe sẵn sàng trong đúng khoảng thời gian bạn chọn.</p>
            </div>
            <span class="vehicle-search-format">Ngày/tháng/năm · Giờ 24 giờ</span>
        </div>

        <form method="get"
              action="@searchAction"
              class="row g-3 align-items-start"
              data-vehicle-search-form
              novalidate>
            <div class="col-lg-5 col-md-6">
                <label for="vehiclePickupDisplay" class="form-label fw-semibold">Ngày giờ nhận xe</label>
                <div class="vn-datetime-control">
                    <input id="vehiclePickupDisplay"
                           type="text"
                           value="@search.PickupDate.ToString("dd/MM/yyyy HH:mm")"
                           placeholder="dd/MM/yyyy HH:mm"
                           inputmode="numeric"
                           autocomplete="off"
                           class="form-control vn-datetime-input"
                           aria-describedby="vehiclePickupHint vehiclePickupError"
                           data-vn-datetime="pickup" />
                    <svg class="vn-datetime-icon vehicle-search-date-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <rect x="3" y="5" width="18" height="16" rx="2"></rect>
                        <path d="M16 3v4M8 3v4M3 10h18"></path>
                    </svg>
                </div>
                <small id="vehiclePickupHint" class="vn-datetime-hint">Ví dụ: 09/08/2026 09:00</small>
                <span id="vehiclePickupError" class="search-field-error" data-vn-datetime-error="pickup" role="alert"></span>
                <input type="hidden" name="PickupDate" value="@search.PickupDate.ToString("yyyy-MM-ddTHH:mm")" data-vn-datetime-hidden="pickup" />
            </div>

            <div class="col-lg-5 col-md-6">
                <label for="vehicleReturnDisplay" class="form-label fw-semibold">Ngày giờ trả xe</label>
                <div class="vn-datetime-control">
                    <input id="vehicleReturnDisplay"
                           type="text"
                           value="@search.ReturnDate.ToString("dd/MM/yyyy HH:mm")"
                           placeholder="dd/MM/yyyy HH:mm"
                           inputmode="numeric"
                           autocomplete="off"
                           class="form-control vn-datetime-input"
                           aria-describedby="vehicleReturnHint vehicleReturnError"
                           data-vn-datetime="return" />
                    <svg class="vn-datetime-icon vehicle-search-date-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <rect x="3" y="5" width="18" height="16" rx="2"></rect>
                        <path d="M16 3v4M8 3v4M3 10h18"></path>
                    </svg>
                </div>
                <small id="vehicleReturnHint" class="vn-datetime-hint">Phải sau ngày giờ nhận xe</small>
                <span id="vehicleReturnError" class="search-field-error" data-vn-datetime-error="return" role="alert"></span>
                <input type="hidden" name="ReturnDate" value="@search.ReturnDate.ToString("yyyy-MM-ddTHH:mm")" data-vn-datetime-hidden="return" />
            </div>

            <input type="hidden" name="BrandId" value="@search.BrandId" />
            <input type="hidden" name="Seats" value="@search.Seats" />
            <input type="hidden" name="Transmission" value="@search.Transmission" />
            <input type="hidden" name="FuelType" value="@search.FuelType" />
            <input type="hidden" name="MinDailyPrice" value="@(search.MinDailyPrice?.ToString("0"))" />
            <input type="hidden" name="MaxDailyPrice" value="@(search.MaxDailyPrice?.ToString("0"))" />
            <input type="hidden" name="MinManufactureYear" value="@search.MinManufactureYear" />
            <input type="hidden" name="SortBy" value="@search.SortBy" />

            <div class="col-lg-2 col-md-12 search-submit-column">
                <button class="btn btn-primary w-100" type="submit" data-search-submit>
                    <span data-search-submit-label>Tìm xe</span>
                    <span class="d-none search-button-loading" data-search-submit-loading>
                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                        Đang tìm...
                    </span>
                </button>
            </div>

            <div class="col-12 d-lg-none">
                <button class="btn btn-outline-primary w-100"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#advancedFilters"
                        aria-controls="advancedFilters"
                        aria-expanded="@(hasAdvancedFilters ? "true" : "false")">
                    ⚙ Bộ lọc @(activeFilterCount > 0 ? $"({activeFilterCount})" : string.Empty)
                </button>
            </div>

            <div class="col-12">
                <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
                <div class="home-search-error" data-search-error role="alert" aria-live="polite"></div>
            </div>
        </form>
    </div>

    <div class="row g-4 align-items-start">
        <aside class="col-lg-3">
            <div id="advancedFilters" class="collapse d-lg-block @(hasAdvancedFilters ? "show" : string.Empty)">
                <div class="vehicle-filter-card vehicle-filter-sticky p-3 p-xl-4">
                    <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
                        <div>
                            <div class="small text-muted text-uppercase fw-semibold">Bộ lọc</div>
                            <h2 class="h5 mb-0">Lọc xe chi tiết</h2>
                        </div>
                        @if (hasAdvancedFilters)
                        {
                            <span class="badge bg-primary rounded-pill">@activeFilterCount</span>
                        }
                    </div>

                    <form method="get" action="@searchAction" data-vehicle-filter-form>
                        <input type="hidden" name="PickupDate" value="@search.PickupDate.ToString("yyyy-MM-ddTHH:mm")" data-filter-period="pickup" />
                        <input type="hidden" name="ReturnDate" value="@search.ReturnDate.ToString("yyyy-MM-ddTHH:mm")" data-filter-period="return" />

                        <div class="mb-3">
                            <label for="filterBrand" class="form-label fw-semibold">Hãng xe</label>
                            <select id="filterBrand" name="BrandId" asp-items="ViewBag.Brands" class="form-select">
                                <option value="">Tất cả hãng</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="filterSeats" class="form-label fw-semibold">Số chỗ tối thiểu</label>
                            <select id="filterSeats" name="Seats" class="form-select">
                                <option value="">Tất cả</option>
                                @if (search.Seats == 4) { <option value="4" selected>4+ chỗ</option> } else { <option value="4">4+ chỗ</option> }
                                @if (search.Seats == 5) { <option value="5" selected>5+ chỗ</option> } else { <option value="5">5+ chỗ</option> }
                                @if (search.Seats == 7) { <option value="7" selected>7+ chỗ</option> } else { <option value="7">7+ chỗ</option> }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="filterTransmission" class="form-label fw-semibold">Hộp số</label>
                            <select id="filterTransmission" name="Transmission" class="form-select">
                                <option value="">Tất cả</option>
                                @if (search.Transmission == "Tự động") { <option value="Tự động" selected>Tự động</option> } else { <option value="Tự động">Tự động</option> }
                                @if (search.Transmission == "Số sàn") { <option value="Số sàn" selected>Số sàn</option> } else { <option value="Số sàn">Số sàn</option> }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="filterFuel" class="form-label fw-semibold">Nhiên liệu</label>
                            <select id="filterFuel" name="FuelType" class="form-select">
                                <option value="">Tất cả</option>
                                @if (search.FuelType == "Xăng") { <option value="Xăng" selected>Xăng</option> } else { <option value="Xăng">Xăng</option> }
                                @if (search.FuelType == "Dầu") { <option value="Dầu" selected>Dầu</option> } else { <option value="Dầu">Dầu</option> }
                                @if (search.FuelType == "Điện") { <option value="Điện" selected>Điện</option> } else { <option value="Điện">Điện</option> }
                                @if (search.FuelType == "Hybrid") { <option value="Hybrid" selected>Hybrid</option> } else { <option value="Hybrid">Hybrid</option> }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Khoảng giá / ngày</label>
                            <div class="row g-2">
                                <div class="col-6">
                                    <input name="MinDailyPrice" type="number" min="1" step="50000" class="form-control" value="@(search.MinDailyPrice?.ToString("0"))" placeholder="Từ" aria-label="Giá thuê tối thiểu" />
                                </div>
                                <div class="col-6">
                                    <input name="MaxDailyPrice" type="number" min="1" step="50000" class="form-control" value="@(search.MaxDailyPrice?.ToString("0"))" placeholder="Đến" aria-label="Giá thuê tối đa" />
                                </div>
                            </div>
                            <div class="form-text">Đơn vị: đồng/ngày</div>
                        </div>

                        <div class="mb-3">
                            <label for="filterYear" class="form-label fw-semibold">Đời xe</label>
                            <select id="filterYear" name="MinManufactureYear" class="form-select">
                                <option value="">Tất cả</option>
                                @if (search.MinManufactureYear == 2024) { <option value="2024" selected>2024 trở lên</option> } else { <option value="2024">2024 trở lên</option> }
                                @if (search.MinManufactureYear == 2022) { <option value="2022" selected>2022 trở lên</option> } else { <option value="2022">2022 trở lên</option> }
                                @if (search.MinManufactureYear == 2020) { <option value="2020" selected>2020 trở lên</option> } else { <option value="2020">2020 trở lên</option> }
                                @if (search.MinManufactureYear == 2018) { <option value="2018" selected>2018 trở lên</option> } else { <option value="2018">2018 trở lên</option> }
                            </select>
                        </div>

                        <div class="mb-4">
                            <label for="filterSort" class="form-label fw-semibold">Sắp xếp</label>
                            <select id="filterSort" name="SortBy" class="form-select">
                                @if (search.SortBy == "price_asc" || string.IsNullOrWhiteSpace(search.SortBy)) { <option value="price_asc" selected>Giá thấp → cao</option> } else { <option value="price_asc">Giá thấp → cao</option> }
                                @if (search.SortBy == "price_desc") { <option value="price_desc" selected>Giá cao → thấp</option> } else { <option value="price_desc">Giá cao → thấp</option> }
                                @if (search.SortBy == "year_desc") { <option value="year_desc" selected>Xe đời mới nhất</option> } else { <option value="year_desc">Xe đời mới nhất</option> }
                            </select>
                        </div>

                        <button class="btn btn-primary w-100 @(hasAdvancedFilters ? "mb-2" : string.Empty)" type="submit">Áp dụng bộ lọc</button>
                        @if (hasAdvancedFilters)
                        {
                            <a href="@resetFiltersUrl#vehicle-results" class="btn btn-outline-secondary w-100">Xóa bộ lọc</a>
                        }
                    </form>
                </div>
            </div>
        </aside>

        <div class="col-lg-9" id="vehicle-results" tabindex="-1" style="scroll-margin-top: 96px; outline: none;">
            @if (hasSearch)
            {
                <div class="alert @(Model.Count > 0 ? "alert-success" : "alert-warning") d-flex align-items-start gap-2 mb-3" role="status" aria-live="polite">
                    <span aria-hidden="true">@(Model.Count > 0 ? "✓" : "!")</span>
                    <div>
                        @if (Model.Count > 0)
                        {
                            <strong>Xe sẵn sàng trong thời gian bạn đã chọn.</strong>
                            <div>Từ <strong>@search.PickupDate.ToString("dd/MM/yyyy HH:mm")</strong> đến <strong>@search.ReturnDate.ToString("dd/MM/yyyy HH:mm")</strong>.</div>
                        }
                        else
                        {
                            <strong>Không tìm thấy xe phù hợp với điều kiện đã chọn.</strong>
                            <div>Hãy mở rộng bộ lọc hoặc thay đổi thời gian thuê.</div>
                        }
                    </div>
                </div>
            }

            <div class="vehicle-results-header mb-3">
                <div>
                    <span class="section-eyebrow">@(hasSearch ? "KẾT QUẢ TÌM KIẾM" : "XE ĐANG SẴN SÀNG")</span>
                    <h2 class="h4 mb-0">@Model.Count xe phù hợp</h2>
                </div>
                @if (hasAdvancedFilters)
                {
                    <span class="small text-muted">@activeFilterCount bộ lọc đang áp dụng</span>
                }
            </div>

            @if (hasAdvancedFilters)
            {
                <div class="d-flex flex-wrap align-items-center gap-2 mb-4" aria-label="Các bộ lọc đang áp dụng">
                    @if (search.BrandId.HasValue)
                    {
                        <a class="vehicle-filter-chip" href="@Url.Action("Index", "Vehicles", new { PickupDate = search.PickupDate, ReturnDate = search.ReturnDate, Seats = search.Seats, Transmission = search.Transmission, FuelType = search.FuelType, MinDailyPrice = search.MinDailyPrice, MaxDailyPrice = search.MaxDailyPrice, MinManufactureYear = search.MinManufactureYear, SortBy = search.SortBy })#vehicle-results">
                            @(selectedBrandName ?? "Hãng xe") <span class="chip-close" aria-hidden="true">×</span>
                        </a>
                    }
                    @if (search.Seats.HasValue)
                    {
                        <a class="vehicle-filter-chip" href="@Url.Action("Index", "Vehicles", new { PickupDate = search.PickupDate, ReturnDate = search.ReturnDate, BrandId = search.BrandId, Transmission = search.Transmission, FuelType = search.FuelType, MinDailyPrice = search.MinDailyPrice, MaxDailyPrice = search.MaxDailyPrice, MinManufactureYear = search.MinManufactureYear, SortBy = search.SortBy })#vehicle-results">
                            @search.Seats+ chỗ <span class="chip-close" aria-hidden="true">×</span>
                        </a>
                    }
                    @if (!string.IsNullOrWhiteSpace(search.Transmission))
                    {
                        <a class="vehicle-filter-chip" href="@Url.Action("Index", "Vehicles", new { PickupDate = search.PickupDate, ReturnDate = search.ReturnDate, BrandId = search.BrandId, Seats = search.Seats, FuelType = search.FuelType, MinDailyPrice = search.MinDailyPrice, MaxDailyPrice = search.MaxDailyPrice, MinManufactureYear = search.MinManufactureYear, SortBy = search.SortBy })#vehicle-results">
                            @search.Transmission <span class="chip-close" aria-hidden="true">×</span>
                        </a>
                    }
                    @if (!string.IsNullOrWhiteSpace(search.FuelType))
                    {
                        <a class="vehicle-filter-chip" href="@Url.Action("Index", "Vehicles", new { PickupDate = search.PickupDate, ReturnDate = search.ReturnDate, BrandId = search.BrandId, Seats = search.Seats, Transmission = search.Transmission, MinDailyPrice = search.MinDailyPrice, MaxDailyPrice = search.MaxDailyPrice, MinManufactureYear = search.MinManufactureYear, SortBy = search.SortBy })#vehicle-results">
                            @search.FuelType <span class="chip-close" aria-hidden="true">×</span>
                        </a>
                    }
                    @if (search.MinDailyPrice.HasValue)
                    {
                        <a class="vehicle-filter-chip" href="@Url.Action("Index", "Vehicles", new { PickupDate = search.PickupDate, ReturnDate = search.ReturnDate, BrandId = search.BrandId, Seats = search.Seats, Transmission = search.Transmission, FuelType = search.FuelType, MaxDailyPrice = search.MaxDailyPrice, MinManufactureYear = search.MinManufactureYear, SortBy = search.SortBy })#vehicle-results">
                            Từ @search.MinDailyPrice.Value.ToString("N0") đ <span class="chip-close" aria-hidden="true">×</span>
                        </a>
                    }
                    @if (search.MaxDailyPrice.HasValue)
                    {
                        <a class="vehicle-filter-chip" href="@Url.Action("Index", "Vehicles", new { PickupDate = search.PickupDate, ReturnDate = search.ReturnDate, BrandId = search.BrandId, Seats = search.Seats, Transmission = search.Transmission, FuelType = search.FuelType, MinDailyPrice = search.MinDailyPrice, MinManufactureYear = search.MinManufactureYear, SortBy = search.SortBy })#vehicle-results">
                            ≤ @search.MaxDailyPrice.Value.ToString("N0") đ <span class="chip-close" aria-hidden="true">×</span>
                        </a>
                    }
                    @if (search.MinManufactureYear.HasValue)
                    {
                        <a class="vehicle-filter-chip" href="@Url.Action("Index", "Vehicles", new { PickupDate = search.PickupDate, ReturnDate = search.ReturnDate, BrandId = search.BrandId, Seats = search.Seats, Transmission = search.Transmission, FuelType = search.FuelType, MinDailyPrice = search.MinDailyPrice, MaxDailyPrice = search.MaxDailyPrice, SortBy = search.SortBy })#vehicle-results">
                            Đời @search.MinManufactureYear+ <span class="chip-close" aria-hidden="true">×</span>
                        </a>
                    }
                    <a href="@resetFiltersUrl#vehicle-results" class="small fw-semibold ms-1">Xóa tất cả</a>
                </div>
            }

            @if (Model.Count == 0)
            {
                <div class="vehicle-empty-state">
                    <div class="vehicle-empty-icon" aria-hidden="true">🚗</div>
                    <h3 class="h5">Không tìm thấy xe phù hợp</h3>
                    <p>Thử tăng khoảng giá, giảm số chỗ tối thiểu, chọn tất cả hãng hoặc thay đổi thời gian thuê.</p>
                    <div class="vehicle-empty-actions">
                        <a href="@resetFiltersUrl#vehicle-results" class="btn btn-primary">Mở rộng điều kiện</a>
                        <button type="button" class="btn btn-outline-primary" onclick="document.getElementById('vehiclePickupDisplay')?.focus(); window.scrollTo({ top: 0, behavior: 'smooth' });">Đổi thời gian</button>
                    </div>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var vehicle in Model)
                    {
                        <div class="col-xl-4 col-md-6">
                            <article class="card h-100 shadow-sm border-0 vehicle-result-card">
                                @if (!string.IsNullOrWhiteSpace(vehicle.PrimaryImagePath))
                                {
                                    <img src="@vehicle.PrimaryImagePath" class="card-img-top vehicle-result-image" alt="@vehicle.VehicleName" />
                                }
                                else
                                {
                                    <div class="vehicle-result-placeholder">Chưa có ảnh</div>
                                }
                                <div class="card-body">
                                    <div class="d-flex justify-content-between gap-3 mb-2">
                                        <div>
                                            <span class="availability-badge vehicle-result-status">Sẵn sàng</span>
                                            <div class="featured-brand mt-2">@vehicle.BrandName</div>
                                            <h3 class="h5 mb-1">@vehicle.VehicleName</h3>
                                        </div>
                                        <div class="vehicle-result-price text-end">
                                            <strong>@vehicle.DailyPrice.ToString("N0") đ</strong>
                                            <span>/ ngày</span>
                                        </div>
                                    </div>
                                    <div class="vehicle-result-meta mt-3">
                                        <span>👥 @vehicle.Seats chỗ</span>
                                        <span>⚙ @vehicle.Transmission</span>
                                        <span>⛽ @vehicle.FuelType</span>
                                        <span>📅 @vehicle.ManufactureYear</span>
                                    </div>
                                </div>
                                <div class="card-footer bg-white border-0 pb-3">
                                    <a class="btn btn-outline-primary w-100 stretched-link"
                                       asp-action="Details"
                                       asp-route-id="@vehicle.VehicleId"
                                       asp-route-pickupDate="@search.PickupDate.ToString("O")"
                                       asp-route-returnDate="@search.ReturnDate.ToString("O")"
                                       aria-label="Xem chi tiết @vehicle.VehicleName">
                                        Xem chi tiết xe
                                    </a>
                                </div>
                            </article>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/vehicle-search.js" asp-append-version="true"></script>
}