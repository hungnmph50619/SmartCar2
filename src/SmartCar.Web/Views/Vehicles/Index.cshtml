@model IReadOnlyList<SmartCar.Application.Features.Vehicles.VehicleDto>
@using SmartCar.Web.ViewModels
@{
    ViewData["Title"] = "Tìm xe";
    var search = ViewBag.Search as VehicleSearchViewModel ?? new VehicleSearchViewModel();
    var hasSearch = Context.Request.Query.ContainsKey("PickupDate") &&
                    Context.Request.Query.ContainsKey("ReturnDate");
    var searchAction = $"{Url.Action("Index", "Vehicles")}#vehicle-results";
}

<section class="vehicle-search-page" aria-labelledby="vehicle-search-title">
    <div class="vehicle-search-card">
        <div class="vehicle-search-heading">
            <div>
                <span class="section-eyebrow">TÌM XE CÒN TRỐNG</span>
                <h1 id="vehicle-search-title" class="h3 mb-1">Chọn thời gian và nhu cầu của bạn</h1>
                <p class="text-muted mb-0">Hệ thống chỉ hiển thị những xe sẵn sàng trong khoảng thời gian đã chọn.</p>
            </div>
            <span class="vehicle-search-format">Ngày/tháng/năm · Giờ 24 giờ</span>
        </div>

        <form method="get"
              action="@searchAction"
              class="row g-3 align-items-start"
              data-vehicle-search-form
              novalidate>
            <div class="col-lg-3 col-md-6">
                <label for="vehiclePickupDisplay" class="form-label fw-semibold">Ngày giờ nhận xe</label>
                <div class="vn-datetime-control">
                    <input id="vehiclePickupDisplay"
                           type="text"
                           value="@search.PickupDate.ToString("dd/MM/yyyy HH:mm")"
                           placeholder="dd/MM/yyyy HH:mm"
                           inputmode="numeric"
                           autocomplete="off"
                           class="form-control vn-datetime-input"
                           aria-describedby="vehiclePickupHint vehiclePickupError"
                           data-vn-datetime="pickup" />
                    <svg class="vn-datetime-icon vehicle-search-date-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <rect x="3" y="5" width="18" height="16" rx="2"></rect>
                        <path d="M16 3v4M8 3v4M3 10h18"></path>
                    </svg>
                </div>
                <small id="vehiclePickupHint" class="vn-datetime-hint">Ví dụ: 06/08/2026 09:00</small>
                <span id="vehiclePickupError" class="search-field-error" data-vn-datetime-error="pickup" role="alert"></span>
                <input type="hidden"
                       name="PickupDate"
                       value="@search.PickupDate.ToString("yyyy-MM-ddTHH:mm")"
                       data-vn-datetime-hidden="pickup" />
            </div>

            <div class="col-lg-3 col-md-6">
                <label for="vehicleReturnDisplay" class="form-label fw-semibold">Ngày giờ trả xe</label>
                <div class="vn-datetime-control">
                    <input id="vehicleReturnDisplay"
                           type="text"
                           value="@search.ReturnDate.ToString("dd/MM/yyyy HH:mm")"
                           placeholder="dd/MM/yyyy HH:mm"
                           inputmode="numeric"
                           autocomplete="off"
                           class="form-control vn-datetime-input"
                           aria-describedby="vehicleReturnHint vehicleReturnError"
                           data-vn-datetime="return" />
                    <svg class="vn-datetime-icon vehicle-search-date-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <rect x="3" y="5" width="18" height="16" rx="2"></rect>
                        <path d="M16 3v4M8 3v4M3 10h18"></path>
                    </svg>
                </div>
                <small id="vehicleReturnHint" class="vn-datetime-hint">Phải sau ngày giờ nhận xe</small>
                <span id="vehicleReturnError" class="search-field-error" data-vn-datetime-error="return" role="alert"></span>
                <input type="hidden"
                       name="ReturnDate"
                       value="@search.ReturnDate.ToString("yyyy-MM-ddTHH:mm")"
                       data-vn-datetime-hidden="return" />
            </div>

            <div class="col-lg-2 col-md-4">
                <label for="vehicleBrand" class="form-label fw-semibold">Hãng xe</label>
                <select id="vehicleBrand" name="BrandId" asp-items="ViewBag.Brands" class="form-select">
                    <option value="">Tất cả</option>
                </select>
            </div>

            <div class="col-lg-2 col-md-4">
                <label for="vehicleSeats" class="form-label fw-semibold">Số chỗ tối thiểu</label>
                <select id="vehicleSeats" name="Seats" class="form-select">
                    <option value="">Tất cả</option>
                    @if (search.Seats == 4)
                    {
                        <option value="4" selected>4 chỗ</option>
                    }
                    else
                    {
                        <option value="4">4 chỗ</option>
                    }
                    @if (search.Seats == 5)
                    {
                        <option value="5" selected>5 chỗ</option>
                    }
                    else
                    {
                        <option value="5">5 chỗ</option>
                    }
                    @if (search.Seats == 7)
                    {
                        <option value="7" selected>7 chỗ</option>
                    }
                    else
                    {
                        <option value="7">7 chỗ</option>
                    }
                </select>
            </div>

            <div class="col-lg-2 col-md-4 search-submit-column">
                <button class="btn btn-primary w-100"
                        type="submit"
                        data-search-submit>
                    <span data-search-submit-label>Tìm xe</span>
                    <span class="d-none search-button-loading" data-search-submit-loading>
                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                        Đang tìm...
                    </span>
                </button>
            </div>

            <div class="col-12">
                <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
                <div class="home-search-error" data-search-error role="alert" aria-live="polite"></div>
            </div>
        </form>
    </div>

    <div id="vehicle-results"
         class="vehicle-results-section"
         tabindex="-1"
         style="scroll-margin-top: 96px; outline: none;">
        @if (hasSearch)
        {
            <div class="alert @(Model.Count > 0 ? "alert-success" : "alert-warning") d-flex align-items-start gap-2 mb-4"
                 role="status"
                 aria-live="polite">
                <span aria-hidden="true">@(Model.Count > 0 ? "✓" : "!")</span>
                <div>
                    @if (Model.Count > 0)
                    {
                        <strong>Đã tìm thấy @Model.Count xe còn trống.</strong>
                        <div>
                            Thời gian thuê từ
                            <strong>@search.PickupDate.ToString("dd/MM/yyyy HH:mm")</strong>
                            đến
                            <strong>@search.ReturnDate.ToString("dd/MM/yyyy HH:mm")</strong>.
                        </div>
                    }
                    else
                    {
                        <strong>Không tìm thấy xe phù hợp với điều kiện đã chọn.</strong>
                        <div>Hãy thay đổi thời gian, hãng xe hoặc số chỗ để tìm lại.</div>
                    }
                </div>
            </div>
        }

        <div class="vehicle-results-header">
            <div>
                <span class="section-eyebrow">@(hasSearch ? "KẾT QUẢ TÌM KIẾM" : "XE ĐANG SẴN SÀNG")</span>
                <h2 class="h4 mb-0">
                    @(hasSearch
                        ? $"{Model.Count} xe phù hợp với thời gian đã chọn"
                        : "Xe có thể thuê trong thời gian đã chọn")
                </h2>
            </div>
            <span class="vehicle-result-count">@Model.Count xe</span>
        </div>

        @if (Model.Count == 0)
        {
            <div class="vehicle-empty-state">
                <div class="vehicle-empty-icon" aria-hidden="true">🚗</div>
                <h3 class="h5">Không tìm thấy xe phù hợp</h3>
                <p>
                    Có thể xe đã được đặt trong khoảng thời gian này hoặc chưa đáp ứng số chỗ bạn chọn.
                    Hãy thay đổi thời gian hoặc mở rộng điều kiện tìm kiếm.
                </p>
                <div class="vehicle-empty-actions">
                    <button type="button"
                            class="btn btn-primary"
                            onclick="document.getElementById('vehiclePickupDisplay')?.focus(); window.scrollTo({ top: 0, behavior: 'smooth' });">
                        Thay đổi thời gian
                    </button>
                    <a asp-action="Index" class="btn btn-outline-primary">Đặt lại bộ lọc</a>
                </div>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var vehicle in Model)
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="card h-100 shadow-sm border-0 vehicle-result-card">
                            @if (!string.IsNullOrWhiteSpace(vehicle.PrimaryImagePath))
                            {
                                <img src="@vehicle.PrimaryImagePath"
                                     class="card-img-top vehicle-result-image"
                                     alt="@vehicle.VehicleName" />
                            }
                            else
                            {
                                <div class="vehicle-result-placeholder">Chưa có ảnh</div>
                            }
                            <div class="card-body">
                                <div class="d-flex justify-content-between gap-3">
                                    <div>
                                        <span class="availability-badge vehicle-result-status">Sẵn sàng</span>
                                        <h3 class="h5 mt-2">@vehicle.VehicleName</h3>
                                        <p class="text-muted mb-0">@vehicle.BrandName · @vehicle.Seats chỗ · @vehicle.Transmission</p>
                                    </div>
                                    <div class="vehicle-result-price text-end">
                                        <strong>@vehicle.DailyPrice.ToString("N0") đ</strong>
                                        <span>/ ngày</span>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer bg-white border-0 pb-3">
                                <a class="btn btn-outline-primary w-100"
                                   asp-action="Details"
                                   asp-route-id="@vehicle.VehicleId"
                                   asp-route-pickupDate="@search.PickupDate"
                                   asp-route-returnDate="@search.ReturnDate">
                                    Xem chi tiết xe
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@section Scripts {
    <script src="~/js/vehicle-search.js" asp-append-version="true"></script>
}
