@model SmartCar.Application.Features.Vehicles.VehicleDto
@using SmartCar.Application.Features.Reviews
@using SmartCar.Domain.Constants
@{
    ViewData["Title"] = Model.VehicleName;
    var pickupDate = (DateTime)ViewBag.PickupDate;
    var returnDate = (DateTime)ViewBag.ReturnDate;
    var numberOfDays = Math.Max(1, (int)Math.Ceiling((returnDate - pickupDate).TotalHours / 24d));
    var estimatedAmount = numberOfDays * Model.DailyPrice;
    var reviews = ViewBag.Reviews as IReadOnlyList<ReviewDto> ?? Array.Empty<ReviewDto>();
    var averageRating = (double)(ViewBag.AverageRating ?? 0d);
    var kycVerified = ViewBag.KycVerified is bool verified && verified;
    var kycVerifiedCount = ViewBag.KycVerifiedCount is int count ? count : 0;
    var kycTotal = ViewBag.KycTotal is int total ? total : 2;
    var citizenApproved = ViewBag.CitizenApproved is bool citizenOk && citizenOk;
    var licenseApproved = ViewBag.LicenseApproved is bool licenseOk && licenseOk;
    var citizenValidForRental = ViewBag.CitizenValidForRental is bool citizenRentalOk && citizenRentalOk;
    var licenseValidForRental = ViewBag.LicenseValidForRental is bool licenseRentalOk && licenseRentalOk;
    var citizenExpiryDate = ViewBag.CitizenExpiryDate is DateTime citizenExpiry ? citizenExpiry : (DateTime?)null;
    var licenseExpiryDate = ViewBag.LicenseExpiryDate is DateTime licenseExpiry ? licenseExpiry : (DateTime?)null;
    var allDocumentsApproved = citizenApproved && licenseApproved;
    var hasBankAccount = ViewBag.HasBankAccount is bool hasBank && hasBank;

    var smartCarPickupLocation = DeliveryConstants.SmartCarLocation;
    var smartCarMapQuery = DeliveryConstants.SmartCarMapQuery;
    var deliveryRatePerKm = DeliveryConstants.RatePerKm;
    var maxDeliveryKm = DeliveryConstants.MaxDistancePerLegKm;
    var smartCarMapUrl = $"https://www.google.com/maps?q={Uri.EscapeDataString(smartCarMapQuery)}&output=embed";
    var smartCarSearchUrl = $"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(smartCarMapQuery)}";
}

<style>
    .location-choice {
        cursor: pointer;
        transition: border-color .18s ease, box-shadow .18s ease, background-color .18s ease;
    }
    .location-choice.active {
        border-color: var(--bs-primary) !important;
        box-shadow: 0 0 0 .15rem rgba(13,110,253,.08);
        background: #f8fbff !important;
    }
    .location-result {
        cursor: pointer;
        transition: background-color .15s ease;
    }
    .location-result:hover { background: #f8f9fa; }
    .delivery-map-frame { min-height: 240px; }
</style>

<div class="row g-4 align-items-start">
    <div class="col-lg-7">
        @if (Model.Images.Count > 0)
        {
            <div class="row g-2 mb-4">
            @foreach (var image in Model.Images)
            {
                <div class="col-6">
                    <img src="@image.ImagePath" class="img-fluid rounded-3 w-100 shadow-sm" style="height:240px;object-fit:cover" alt="@Model.VehicleName" />
                </div>
            }
            </div>
        }
        else
        {
            <div class="bg-light rounded-3 d-flex align-items-center justify-content-center mb-4 shadow-sm" style="height:360px">Xe chưa có ảnh</div>
        }

        <div class="card card-body shadow-sm border-0 mb-4">
            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3">
                <div>
                    <div class="text-uppercase small text-muted fw-semibold">Thông tin xe</div>
                    <h2 class="h4 mb-1">@Model.VehicleName</h2>
                    <div class="text-muted">@Model.BrandName · @Model.Model · @Model.LicensePlate</div>
                </div>
                <div class="text-end">
                    <div class="text-warning fw-semibold">★ @(reviews.Count == 0 ? "Chưa có đánh giá" : $"{averageRating:F1}/5")</div>
                    @if (reviews.Count > 0)
                    {
                        <small class="text-muted">@reviews.Count lượt đánh giá</small>
                    }
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-6 col-md-3"><div class="bg-light rounded-3 p-3 h-100"><div class="small text-muted">Số chỗ</div><strong>@Model.Seats chỗ</strong></div></div>
                <div class="col-6 col-md-3"><div class="bg-light rounded-3 p-3 h-100"><div class="small text-muted">Hộp số</div><strong>@Model.Transmission</strong></div></div>
                <div class="col-6 col-md-3"><div class="bg-light rounded-3 p-3 h-100"><div class="small text-muted">Nhiên liệu</div><strong>@Model.FuelType</strong></div></div>
                <div class="col-6 col-md-3"><div class="bg-light rounded-3 p-3 h-100"><div class="small text-muted">Năm sản xuất</div><strong>@Model.ManufactureYear</strong></div></div>
            </div>

            <h3 class="h6">Mô tả</h3>
            <p class="text-muted mb-0">@(string.IsNullOrWhiteSpace(Model.Description) ? "Xe thuộc đội xe SmartCar và được kiểm tra trước mỗi lượt thuê." : Model.Description)</p>
        </div>

        <div class="card shadow-sm border-0 mb-4" id="pickup-map">
            <div class="card-body pb-0">
                <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3">
                    <div>
                        <div class="text-uppercase small text-muted fw-semibold">Vị trí xe</div>
                        <h2 class="h4 mb-1">Điểm giao nhận SmartCar - Đống Đa</h2>
                        <div class="text-muted">@smartCarPickupLocation</div>
                    </div>
                    <span class="badge bg-light text-dark border">Điểm demo Hà Nội</span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <div class="border rounded-3 p-3 h-100">
                            <div class="small text-muted">Khách tự đến lấy xe</div>
                            <strong class="text-success">Miễn phí</strong>
                            <div class="small text-muted mt-1">Nhận và trả tại điểm SmartCar ở Đống Đa.</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="border rounded-3 p-3 h-100">
                            <div class="small text-muted">Giao nhận tận nơi trong Hà Nội</div>
                            <strong>@deliveryRatePerKm.ToString("N0") đ/km/lượt</strong>
                            <div class="small text-muted mt-1">Mỗi lượt tối đa @maxDeliveryKm.ToString("N0") km đường bộ từ SmartCar.</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="ratio ratio-16x9 border-top">
                <iframe title="Bản đồ điểm giao nhận SmartCar tại Đống Đa"
                        src="@smartCarMapUrl"
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"
                        style="border:0"
                        allowfullscreen></iframe>
            </div>

            <div class="card-body pt-3">
                <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap">
                    <div class="small text-muted">Đây là điểm gốc dùng để tính quãng đường giao và nhận xe.</div>
                    <a class="btn btn-sm btn-outline-primary" href="@smartCarSearchUrl" target="_blank" rel="noopener noreferrer">Mở Google Maps</a>
                </div>
            </div>
        </div>

        <div class="card card-body shadow-sm border-0 mb-4">
            <div class="text-uppercase small text-muted fw-semibold">Phụ phí có thể phát sinh</div>
            <h2 class="h4 mb-3">Thông tin trước khi thuê</h2>
            <div class="d-flex justify-content-between py-2 border-bottom gap-3">
                <div><strong>Giao nhận tận nơi</strong><div class="small text-muted">Tính theo quãng đường ô tô từ điểm SmartCar.</div></div>
                <div class="text-end fw-semibold">@deliveryRatePerKm.ToString("N0") đ/km/lượt</div>
            </div>
            <div class="d-flex justify-content-between py-2 border-bottom gap-3">
                <div><strong>Trả xe quá giờ</strong><div class="small text-muted">Chỉ tính khi thời gian trả thực tế vượt thời gian đã chốt.</div></div>
                <div class="text-end text-muted">Theo quy định đơn thuê</div>
            </div>
            <div class="d-flex justify-content-between py-2 border-bottom gap-3">
                <div><strong>Nhiên liệu / vệ sinh</strong><div class="small text-muted">Đối chiếu biên bản giao xe và trả xe.</div></div>
                <div class="text-end text-muted">Theo phát sinh thực tế</div>
            </div>
            <div class="d-flex justify-content-between pt-2 gap-3">
                <div><strong>Hư hỏng / vi phạm</strong><div class="small text-muted">Phải có bằng chứng hoặc căn cứ xử lý.</div></div>
                <div class="text-end text-muted">Xác nhận sau kiểm tra</div>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card card-body shadow-sm sticky-top border-0" style="top:1rem">
            <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
                <div>
                    <h1 class="h3 mb-1">@Model.VehicleName</h1>
                    <p class="text-muted mb-0">@Model.BrandName · @Model.Model · @Model.LicensePlate</p>
                </div>
                <span class="badge bg-light text-dark border">@Model.Seats chỗ</span>
            </div>

            <div class="mb-3">
                <span class="text-warning fs-5">★</span>
                <strong>@(reviews.Count == 0 ? "Chưa có đánh giá" : $"{averageRating:F1}/5")</strong>
                @if (reviews.Count > 0)
                {
                    <span class="text-muted">(@reviews.Count lượt)</span>
                }
            </div>

            <div class="border rounded-3 p-3 mb-3 bg-light">
                <div class="d-flex justify-content-between align-items-center mb-2"><strong>Nhận xe</strong><span>@pickupDate.ToString("dd/MM/yyyy HH:mm")</span></div>
                <div class="d-flex justify-content-between align-items-center mb-2"><strong>Trả xe</strong><span>@returnDate.ToString("dd/MM/yyyy HH:mm")</span></div>
                <div class="d-flex justify-content-between align-items-center"><strong>Số ngày tính phí</strong><span>@numberOfDays</span></div>
            </div>

            @if (User.Identity?.IsAuthenticated == true && User.IsInRole(RoleNames.Customer))
            {
                @if (kycVerified)
                {
                    @if (hasBankAccount)
                    {
                        <form asp-controller="Bookings" asp-action="Create" method="post" data-loading-form id="booking-location-form">
                            <input type="hidden" name="VehicleId" value="@Model.VehicleId" />
                            <input type="hidden" name="PickupDate" value="@pickupDate.ToString("O")" />
                            <input type="hidden" name="ReturnDate" value="@returnDate.ToString("O")" />
                            <input type="hidden" name="PickupMethod" id="pickupMethodInput" value="@DeliveryConstants.SelfPickup" />
                            <input type="hidden" name="PickupLocation" id="pickupLocation" value="@smartCarPickupLocation" />
                            <input type="hidden" name="ReturnLocation" id="returnLocation" value="@smartCarPickupLocation" />

                            <div class="mb-3">
                                <div class="text-uppercase small text-muted fw-semibold mb-1">Vị trí nhận xe</div>
                                <div class="fw-bold mb-3">Chọn cách nhận xe</div>

                                <label class="location-choice active border rounded-3 p-3 mb-2 d-block bg-white" id="selfPickupCard" for="pickupAtSmartCar">
                                    <div class="d-flex gap-2 align-items-start">
                                        <input class="form-check-input mt-1" type="radio" name="PickupMethodOption" id="pickupAtSmartCar" value="@DeliveryConstants.SelfPickup" checked />
                                        <div class="flex-grow-1">
                                            <div class="d-flex justify-content-between gap-2">
                                                <strong>Khách nhận tại vị trí xe đậu</strong>
                                                <span class="text-success fw-semibold">Miễn phí</span>
                                            </div>
                                            <div class="small text-muted mt-1">@smartCarPickupLocation</div>
                                            <div class="d-flex justify-content-between align-items-center mt-2 gap-2 flex-wrap">
                                                <span class="small text-muted">Đống Đa, Hà Nội</span>
                                                <a href="#pickup-map" class="small text-decoration-none">Xem vị trí</a>
                                            </div>
                                        </div>
                                    </div>
                                </label>

                                <label class="location-choice border rounded-3 p-3 d-block bg-white" id="deliveryCard" for="pickupDelivery">
                                    <div class="d-flex gap-2 align-items-start">
                                        <input class="form-check-input mt-1" type="radio" name="PickupMethodOption" id="pickupDelivery" value="@DeliveryConstants.HomeDelivery" />
                                        <div class="flex-grow-1">
                                            <div class="d-flex justify-content-between gap-2">
                                                <strong>SmartCar giao & nhận xe tận nơi</strong>
                                                <span id="deliveryChoicePrice" class="text-primary fw-semibold">@deliveryRatePerKm.ToString("N0") đ/km/lượt</span>
                                            </div>
                                            <div class="small text-muted mt-1">Chọn chính xác địa điểm trên danh sách gợi ý và bản đồ.</div>
                                            <div class="small text-muted">Chỉ hỗ trợ trong Hà Nội, tối đa @maxDeliveryKm.ToString("N0") km/lượt.</div>
                                        </div>
                                    </div>
                                </label>

                                <div id="deliveryAddressPanel" class="border rounded-3 p-3 mt-2 d-none">
                                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                        <div>
                                            <div class="small text-muted">Địa điểm giao xe</div>
                                            <strong id="pickupLocationDisplay">Chưa chọn địa điểm</strong>
                                        </div>
                                        <button type="button" class="btn btn-sm btn-outline-primary" id="choosePickupLocation">Chọn địa điểm</button>
                                    </div>

                                    <div id="pickupMapPanel" class="d-none mt-3">
                                        <div class="ratio ratio-16x9 border rounded-3 overflow-hidden">
                                            <iframe id="pickupMapFrame" class="delivery-map-frame" title="Bản đồ địa điểm giao xe" loading="lazy" style="border:0"></iframe>
                                        </div>
                                        <div class="d-flex justify-content-between gap-2 mt-2 small flex-wrap">
                                            <span id="pickupMapCaption" class="text-muted"></span>
                                            <a id="pickupDirectionsLink" href="#" target="_blank" rel="noopener noreferrer" class="text-decoration-none">Mở tuyến đường</a>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="border rounded-3 p-3 mb-3">
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                    <div>
                                        <div class="text-uppercase small text-muted fw-semibold">Trả xe</div>
                                        <div class="fw-bold">Địa điểm trả xe</div>
                                    </div>
                                    <span class="badge bg-light text-dark border">@returnDate.ToString("HH:mm dd/MM")</span>
                                </div>

                                <div class="form-check form-switch mb-3">
                                    <input class="form-check-input" type="checkbox" role="switch" id="sameReturnLocation" checked />
                                    <label class="form-check-label" for="sameReturnLocation">
                                        <strong>Trả tại cùng địa điểm nhận xe</strong>
                                        <span class="d-block small text-muted">Nếu SmartCar phải đến nhận lại xe, lượt nhận lại cũng tính theo km.</span>
                                    </label>
                                </div>

                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div>
                                        <div class="small text-muted">Địa điểm trả</div>
                                        <strong id="returnLocationDisplay">@smartCarPickupLocation</strong>
                                    </div>
                                    <button type="button" id="chooseReturnLocation" class="btn btn-sm btn-outline-primary d-none">Chọn địa điểm khác</button>
                                </div>

                                <div id="returnMapPanel" class="d-none mt-3">
                                    <div class="ratio ratio-16x9 border rounded-3 overflow-hidden">
                                        <iframe id="returnMapFrame" class="delivery-map-frame" title="Bản đồ địa điểm trả xe" loading="lazy" style="border:0"></iframe>
                                    </div>
                                </div>
                            </div>

                            <div class="border rounded-3 p-3 mb-3">
                                <div class="text-uppercase small text-muted fw-semibold mb-2">Chi tiết chi phí</div>
                                <div class="d-flex justify-content-between mb-2"><span>Tiền thuê xe</span><strong>@estimatedAmount.ToString("N0") đ</strong></div>
                                <div id="pickupDeliveryDetail" class="d-flex justify-content-between small mb-1 d-none"><span>Giao xe tận nơi</span><strong id="pickupDeliveryDetailValue"></strong></div>
                                <div id="returnCollectionDetail" class="d-flex justify-content-between small mb-1 d-none"><span>Nhận lại xe</span><strong id="returnCollectionDetailValue"></strong></div>
                                <div class="d-flex justify-content-between mb-2"><span>Phí giao nhận</span><strong id="deliveryFeeText" class="text-success">Miễn phí</strong></div>
                                <div id="deliveryFormula" class="small text-muted d-none"></div>
                                <hr class="my-2" />
                                <div class="d-flex justify-content-between fs-5"><span>Tổng dự kiến</span><strong id="grandTotalText" class="text-primary">@estimatedAmount.ToString("N0") đ</strong></div>
                                <div class="small text-muted mt-2" id="priceNote">Tự đến nhận và trả tại SmartCar không phát sinh phí giao nhận.</div>
                            </div>

                            <div id="deliveryQuoteStatus" class="alert alert-light border py-2 small mb-3">Chọn hình thức nhận xe và địa điểm. Hệ thống sẽ tự tính quãng đường và phí.</div>

                            <div class="alert alert-success py-2 mb-3">
                                <strong>✓ Hồ sơ đã đủ điều kiện.</strong> Giấy tờ và tài khoản nhận hoàn tiền đã sẵn sàng.
                            </div>

                            <button id="bookingSubmitButton" class="btn btn-primary btn-lg w-100" type="submit" data-loading-text="Đang gửi yêu cầu...">Gửi yêu cầu thuê xe</button>
                        </form>
                    }
                    else
                    {
                        <div class="border rounded-3 p-3 mb-3 bg-light">
                            <div class="fw-bold">🏦 Cần thêm tài khoản ngân hàng</div>
                            <div class="small text-muted mt-1">Trước khi đặt xe, bạn cần lưu tài khoản ngân hàng để SmartCar có thể hoàn tiền, hoàn cọc hoặc chuyển trả các khoản phát sinh khi cần.</div>
                        </div>
                        <a class="btn btn-primary btn-lg w-100" asp-controller="Profile" asp-action="Index" asp-route-tab="banking" asp-route-returnVehicleId="@Model.VehicleId" asp-route-pickupDate="@pickupDate.ToString("O")" asp-route-returnDate="@returnDate.ToString("O")">Thêm tài khoản ngân hàng</a>
                    }
                }
                else if (allDocumentsApproved)
                {
                    <div class="border border-warning rounded-3 p-3 mb-3 bg-light">
                        <div class="fw-bold mb-2">⚠ Giấy tờ không đủ thời hạn cho chuyến thuê</div>
                        <div class="small mb-1"><strong>CCCD:</strong> ✓ Đã xác minh · Hết hạn @(citizenExpiryDate?.ToString("dd/MM/yyyy") ?? "chưa xác định") @if (!citizenValidForRental) { <span class="text-danger fw-semibold"> · Không đủ hiệu lực</span> }</div>
                        <div class="small mb-2"><strong>GPLX:</strong> ✓ Đã xác minh · Hết hạn @(licenseExpiryDate?.ToString("dd/MM/yyyy") ?? "chưa xác định") @if (!licenseValidForRental) { <span class="text-danger fw-semibold"> · Không đủ hiệu lực</span> }</div>
                        <div class="small text-muted">Chuyến thuê kết thúc ngày <strong>@returnDate.ToString("dd/MM/yyyy")</strong>. CCCD và GPLX phải còn hiệu lực ít nhất đến ngày trả xe.</div>
                    </div>
                    <a class="btn btn-primary btn-lg w-100" asp-controller="Profile" asp-action="Index" asp-route-tab="documents" asp-route-returnVehicleId="@Model.VehicleId" asp-route-pickupDate="@pickupDate.ToString("O")" asp-route-returnDate="@returnDate.ToString("O")">Cập nhật giấy tờ để tiếp tục</a>
                }
                else
                {
                    <div class="border rounded-3 p-3 mb-3 bg-light">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
                            <div><div class="fw-bold">🔒 Cần xác minh để thuê xe</div><div class="small text-muted mt-1">Hoàn tất xác minh CCCD và GPLX trước khi gửi yêu cầu.</div></div>
                            <span class="badge bg-warning text-dark">@kycVerifiedCount/@kycTotal</span>
                        </div>
                        <div class="small text-muted">① CCCD: thông tin + 2 ảnh &nbsp;·&nbsp; ② GPLX: thông tin + 2 ảnh</div>
                    </div>
                    <a class="btn btn-primary btn-lg w-100" asp-controller="Profile" asp-action="Index" asp-route-tab="documents" asp-route-returnVehicleId="@Model.VehicleId" asp-route-pickupDate="@pickupDate.ToString("O")" asp-route-returnDate="@returnDate.ToString("O")">Xác minh để thuê xe</a>
                }
            }
            else if (User.Identity?.IsAuthenticated != true)
            {
                <a class="btn btn-primary btn-lg w-100" asp-controller="Account" asp-action="Login">Đăng nhập để thuê xe</a>
            }
        </div>
    </div>
</div>

<div class="card card-body shadow-sm border-0 mt-4">
    <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-3">
        <div><div class="text-uppercase small text-muted fw-semibold">Trải nghiệm thực tế</div><h2 class="h4 mb-0">Đánh giá từ khách hàng</h2></div>
        @if (reviews.Count > 0)
        {
            <div><span class="text-warning">★</span> <strong>@averageRating.ToString("F1")/5</strong> <span class="text-muted">· @reviews.Count lượt</span></div>
        }
    </div>
    @if (reviews.Count == 0)
    {
        <p class="text-muted mb-0">Xe chưa có đánh giá sau chuyến thuê.</p>
    }
    else
    {
        <div class="row g-3">
        @foreach (var review in reviews)
        {
            <div class="col-md-6"><div class="border rounded-3 p-3 h-100"><div class="d-flex justify-content-between"><strong>@review.CustomerName</strong><span class="text-warning">@string.Concat(Enumerable.Repeat("★", review.Rating))</span></div><p class="mb-1 mt-2">@(string.IsNullOrWhiteSpace(review.Comment) ? "Khách hàng không để lại nhận xét." : review.Comment)</p><small class="text-muted">@review.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</small></div></div>
        }
        </div>
    }
</div>

<div class="modal fade" id="locationPickerModal" tabindex="-1" aria-labelledby="locationPickerTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h2 class="modal-title h4 w-100 text-center" id="locationPickerTitle">Địa điểm</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body p-4">
                <div class="input-group input-group-lg mb-3">
                    <span class="input-group-text bg-white">⌕</span>
                    <input type="search" id="locationSearchInput" class="form-control" autocomplete="off" placeholder="Nhập tên đường, địa điểm hoặc quận tại Hà Nội" />
                    <button type="button" id="locationSearchButton" class="btn btn-primary">Tìm</button>
                </div>
                <div class="small text-muted mb-3">Ví dụ: Xuân Phương, Đại Cồ Việt, Nguyễn Trãi, Cầu Giấy...</div>
                <div id="locationSearchStatus" class="alert alert-light border small">Nhập ít nhất 2 ký tự rồi bấm Tìm. SmartCar chỉ nhận địa điểm trong Hà Nội.</div>
                <div id="locationSearchResults" class="list-group list-group-flush border rounded-3 overflow-hidden"></div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const form = document.getElementById("booking-location-form");
        if (!form) return;

        const pickupAtSmartCar = document.getElementById("pickupAtSmartCar");
        const pickupDelivery = document.getElementById("pickupDelivery");
        const selfPickupCard = document.getElementById("selfPickupCard");
        const deliveryCard = document.getElementById("deliveryCard");
        const pickupMethodInput = document.getElementById("pickupMethodInput");
        const pickupLocation = document.getElementById("pickupLocation");
        const returnLocation = document.getElementById("returnLocation");
        const pickupLocationDisplay = document.getElementById("pickupLocationDisplay");
        const returnLocationDisplay = document.getElementById("returnLocationDisplay");
        const deliveryAddressPanel = document.getElementById("deliveryAddressPanel");
        const sameReturnLocation = document.getElementById("sameReturnLocation");
        const choosePickupLocation = document.getElementById("choosePickupLocation");
        const chooseReturnLocation = document.getElementById("chooseReturnLocation");
        const pickupMapPanel = document.getElementById("pickupMapPanel");
        const pickupMapFrame = document.getElementById("pickupMapFrame");
        const pickupMapCaption = document.getElementById("pickupMapCaption");
        const pickupDirectionsLink = document.getElementById("pickupDirectionsLink");
        const returnMapPanel = document.getElementById("returnMapPanel");
        const returnMapFrame = document.getElementById("returnMapFrame");
        const quoteStatus = document.getElementById("deliveryQuoteStatus");
        const deliveryFeeText = document.getElementById("deliveryFeeText");
        const deliveryChoicePrice = document.getElementById("deliveryChoicePrice");
        const grandTotalText = document.getElementById("grandTotalText");
        const priceNote = document.getElementById("priceNote");
        const deliveryFormula = document.getElementById("deliveryFormula");
        const submitButton = document.getElementById("bookingSubmitButton");
        const pickupDetail = document.getElementById("pickupDeliveryDetail");
        const pickupDetailValue = document.getElementById("pickupDeliveryDetailValue");
        const returnDetail = document.getElementById("returnCollectionDetail");
        const returnDetailValue = document.getElementById("returnCollectionDetailValue");

        const modalElement = document.getElementById("locationPickerModal");
        const modal = window.bootstrap ? new bootstrap.Modal(modalElement) : null;
        const modalTitle = document.getElementById("locationPickerTitle");
        const searchInput = document.getElementById("locationSearchInput");
        const searchButton = document.getElementById("locationSearchButton");
        const searchStatus = document.getElementById("locationSearchStatus");
        const searchResults = document.getElementById("locationSearchResults");

        const smartCarLocation = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(smartCarPickupLocation));
        const smartCarMapQuery = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(smartCarMapQuery));
        const quoteUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("DeliveryQuote", "Bookings")));
        const searchUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("SearchLocations", "Bookings")));
        const baseRentalAmount = @estimatedAmount.ToString(System.Globalization.CultureInfo.InvariantCulture);
        const selfPickupMethod = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(DeliveryConstants.SelfPickup));
        const homeDeliveryMethod = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(DeliveryConstants.HomeDelivery));
        const ratePerKm = @deliveryRatePerKm.ToString(System.Globalization.CultureInfo.InvariantCulture);

        let pickerTarget = "pickup";
        let pickupPoint = null;
        let returnPoint = null;
        let quotedSignature = null;

        function money(value) {
            return new Intl.NumberFormat("vi-VN", { maximumFractionDigits: 0 }).format(value) + " đ";
        }

        function km(value) {
            return Number(value).toLocaleString("vi-VN", { maximumFractionDigits: 1 }) + " km";
        }

        function currentSignature() {
            return [pickupMethodInput.value, pickupLocation.value.trim(), returnLocation.value.trim()].join("|");
        }

        function osmEmbedUrl(latitude, longitude) {
            const lat = Number(latitude);
            const lon = Number(longitude);
            const delta = 0.008;
            const bbox = [lon - delta, lat - delta, lon + delta, lat + delta].join(",");
            return "https://www.openstreetmap.org/export/embed.html?bbox=" + encodeURIComponent(bbox) + "&layer=mapnik&marker=" + encodeURIComponent(lat + "," + lon);
        }

        function googleDirections(destination) {
            return "https://www.google.com/maps/dir/?api=1&origin=" + encodeURIComponent(smartCarMapQuery) + "&destination=" + encodeURIComponent(destination);
        }

        function showSelectedMap(target, point) {
            if (!point) return;
            if (target === "pickup") {
                pickupMapFrame.src = osmEmbedUrl(point.latitude, point.longitude);
                pickupMapCaption.textContent = point.displayName;
                pickupDirectionsLink.href = googleDirections(point.displayName);
                pickupMapPanel.classList.remove("d-none");
            } else {
                returnMapFrame.src = osmEmbedUrl(point.latitude, point.longitude);
                returnMapPanel.classList.remove("d-none");
            }
        }

        function openPicker(target) {
            pickerTarget = target;
            modalTitle.textContent = target === "pickup" ? "Chọn địa điểm giao xe" : "Chọn địa điểm trả xe";
            searchInput.value = "";
            searchResults.innerHTML = "";
            searchStatus.textContent = "Nhập tên đường, địa điểm hoặc quận tại Hà Nội rồi bấm Tìm.";
            searchStatus.className = "alert alert-light border small";
            if (modal) {
                modal.show();
                setTimeout(() => searchInput.focus(), 250);
            }
        }

        async function searchLocations() {
            const query = searchInput.value.trim();
            if (query.length < 2) {
                searchStatus.textContent = "Vui lòng nhập ít nhất 2 ký tự.";
                searchStatus.className = "alert alert-warning small";
                return;
            }

            searchButton.disabled = true;
            searchButton.textContent = "Đang tìm...";
            searchResults.innerHTML = "";
            searchStatus.textContent = "Đang tìm các địa điểm phù hợp trong Hà Nội...";
            searchStatus.className = "alert alert-info small";

            try {
                const response = await fetch(searchUrl + "?" + new URLSearchParams({ query }), {
                    headers: { "Accept": "application/json" }
                });
                if (!response.ok) throw new Error("Không thể kết nối dịch vụ tìm địa điểm.");
                const result = await response.json();
                if (!result.succeeded) throw new Error(result.error || "Không thể tìm địa điểm.");

                const items = Array.isArray(result.results) ? result.results : [];
                if (items.length === 0) {
                    searchStatus.textContent = "Không tìm thấy địa điểm phù hợp trong Hà Nội. Hãy thử từ khóa rõ hơn.";
                    searchStatus.className = "alert alert-warning small";
                    return;
                }

                searchStatus.textContent = "Chọn đúng địa điểm trong danh sách bên dưới.";
                searchStatus.className = "alert alert-success small";

                items.forEach(item => {
                    const button = document.createElement("button");
                    button.type = "button";
                    button.className = "list-group-item list-group-item-action location-result p-3 text-start";
                    button.innerHTML = '<div class="d-flex gap-3"><div class="fs-5">⌖</div><div><div class="fw-semibold">' + escapeHtml(item.displayName) + '</div><div class="small text-muted mt-1">Hà Nội · Chọn địa điểm này</div></div></div>';
                    button.addEventListener("click", function () { selectLocation(item); });
                    searchResults.appendChild(button);
                });
            } catch (error) {
                searchStatus.textContent = error.message || "Không thể tìm địa điểm.";
                searchStatus.className = "alert alert-danger small";
            } finally {
                searchButton.disabled = false;
                searchButton.textContent = "Tìm";
            }
        }

        function escapeHtml(value) {
            return String(value)
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#039;");
        }

        function selectLocation(item) {
            const point = {
                displayName: item.displayName,
                latitude: Number(item.latitude),
                longitude: Number(item.longitude)
            };

            if (pickerTarget === "pickup") {
                pickupPoint = point;
                pickupLocation.value = point.displayName;
                pickupLocationDisplay.textContent = point.displayName;
                showSelectedMap("pickup", point);

                if (sameReturnLocation.checked) {
                    returnPoint = point;
                    returnLocation.value = point.displayName;
                    returnLocationDisplay.textContent = point.displayName;
                    returnMapPanel.classList.add("d-none");
                }
            } else {
                returnPoint = point;
                returnLocation.value = point.displayName;
                returnLocationDisplay.textContent = point.displayName;
                showSelectedMap("return", point);
            }

            if (modal) modal.hide();
            resetQuote("Đang tính quãng đường và phí cho địa điểm vừa chọn...");
            calculateQuote();
        }

        function resetQuote(message) {
            quotedSignature = null;
            pickupDetail.classList.add("d-none");
            returnDetail.classList.add("d-none");
            deliveryFormula.classList.add("d-none");
            deliveryFeeText.textContent = "Chưa tính";
            deliveryFeeText.className = "text-warning";
            deliveryChoicePrice.textContent = money(ratePerKm).replace(" đ", " đ/km/lượt");
            grandTotalText.textContent = money(baseRentalAmount);
            quoteStatus.textContent = message || "Hãy chọn địa điểm để hệ thống tính quãng đường và phí.";
            quoteStatus.className = "alert alert-light border py-2 small mb-3";
            priceNote.textContent = "Phí giao nhận sẽ được cộng vào tổng tiền sau khi tính quãng đường.";
            submitButton.disabled = true;
        }

        function applyFreeQuote() {
            quotedSignature = currentSignature();
            pickupDetail.classList.add("d-none");
            returnDetail.classList.add("d-none");
            deliveryFormula.classList.add("d-none");
            deliveryFeeText.textContent = "Miễn phí";
            deliveryFeeText.className = "text-success";
            deliveryChoicePrice.textContent = money(ratePerKm).replace(" đ", " đ/km/lượt");
            grandTotalText.textContent = money(baseRentalAmount);
            quoteStatus.textContent = "Tự đến nhận và trả tại SmartCar: không phát sinh phí giao nhận.";
            quoteStatus.className = "alert alert-success py-2 small mb-3";
            priceNote.textContent = "Tổng dự kiến hiện chỉ gồm tiền thuê xe.";
            submitButton.disabled = false;
        }

        async function calculateQuote() {
            const pickup = pickupLocation.value.trim();
            const returned = returnLocation.value.trim();

            if (!pickup || !returned) {
                resetQuote("Vui lòng chọn đầy đủ địa điểm nhận và trả xe.");
                return;
            }

            if (pickupAtSmartCar.checked && sameReturnLocation.checked) {
                applyFreeQuote();
                return;
            }

            submitButton.disabled = true;
            quoteStatus.textContent = "Đang tính quãng đường ô tô và phí giao nhận...";
            quoteStatus.className = "alert alert-info py-2 small mb-3";

            try {
                const query = new URLSearchParams({
                    pickupMethod: pickupMethodInput.value,
                    pickupLocation: pickup,
                    returnLocation: returned
                });
                const response = await fetch(quoteUrl + "?" + query.toString(), {
                    headers: { "Accept": "application/json" }
                });
                if (!response.ok) throw new Error("Không thể kết nối dịch vụ tính phí.");
                const result = await response.json();
                if (!result.succeeded) throw new Error(result.error || "Không thể tính phí giao nhận.");

                const pickupKm = Number(result.pickupDeliveryDistanceKm || 0);
                const returnKm = Number(result.returnCollectionDistanceKm || 0);
                const deliveryFee = Number(result.deliveryFee || 0);
                const totalKm = Number(result.totalDistanceKm || 0);
                const actualRate = Number(result.deliveryRatePerKm || ratePerKm);

                pickupDetail.classList.toggle("d-none", pickupKm <= 0);
                returnDetail.classList.toggle("d-none", returnKm <= 0);
                if (pickupKm > 0) pickupDetailValue.textContent = km(pickupKm);
                if (returnKm > 0) returnDetailValue.textContent = km(returnKm);

                deliveryFeeText.textContent = deliveryFee > 0 ? money(deliveryFee) : "Miễn phí";
                deliveryFeeText.className = deliveryFee > 0 ? "text-primary" : "text-success";
                deliveryChoicePrice.textContent = deliveryFee > 0 ? "+" + money(deliveryFee) : money(actualRate).replace(" đ", " đ/km/lượt");
                grandTotalText.textContent = money(baseRentalAmount + deliveryFee);

                if (deliveryFee > 0) {
                    deliveryFormula.textContent = km(totalKm) + " × " + money(actualRate).replace(" đ", " đ/km") + " = " + money(deliveryFee);
                    deliveryFormula.classList.remove("d-none");
                } else {
                    deliveryFormula.classList.add("d-none");
                }

                quoteStatus.textContent = "Đã xác định quãng đường và phí giao nhận. Số tiền này sẽ được kiểm tra lại trên máy chủ khi tạo đơn.";
                quoteStatus.className = "alert alert-success py-2 small mb-3";
                priceNote.textContent = "Tổng dự kiến = tiền thuê xe + phí giao nhận. Phụ phí sau trả xe chưa tính ở bước này.";
                quotedSignature = currentSignature();
                submitButton.disabled = false;
            } catch (error) {
                resetQuote(error.message || "Không thể tính phí giao nhận.");
                quoteStatus.className = "alert alert-danger py-2 small mb-3";
            }
        }

        function syncReturnLocation() {
            if (sameReturnLocation.checked) {
                chooseReturnLocation.classList.add("d-none");
                returnMapPanel.classList.add("d-none");
                if (pickupDelivery.checked && pickupPoint) {
                    returnPoint = pickupPoint;
                    returnLocation.value = pickupPoint.displayName;
                    returnLocationDisplay.textContent = pickupPoint.displayName;
                } else {
                    returnPoint = null;
                    returnLocation.value = smartCarLocation;
                    returnLocationDisplay.textContent = smartCarLocation;
                }
            } else {
                chooseReturnLocation.classList.remove("d-none");
                returnPoint = null;
                returnLocation.value = "";
                returnLocationDisplay.textContent = "Chưa chọn địa điểm trả xe";
                returnMapPanel.classList.add("d-none");
            }
        }

        function setPickupMode() {
            if (pickupAtSmartCar.checked) {
                pickupMethodInput.value = selfPickupMethod;
                selfPickupCard.classList.add("active");
                deliveryCard.classList.remove("active");
                deliveryAddressPanel.classList.add("d-none");
                pickupPoint = null;
                pickupLocation.value = smartCarLocation;
                pickupLocationDisplay.textContent = smartCarLocation;
                pickupMapPanel.classList.add("d-none");
            } else {
                pickupMethodInput.value = homeDeliveryMethod;
                deliveryCard.classList.add("active");
                selfPickupCard.classList.remove("active");
                deliveryAddressPanel.classList.remove("d-none");
                if (!pickupPoint) {
                    pickupLocation.value = "";
                    pickupLocationDisplay.textContent = "Chưa chọn địa điểm";
                }
            }

            syncReturnLocation();
            if (pickupAtSmartCar.checked && sameReturnLocation.checked) {
                applyFreeQuote();
            } else if (pickupDelivery.checked && !pickupPoint) {
                resetQuote("Bấm ‘Chọn địa điểm’ để tìm chính xác nơi giao xe trong Hà Nội.");
            } else if (!sameReturnLocation.checked && !returnPoint) {
                resetQuote("Hãy chọn địa điểm trả xe khác để tính phí nhận lại xe.");
            } else {
                calculateQuote();
            }
        }

        pickupAtSmartCar.addEventListener("change", setPickupMode);
        pickupDelivery.addEventListener("change", setPickupMode);
        sameReturnLocation.addEventListener("change", function () {
            syncReturnLocation();
            if (!sameReturnLocation.checked) {
                resetQuote("Hãy chọn địa điểm trả xe khác.");
                openPicker("return");
            } else {
                calculateQuote();
            }
        });

        choosePickupLocation.addEventListener("click", function () { openPicker("pickup"); });
        chooseReturnLocation.addEventListener("click", function () { openPicker("return"); });
        searchButton.addEventListener("click", searchLocations);
        searchInput.addEventListener("keydown", function (event) {
            if (event.key === "Enter") {
                event.preventDefault();
                searchLocations();
            }
        });

        form.addEventListener("submit", function (event) {
            if (quotedSignature !== currentSignature()) {
                event.preventDefault();
                quoteStatus.textContent = "Địa điểm chưa được xác nhận phí. Hãy chọn lại địa điểm để hệ thống tính quãng đường trước khi gửi yêu cầu.";
                quoteStatus.className = "alert alert-danger py-2 small mb-3";
            }
        });

        setPickupMode();
    });
</script>
