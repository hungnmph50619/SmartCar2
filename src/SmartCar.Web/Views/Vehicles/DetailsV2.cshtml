@model SmartCar.Application.Features.Vehicles.VehicleDto
@using SmartCar.Application.Features.Reviews
@using SmartCar.Domain.Constants
@{
    ViewData["Title"] = Model.VehicleName;
    var pickupDate = (DateTime)ViewBag.PickupDate;
    var returnDate = (DateTime)ViewBag.ReturnDate;
    var numberOfDays = Math.Max(1, (int)Math.Ceiling((returnDate - pickupDate).TotalHours / 24d));
    var estimatedAmount = numberOfDays * Model.DailyPrice;
    var reviews = ViewBag.Reviews as IReadOnlyList<ReviewDto> ?? Array.Empty<ReviewDto>();
    var averageRating = (double)(ViewBag.AverageRating ?? 0d);
    var kycVerified = ViewBag.KycVerified is bool verified && verified;
    var kycVerifiedCount = ViewBag.KycVerifiedCount is int count ? count : 0;
    var kycTotal = ViewBag.KycTotal is int total ? total : 2;
    var citizenApproved = ViewBag.CitizenApproved is bool citizenOk && citizenOk;
    var licenseApproved = ViewBag.LicenseApproved is bool licenseOk && licenseOk;
    var citizenValidForRental = ViewBag.CitizenValidForRental is bool citizenRentalOk && citizenRentalOk;
    var licenseValidForRental = ViewBag.LicenseValidForRental is bool licenseRentalOk && licenseRentalOk;
    var citizenExpiryDate = ViewBag.CitizenExpiryDate is DateTime citizenExpiry ? citizenExpiry : (DateTime?)null;
    var licenseExpiryDate = ViewBag.LicenseExpiryDate is DateTime licenseExpiry ? licenseExpiry : (DateTime?)null;
    var allDocumentsApproved = citizenApproved && licenseApproved;
    var hasBankAccount = ViewBag.HasBankAccount is bool hasBank && hasBank;

    // Cấu hình demo cho đồ án. Sau này có thể chuyển sang bảng/cấu hình hệ thống.
    const string smartCarPickupLocation = "Điểm giao nhận SmartCar - Quận 5, TP.HCM";
    const decimal deliveryRatePerKm = 15000m;
    const int maxDeliveryKm = 10;
}

<div class="row g-4">
    <div class="col-lg-7">
        @if (Model.Images.Count > 0)
        {
            <div class="row g-2">
            @foreach (var image in Model.Images)
            {
                <div class="col-6">
                    <img src="@image.ImagePath" class="img-fluid rounded w-100" style="height:240px;object-fit:cover" alt="@Model.VehicleName" />
                </div>
            }
            </div>
        }
        else
        {
            <div class="bg-light rounded d-flex align-items-center justify-content-center" style="height:360px">Xe chưa có ảnh</div>
        }
    </div>

    <div class="col-lg-5">
        <div class="card card-body shadow-sm sticky-top" style="top:1rem">
            <h1 class="h3">@Model.VehicleName</h1>
            <p class="text-muted">@Model.BrandName · @Model.Model · @Model.LicensePlate</p>

            <div class="mb-3">
                <span class="text-warning fs-5">★</span>
                <strong>@(reviews.Count == 0 ? "Chưa có đánh giá" : $"{averageRating:F1}/5")</strong>
                @if (reviews.Count > 0)
                {
                    <span class="text-muted">(@reviews.Count lượt)</span>
                }
            </div>

            <dl class="row mb-3">
                <dt class="col-5">Số chỗ</dt><dd class="col-7">@Model.Seats</dd>
                <dt class="col-5">Hộp số</dt><dd class="col-7">@Model.Transmission</dd>
                <dt class="col-5">Nhiên liệu</dt><dd class="col-7">@Model.FuelType</dd>
                <dt class="col-5">Năm sản xuất</dt><dd class="col-7">@Model.ManufactureYear</dd>
            </dl>

            <p>@Model.Description</p>
            <hr />

            <div class="d-flex justify-content-between align-items-center mb-2">
                <span><strong>Nhận xe</strong></span>
                <span>@pickupDate.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span><strong>Trả xe</strong></span>
                <span>@returnDate.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span><strong>Số ngày tính phí</strong></span>
                <span>@numberOfDays</span>
            </div>

            @if (User.Identity?.IsAuthenticated == true && User.IsInRole(RoleNames.Customer))
            {
                @if (kycVerified)
                {
                    @if (hasBankAccount)
                    {
                        <form asp-controller="Bookings" asp-action="Create" method="post" data-loading-form id="booking-location-form">
                            <input type="hidden" name="VehicleId" value="@Model.VehicleId" />
                            <input type="hidden" name="PickupDate" value="@pickupDate.ToString("O")" />
                            <input type="hidden" name="ReturnDate" value="@returnDate.ToString("O")" />

                            <div class="border rounded-3 p-3 mb-3 bg-light">
                                <div class="text-uppercase small text-muted fw-semibold mb-1">Địa điểm giao nhận xe</div>
                                <div class="fw-bold mb-3">Bạn muốn nhận xe bằng cách nào?</div>

                                <label class="border rounded-3 p-3 mb-2 d-block bg-white" for="pickupAtSmartCar" style="cursor:pointer">
                                    <div class="d-flex gap-2 align-items-start">
                                        <input class="form-check-input mt-1" type="radio" name="PickupMethodOption" id="pickupAtSmartCar" value="smartcar" checked />
                                        <div class="flex-grow-1">
                                            <div class="d-flex justify-content-between gap-2">
                                                <strong>Tôi tự đến lấy xe</strong>
                                                <span class="text-success fw-semibold">Miễn phí</span>
                                            </div>
                                            <div class="small text-muted mt-1">@smartCarPickupLocation</div>
                                            <div class="small text-muted">Giờ nhận: @pickupDate.ToString("HH:mm dd/MM/yyyy")</div>
                                        </div>
                                    </div>
                                </label>

                                <label class="border rounded-3 p-3 d-block bg-white" for="pickupDelivery" style="cursor:pointer">
                                    <div class="d-flex gap-2 align-items-start">
                                        <input class="form-check-input mt-1" type="radio" name="PickupMethodOption" id="pickupDelivery" value="delivery" />
                                        <div class="flex-grow-1">
                                            <div class="d-flex justify-content-between gap-2">
                                                <strong>Tôi muốn được giao xe tận nơi</strong>
                                                <span class="text-primary fw-semibold">@deliveryRatePerKm.ToString("N0") đ/km/lượt</span>
                                            </div>
                                            <div class="small text-muted mt-1">Hỗ trợ trong bán kính tối đa @maxDeliveryKm km tính từ điểm giao nhận SmartCar.</div>
                                            <div class="small text-muted">Khoảng cách và phí chính thức được Admin xác nhận trước khi bạn thanh toán.</div>
                                        </div>
                                    </div>
                                </label>

                                <div id="deliveryAddressPanel" class="mt-3 d-none">
                                    <label class="form-label fw-semibold" for="pickupLocation">Địa chỉ giao xe tận nơi</label>
                                    <input id="pickupLocation"
                                           name="PickupLocation"
                                           class="form-control"
                                           maxlength="250"
                                           required
                                           readonly
                                           value="@smartCarPickupLocation" />
                                    <div class="form-text" id="pickupLocationHelp">Địa điểm nhận xe mặc định của SmartCar.</div>

                                    <div class="alert alert-primary py-2 mt-3 mb-0 small">
                                        <strong>Cách tính phí:</strong> khoảng cách được Admin xác nhận × @deliveryRatePerKm.ToString("N0") đ/km × số lượt giao/nhận thực tế.
                                        Ví dụ 2 km và giao + nhận xe tại cùng địa chỉ: 2 × @deliveryRatePerKm.ToString("N0") × 2 = <strong>@((2 * deliveryRatePerKm * 2).ToString("N0")) đ</strong>.
                                    </div>
                                </div>
                            </div>

                            <div class="border rounded-3 p-3 mb-3">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div>
                                        <div class="text-uppercase small text-muted fw-semibold">Trả xe</div>
                                        <div class="fw-bold">Nơi trả xe</div>
                                    </div>
                                    <span class="badge bg-secondary-subtle text-secondary">@returnDate.ToString("HH:mm dd/MM")</span>
                                </div>

                                <div class="form-check form-switch mb-3">
                                    <input class="form-check-input" type="checkbox" role="switch" id="sameReturnLocation" checked />
                                    <label class="form-check-label" for="sameReturnLocation">
                                        <strong>Trả xe tại cùng địa điểm nhận</strong>
                                        <span class="d-block small text-muted">Mặc định để đơn giản hóa việc giao nhận và tính phí.</span>
                                    </label>
                                </div>

                                <label class="form-label fw-semibold" for="returnLocation">Địa điểm trả xe</label>
                                <input id="returnLocation"
                                       name="ReturnLocation"
                                       class="form-control"
                                       maxlength="250"
                                       required
                                       readonly
                                       value="@smartCarPickupLocation" />
                                <div class="form-text" id="returnLocationHelp">Đang dùng cùng địa điểm nhận xe.</div>
                            </div>

                            <div class="border rounded-3 p-3 mb-3">
                                <div class="d-flex justify-content-between mb-2">
                                    <span>Tiền thuê tạm tính</span>
                                    <strong>@estimatedAmount.ToString("N0") đ</strong>
                                </div>
                                <div class="d-flex justify-content-between mb-2" id="deliveryFeeRow">
                                    <span>Phí giao nhận</span>
                                    <strong id="deliveryFeeText" class="text-success">Miễn phí</strong>
                                </div>
                                <hr class="my-2" />
                                <div class="small text-muted" id="priceNote">
                                    Nếu chọn giao tận nơi, tổng thanh toán cuối cùng chỉ được chốt sau khi Admin xác nhận khoảng cách và phí giao nhận.
                                </div>
                            </div>

                            <div class="alert alert-success py-2 mb-3">
                                <strong>✓ Hồ sơ đã đủ điều kiện.</strong>
                                Giấy tờ và tài khoản nhận hoàn tiền đã sẵn sàng.
                            </div>

                            <button class="btn btn-primary btn-lg w-100" type="submit" data-loading-text="Đang gửi yêu cầu...">
                                Gửi yêu cầu thuê xe
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="border rounded-3 p-3 mb-3 bg-light">
                            <div class="fw-bold">🏦 Cần thêm tài khoản ngân hàng</div>
                            <div class="small text-muted mt-1">Trước khi đặt xe, bạn cần lưu tài khoản ngân hàng để SmartCar có thể hoàn tiền, hoàn cọc hoặc chuyển trả các khoản phát sinh khi cần.</div>
                        </div>
                        <a class="btn btn-primary btn-lg w-100" asp-controller="Profile" asp-action="Index" asp-route-tab="banking" asp-route-returnVehicleId="@Model.VehicleId" asp-route-pickupDate="@pickupDate.ToString("O")" asp-route-returnDate="@returnDate.ToString("O")">Thêm tài khoản ngân hàng</a>
                    }
                }
                else if (allDocumentsApproved)
                {
                    <div class="border border-warning rounded-3 p-3 mb-3 bg-light">
                        <div class="fw-bold mb-2">⚠ Giấy tờ không đủ thời hạn cho chuyến thuê</div>
                        <div class="small mb-1">
                            <strong>CCCD:</strong> ✓ Đã xác minh · Hết hạn @(citizenExpiryDate?.ToString("dd/MM/yyyy") ?? "chưa xác định")
                            @if (!citizenValidForRental)
                            {
                                <span class="text-danger fw-semibold"> · Không đủ hiệu lực</span>
                            }
                        </div>
                        <div class="small mb-2">
                            <strong>GPLX:</strong> ✓ Đã xác minh · Hết hạn @(licenseExpiryDate?.ToString("dd/MM/yyyy") ?? "chưa xác định")
                            @if (!licenseValidForRental)
                            {
                                <span class="text-danger fw-semibold"> · Không đủ hiệu lực</span>
                            }
                        </div>
                        <div class="small text-muted">Chuyến thuê kết thúc ngày <strong>@returnDate.ToString("dd/MM/yyyy")</strong>. CCCD và GPLX phải còn hiệu lực ít nhất đến ngày trả xe.</div>
                    </div>
                    <a class="btn btn-primary btn-lg w-100" asp-controller="Profile" asp-action="Index" asp-route-tab="documents" asp-route-returnVehicleId="@Model.VehicleId" asp-route-pickupDate="@pickupDate.ToString("O")" asp-route-returnDate="@returnDate.ToString("O")">Cập nhật giấy tờ để tiếp tục</a>
                }
                else
                {
                    <div class="border rounded-3 p-3 mb-3 bg-light">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
                            <div>
                                <div class="fw-bold">🔒 Cần xác minh để thuê xe</div>
                                <div class="small text-muted mt-1">Hoàn tất xác minh CCCD và GPLX trước khi gửi yêu cầu.</div>
                            </div>
                            <span class="badge bg-warning text-dark">@kycVerifiedCount/@kycTotal</span>
                        </div>
                        <div class="small text-muted">① CCCD: thông tin + 2 ảnh &nbsp;·&nbsp; ② GPLX: thông tin + 2 ảnh</div>
                    </div>
                    <a class="btn btn-primary btn-lg w-100" asp-controller="Profile" asp-action="Index" asp-route-tab="documents" asp-route-returnVehicleId="@Model.VehicleId" asp-route-pickupDate="@pickupDate.ToString("O")" asp-route-returnDate="@returnDate.ToString("O")">Xác minh để thuê xe</a>
                }
            }
            else if (User.Identity?.IsAuthenticated != true)
            {
                <a class="btn btn-primary btn-lg w-100" asp-controller="Account" asp-action="Login">Đăng nhập để thuê xe</a>
            }
        </div>
    </div>
</div>

<div class="card card-body shadow-sm mt-4">
    <h2 class="h4">Đánh giá từ khách hàng</h2>
    @if (reviews.Count == 0)
    {
        <p class="text-muted mb-0">Xe chưa có đánh giá sau chuyến thuê.</p>
    }
    else
    {
        <div class="row g-3">
        @foreach (var review in reviews)
        {
            <div class="col-md-6">
                <div class="border rounded p-3 h-100">
                    <div class="d-flex justify-content-between">
                        <strong>@review.CustomerName</strong>
                        <span class="text-warning">@string.Concat(Enumerable.Repeat("★", review.Rating))</span>
                    </div>
                    <p class="mb-1 mt-2">@(string.IsNullOrWhiteSpace(review.Comment) ? "Khách hàng không để lại nhận xét." : review.Comment)</p>
                    <small class="text-muted">@review.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</small>
                </div>
            </div>
        }
        </div>
    }
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const form = document.getElementById("booking-location-form");
        if (!form) return;

        const pickupAtSmartCar = document.getElementById("pickupAtSmartCar");
        const pickupDelivery = document.getElementById("pickupDelivery");
        const deliveryAddressPanel = document.getElementById("deliveryAddressPanel");
        const pickupLocation = document.getElementById("pickupLocation");
        const pickupHelp = document.getElementById("pickupLocationHelp");
        const sameReturnLocation = document.getElementById("sameReturnLocation");
        const returnLocation = document.getElementById("returnLocation");
        const returnHelp = document.getElementById("returnLocationHelp");
        const deliveryFeeText = document.getElementById("deliveryFeeText");
        const priceNote = document.getElementById("priceNote");
        const smartCarLocation = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(smartCarPickupLocation));

        function syncReturnLocation() {
            if (sameReturnLocation.checked) {
                returnLocation.value = pickupLocation.value;
                returnLocation.readOnly = true;
                returnHelp.textContent = "Đang dùng cùng địa điểm nhận xe.";
            } else {
                returnLocation.readOnly = false;
                if (returnLocation.value === pickupLocation.value || returnLocation.value === smartCarLocation) {
                    returnLocation.value = "";
                }
                returnLocation.placeholder = "Nhập địa điểm trả xe khác";
                returnHelp.textContent = "Địa điểm trả khác cần Admin kiểm tra; có thể phát sinh thêm phí giao nhận.";
            }
        }

        function setPickupMode() {
            if (pickupAtSmartCar.checked) {
                deliveryAddressPanel.classList.add("d-none");
                pickupLocation.value = smartCarLocation;
                pickupLocation.readOnly = true;
                pickupLocation.required = true;
                deliveryFeeText.textContent = "Miễn phí";
                deliveryFeeText.className = "text-success";
                priceNote.textContent = "Tự đến nhận và trả tại điểm SmartCar không phát sinh phí giao nhận.";
            } else {
                deliveryAddressPanel.classList.remove("d-none");
                if (pickupLocation.value === smartCarLocation) {
                    pickupLocation.value = "";
                }
                pickupLocation.readOnly = false;
                pickupLocation.required = true;
                pickupLocation.placeholder = "Nhập địa chỉ giao xe tận nơi";
                pickupHelp.textContent = "Nhập địa chỉ cụ thể để Admin kiểm tra khoảng cách và phí giao nhận.";
                deliveryFeeText.textContent = "Chờ Admin xác nhận";
                deliveryFeeText.className = "text-primary";
                priceNote.textContent = "Phí giao nhận chưa cộng vào tiền thuê tạm tính. Admin sẽ xác nhận khoảng cách và phí trước bước thanh toán.";
                setTimeout(() => pickupLocation.focus(), 0);
            }
            syncReturnLocation();
        }

        pickupAtSmartCar.addEventListener("change", setPickupMode);
        pickupDelivery.addEventListener("change", setPickupMode);
        pickupLocation.addEventListener("input", syncReturnLocation);
        sameReturnLocation.addEventListener("change", syncReturnLocation);

        setPickupMode();
    });
</script>
