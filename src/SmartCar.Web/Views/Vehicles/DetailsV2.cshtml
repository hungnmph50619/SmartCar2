@model SmartCar.Application.Features.Vehicles.VehicleDto
@using SmartCar.Application.Features.Reviews
@using SmartCar.Domain.Constants
@using SmartCar.Domain.Enums
@using System.Globalization
@inject SmartCar.Infrastructure.Persistence.ApplicationDbContext PolicyDb
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var policy = await SmartCar.Infrastructure.Services.BusinessPolicyStore.ReadAsync(PolicyDb, Context.RequestAborted);
    ViewData["Title"] = Model.VehicleName;
    var pickupDate = (DateTime)ViewBag.PickupDate;
    var returnDate = (DateTime)ViewBag.ReturnDate;
    var numberOfDays = Math.Max(1, (int)Math.Ceiling((returnDate - pickupDate).TotalHours / 24d));
    var estimatedAmount = numberOfDays * Model.DailyPrice;
    var depositAmount =
    policy.CalculateDeposit(
        estimatedAmount);

    var deliveryBaseFee = policy.BaseDeliveryFee;
    var deliveryIncludedKm = policy.IncludedDeliveryDistanceKm;
    var deliveryFeePerExtraKm = policy.DeliveryFeePerExtraKm;
    var maxDeliveryKm = policy.MaxDeliveryDistanceKm;

    var upfrontAmount =
        estimatedAmount + depositAmount;

    var availableForSelectedPeriod =
        ViewBag.AvailableForSelectedPeriod
            is bool available &&
        available;

    var storeAddress =
        ViewBag.StoreAddress as string
        ?? "SmartCar";
    var reviews = ViewBag.Reviews as IReadOnlyList<ReviewDto> ?? Array.Empty<ReviewDto>();
    var averageRating = (double)(ViewBag.AverageRating ?? 0d);
    var kycVerified = ViewBag.KycVerified is bool verified && verified;
    var kycVerifiedCount = ViewBag.KycVerifiedCount is int count ? count : 0;
    var kycTotal = ViewBag.KycTotal is int total ? total : 2;
    var citizenApproved = ViewBag.CitizenApproved is bool citizenOk && citizenOk;
    var licenseApproved = ViewBag.LicenseApproved is bool licenseOk && licenseOk;
    var citizenValidForRental = ViewBag.CitizenValidForRental is bool citizenRentalOk && citizenRentalOk;
    var licenseValidForRental = ViewBag.LicenseValidForRental is bool licenseRentalOk && licenseRentalOk;
    var citizenExpiryDate = ViewBag.CitizenExpiryDate is DateTime citizenExpiry ? citizenExpiry : (DateTime?)null;
    var licenseExpiryDate = ViewBag.LicenseExpiryDate is DateTime licenseExpiry ? licenseExpiry : (DateTime?)null;
    var allDocumentsApproved = citizenApproved && licenseApproved;
    var hasBankAccount = ViewBag.HasBankAccount is bool hasBank && hasBank;
    var googleMapsApiKey = Configuration["GoogleMaps:BrowserApiKey"];
}
<link rel="stylesheet" href="~/lib/leaflet/leaflet.css" asp-append-version="true" />

<style>
    #delivery-map {
        height: 300px;
        border-radius: 12px;
    }

    .pickup-method-card {
        cursor: pointer;
    }

    .invoice-mini-row {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
    }
</style>
<div class="row g-4">
    <div class="col-lg-7">
        @if (Model.Images.Count > 0)
        {
            <div class="row g-2">
            @foreach (var image in Model.Images)
            {
                <div class="col-6">
                    <img src="@image.ImagePath" class="img-fluid rounded w-100" style="height:240px;object-fit:cover" alt="@Model.VehicleName" />
                </div>
            }
            </div>
        }
        else
        {
            <div class="bg-light rounded d-flex align-items-center justify-content-center" style="height:360px">Xe chưa có ảnh</div>
        }
    </div>
    <div class="col-lg-5">
        <div class="card card-body shadow-sm sticky-top" style="top:1rem">
            <h1 class="h3">@Model.VehicleName</h1>
            <p class="text-muted">@Model.BrandName · @Model.Model · @Model.LicensePlate</p>
            <div class="mb-3">
                <span class="text-warning fs-5">★</span>
                <strong>@(reviews.Count == 0 ? "Chưa có đánh giá" : $"{averageRating:F1}/5")</strong>
                @if (reviews.Count > 0)
                {
                    <span class="text-muted">(@reviews.Count lượt)</span>
                }
            </div>
            <dl class="row mb-3">
                <dt class="col-5">Số chỗ</dt><dd class="col-7">@Model.Seats</dd>
                <dt class="col-5">Hộp số</dt><dd class="col-7">@Model.Transmission</dd>
                <dt class="col-5">Nhiên liệu</dt><dd class="col-7">@Model.FuelType</dd>
                <dt class="col-5">Năm sản xuất</dt><dd class="col-7">@Model.ManufactureYear</dd>
            </dl>
            <p>@Model.Description</p>
            <hr />
            <div class="mb-2"><strong>Nhận xe:</strong> @pickupDate.ToString("dd/MM/yyyy HH:mm")</div>
            <div class="mb-2"><strong>Trả xe:</strong> @returnDate.ToString("dd/MM/yyyy HH:mm")</div>
            <div class="mb-2"><strong>Số ngày tính phí:</strong> @numberOfDays</div>
            <div class="border rounded p-3 bg-light mb-3">
                <div class="invoice-mini-row">
                    <span>Tiền thuê</span>
                    <strong>
                        @estimatedAmount.ToString("N0") đ
                    </strong>
                </div>

                <div class="invoice-mini-row">
                    <span>
                        Tiền cọc
                        (@((policy.DepositPercent)
                                        .ToString("0"))%)
                    </span>

                    <strong>
                        @depositAmount.ToString("N0") đ
                    </strong>
                </div>

                <div class="invoice-mini-row d-none" id="delivery-fee-row">
                    <span id="delivery-fee-label">Phí giao xe tận nơi</span>
                    <strong id="delivery-fee-amount">Chọn điểm giao</strong>
                </div>

                <hr class="my-2" />

                <div class="invoice-mini-row fs-5 p-2 rounded border border-primary bg-white">
                    <span class="fw-bold text-uppercase">
                        Tổng thanh toán trước khi nhận xe
                    </span>

                    <strong class="text-primary"
                            id="upfront-amount"
                            data-base-amount="@upfrontAmount.ToString(CultureInfo.InvariantCulture)"
                            data-store-latitude="@RentalPolicy.StoreLatitude.ToString(CultureInfo.InvariantCulture)"
                            data-store-longitude="@RentalPolicy.StoreLongitude.ToString(CultureInfo.InvariantCulture)"
                            data-included-delivery-km="@policy.IncludedDeliveryDistanceKm.ToString(CultureInfo.InvariantCulture)"
                            data-base-delivery-fee="@policy.BaseDeliveryFee.ToString(CultureInfo.InvariantCulture)"
                            data-delivery-fee-per-extra-km="@policy.DeliveryFeePerExtraKm.ToString(CultureInfo.InvariantCulture)"
                            data-max-delivery-km="@policy.MaxDeliveryDistanceKm.ToString(CultureInfo.InvariantCulture)">
                        @upfrontAmount.ToString("N0") đ
                    </strong>
                </div>
            </div>

            @if (User.Identity?.IsAuthenticated == true && User.IsInRole(RoleNames.Customer))
            {
                @if (kycVerified)
                {
                    @if (hasBankAccount)
                    {
                        <div class="alert alert-success py-2 mb-3">
                            <strong>✓ Giấy tờ và tài khoản nhận hoàn tiền đã sẵn sàng.</strong> Bạn có thể gửi yêu cầu thuê xe.
                        </div>
                        @if (!availableForSelectedPeriod)
                        {
                            <div class="alert alert-danger">
                                Xe không còn trống trong đúng khoảng
                                thời gian bạn chọn.
                                Hãy quay lại danh sách và chọn ngày khác.
                            </div>

                            <a class="btn btn-outline-primary w-100"
                               asp-action="Index"
                               asp-route-PickupDate="@pickupDate.ToString("O")"
                               asp-route-ReturnDate="@returnDate.ToString("O")">
                                Chọn xe/ngày khác
                            </a>
                        }
                        else if (
                            User.Identity?.IsAuthenticated == true &&
                            User.IsInRole(RoleNames.Customer))
                        {
                            <form asp-controller="Bookings"
                                  asp-action="Create"
                                  method="post"
                                  data-loading-form
                                  id="booking-form">
                                <input type="hidden" name="PolicyVersion" value="@policy.Version" />
                                <details class="border rounded p-3 mb-3"><summary>Chính sách áp dụng cho đơn này</summary>
                                    <p class="mt-2">Định mức @policy.IncludedKilometersPerDay km/ngày; vượt mức @policy.ExcessKilometerFee.ToString("N0") đ/km.</p>
                                    <p>Trả muộn: miễn @policy.LateReturnGraceMinutes phút; sau đó mỗi 24 giờ bắt đầu tính @policy.LateReturnFeeMultiplier.ToString("0.##") × giá thuê/ngày. Giữ cọc @policy.DepositHoldDays ngày sau khi trả xe trước khi xét duyệt hoàn.</p>
                                    <strong>Vi phạm giao thông / phạt nguội</strong><p style="white-space:pre-wrap">@policy.TrafficFineTerms</p>
                                    <strong>Hư hỏng / thiếu / trả muộn</strong><p style="white-space:pre-wrap">@policy.DamageCompensationTerms</p>
                                </details>

                                <input type="hidden"
                                       name="VehicleId"
                                       value="@Model.VehicleId" />

                                <input type="hidden"
                                       name="PickupDate"
                                       value="@pickupDate.ToString("O")" />

                                <input type="hidden"
                                       name="ReturnDate"
                                       value="@returnDate.ToString("O")" />

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">
                                        Phương thức nhận xe
                                    </label>

                                    <div class="border rounded p-3 mb-2
                                        pickup-method-card">

                                        <div class="form-check">
                                            <input class="form-check-input"
                                                   type="radio"
                                                   name="PickupMethod"
                                                   id="storePickup"
                                                   value="@VehiclePickupMethod.StorePickup"
                                                   checked />

                                            <label class="form-check-label fw-semibold"
                                                   for="storePickup">
                                                Nhận xe trực tiếp tại cửa hàng
                                            </label>
                                        </div>

                                        <div class="small text-muted ms-4 mt-1">
                                            @storeAddress
                                        </div>
                                    </div>

                                    <div class="border rounded p-3
                                        pickup-method-card">

                                        <div class="form-check">
                                            <input class="form-check-input"
                                                   type="radio"
                                                   name="PickupMethod"
                                                   id="deliveryPickup"
                                                   value="@VehiclePickupMethod.Delivery" />

                                            <label class="form-check-label fw-semibold"
                                                   for="deliveryPickup">
                                                Giao xe đến nơi người nhận yêu cầu
                                            </label>
                                        </div>

                                        <div class="small text-muted ms-4 mt-1">
                                            @deliveryIncludedKm.ToString("0") km đầu: @deliveryBaseFee.ToString("N0") đ.
                                            Sau đó mỗi km bắt đầu tiếp theo: +@deliveryFeePerExtraKm.ToString("N0") đ.
                                            Phạm vi giao tối đa @maxDeliveryKm.ToString("0") km.
                                        </div>
                                    </div>
                                </div>

                                <div id="delivery-fields"
                                     class="d-none border rounded p-3 mb-3 bg-light">

                                    <label class="form-label fw-semibold"
                                           for="deliveryAddress">
                                        Địa chỉ giao xe
                                    </label>

                                    <div class="input-group mb-2">
                                        <input id="deliveryAddress"
                                               name="DeliveryAddress"
                                               class="form-control"
                                               maxlength="500"
                                               autocomplete="street-address"
                                               placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành" />
                                        <button type="button"
                                                class="btn btn-outline-secondary"
                                                id="find-delivery-address">
                                            Tìm trên bản đồ
                                        </button>
                                    </div>
                                    <div id="delivery-search-results"
                                         class="list-group d-none mb-2"
                                         role="group"
                                         aria-label="Chọn địa chỉ tìm thấy"></div>
                                    <div id="delivery-search-help"
                                         class="small text-muted mb-2"
                                         aria-live="polite"></div>

                                    <input type="hidden"
                                           id="deliveryLatitude"
                                           name="DeliveryLatitude" />

                                    <input type="hidden"
                                           id="deliveryLongitude"
                                           name="DeliveryLongitude" />

                                    <div class="d-flex justify-content-between
                                        align-items-center gap-2 mb-2 flex-wrap">

                                        <small class="text-muted" id="delivery-map-help">
                                            Nhập số nhà và tên đường rồi chọn đúng quận/huyện trong kết quả. Vị trí GPS có thể có sai số; hãy kiểm tra ghim trước khi đặt.
                                        </small>

                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary"
                                                id="use-current-location">
                                            Dùng vị trí hiện tại
                                        </button>
                                    </div>

                                    <div id="delivery-map"
                                         aria-label="Bản đồ chọn vị trí giao xe">
                                    </div>
                                    <div class="small text-muted mt-2" id="delivery-coordinate-text" aria-live="polite"></div>
                                    <div class="small text-danger mt-2 d-none"
                                         id="delivery-location-error"></div>
                                </div>

                                <p class="small text-muted">Thanh toán sau khi Staff kiểm tra và Admin duyệt đơn: khách chuyển khoản/QR hoặc trả tiền mặt tại quầy. Chưa thu tiền ở bước gửi yêu cầu.</p>
                                <button class="btn btn-primary btn-lg w-100"
                                        type="submit"
                                        data-loading-text="Đang gửi yêu cầu...">
                                    Gửi yêu cầu thuê xe
                                </button>
                            </form>
                        }
                    }
                    else
                    {
                        <div class="border rounded-3 p-3 mb-3 bg-light">
                            <div class="fw-bold">🏦 Cần thêm tài khoản ngân hàng</div>
                            <div class="small text-muted mt-1">Trước khi đặt xe, bạn cần lưu tài khoản ngân hàng để SmartCar có thể hoàn tiền, hoàn cọc hoặc chuyển trả các khoản phát sinh khi cần.</div>
                        </div>
                        <a class="btn btn-primary btn-lg w-100" asp-controller="Profile" asp-action="Index" asp-route-tab="banking" asp-route-returnVehicleId="@Model.VehicleId" asp-route-pickupDate="@pickupDate.ToString("O")" asp-route-returnDate="@returnDate.ToString("O")">Thêm tài khoản ngân hàng</a>
                    }
                }
                else if (allDocumentsApproved)
                {
                    <div class="border border-warning rounded-3 p-3 mb-3 bg-light">
                        <div class="fw-bold mb-2">⚠ Giấy tờ không đủ thời hạn cho chuyến thuê</div>
                        <div class="small mb-1">
                            <strong>CCCD:</strong> ✓ Đã xác minh · Hết hạn @(citizenExpiryDate?.ToString("dd/MM/yyyy") ?? "chưa xác định")
                            @if (!citizenValidForRental)
                            {
                                <span class="text-danger fw-semibold"> · Không đủ hiệu lực</span>
                            }
                        </div>
                        <div class="small mb-2">
                            <strong>GPLX:</strong> ✓ Đã xác minh · Hết hạn @(licenseExpiryDate?.ToString("dd/MM/yyyy") ?? "chưa xác định")
                            @if (!licenseValidForRental)
                            {
                                <span class="text-danger fw-semibold"> · Không đủ hiệu lực</span>
                            }
                        </div>
                        <div class="small text-muted">Chuyến thuê kết thúc ngày <strong>@returnDate.ToString("dd/MM/yyyy")</strong>. CCCD và GPLX phải còn hiệu lực ít nhất đến ngày trả xe.</div>
                    </div>
                    <a class="btn btn-primary btn-lg w-100" asp-controller="Profile" asp-action="Index" asp-route-tab="documents" asp-route-returnVehicleId="@Model.VehicleId" asp-route-pickupDate="@pickupDate.ToString("O")" asp-route-returnDate="@returnDate.ToString("O")">Cập nhật giấy tờ để tiếp tục</a>
                }
                else
                {
                    <div class="border rounded-3 p-3 mb-3 bg-light">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
                            <div>
                                <div class="fw-bold">🔒 Cần xác minh để thuê xe</div>
                                <div class="small text-muted mt-1">Hoàn tất xác minh CCCD và GPLX trước khi gửi yêu cầu.</div>
                            </div>
                            <span class="badge bg-warning text-dark">@kycVerifiedCount/@kycTotal</span>
                        </div>
                        <div class="small text-muted">① CCCD: thông tin + 2 ảnh &nbsp;·&nbsp; ② GPLX: thông tin + 2 ảnh</div>
                    </div>
                    <a class="btn btn-primary btn-lg w-100" asp-controller="Profile" asp-action="Index" asp-route-tab="documents" asp-route-returnVehicleId="@Model.VehicleId" asp-route-pickupDate="@pickupDate.ToString("O")" asp-route-returnDate="@returnDate.ToString("O")">Xác minh để thuê xe</a>
                }
            }
            else if (User.Identity?.IsAuthenticated != true)
            {
                <a class="btn btn-primary btn-lg w-100" asp-controller="Account" asp-action="Login">Đăng nhập để thuê xe</a>
            }
        </div>
    </div>
</div>

<div class="card card-body shadow-sm mt-4">
    <h2 class="h4">Đánh giá từ khách hàng</h2>
    @if (reviews.Count == 0)
    {
        <p class="text-muted mb-0">Xe chưa có đánh giá sau chuyến thuê.</p>
    }
    else
    {
        <div class="row g-3">
        @foreach (var review in reviews)
        {
            <div class="col-md-6">
                <div class="border rounded p-3 h-100">
                    <div class="d-flex justify-content-between">
                        <strong>@review.CustomerName</strong>
                        <span class="text-warning">@string.Concat(Enumerable.Repeat("★", review.Rating))</span>
                    </div>
                    <p class="mb-1 mt-2">@(string.IsNullOrWhiteSpace(review.Comment) ? "Khách hàng không để lại nhận xét." : review.Comment)</p>
                    <small class="text-muted">@review.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</small>
                </div>
            </div>
        }
        </div>
    }
</div>
@section Scripts {
    @if (!string.IsNullOrWhiteSpace(googleMapsApiKey))
    {
        <script src="https://maps.googleapis.com/maps/api/js?key=@Uri.EscapeDataString(googleMapsApiKey)"></script>
    }
    <script src="~/lib/leaflet/leaflet.js" asp-append-version="true"></script>
    <script src="~/js/delivery-geocoding.js" asp-append-version="true"></script>

    <script>
        (() => {
            const form = document.getElementById('booking-form');
            if (!form) return;

            const store = document.getElementById('storePickup');
            const delivery = document.getElementById('deliveryPickup');
            const fields = document.getElementById('delivery-fields');
            const address = document.getElementById('deliveryAddress');
            const latInput = document.getElementById('deliveryLatitude');
            const lngInput = document.getElementById('deliveryLongitude');
            const error = document.getElementById('delivery-location-error');
            const locationButton = document.getElementById('use-current-location');
            const findAddressButton = document.getElementById('find-delivery-address');
            const searchResults = document.getElementById('delivery-search-results');
            const searchHelp = document.getElementById('delivery-search-help');
            const coordinateText = document.getElementById('delivery-coordinate-text');
            const mapHelp = document.getElementById('delivery-map-help');
            const deliveryFeeRow = document.getElementById('delivery-fee-row');
            const deliveryFeeLabel = document.getElementById('delivery-fee-label');
            const deliveryFeeAmount = document.getElementById('delivery-fee-amount');
            const upfrontAmount = document.getElementById('upfront-amount');

            const baseAmount = Number(upfrontAmount?.dataset.baseAmount || 0);
            const storeLat = Number(upfrontAmount?.dataset.storeLatitude || 0);
            const storeLng = Number(upfrontAmount?.dataset.storeLongitude || 0);
            const includedDeliveryKm = Number(upfrontAmount?.dataset.includedDeliveryKm || 0);
            const baseDeliveryFee = Number(upfrontAmount?.dataset.baseDeliveryFee || 0);
            const feePerExtraKm = Number(upfrontAmount?.dataset.deliveryFeePerExtraKm || 0);
            const maxDeliveryKm = Number(upfrontAmount?.dataset.maxDeliveryKm || 0);

            const money = value =>
                new Intl.NumberFormat('vi-VN').format(value) + ' đ';

            let map = null;
            let marker = null;
            let storeMarker = null;
            let googleMap = false;
            let currentDeliveryFee = 0;
            let locationRevision = 0;
            address.addEventListener('input', () => {
                locationRevision++;
                searchResults.replaceChildren();
                searchResults.classList.add('d-none');
                searchHelp.textContent = '';
            });

            const toRadians = degrees => degrees * Math.PI / 180;

            // Phải giống công thức Haversine trong RentalPolicy.cs.
            const calculateDistanceKm = (lat, lng) => {
                const earthRadiusKm = 6371.0088;
                const lat1 = toRadians(storeLat);
                const lng1 = toRadians(storeLng);
                const lat2 = toRadians(Number(lat));
                const lng2 = toRadians(Number(lng));
                const deltaLat = lat2 - lat1;
                const deltaLng = lng2 - lng1;

                const a =
                    Math.sin(deltaLat / 2) ** 2 +
                    Math.cos(lat1) * Math.cos(lat2) *
                    Math.sin(deltaLng / 2) ** 2;

                const c = 2 * Math.atan2(
                    Math.sqrt(a),
                    Math.sqrt(1 - a));

                return Math.round((earthRadiusKm * c + Number.EPSILON) * 100) / 100;
            };

            const calculateDeliveryFee = distanceKm => {
                const extraDistanceKm = Math.max(
                    0,
                    distanceKm - includedDeliveryKm);

                const extraWholeKm = Math.ceil(extraDistanceKm);

                return baseDeliveryFee +
                    extraWholeKm * feePerExtraKm;
            };

            const updatePriceByPoint = (lat, lng) => {
                const distanceKm = calculateDistanceKm(lat, lng);

                if (distanceKm > maxDeliveryKm) {
                    currentDeliveryFee = 0;
                    deliveryFeeLabel.textContent =
                        `Ngoài phạm vi giao (${distanceKm.toFixed(1)} km)`;
                    deliveryFeeAmount.textContent = 'Không hỗ trợ';
                    upfrontAmount.textContent = money(baseAmount);
                    error.textContent =
                        `Điểm giao cách cửa hàng khoảng ${distanceKm.toFixed(1)} km, ` +
                        `vượt phạm vi tối đa ${maxDeliveryKm.toFixed(0)} km.`;
                    error.classList.remove('d-none');
                    return false;
                }

                currentDeliveryFee = calculateDeliveryFee(distanceKm);
                deliveryFeeLabel.textContent =
                    `Phí giao xe (${distanceKm.toFixed(1)} km)`;
                deliveryFeeAmount.textContent = '+' + money(currentDeliveryFee);
                upfrontAmount.textContent = money(baseAmount + currentDeliveryFee);
                error.classList.add('d-none');
            };

            // Reverse geocoding is optional: GPS coordinates still identify the
            // delivery point when external address services are unreachable.
            const showReverseFailure = () => {
                if (address.value.trim()) return;

                const latitude = latInput.value;
                const longitude = lngInput.value;
                if (latitude && longitude) {
                    address.value = `Điểm GPS (${latitude}, ${longitude})`;
                    error.textContent =
                        'Đã giữ điểm GPS giao xe. Chưa lấy được tên đường; nhân viên có thể mở đúng vị trí trên bản đồ. ' +
                        'Nhập thêm số nhà hoặc hướng dẫn giao nếu cần.';
                } else {
                    error.textContent =
                        'Chưa tra được tên địa chỉ. Hãy nhập địa chỉ giao xe hoặc chọn lại vị trí.';
                }
                error.classList.remove('d-none');
            };
            const reverseGeocode = async (lat, lng) => {
                const revision = locationRevision;
                try {
                    const place = googleMap
                        ? (await new google.maps.Geocoder().geocode({ location: { lat, lng } })).results?.[0]?.formatted_address
                        : (await window.SmartCarDeliveryGeocoding.reverse(lat, lng))?.display_name;
                    if (revision !== locationRevision) return true;
                    if (place) {
                        address.value = place;
                        searchHelp.textContent = 'Đã tự nhận diện địa chỉ từ vị trí hiện tại. Kiểm tra tên địa chỉ trước khi đặt xe.';
                        updatePriceByPoint(lat, lng);
                        return true;
                    }
                    throw new Error('Không có tên địa chỉ tại điểm này.');
                } catch (ex) {
                    if (revision !== locationRevision) return true;
                    console.warn('Không reverse geocode được địa chỉ:', ex);
                }

                return false;
            };

            const clearSelectedPoint = () => {
                latInput.value = '';
                lngInput.value = '';
                currentDeliveryFee = 0;
                deliveryFeeLabel.textContent = 'Phí giao xe tận nơi';
                deliveryFeeAmount.textContent = 'Chọn điểm giao';
                upfrontAmount.textContent = money(baseAmount);
                coordinateText.textContent = 'Chưa chọn điểm giao.';

                if (marker) {
                    if (googleMap) marker.setMap(null);
                    else marker.remove?.();
                    marker = null;
                }
            };

            const setPoint = (lat, lng, zoom = 16) => {
                const normalizedLat = Number(lat);
                const normalizedLng = Number(lng);

                if (
                    !Number.isFinite(normalizedLat) ||
                    !Number.isFinite(normalizedLng) ||
                    normalizedLat < -90 ||
                    normalizedLat > 90 ||
                    normalizedLng < -180 ||
                    normalizedLng > 180) {
                    error.textContent =
                        'Tọa độ được chọn không hợp lệ. Vui lòng chọn lại điểm giao xe.';
                    error.classList.remove('d-none');
                    return false;
                }

                // Hidden input luôn dùng dấu chấm theo chuẩn JavaScript.
                // BookingsController sẽ parse bằng InvariantCulture.
                locationRevision++;
                clearAccuracyCircle();
                address.value = '';
                searchHelp.textContent = '';
                latInput.value = normalizedLat.toFixed(7);
                lngInput.value = normalizedLng.toFixed(7);

                coordinateText.textContent = `Điểm giao: ${normalizedLat.toFixed(6)}, ${normalizedLng.toFixed(6)}.`;

                updatePriceByPoint(normalizedLat, normalizedLng);

                if (!map) return true;

                if (googleMap) {
                    if (marker) marker.setPosition({ lat: normalizedLat, lng: normalizedLng });
                    else {
                        marker = new google.maps.Marker({
                            map, position: { lat: normalizedLat, lng: normalizedLng }, draggable: true
                        });
                        marker.addListener('dragend', async event => {
                            const point = event.latLng;
                            setPoint(point.lat(), point.lng(), map.getZoom());
                            if (!await reverseGeocode(point.lat(), point.lng())) showReverseFailure();
                        });
                    }
                    map.setCenter({ lat: normalizedLat, lng: normalizedLng });
                    map.setZoom(zoom);
                    return true;
                }

                if (marker) {
                    marker.setLatLng([normalizedLat, normalizedLng]);
                } else {
                    marker = L.marker(
                        [normalizedLat, normalizedLng],
                        { draggable: true })
                        .addTo(map);
                }

                marker
                    .off('dragend')
                    .on('dragend', async event => {
                        const point = event.target.getLatLng();

                        setPoint(
                            point.lat,
                            point.lng,
                            map.getZoom());

                        if (!await reverseGeocode(point.lat, point.lng)) showReverseFailure();
                    });

                map.setView(
                    [normalizedLat, normalizedLng],
                    zoom);
                return true;
            };

            const clearPointBeforeAddressSearch = () => {
                clearSelectedPoint();

                if (map && googleMap) {
                    map.setCenter({ lat: storeLat, lng: storeLng });
                    map.setZoom(13);
                } else if (map) {
                    map.setView([storeLat, storeLng], 13);
                }
            };

            const initMap = () => {
                if (window.google?.maps?.Map) {
                    googleMap = true;
                    map = new google.maps.Map(document.getElementById('delivery-map'), {
                        center: { lat: storeLat, lng: storeLng }, zoom: 13
                    });
                    storeMarker = new google.maps.Marker({
                        map, position: { lat: storeLat, lng: storeLng }, title: 'Điểm xuất phát SmartCar'
                    });
                    map.addListener('click', async event => {
                        const point = event.latLng;
                        setPoint(point.lat(), point.lng());
                        if (!await reverseGeocode(point.lat(), point.lng())) showReverseFailure();
                    });
                    return;
                }
                if (typeof L === 'undefined') {
                    const mapElement = document.getElementById('delivery-map');
                    mapElement.classList.remove('d-none');
                    mapElement.replaceChildren();

                    const fallbackFrame = document.createElement('iframe');
                    fallbackFrame.title = 'Bản đồ dự phòng SmartCar';
                    fallbackFrame.src =
                        `https://www.google.com/maps?q=${encodeURIComponent(storeLat + ',' + storeLng)}&z=13&output=embed`;
                    fallbackFrame.loading = 'lazy';
                    fallbackFrame.referrerPolicy = 'no-referrer-when-downgrade';
                    fallbackFrame.style.width = '100%';
                    fallbackFrame.style.height = '100%';
                    fallbackFrame.style.minHeight = '320px';
                    fallbackFrame.style.border = '0';
                    fallbackFrame.style.borderRadius = 'inherit';
                    mapElement.appendChild(fallbackFrame);

                    mapHelp.textContent =
                        'Đang dùng bản đồ dự phòng. Có thể dùng GPS để lấy tọa độ chính xác và tính phí giao xe.';
                    return;
                }

                map = L.map('delivery-map')
                    .setView([storeLat, storeLng], 13);

                let tileLoaded = false;
                let tileErrors = 0;
                let fallbackStarted = false;
                const mapElement = document.getElementById('delivery-map');

                const markMapReady = () => {
                    tileLoaded = true;
                    mapElement.classList.remove('d-none');
                    mapHelp.textContent = 'Bấm trên bản đồ để chọn điểm giao hoặc dùng GPS.';
                };

                const startFallbackTiles = () => {
                    if (fallbackStarted || tileLoaded) return;
                    fallbackStarted = true;
                    mapHelp.textContent = 'OpenStreetMap không phản hồi, đang chuyển sang nền bản đồ dự phòng...';

                    L.tileLayer(
                        'https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}',
                        {
                            maxZoom: 19,
                            attribution: 'Tiles &copy; Esri'
                        })
                        .on('tileload', markMapReady)
                        .on('tileerror', () => {
                            // Không ẩn khung bản đồ: marker/tọa độ vẫn phải dùng được
                            // và người dùng vẫn có thể dùng GPS để tính phí.
                            mapElement.classList.remove('d-none');
                            mapHelp.textContent =
                                'Không tải được ảnh nền bản đồ. Vẫn có thể dùng GPS/chọn tọa độ đã có để tính phí và nhập địa chỉ thủ công.';
                        })
                        .addTo(map);
                };

                L.tileLayer(
                    'https://tile.openstreetmap.org/{z}/{x}/{y}.png',
                    {
                        maxZoom: 19,
                        attribution: '&copy; OpenStreetMap contributors'
                    })
                    .on('tileload', markMapReady)
                    .on('tileerror', () => {
                        if (++tileErrors >= 2 && !tileLoaded) startFallbackTiles();
                    })
                    .addTo(map);

                storeMarker = L.marker([storeLat, storeLng])
                    .addTo(map)
                    .bindPopup('Điểm xuất phát SmartCar');

                map.on('click', async event => {
                    setPoint(event.latlng.lat, event.latlng.lng);
                    if (!await reverseGeocode(event.latlng.lat, event.latlng.lng)) showReverseFailure();
                });
            };

            const toggle = () => {
                const isDelivery = delivery.checked;
                fields.classList.toggle('d-none', !isDelivery);
                address.required = isDelivery;
                deliveryFeeRow?.classList.toggle('d-none', !isDelivery);

                if (!isDelivery) {
                    currentDeliveryFee = 0;
                    upfrontAmount.textContent = money(baseAmount);
                    error.classList.add('d-none');
                } else if (latInput.value && lngInput.value) {
                    updatePriceByPoint(
                        Number(latInput.value),
                        Number(lngInput.value));
                } else {
                    deliveryFeeLabel.textContent = 'Phí giao xe tận nơi';
                    deliveryFeeAmount.textContent = 'Chọn điểm giao';
                    upfrontAmount.textContent = money(baseAmount);
                }

                if (isDelivery && map && !googleMap) {
                    setTimeout(() => map.invalidateSize(), 80);
                }
            };

            store.addEventListener('change', toggle);
            delivery.addEventListener('change', toggle);

            const getBestCurrentPosition = () => new Promise((resolve, reject) => {
                const targetAccuracyMeters = 80;
                const maxWaitMs = 12000;
                const options = {
                    enableHighAccuracy: true,
                    timeout: maxWaitMs,
                    maximumAge: 0
                };

                let bestPosition = null;
                let watchId = null;
                let timeoutId = null;
                let finished = false;

                const cleanup = () => {
                    if (watchId !== null && typeof navigator.geolocation.clearWatch === 'function') {
                        navigator.geolocation.clearWatch(watchId);
                    }
                    if (timeoutId !== null) clearTimeout(timeoutId);
                };

                const complete = position => {
                    if (finished) return;
                    finished = true;
                    cleanup();
                    resolve(position);
                };

                const fail = geolocationError => {
                    if (finished) return;
                    finished = true;
                    cleanup();
                    reject(geolocationError);
                };

                const onPosition = position => {
                    const lat = Number(position?.coords?.latitude);
                    const lng = Number(position?.coords?.longitude);
                    const accuracy = Number(position?.coords?.accuracy);

                    if (!Number.isFinite(lat) || lat < -90 || lat > 90 ||
                        !Number.isFinite(lng) || lng < -180 || lng > 180) {
                        return;
                    }

                    if (!bestPosition ||
                        (Number.isFinite(accuracy) &&
                         (!Number.isFinite(Number(bestPosition.coords.accuracy)) ||
                          accuracy < Number(bestPosition.coords.accuracy)))) {
                        bestPosition = position;
                    }

                    if (Number.isFinite(accuracy) && accuracy <= targetAccuracyMeters) {
                        complete(position);
                    }
                };

                const onError = geolocationError => {
                    if (bestPosition) {
                        complete(bestPosition);
                        return;
                    }
                    fail(geolocationError);
                };

                if (typeof navigator.geolocation.watchPosition === 'function') {
                    watchId = navigator.geolocation.watchPosition(
                        onPosition,
                        onError,
                        options);

                    timeoutId = setTimeout(() => {
                        if (bestPosition) complete(bestPosition);
                        else fail({ code: 3, TIMEOUT: 3 });
                    }, maxWaitMs);
                    return;
                }

                navigator.geolocation.getCurrentPosition(
                    complete,
                    fail,
                    options);
            });

            locationButton.addEventListener('click', () => {
                error.classList.add('d-none');

                const localHosts = [
                    'localhost',
                    '127.0.0.1',
                    '::1'
                ];

                if (
                    !window.isSecureContext &&
                    !localHosts.includes(window.location.hostname)) {
                    error.textContent =
                        'Trình duyệt chỉ cho phép lấy vị trí hiện tại trên HTTPS hoặc localhost. ' +
                        'Hãy mở website bằng HTTPS rồi thử lại.';
                    error.classList.remove('d-none');
                    return;
                }

                if (!navigator.geolocation) {
                    error.textContent =
                        'Trình duyệt không hỗ trợ lấy vị trí hiện tại. Hãy nhập địa chỉ giao xe.';
                    error.classList.remove('d-none');
                    return;
                }

                const revision = ++locationRevision;
                locationButton.disabled = true;
                const oldLocationText = locationButton.textContent;
                locationButton.textContent = 'Đang xác định vị trí...';

                getBestCurrentPosition()
                    .then(async position => {
                        if (revision !== locationRevision) return;

                        const lat = Number(position.coords.latitude);
                        const lng = Number(position.coords.longitude);
                        const accuracy = Number(position.coords.accuracy);

                        if (!setPoint(lat, lng)) {
                            throw new Error('Vị trí thiết bị trả về không hợp lệ.');
                        }

                        locationButton.textContent = 'Đang nhận diện địa chỉ...';
                        const filled = await reverseGeocode(lat, lng);
                        if (!filled) showReverseFailure();

                        if (Number.isFinite(accuracy) &&
                            accuracy > 100 &&
                            calculateDistanceKm(lat, lng) <= maxDeliveryKm) {
                            error.textContent =
                                'Đã tự chọn vị trí tốt nhất thiết bị cung cấp. ' +
                                'Thiết bị hiện có độ chính xác thấp; hãy kiểm tra tên địa chỉ hiển thị trước khi đặt xe.';
                            error.classList.remove('d-none');
                        }
                    })
                    .catch(geolocationError => {
                        if (revision !== locationRevision) return;

                        switch (geolocationError?.code) {
                            case geolocationError?.PERMISSION_DENIED:
                            case 1:
                                error.textContent =
                                    'Bạn đã từ chối quyền truy cập vị trí. Hãy cho phép Location cho trang rồi thử lại.';
                                break;

                            case geolocationError?.POSITION_UNAVAILABLE:
                            case 2:
                                error.textContent =
                                    'Thiết bị hiện không xác định được vị trí. Hãy nhập địa chỉ giao xe.';
                                break;

                            case geolocationError?.TIMEOUT:
                            case 3:
                                error.textContent =
                                    'Không lấy được vị trí đủ nhanh. Hãy thử lại hoặc nhập địa chỉ giao xe.';
                                break;

                            default:
                                error.textContent =
                                    geolocationError instanceof Error
                                        ? geolocationError.message
                                        : 'Không thể lấy vị trí hiện tại. Hãy nhập địa chỉ giao xe.';
                                break;
                        }

                        error.classList.remove('d-none');
                    })
                    .finally(() => {
                        locationButton.disabled = false;
                        locationButton.textContent = oldLocationText;
                    });
            });

            findAddressButton.addEventListener('click', async () => {
                const query = address.value.trim();

                if (query.length < 3) {
                    address.focus();
                    error.textContent = 'Nhập ít nhất 3 ký tự địa chỉ cần tìm.';
                    error.classList.remove('d-none');
                    return;
                }

                const revision = ++locationRevision;
                const focus = {
                    lat: storeLat,
                    lon: storeLng
                };
                clearPointBeforeAddressSearch();
                searchResults.replaceChildren();
                searchResults.classList.add('d-none');
                searchHelp.textContent = '';
                error.classList.add('d-none');
                findAddressButton.disabled = true;
                const oldText = findAddressButton.textContent;
                findAddressButton.textContent = 'Đang tìm...';

                try {
                    const results = googleMap
                        ? (await new google.maps.Geocoder().geocode({ address: query, componentRestrictions: { country: 'VN' } })).results.map(item => ({
                            lat: item.geometry.location.lat(),
                            lon: item.geometry.location.lng(),
                            display_name: item.formatted_address
                        }))
                        : await window.SmartCarDeliveryGeocoding.search(query, focus);
                    if (revision !== locationRevision) return;
                    if (!Array.isArray(results)) throw new Error('Dữ liệu địa chỉ chưa hợp lệ.');

                    const candidates = results.filter(item =>
                        Number.isFinite(Number(item.lat)) && Number.isFinite(Number(item.lon)) &&
                        Math.abs(Number(item.lat)) <= 90 && Math.abs(Number(item.lon)) <= 180 &&
                        typeof item.display_name === 'string' && item.display_name.trim())
                        .slice(0, 8);

                    if (!candidates.length) {
                        error.textContent =
                            'Chưa thấy địa chỉ phù hợp. Hãy nhập thêm số nhà, tên đường và quận/huyện rồi thử lại.';
                        error.classList.remove('d-none');
                        return;
                    }

                    const selectCandidate = candidate => {
                        if (revision !== locationRevision) return;
                        if (!setPoint(Number(candidate.lat), Number(candidate.lon))) return;
                        address.value = candidate.display_name;
                        searchResults.replaceChildren();
                        searchResults.classList.add('d-none');
                        searchHelp.textContent = 'Đã chọn địa chỉ và tự đặt vị trí tương ứng.';
                    };

                    if (candidates.length === 1) {
                        selectCandidate(candidates[0]);
                    } else {
                        candidates.forEach(candidate => {
                            const choice = document.createElement('button');
                            choice.type = 'button';
                            choice.className = 'list-group-item list-group-item-action text-start text-break';
                            choice.textContent = candidate.display_name;
                            choice.addEventListener('click', () => selectCandidate(candidate));
                            searchResults.append(choice);
                        });
                        searchResults.classList.remove('d-none');
                        searchHelp.textContent = 'Có nhiều địa chỉ gần giống. Chọn đúng số nhà và quận/huyện để đặt ghim.';
                    }
                } catch (ex) {
                    if (revision !== locationRevision) return;
                    error.textContent =
                        (ex instanceof Error ? ex.message : 'Không thể tìm địa chỉ lúc này.') +
                        ' Bạn có thể bấm trực tiếp lên bản đồ hoặc dùng GPS để chọn điểm giao.';
                    error.classList.remove('d-none');
                } finally {
                    findAddressButton.disabled = false;
                    findAddressButton.textContent = oldText;
                }
            });

            form.addEventListener('submit', event => {
                if (!delivery.checked) return;

                if (!address.value.trim()) {
                    event.preventDefault();
                    error.textContent = 'Vui lòng nhập địa chỉ giao xe.';
                    error.classList.remove('d-none');
                    address.focus();
                    fields.scrollIntoView({
                        behavior: 'smooth',
                        block: 'center'
                    });
                    return;
                }

                if (!latInput.value || !lngInput.value) {
                    event.preventDefault();
                    error.textContent =
                        'Vui lòng bấm “Tìm trên bản đồ”, “Dùng vị trí hiện tại” hoặc chọn một điểm trên bản đồ để tính phí giao xe.';
                    error.classList.remove('d-none');
                    fields.scrollIntoView({
                        behavior: 'smooth',
                        block: 'center'
                    });
                    return;
                }

                const distanceKm = calculateDistanceKm(
                    Number(latInput.value),
                    Number(lngInput.value));

                if (distanceKm > maxDeliveryKm) {
                    event.preventDefault();
                    error.textContent =
                        `Điểm giao vượt phạm vi tối đa ${maxDeliveryKm.toFixed(0)} km. Vui lòng chọn điểm gần hơn.`;
                    error.classList.remove('d-none');
                    fields.scrollIntoView({
                        behavior: 'smooth',
                        block: 'center'
                    });
                }
            });

            initMap();
            toggle();
        })();
    </script>
}
